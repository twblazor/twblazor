<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- The XML doc file is a runtime input here, not just a build artifact: XmlDocSummary reads the
         "<assembly>.xml" next to the DLL, and its tests reflect over the fixtures in this assembly. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- 1591: most XmlDocSummary fixtures are intentionally undocumented. 1735: ParamAndTypeParamRefs
         intentionally uses a typeparamref with no matching generic parameter - it's markup being fed
         to XmlDocSummary, not a real doc comment on a generic member. -->
    <NoWarn>$(NoWarn);1591;1735</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AngleSharp" />
    <PackageReference Include="bunit" />
    <PackageReference Include="coverlet.MTP" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\build\TwBlazor.Docs.Compiler\TwBlazor.Docs.Compiler.csproj" />
    <ProjectReference Include="..\..\docs\TwBlazor.Docs\TwBlazor.Docs.csproj" />
    <ProjectReference Include="..\..\src\TwBlazor.Theme\TwBlazor.Theme.csproj" />
    <ProjectReference Include="..\..\src\TwBlazor\TwBlazor.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
