@page "/_Host"
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>TwBlazor</title>
    <base href="~/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="_content/twblazor/icons/bootstrap-icons.min.css">
    <link rel="stylesheet" href="_content/TwBlazor.Docs/css/output.css" />
</head>

<body>
    <div id="app" class="overflow-none">
        <div class="flex items-center justify-center h-screen dark:bg-gray-900">
            <output class="inline-flex flex-col items-center gap-3" aria-label="Loading">
                <span class="inline-block rounded-full animate-spin size-10 border-5 border-gray-200 dark:border-gray-700 border-t-purple-600 dark:border-t-purple-500" aria-hidden="true"></span>
                <p class="text-gray-700 dark:text-gray-100">Loading twblazor docs...</p>
            </output>
        </div>
    </div>

    <script src="_framework/blazor.webassembly.js"></script>
    <script src="_content/twblazor/js/twblazor.js"></script>
    <script src="_content/TwBlazor.Docs/js/themeToggle.js"></script>
    <!-- highlight js -->
    <script src="_content/TwBlazor.Docs/js/highlight.min.js"> </script>
</body>

</html>
