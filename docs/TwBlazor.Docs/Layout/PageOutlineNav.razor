@using TwBlazor.Models

@* The docs site's "On this page" rail. The list itself is TwOnThisPage, so the site shows the same
   component it documents; this wrapper only feeds it the page's sections and places it beside the content. *@
<TwOnThisPage Id="page-outline"
                   Items="items"
                   BasePath="@Path"
                   Class="sticky top-6 hidden max-h-[calc(100dvh-8rem)] w-56 shrink-0 self-start overflow-y-auto xl:block" />

@code {
    /// <summary>
    /// The page's sections, as registered by its <see cref="PageCard"/>s.
    /// </summary>
    [Parameter, EditorRequired] public PageOutline Outline { get; set; } = null!;

    /// <summary>
    /// The page's route (e.g. <c>/card</c>). Links are absolute to it so the <c>&lt;base href&gt;</c> can't
    /// turn a bare <c>#section</c> into a link to the site root.
    /// </summary>
    [Parameter, EditorRequired] public string Path { get; set; } = string.Empty;

    private IReadOnlyList<OnThisPageItem> items => [.. Outline.Items.Select(item => new OnThisPageItem(item.Id, item.Title))];
}
