@if (ownProperties.Count > 0 || globalProperties.Count > 0)
{
    <PageCard Id="@AnchorId" Title="Theme configuration">
        <Description>
            Styling is controlled by <code>TwBlazorTheme.Components</code> (a <code>@ThemeType.Name</code>), configured via the
            <code>AddTwBlazor()</code> options callback described on the <a href="/get-started" class="underline text-purple-700 dark:text-purple-300">Get Started</a> page.
            Every property is a set of Tailwind classes, so changes are picked up by your own Tailwind build.
        </Description>

        @if (inheritedFrom is { } inherited)
        {
            <p class="text-xs text-gray-500 dark:text-gray-500 mb-3">
                Inherited from <a href="@inherited.Route" class="underline text-purple-700 dark:text-purple-300">@inherited.Title</a> - this component reuses that theme rather than defining its own.
            </p>
        }

        @if (ownProperties.Count > 0)
        {
            <TwTable Bordered Striped Class="mb-4">
                <TableHeader>
                    <tr>
                        <th class="px-4 py-3">Property</th>
                        <th class="px-4 py-3">Type</th>
                        <th class="px-4 py-3">Controls</th>
                    </tr>
                </TableHeader>
                <TableBody>
                    @foreach (var property in ownProperties)
                    {
                        <tr>
                            <td class="px-4 py-3">
                                <a href="@property.DocsUrl" target="_blank" rel="noopener noreferrer" class="underline text-purple-700 dark:text-purple-300">
                                    <code class="text-xs">@property.Name</code>
                                </a>
                            </td>
                            <td class="px-4 py-3 text-xs text-gray-600 dark:text-gray-400">@property.TypeDisplay</td>
                            <td class="px-4 py-3 text-xs text-gray-600 dark:text-gray-400">
                                @foreach (var segment in property.Description)
                                {
                                    if (segment.Url is not null)
                                    {
                                        <a href="@segment.Url" target="_blank" rel="noopener noreferrer" class="underline text-purple-700 dark:text-purple-300">@segment.Text</a>
                                    }
                                    else
                                    {
                                        @segment.Text
                                    }
                                }
                            </td>
                        </tr>
                    }
                </TableBody>
            </TwTable>
        }

        @if (globalProperties.Count > 0)
        {
            <h3 class="text-sm font-semibold text-gray-900 dark:text-white mb-2">Global Theme Configuration</h3>
            <p class="text-xs text-gray-600 dark:text-gray-400 mb-2">
                These reuse shared design tokens configured once on <code>TwBlazorTheme</code>, rather than being unique to this component.
            </p>

            <TwTable Bordered Striped Class="mb-4">
                <TableHeader>
                    <tr>
                        <th class="px-4 py-3">Property</th>
                        <th class="px-4 py-3">Type</th>
                        <th class="px-4 py-3">Controls</th>
                    </tr>
                </TableHeader>
                <TableBody>
                    @foreach (var property in globalProperties)
                    {
                        <tr>
                            <td class="px-4 py-3">
                                <a href="@property.DocsUrl" target="_blank" rel="noopener noreferrer" class="underline text-purple-700 dark:text-purple-300">
                                    <code class="text-xs">@property.Name</code>
                                </a>
                            </td>
                            <td class="px-4 py-3 text-xs text-gray-600 dark:text-gray-400">@property.TypeDisplay</td>
                            <td class="px-4 py-3 text-xs text-gray-600 dark:text-gray-400">
                                @foreach (var segment in property.Description)
                                {
                                    if (segment.Url is not null)
                                    {
                                        <a href="@segment.Url" target="_blank" rel="noopener noreferrer" class="underline text-purple-700 dark:text-purple-300">@segment.Text</a>
                                    }
                                    else
                                    {
                                        @segment.Text
                                    }
                                }
                            </td>
                        </tr>
                    }
                </TableBody>
            </TwTable>
        }

        @ChildContent

        <p class="text-xs text-gray-500 dark:text-gray-500 mt-4">
            Full reference: <a href="@apiUrl" target="_blank" rel="noopener noreferrer" class="underline text-purple-700 dark:text-purple-300">@ThemeType.Name on the API docs</a>.
        </p>
    </PageCard>
}
