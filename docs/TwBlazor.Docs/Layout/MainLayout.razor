@inherits DocsLayoutBase
@using TwBlazor.Components

@* Follows the language unless the reader picks a direction in the navbar. *@
<TwDirectionProvider Direction="@directionState.Direction">
    <CascadingValue Value="directionState" IsFixed="true">
        <Navigation>
            @Body
        </Navigation>
    </CascadingValue>

    @* #region CodeExample GetStartedProviders *@
    @* #region CodeExample ToastSetupProvider *@
    <TwToastProvider />
    @* #endregion *@
    @* #region CodeExample DialogSetupProvider *@
    <TwDialogProvider />
    @* #endregion *@
    @* #endregion *@
</TwDirectionProvider>
