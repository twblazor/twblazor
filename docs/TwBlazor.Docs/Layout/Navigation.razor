@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject IJSRuntime JS

<TwSidebar NavigationItems="_navigationItems" MainContentClass="@(MainContentPadding ? "p-3" : string.Empty)" NavbarClass="justify-between" @bind-IsSidebarOpen="isSidebarOpen" IsSearchable>
    <NavbarNavigationContent>
        <span class="@navDividerClasses" aria-hidden="true"></span>
        <NavLink href="/" Match="NavLinkMatch.All" class="@navLinkClasses">
            Home
        </NavLink>
        <NavLink href="/get-started" Match="NavLinkMatch.All" class="@navLinkClasses">
            Get Started
        </NavLink>
    </NavbarNavigationContent>
    <NavbarActionsContent>
        <TwIcon Id="search-dialog-toggle" Icon="Icon.Search" AriaLabel="Open search dialog" OnClick="SearchDialog" Class="@navIconClasses" />
        <TwIcon Id="theme-toggle" Icon="@themeIcon" AriaLabel="@themeToggleLabel" OnClick="ToggleTheme" Class="@navIconClasses" />
        <span class="sr-only" role="status" aria-live="polite">@themeStatusMessage</span>
    </NavbarActionsContent>
    <HeaderContent>
        <a href="/" aria-label="twblazor home" class="ml-1 w-fit inline-flex justify-center items-center rounded text-2xl font-bold tracking-tight bg-linear-to-r from-purple-700 to-fuchsia-600 bg-clip-text text-transparent focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:from-purple-400 dark:to-fuchsia-300 dark:focus-visible:outline-purple-300">
            <img src="_content/TwBlazor.Docs/images/logo.svg" alt="" class="h-8 me-2" />
            twblazor
        </a>
    </HeaderContent>
    <NavigationItemContent Context="item">
        @if (IsNew(item))
        {
            <NewBadge />
        }
    </NavigationItemContent>
    <ChildContent>
        @ChildContent
        <SiteFooter />
    </ChildContent>
</TwSidebar>