@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@inject IJSRuntime JS

<TwSidebar NavigationItems="_navigationItems" MainContentClass="@(MainContentPadding ? "p-3" : string.Empty)" NavbarClass="justify-between" @bind-IsSidebarOpen="isSidebarOpen" IsSearchable>
    <NavbarNavigationContent>
        <NavLink href="/" Match="NavLinkMatch.All" class="@navLinkClasses">
           <TwIcon Icon="Icon.House" /> Home
        </NavLink>
        <NavLink href="/get-started" Match="NavLinkMatch.All" class="@navLinkClasses">
            <TwIcon Icon="Icon.Question_Circle" /> Get Started
        </NavLink>
    </NavbarNavigationContent>
    <NavbarActionsContent>
        <TwIcon Id="search-dialog-toggle" Icon="Icon.Search" AriaLabel="Open search dialog" OnClick="SearchDialog" Class="@navIconClasses" />
        <TwIcon Id="theme-toggle" Icon="@themeIcon" AriaLabel="Toggle theme" OnClick="ToggleTheme" Class="@navIconClasses" />
    </NavbarActionsContent>
    <HeaderContent>
        <a href="#" class="ml-1 w-fit inline-flex justify-center items-center text-2xl font-bold tracking-tight bg-linear-to-r from-purple-700 to-fuchsia-600 bg-clip-text text-transparent dark:from-purple-400 dark:to-fuchsia-300">
            <img src="_content/TwBlazor.Docs/images/logo.svg" alt="twblazor Logo" class="h-8 me-2" />
            twblazor
        </a>
    </HeaderContent>
    <NavigationItemContent Context="item">
        @if (IsNew(item))
        {
            <NewBadge />
        }
    </NavigationItemContent>
    <ChildContent>
        @ChildContent
        <SiteFooter />
    </ChildContent>
</TwSidebar>