@using TwBlazor.Docs.Services

<PageSeo Title="@(SeoTitle ?? SiteMetadata.ComponentTitle(Title ?? string.Empty))" Description="@Description" Path="@Path" />

<CascadingValue Value="_outline" IsFixed>
    <div class="mx-auto flex max-w-6xl items-start gap-10 p-6 text-sm text-gray-900 dark:text-gray-200">
        <div class="min-w-0 flex-1">
            @if (!string.IsNullOrWhiteSpace(category))
            {
                <p class="mb-2 text-sm font-medium text-gray-500 dark:text-gray-400">@category</p>
            }
            <h1 class="text-3xl font-bold tracking-tight text-gray-950 dark:text-white">@Title</h1>
            <p class="@(hasLastModified ? "mt-4 mb-2" : "mt-4 mb-6") text-base/7 text-gray-600 dark:text-gray-400">@Description</p>
            @if (hasLastModified)
            {
                <p class="mb-6 text-xs text-gray-600 dark:text-gray-400">Last updated <time datetime="@SiteMetadata.FormatIsoDate(lastModified)">@SiteMetadata.FormatDate(lastModified)</time></p>
            }

            @if (Beta)
            {
                <TwAlert Color="TwBlazor.Enums.Color.Warning" StartIcon="TwBlazor.Enums.Icon.Exclamation_Triangle" Class="mb-6 ps-3">
                    Please be aware this component is new, may have bugs and/or be subject to change. Please report any bugs at
                    <a href="@SiteMetadata.IssuesUrl" target="_blank" rel="noopener noreferrer" class="font-medium underline">@SiteMetadata.IssuesUrl</a>.
                </TwAlert>
            }

            @ChildContent

            @if (ThemeType is not null)
            {
                <ThemeConfigurationCard ThemeType="ThemeType" ComponentTitle="Title">@ThemeContent</ThemeConfigurationCard>
            }
        </div>

        <PageOutlineNav Outline="_outline" Path="@Path" />
    </div>
</CascadingValue>
