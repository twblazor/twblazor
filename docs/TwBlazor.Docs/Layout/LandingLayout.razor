@inherits DocsLayoutBase
@using TwBlazor.Components

@* Follows the language unless the reader picks a direction in the navbar. *@
<TwDirectionProvider Direction="@directionState.Direction">
    <CascadingValue Value="directionState" IsFixed="true">
        <Navigation MainContentPadding="false">
            @Body
        </Navigation>
    </CascadingValue>

    <TwToastProvider />
    <TwDialogProvider />
</TwDirectionProvider>
