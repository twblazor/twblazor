@using TwBlazor.Enums

<TwPopover Id="components-menu" Class="hidden lg:inline-flex" Open="isOpen" OpenChanged="OnOpenChanged" Offset="10"
           PanelClass="w-[40rem] max-w-[calc(100vw-2rem)] p-0 rounded-2xl overflow-hidden flex flex-col">
    <TriggerContent>
        <button type="button" class="@(context.IsOpen ? $"{triggerClasses} bg-purple-50 text-purple-700 dark:bg-purple-400/15 dark:text-purple-100" : triggerClasses)" @attributes="context.Attributes" @onclick="context.ToggleAsync">
            @Loc.Text("Nav_Menu_Components", "Components")
            <TwIcon Icon="Icon.Chevron_Down" Plain Class="@(context.IsOpen ? "text-xs transition-transform duration-200 rotate-180 motion-reduce:transition-none" : "text-xs transition-transform duration-200 motion-reduce:transition-none")" />
        </button>
    </TriggerContent>
    <ChildContent>
        <div class="flex flex-col gap-3 border-b border-gray-200 p-4 dark:border-white/10">
            <div>
                <p class="text-base font-semibold text-gray-950 dark:text-white">@Loc.Text("Nav_Menu_Components", "Components")</p>
                <p class="mt-0.5 text-sm text-gray-600 dark:text-gray-400">@Loc.Text("Nav_Menu_Description", "Accessible, themeable building blocks for Blazor.")</p>
            </div>
            <div class="relative">
                <TwIcon Icon="Icon.Search" Plain Class="pointer-events-none absolute start-3 top-1/2 -translate-y-1/2 text-sm text-gray-500 dark:text-gray-400" />
                <input id="components-menu-search" type="search" autocomplete="off" value="@query" @oninput="OnQueryInput"
                       placeholder="@Loc.Format("Nav_Menu_Search", "Search {0} components", _totalCount)"
                       aria-label="@Loc.Format("Nav_Menu_Search", "Search {0} components", _totalCount)"
                       aria-controls="components-menu-body"
                       class="h-10 w-full rounded-lg border border-gray-200 bg-gray-50 ps-9 pe-3 text-sm text-gray-950 placeholder:text-gray-500 focus-visible:border-purple-500 focus-visible:bg-white focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-purple-500/40 dark:border-white/10 dark:bg-white/5 dark:text-white dark:placeholder:text-gray-400 dark:focus-visible:border-purple-400 dark:focus-visible:bg-transparent" />
            </div>
        </div>

        <div id="components-menu-body" class="min-h-0 flex-1 overflow-y-auto overscroll-contain p-4 max-h-[min(30rem,calc(100dvh-14rem))]">
            @if (isSearching)
            {
                var found = matches;
                <p class="sr-only" role="status" aria-live="polite">@CountLabel(found.Count)</p>
                @if (found.Count == 0)
                {
                    <p class="px-2 py-6 text-center text-sm text-gray-600 dark:text-gray-400">@Loc.Text("Nav_Menu_NoMatch", "No components match your search.")</p>
                }
                else
                {
                    <ul class="grid grid-cols-2 gap-1">
                        @foreach (var (category, link) in found)
                        {
                            <li>
                                <a href="@link.Href" class="@linkClasses">
                                    <TwIcon Icon="@category.Icon" Plain Class="shrink-0 text-gray-500 dark:text-gray-400" />
                                    <span class="truncate">@link.Label</span>
                                    <span class="ms-auto shrink-0 text-xs text-gray-500 dark:text-gray-400">@category.Label</span>
                                </a>
                            </li>
                        }
                    </ul>
                }
            }
            else if (selected is { } category)
            {
                <div class="flex items-center gap-3">
                    <button type="button" @ref="backButton" class="inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-lg text-gray-600 transition-colors hover:bg-gray-100 hover:text-gray-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:text-gray-300 dark:hover:bg-white/10 dark:hover:text-white dark:focus-visible:outline-purple-300"
                            aria-label="@Loc.Text("Nav_Menu_Back", "All categories")" @onclick="CloseCategory">
                        <TwIcon Icon="Icon.Arrow_Left" Plain Class="rtl:-scale-x-100" />
                    </button>
                    <span class="@tileIconClasses"><TwIcon Icon="@category.Icon" Plain /></span>
                    <div class="min-w-0">
                        <p class="text-sm font-semibold text-gray-950 dark:text-white">@category.Label</p>
                        <p class="text-xs text-gray-600 dark:text-gray-400">@CountLabel(category.Count)</p>
                    </div>
                </div>
                @foreach (var group in category.Groups)
                {
                    @if (group.Heading is { } heading)
                    {
                        <p class="mt-4 px-2 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400">@heading</p>
                    }
                    <ul class="mt-2 grid grid-cols-2 gap-1 sm:grid-cols-3">
                        @foreach (var link in group.Links)
                        {
                            <li><a href="@link.Href" class="@linkClasses"><span class="truncate">@link.Label</span></a></li>
                        }
                    </ul>
                }
            }
            else
            {
                <ul class="grid grid-cols-2 gap-2">
                    @foreach (var item in _categories)
                    {
                        <li class="odd:last:col-span-2">
                            <button type="button" id="@TileId(item)" @ref="_tileRefs[item.Id]" class="@tileClasses" @onclick="() => OpenCategory(item)">
                                <span class="@tileIconClasses"><TwIcon Icon="@item.Icon" Plain /></span>
                                <span class="min-w-0">
                                    <span class="block truncate text-sm font-medium text-gray-950 dark:text-white">@item.Label</span>
                                    <span class="block text-xs text-gray-600 dark:text-gray-400">@CountLabel(item.Count)</span>
                                </span>
                                <TwIcon Icon="Icon.Chevron_Right" Plain Class="ms-auto shrink-0 text-xs text-gray-400 opacity-0 transition duration-200 group-hover:translate-x-0.5 group-hover:opacity-100 group-focus-visible:opacity-100 motion-reduce:transition-none rtl:-scale-x-100 rtl:group-hover:-translate-x-0.5" />
                            </button>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="flex items-center justify-between gap-3 border-t border-gray-200 bg-gray-50/70 px-4 py-3 text-sm dark:border-white/10 dark:bg-white/5">
            <span class="text-gray-600 dark:text-gray-400">@CountLabel(_totalCount)</span>
            <a href="/get-started" class="inline-flex items-center gap-1.5 rounded-md font-medium text-purple-700 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:text-purple-300 dark:focus-visible:outline-purple-300">
                @Loc.Text("Nav_GetStarted", "Get started")
                <TwIcon Icon="Icon.Arrow_Right" Plain Class="rtl:-scale-x-100" />
            </a>
        </div>
    </ChildContent>
</TwPopover>

@code {
    // Matches the other top-bar links, so the menu reads as one of them.
    private const string triggerClasses =
        "inline-flex cursor-pointer items-center gap-1.5 rounded-md px-3 py-1.5 text-sm font-medium text-gray-600 transition-colors duration-200 motion-reduce:transition-none hover:bg-gray-100 hover:text-gray-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:text-gray-300 dark:hover:bg-white/5 dark:hover:text-white dark:focus-visible:outline-purple-300";

    private const string tileClasses =
        "group flex w-full cursor-pointer items-center gap-3 rounded-xl border border-gray-200 bg-white p-3 text-start transition-colors duration-200 motion-reduce:transition-none hover:border-purple-300 hover:bg-purple-50/60 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:border-white/10 dark:bg-white/[0.03] dark:hover:border-purple-400/40 dark:hover:bg-purple-400/10 dark:focus-visible:outline-purple-300";

    private const string tileIconClasses =
        "inline-flex size-9 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-base text-gray-700 transition-colors duration-200 motion-reduce:transition-none group-hover:bg-purple-100 group-hover:text-purple-700 dark:bg-white/10 dark:text-gray-200 dark:group-hover:bg-purple-400/20 dark:group-hover:text-purple-200";

    private const string linkClasses =
        "flex min-h-9 items-center gap-2 rounded-lg px-2 py-1.5 text-sm text-gray-700 transition-colors hover:bg-purple-50 hover:text-purple-800 focus-visible:outline-2 focus-visible:outline-offset-0 focus-visible:outline-purple-600 dark:text-gray-300 dark:hover:bg-purple-400/10 dark:hover:text-white dark:focus-visible:outline-purple-300";
}
