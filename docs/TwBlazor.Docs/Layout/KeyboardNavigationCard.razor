@using TwBlazor.Docs.Services

@* The "Keyboard navigation" section of a component's docs page. PageContainer adds it to every page that
   has an entry in KeyboardShortcuts, so the keys are written down once and never drift between pages. *@
@if (guide is not null)
{
    <PageCard Title="Keyboard navigation">
        <Description NoMargin="@(guide.Shortcuts.Count == 0)">@guide.Summary</Description>
        @if (guide.Shortcuts.Count > 0)
        {
            <TwTable Bordered Striped AriaLabel="@($"{ComponentTitle} keyboard controls")">
                <TableHeader>
                    <tr>
                        <th scope="col" class="w-px px-4 py-3">Key</th>
                        <th scope="col" class="px-4 py-3">What it does</th>
                    </tr>
                </TableHeader>
                <TableBody>
                    @foreach (var shortcut in guide.Shortcuts)
                    {
                        <tr>
                            <th scope="row" class="px-4 py-3 text-left align-top font-normal">
                                <span class="flex flex-wrap items-start gap-1.5 sm:flex-nowrap">
                                    @for (var k = 0; k < shortcut.Keys.Count; k++)
                                    {
                                        var parts = shortcut.Keys[k].Split(" + ");
                                        if (k > 0)
                                        {
                                            @* Razor drops the whitespace between key caps, so the joining words carry their own spaces. *@
                                            <span class="sr-only">@(" or ")</span>
                                        }

                                        <span class="inline-flex items-start gap-1">
                                            @for (var i = 0; i < parts.Length; i++)
                                            {
                                                var part = parts[i];
                                                if (i > 0)
                                                {
                                                    <span aria-hidden="true" class="text-xs leading-6 text-gray-600 dark:text-gray-400">+</span>
                                                    <span class="sr-only">@(" plus ")</span>
                                                }

                                                if (part == "Enter")
                                                {
                                                    <kbd class="@keyCap"><TwIcon Icon="TwBlazor.Enums.Icon.Arrow_Return_Left" Class="@keyIcon" />Enter</kbd>
                                                }
                                                else if (_arrowIcons.TryGetValue(part, out var arrow))
                                                {
                                                    <kbd class="@keyCap"><TwIcon Icon="arrow" Class="@keyIcon" /><span class="sr-only">@part</span></kbd>
                                                }
                                                else if (part == "Shift")
                                                {
                                                    <kbd class="@keyCap"><TwIcon Icon="TwBlazor.Enums.Icon.Shift" Class="@keyIcon" />Shift</kbd>
                                                }
                                                else
                                                {
                                                    <kbd class="@keyCap">@part</kbd>
                                                }
                                            }
                                        </span>
                                    }
                                </span>
                            </th>
                            <td class="px-4 py-3 align-top text-xs text-gray-600 dark:text-gray-400">@shortcut.Action</td>
                        </tr>
                    }
                </TableBody>
            </TwTable>
        }
    </PageCard>
}

@code {
    /// <summary>
    /// The route of the page this card sits on (e.g. <c>/tabs</c>), which selects the keys to show.
    /// </summary>
    [Parameter, EditorRequired] public string Path { get; set; } = string.Empty;

    /// <summary>
    /// The component's name, used to name the table for assistive technology.
    /// </summary>
    [Parameter] public string? ComponentTitle { get; set; }

    private const string keyCap = "inline-flex h-6 min-w-6 items-center justify-center gap-1 rounded border border-gray-400 bg-gray-50 px-1.5 font-mono text-xs text-gray-900 dark:border-gray-500 dark:bg-gray-800 dark:text-gray-100";

    // The icon font drops its glyph below the baseline to sit beside text. As a flex box the glyph fills the
    // icon exactly, so the key cap can centre it.
    private const string keyIcon = "flex";

    private static readonly Dictionary<string, TwBlazor.Enums.Icon> _arrowIcons = new()
    {
        ["Arrow Up"] = TwBlazor.Enums.Icon.Arrow_Up,
        ["Arrow Down"] = TwBlazor.Enums.Icon.Arrow_Down,
        ["Arrow Left"] = TwBlazor.Enums.Icon.Arrow_Left,
        ["Arrow Right"] = TwBlazor.Enums.Icon.Arrow_Right,
    };

    private KeyboardGuide? guide;

    protected override void OnParametersSet() => guide = KeyboardShortcuts.ForPath(Path);
}
