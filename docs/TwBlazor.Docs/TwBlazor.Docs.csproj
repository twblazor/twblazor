<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TwBlazor.Docs.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TwBlazor\TwBlazor.csproj" />
  </ItemGroup>

  <!-- Build order only: makes the outer build compile TwBlazor.BuildTools (and TwBlazor.Theme) before this project,
       so GenerateDefaultTheme can run it with no-build instead of starting a second build that races this one for
       the same output files. Nothing from it is referenced or passed on to the docs hosts. -->
  <ItemGroup Condition="'$(CF_PAGES)' != '1'">
    <ProjectReference Include="..\..\build\TwBlazor.BuildTools\TwBlazor.BuildTools.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" SkipGetTargetFrameworkProperties="true" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\components.json" Link="components.json" />
  </ItemGroup>

  <!-- Each showcase page shows its own Razor source, so the source is embedded in the assembly. -->
  <ItemGroup>
    <EmbeddedResource Include="Pages\Showcase\*Showcase.razor" LogicalName="Showcase.%(Filename).razor" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\css\codeblockDark.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\css\codeblockLight.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\css\output.css">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\fonts\source-sans-3-v19-latin-700.woff2">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\fonts\source-sans-3-v19-latin-900.woff2">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\fonts\source-sans-3-v19-latin-regular.woff2">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\images\logo.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\images\logo.svg">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\images\og-image.png">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\images\placeholder-1.webp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\images\placeholder-2.webp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\images\placeholder-3.webp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\images\placeholder-4.webp">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\js\highlight.min.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\js\themeToggle.js">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="wwwroot\source-files\Theme.cs">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Everything TwBlazor.BuildTools reads and writes, so GenerateDefaultTheme only runs when one of the
       inputs is newer than the outputs (or an output is missing). The git index stands in for the git history
       that PageLastModified.cs and sitemap.xml come from. Pass -p:ForceDocsGeneration=true to always run it. -->
  <PropertyGroup>
    <_TwRepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../'))</_TwRepoRoot>
  </PropertyGroup>
  <ItemGroup>
    <_DocsGenInput Include="Pages\**\*.razor;Pages\**\*.cs;Layout\**\*.razor;Layout\**\*.cs;Llms\**\*.txt" />
    <_DocsGenInput Include="$(_TwRepoRoot)components.json" />
    <_DocsGenInput Include="$(_TwRepoRoot)src\TwBlazor.Theme\Theme.cs" />
    <_DocsGenInput Include="$(_TwRepoRoot)docs\TwBlazor.Server\Program.cs" />
    <_DocsGenInput Include="$(_TwRepoRoot)src\TwBlazor\**\*.cs;$(_TwRepoRoot)src\TwBlazor\**\*.razor" Exclude="$(_TwRepoRoot)src\TwBlazor\bin\**;$(_TwRepoRoot)src\TwBlazor\obj\**" />
    <_DocsGenInput Include="$(_TwRepoRoot)build\**\*.cs;$(_TwRepoRoot)build\**\*.csproj" Exclude="$(_TwRepoRoot)build\**\bin\**;$(_TwRepoRoot)build\**\obj\**" />
    <_DocsGenInput Include="$(_TwRepoRoot).git\index" Condition="Exists('$(_TwRepoRoot).git\index')" />
    <_DocsGenOutput Include="Generated\CodeExamples.cs;Generated\PageLastModified.cs;Generated\ThemeTemplateData.cs;Generated\AgentSkills.cs" />
    <_DocsGenOutput Include="$(_TwRepoRoot)docs\TwBlazor.WASM\wwwroot\sitemap.xml;$(_TwRepoRoot)docs\TwBlazor.WASM\wwwroot\llms.txt;$(_TwRepoRoot)docs\TwBlazor.WASM\wwwroot\llms-full.txt" />
  </ItemGroup>

  <!-- A missing output always makes MSBuild run the target, so forcing just adds one that never exists. -->
  <ItemGroup Condition="'$(ForceDocsGeneration)' == 'true'">
    <_DocsGenOutput Include="obj\docs-generation.force" />
  </ItemGroup>

  <!-- Generates CodeExamples.cs and the other files above by running TwBlazor.BuildTools before the build. -->
  <Target Name="GenerateDefaultTheme" BeforeTargets="BeforeBuild" Condition="'$(CF_PAGES)' != '1'" Inputs="@(_DocsGenInput)" Outputs="@(_DocsGenOutput)">
    <Message Text="Running TwBlazor build tools..." Importance="high" />
    <Exec Command="dotnet run --no-build --configuration $(Configuration) --project $(MSBuildThisFileDirectory)../../build/TwBlazor.BuildTools/TwBlazor.BuildTools.csproj" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
  </Target>

  <!-- Explicit Include: the default glob is evaluated before GenerateDefaultTheme
       runs, so on a clean checkout it wouldn't otherwise see this generated file. -->
  <ItemGroup>
    <Compile Remove="Generated\**" />
    <Compile Include="Generated\CodeExamples.cs" />
    <Compile Include="Generated\PageLastModified.cs" />
    <Compile Include="Generated\ThemeTemplateData.cs" />
    <Compile Include="Generated\AgentSkills.cs" />
  </ItemGroup>

  <!-- Copy TwBlazor's generated XML doc comments into wwwroot so ThemeConfigurationCard can fetch
       them at runtime under Blazor WebAssembly, where Assembly.Location is empty and there's no
       filesystem to read the file straight off disk (see XmlDocSummary.cs). Unlike GenerateDefaultTheme
       above, this always runs - including under Cloudflare Pages - since the published WASM site is
       exactly the target it exists for. AfterTargets="ResolveAssemblyReferences" is safe to rely on
       TwBlazor.xml already existing: TwBlazor.csproj is a ProjectReference, so its own build (which
       produces the XML file) is always a prerequisite of this project's build. -->
  <Target Name="CopyTwBlazorXmlDoc" AfterTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <_TwBlazorReference Include="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'TwBlazor'" />
    </ItemGroup>
    <PropertyGroup>
      <_TwBlazorXmlDocSource Condition="'@(_TwBlazorReference)' != ''">%(_TwBlazorReference.RootDir)%(_TwBlazorReference.Directory)%(_TwBlazorReference.Filename).xml</_TwBlazorXmlDocSource>
    </PropertyGroup>
    <Copy SourceFiles="$(_TwBlazorXmlDocSource)" DestinationFolder="$(MSBuildProjectDirectory)\wwwroot" SkipUnchangedFiles="true" Condition="'$(_TwBlazorXmlDocSource)' != '' and Exists('$(_TwBlazorXmlDocSource)')" />
  </Target>

  <!-- Explicit Remove+Include, same reasoning as Generated\CodeExamples.cs above: on a clean
       checkout the default wwwroot glob is evaluated before CopyTwBlazorXmlDoc runs, so it
       wouldn't otherwise see this generated file; the Remove avoids a duplicate item once the
       glob *does* see it on a later incremental build. -->
  <ItemGroup>
    <Content Remove="wwwroot\TwBlazor.xml" />
    <Content Include="wwwroot\TwBlazor.xml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\fonts\" />
  </ItemGroup>

</Project>
