@page "/textfield"
@using TwBlazor.Enums

<PageContainer Title="TwTextfield" Path="/textfield" Description="TwTextfield is a Blazor text input component. Bind Value, use Multiline for a textarea, add a clear button with Clearable, and validate with Validator." ThemeType="typeof(TwInputTheme)">
    <PageCard Title="Textfield">
        <Description>Bind <code>Value</code> to a labeled text input with a placeholder.</Description>
        <CodeExample Name="TextfieldBasic">
            <div class="md:flex-col flex-row flex gap-2">
                <TwTextfield Label="Forename" @bind-Value="Forename" Placeholder="Please enter your forename" AriaLabel="Forename textfield"  />
                <TwTextfield Label="Surname" @bind-Value="Surname" Placeholder="Please enter your surname" AriaLabel="Surname textfield" />
            </div>
        </CodeExample>
    </PageCard>
    <PageCard Title="Disabled textfield">
        <Description>Use the <code>Disabled</code> property to prevent interaction with the textfield.</Description>
        <CodeExample Name="TextfieldDisabled">
            <TwTextfield Label="Forename" @bind-Value="Forename" Placeholder="Please enter your forename" AriaLabel="Forename textfield" Disabled />
        </CodeExample>
    </PageCard>
    <PageCard Title="Readonly textfield">
        <Description>Use the <code>ReadOnly</code> property to display a value that can't be edited.</Description>
        <CodeExample Name="TextfieldReadonly">
            <TwTextfield Label="Account ID" @bind-Value="AccountId" Placeholder="Account ID" AriaLabel="Account ID textfield" ReadOnly />
        </CodeExample>
    </PageCard>
    <PageCard Title="Outlined variant">
        <Description>Set <code>Variant="InputVariant.Outlined"</code> for an outlined textfield style.</Description>
        <CodeExample Name="TextfieldOutlined">
            <div class="md:flex-col flex-row flex gap-2">
                <TwTextfield Label="Forename" @bind-Value="Forename" Placeholder="Please enter your forename" AriaLabel="Forename textfield" Variant="InputVariant.Outlined" />
                <TwTextfield Label="Surname" @bind-Value="Surname" Placeholder="Please enter your surname" AriaLabel="Surname textfield" Variant="InputVariant.Outlined" />
            </div>
        </CodeExample>
    </PageCard>
    <PageCard Title="Filled variant">
        <Description>Set <code>Variant="InputVariant.Filled"</code> for a filled textfield style.</Description>
        <CodeExample Name="TextfieldFilled">
            <div class="md:flex-col flex-row flex gap-2">
                <TwTextfield Label="Forename" @bind-Value="Forename" Placeholder="Please enter your forename" AriaLabel="Forename textfield" Variant="InputVariant.Filled" />
                <TwTextfield Label="Surname" @bind-Value="Surname" Placeholder="Please enter your surname" AriaLabel="Surname textfield" Variant="InputVariant.Filled" />
            </div>
        </CodeExample>
    </PageCard>
    <PageCard Title="Different input types">
        <Description>Use <code>InputType</code> to render native input types such as <code>email</code> and <code>password</code>.</Description>
        <CodeExample Name="TextfieldTypes">
            <div class="md:flex-col flex-row flex gap-2">
                <TwTextfield Label="Email" @bind-Value="Email" Placeholder="Enter your email address" AriaLabel="Email textfield" InputType="email" />
                <TwTextfield Label="Password" @bind-Value="Password" Placeholder="Enter password" AriaLabel="Password textfield" InputType="password" />
            </div>
        </CodeExample>
    </PageCard>
    <PageCard Title="Invalid textfield">
        <Description>Set <code>Invalid</code> and <code>ErrorMessage</code> to mark the textfield as failing validation. The message is rendered below the input and associated with it via <code>aria-describedby</code> so assistive technology announces it alongside the field.</Description>
        <CodeExample Name="TextfieldInvalid">
            <TwTextfield Label="Email" @bind-Value="InvalidEmail" Placeholder="Enter your email address" AriaLabel="Email textfield" Invalid ErrorMessage="Please enter a valid email address." />
        </CodeExample>
    </PageCard>
    <PageCard Title="Dense textfield">
        <Description>Set <code>Dense</code> for a more compact input with a smaller height and text size. Every single-line input shares the same dense height, so they line up when used side by side.</Description>
        <CodeExample Name="TextfieldDense">
            <TwTextfield Label="Forename" @bind-Value="Forename" Placeholder="Please enter your forename" AriaLabel="Dense forename textfield" Dense />
        </CodeExample>
    </PageCard>

    <PageCard Title="Clearable textfield">
        <Description>Set <code>Clearable</code> to show an X button at the end of the field. It is disabled while the field is empty. Pressing it empties the field, runs <code>Validator</code>, invokes <code>OnClear</code> and moves focus back into the field. The button is not a Tab stop, since keyboard users can clear the text themselves, and it is hidden while the field is disabled or read-only.</Description>
        <CodeExample Name="TextfieldClearable" CSharpName="TextfieldClearableCode">
            <div class="md:flex-col flex-row flex gap-2">
                <TwTextfield Label="Search" @bind-Value="SearchTerm" Placeholder="Search orders" Clearable OnClear="@(() => clearCount++)" />
                <TwTextfield Label="Reference" @bind-Value="Reference" Clearable Variant="InputVariant.Outlined" />
            </div>
            <p class="mt-2 text-sm text-gray-600 dark:text-gray-400">Cleared <strong>@clearCount</strong> times.</p>
        </CodeExample>
    </PageCard>

    <PageCard Title="Start and end content">
        <Description>Use <code>StartContent</code> and <code>EndContent</code> to draw content over the start or end of a single-line field, such as an icon or a unit. The field's padding is not widened for it, so add padding through <code>Class</code> so the text does not run underneath. Hide decorative content from screen readers with <code>aria-hidden="true"</code>.</Description>
        <CodeExample Name="TextfieldAdornments">
            <TwTextfield Label="Website" @bind-Value="Website" Placeholder="example.co.uk" Class="ps-9" Clearable>
                <StartContent>
                    <TwIcon Icon="Icon.Globe" aria-hidden="true" />
                </StartContent>
            </TwTextfield>
        </CodeExample>
    </PageCard>

    <PageCard Title="Validation on change">
        <Description>Pass a <code>Validator</code> function to have the textfield validate itself whenever its value changes. Return <code>null</code> (or an empty string) when the value is valid, or an error message to automatically mark the field <code>Invalid</code> and display the returned message - no need to manage <code>Invalid</code> or <code>ErrorMessage</code> yourself.</Description>
        <CodeExample Name="TextfieldValidator" CSharpName="TextfieldValidatorCode">
            <TwTextfield Label="Username" @bind-Value="Username" Placeholder="Enter a username" AriaLabel="Username textfield" Validator="ValidateUsername" />
        </CodeExample>
    </PageCard>
    <PageCard Title="Asynchronous validation">
        <Description><code>Validator</code> returns a <code>Task&lt;string?&gt;</code>, so it can perform asynchronous work such as an API call without blocking the UI. This example simulates checking username availability against a server.</Description>
        <CodeExample Name="TextfieldAsyncValidator" CSharpName="TextfieldAsyncValidatorCode">
            <TwTextfield Label="New Username" @bind-Value="NewUsername" Placeholder="Enter a username" AriaLabel="New username textfield" Validator="ValidateUsernameAvailabilityAsync" />
        </CodeExample>
    </PageCard>
    <PageCard Title="Multiline textfield">
        <Description>Set <code>Multiline</code> to render a <code>&lt;textarea&gt;</code> for longer text such as comments or descriptions. It shows three lines by default and can be resized vertically by dragging its corner.</Description>
        <CodeExample Name="TextfieldMultiline">
            <TwTextfield Label="Comments" @bind-Value="Comments" Placeholder="Tell us what you think" Multiline />
        </CodeExample>
    </PageCard>
    <PageCard Title="Multiline rows">
        <Description>Use <code>Rows</code> to set how many lines of text are visible before the field scrolls.</Description>
        <CodeExample Name="TextfieldMultilineRows">
            <div class="md:flex-col flex-row flex gap-2">
                <TwTextfield Label="Summary" @bind-Value="Summary" Placeholder="A one or two line summary" Multiline Rows="2" />
                <TwTextfield Label="Description" @bind-Value="IssueDescription" Placeholder="Describe the issue in detail" Multiline Rows="6" />
            </div>
        </CodeExample>
    </PageCard>
    <PageCard Title="Auto-growing multiline">
        <Description>Set <code>AutoGrow</code> to have the field grow taller as the user types instead of scrolling. <code>Rows</code> sets the starting height and <code>MaxRows</code> caps how tall it can grow, after which it scrolls. Browsers without support for the CSS <code>field-sizing</code> property keep the <code>Rows</code> height and scroll.</Description>
        <CodeExample Name="TextfieldMultilineAutoGrow">
            <TwTextfield Label="Message" @bind-Value="Message" Placeholder="Start typing and the field grows with you" Multiline AutoGrow Rows="2" MaxRows="8" BindEvent="oninput" />
        </CodeExample>
    </PageCard>
    <PageCard Title="Multiline variants">
        <Description>Multiline fields support every <code>Variant</code>, so they match the single-line fields beside them.</Description>
        <CodeExample Name="TextfieldMultilineVariants">
            <div class="flex flex-col gap-4">
                <TwTextfield Label="Default" @bind-Value="DefaultNotes" Placeholder="Notes" Multiline Variant="InputVariant.Default" />
                <TwTextfield Label="Outlined" @bind-Value="OutlinedNotes" Placeholder="Notes" Multiline Variant="InputVariant.Outlined" />
                <TwTextfield Label="Filled" @bind-Value="FilledNotes" Placeholder="Notes" Multiline Variant="InputVariant.Filled" />
            </div>
        </CodeExample>
    </PageCard>
    <PageCard Title="Dense multiline">
        <Description>Combine <code>Multiline</code> with <code>Dense</code> for tighter padding and a smaller text size.</Description>
        <CodeExample Name="TextfieldMultilineDense">
            <TwTextfield Label="Notes" @bind-Value="DenseNotes" Placeholder="Add a short note" Multiline Dense Rows="2" />
        </CodeExample>
    </PageCard>
    <PageCard Title="Multiline character limit">
        <Description>Pass <code>maxlength</code> through <code>Attributes</code> to limit how much can be typed, and bind on <code>oninput</code> to show a live count below the field.</Description>
        <CodeExample Name="TextfieldMultilineCharacterLimit" CSharpName="TextfieldMultilineCharacterLimitCode">
            <TwTextfield Label="Bio" @bind-Value="Bio" Placeholder="A few words about yourself" Multiline Rows="4" BindEvent="oninput" Attributes="@_bioAttributes" />
            <p class="mt-1 text-xs text-end">@Bio.Length / @bioMaxLength</p>
        </CodeExample>
    </PageCard>
    <PageCard Title="Multiline validation">
        <Description><code>Validator</code>, <code>Required</code>, <code>Disabled</code> and <code>ReadOnly</code> work the same way on a multiline field. The error message is linked to the textarea with <code>aria-describedby</code>.</Description>
        <CodeExample Name="TextfieldMultilineValidator" CSharpName="TextfieldMultilineValidatorCode">
            <div class="flex flex-col gap-4">
                <TwTextfield Label="Feedback" @bind-Value="Feedback" Placeholder="At least 20 characters" Multiline Required Validator="ValidateFeedback" />
                <TwTextfield Label="Terms" @bind-Value="Terms" Multiline Rows="2" ReadOnly />
                <TwTextfield Label="Archived notes" @bind-Value="ArchivedNotes" Multiline Rows="2" Disabled />
            </div>
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    public string Forename { get; set; } = string.Empty;
    public string Surname { get; set; } = string.Empty;
    public string Email { get; set; } = string.Empty;
    public string AccountId { get; set; } = "ACC-2049-7731";
    public string Password { get; set; } = string.Empty;
    public string InvalidEmail { get; set; } = "not-an-email";
    public string Comments { get; set; } = string.Empty;
    public string Summary { get; set; } = string.Empty;
    public string IssueDescription { get; set; } = string.Empty;
    public string Message { get; set; } = string.Empty;
    public string DefaultNotes { get; set; } = string.Empty;
    public string OutlinedNotes { get; set; } = string.Empty;
    public string FilledNotes { get; set; } = string.Empty;
    public string DenseNotes { get; set; } = string.Empty;

    public string Website { get; set; } = string.Empty;

    #region CodeExample TextfieldClearableCode
    public string SearchTerm { get; set; } = "Order 1042";
    public string Reference { get; set; } = "REF-7781";

    private int clearCount;
    #endregion

    #region CodeExample TextfieldMultilineCharacterLimitCode
    private const int bioMaxLength = 160;

    public string Bio { get; set; } = string.Empty;

    private readonly Dictionary<string, object> _bioAttributes = new() { ["maxlength"] = bioMaxLength };
    #endregion

    #region CodeExample TextfieldMultilineValidatorCode
    public string Feedback { get; set; } = string.Empty;
    public string Terms { get; set; } = "By continuing you agree to the terms of service.\nThese terms can't be changed here.";
    public string ArchivedNotes { get; set; } = "Archived on 1 March 2026.";

    private static Task<string?> ValidateFeedback(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<string?>("Feedback is required.");
        }

        return Task.FromResult<string?>(value.Trim().Length < 20 ? "Feedback must be at least 20 characters." : null);
    }
    #endregion

    #region CodeExample TextfieldValidatorCode
    public string Username { get; set; } = string.Empty;

    private static Task<string?> ValidateUsername(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<string?>("Username is required.");
        }

        if (value.Length < 3)
        {
            return Task.FromResult<string?>("Username must be at least 3 characters.");
        }

        return Task.FromResult<string?>(null);
    }
    #endregion

    #region CodeExample TextfieldAsyncValidatorCode
    public string NewUsername { get; set; } = string.Empty;

    private readonly HashSet<string> _takenUsernames = new(StringComparer.OrdinalIgnoreCase) { "admin", "root", "john" };

    private async Task<string?> ValidateUsernameAvailabilityAsync(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "Username is required.";
        }

        // Simulate a network call to check availability against a server.
        await Task.Delay(300);

        return _takenUsernames.Contains(value) ? $"'{value}' is already taken." : null;
    }
    #endregion
}