@page "/showcase/tesco"
@layout EmptyLayout
@using TwBlazor.Docs.Pages.Showcase.Shared
@using TwBlazor.Models
@using IconEnum = TwBlazor.Enums.Icon

<ShowcasePage Brand="_brand">
    <ChildContent>
        <TwFlex Element="LayoutElement.Nav" Wrap="FlexWrap.Wrap" Justify="JustifyContent.End" ColGap="5" RowGap="1" AriaLabel="Tesco example services" Class="border-b border-neutral-200 px-6 py-1.5 text-xs text-grocerblue-600">
            @foreach (var link in _services)
            {
                <a href="@Anchor("showcase-main")" class="underline-offset-4 hover:underline @focusClass">@link</a>
            }
        </TwFlex>

        <TwNavbar AriaLabel="Tesco example header">
            <BrandContent>
                <a href="@_brand.Path" class="@focusClass"><ShowcaseLogo Brand="_brand" /></a>
            </BrandContent>
            <NavigationContent>
                <label class="flex h-11 w-full max-w-xl items-center gap-2 rounded-full border border-neutral-400 bg-white px-4 text-neutral-800 focus-within:border-grocerblue-600 focus-within:ring-2 focus-within:ring-grocerblue-600">
                    <span class="sr-only">Search groceries</span>
                    <input type="search" placeholder="Search" class="min-w-0 flex-1 bg-transparent placeholder:text-neutral-600 focus:outline-hidden" />
                    <span class="text-grocerblue-600" aria-hidden="true"><TwIcon Icon="IconEnum.Search" Plain /></span>
                </label>
            </NavigationContent>
            <ActionsContent>
                <TwButton Label="Sign in" Color="Color.Primary" Variant="ButtonVariant.Outlined" StartIcon="IconEnum.Person" />
                <TwButton Label="@($"Basket ({basket})")" Color="Color.Primary" StartIcon="IconEnum.Basket2" Href="@Anchor("showcase-products")" />
            </ActionsContent>
        </TwNavbar>

        <nav class="bg-grocerblue-600 text-white" aria-label="Tesco example departments">
            <TwContainer MaxWidth="ContainerSize.Xl7" Gutter="4">
                <TwFlex Element="LayoutElement.Ul" Wrap="FlexWrap.Wrap" ColGap="1">
                    @foreach (var link in _departments)
                    {
                        <li><a href="@Anchor("showcase-products")" class="block px-3 py-3 text-sm font-bold underline-offset-4 hover:underline @focusClass">@link</a></li>
                    }
                </TwFlex>
            </TwContainer>
        </nav>

        <main id="showcase-main">
            <TwContainer Element="LayoutElement.Section" AriaLabelledBy="showcase-hero-heading" MaxWidth="ContainerSize.Xl7" Gutter="6" PaddingY="10">
                <TwGrid Cols="1" ColsMd="3" Gap="6">
                    <TwGridItem ColSpanMd="2">
                        <TwFlex Direction="FlexDirection.Col" Align="AlignItems.Start" Justify="JustifyContent.Center" Gap="4" FullHeight>
                            <h1 id="showcase-hero-heading" class="text-4xl font-bold text-balance text-grocerblue-600 md:text-5xl">Your weekly shop, sorted</h1>
                            <p class="max-w-lg text-lg text-neutral-800">Book a delivery or Click+Collect slot, fill your basket and leave the rest to us.</p>
                            <TwFlex Wrap="FlexWrap.Wrap" Gap="3">
                                <TwButton Label="Book a slot" Color="Color.Primary" Href="@Anchor("showcase-products")" />
                                <TwButton Label="Shop groceries" Color="Color.Primary" Variant="ButtonVariant.Outlined" Href="@Anchor("showcase-products")" />
                            </TwFlex>
                        </TwFlex>
                    </TwGridItem>
                    <TwFlex Direction="FlexDirection.Col" Justify="JustifyContent.Between" Gap="4" Class="rounded-md bg-clubyellow-400 p-6 text-grocerblue-700">
                        <p class="text-sm font-bold uppercase tracking-wide">Clubcard Prices</p>
                        <p class="text-3xl font-black text-balance">Better baskets with Clubcard</p>
                        <a href="@Anchor("showcase-products")" class="inline-flex items-center gap-1 self-start font-bold underline underline-offset-4 @focusClass">See this week's offers <TwIcon Icon="IconEnum.Chevron_Right" Plain /></a>
                    </TwFlex>
                </TwGrid>
            </TwContainer>

            <TwContainer Element="LayoutElement.Section" Id="showcase-products" AriaLabelledBy="showcase-products-heading" MaxWidth="ContainerSize.Xl7" Gutter="6" PaddingBottom="12" Class="scroll-mt-6">
                <h2 id="showcase-products-heading" class="text-2xl font-bold text-grocerblue-600">This week's Clubcard Prices</h2>
                <TwGrid Cols="1" ColsSm="2" ColsLg="4" Gap="4" Class="mt-6">
                    @foreach (var product in _brand.Products)
                    {
                        <TwCard>
                            <TwFlex Element="LayoutElement.Article" Direction="FlexDirection.Col" FullHeight Gap="3">
                                <ShowcaseImage Url="@product.Image" Alt="@($"Tesco {product.Name}")" Icon="product.Icon" Class="aspect-4/3 w-full rounded-sm object-contain" FallbackClass="bg-neutral-100 text-6xl text-neutral-400" />
                                <h3 class="font-bold text-grocerblue-600">Tesco @product.Name</h3>
                                <TwFlex Element="LayoutElement.P" Align="AlignItems.Baseline" Gap="2">
                                    <span class="text-xl font-bold text-neutral-900">@product.Price</span>
                                    <span class="text-sm text-neutral-600">@product.Description</span>
                                </TwFlex>
                                <TwFlex Element="LayoutElement.P" Align="AlignItems.Center" Gap="2" Class="self-start bg-clubyellow-400 pe-3 text-sm font-bold text-grocerblue-700">
                                    <TwChip Label="Clubcard" Color="Color.Primary" Size="ChipSize.Small" Rounded="Rounded.None" />
                                    @product.Tag
                                </TwFlex>
                                <TwFlexItem PushEnd>
                                    <TwButton Label="Add" AriaLabel="@($"Add Tesco {product.Name} to basket")" Color="Color.Primary" Class="w-full justify-center" OnClick="@(() => basket++)" />
                                </TwFlexItem>
                            </TwFlex>
                        </TwCard>
                    }
                </TwGrid>
                <p class="mt-6 text-sm font-bold text-grocerblue-600" aria-live="polite">@(basket == 0 ? "Your basket is empty." : $"{basket} in your basket.")</p>
            </TwContainer>
        </main>
    </ChildContent>
    <Footer>
        <TwFooter Sections="@_footer" BottomLinks="@_legal" Copyright="An example page, not a Tesco website." NavigationLabel="Tesco example footer" />
    </Footer>
</ShowcasePage>

@code {
    private const string focusClass = "rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current";

    private static readonly ShowcaseBrand _brand = ShowcaseBrand.Tesco;

    private static readonly string[] _services = ["Tesco.com", "Tesco Bank", "Tesco Mobile", "Delivery Saver", "Store locator", "Help"];

    private static readonly string[] _departments = ["Groceries", "Clubcard", "F&F Clothing", "Recipes", "Offers", "Marketplace"];

    private static readonly (string Title, string[] Links)[] _footerColumns =
    [
        ("Here to help", ["Help", "Contact us", "Product recall", "Store locator"]),
        ("About Tesco", ["Our services", "Careers", "Sustainability", "Tesco PLC"]),
        ("Our website", ["Privacy Centre", "Terms and conditions", "Accessibility", "Site map"]),
        ("Ways to shop", ["Delivery", "Click+Collect", "Whoosh", "Delivery Saver"])
    ];

    // The same columns as the component's own models. Every link leads back to the top of this example.
    private static readonly FooterSection[] _footer =
        [.. _footerColumns.Select(column => new FooterSection(column.Title, [.. column.Links.Select(link => new FooterLink(link, Anchor("showcase-main")))]))];

    private static readonly FooterLink[] _legal = [("Privacy", Anchor("showcase-main")), ("Terms of use", Anchor("showcase-main")), ("Accessibility", Anchor("showcase-main"))];

    private int basket;

    private static string Anchor(string id) => $"{_brand.Path}#{id}";
}
