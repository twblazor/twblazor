@using TwBlazor.Docs.Generated
@implements IDisposable
@inject TwBlazorOptions Options

<PageSeo Title="@($"{Brand.Name}-inspired theme | twblazor example themes")" Description="@description" Path="@Brand.Path" />

@* A stylesheet link is allowed in the body. It sits here because the page's head content is already taken by PageSeo. *@
<link rel="stylesheet" href="@Brand.Stylesheet" />

<TwFlex Id="@($"showcase-{Brand.Slug}")" Direction="FlexDirection.Col" Class="min-h-dvh">
    <ShowcaseBar Current="@Brand" BackHref="/#theme-case-study">An example theme inspired by @Brand.Name. Not affiliated with @Brand.Name.</ShowcaseBar>

    @if (!isThemed)
    {
        <TwFlex Direction="FlexDirection.Col" Align="AlignItems.Center" Justify="JustifyContent.Center" Gap="3" role="status" Class="flex-1 px-6 py-24 text-center text-gray-700 dark:text-gray-300">
            <TwSpinner Color="Color.Dark" />
            <p>Loading the @Brand.Name-inspired theme.</p>
        </TwFlex>
    }
    else
    {
        <div class="@pageClass">
            @ChildContent

            <div class="@Options.Theme.Colors.NeutralSurface.BackgroundSubtle">
                <TwContainer MaxWidth="ContainerSize.Xl7" Gutter="6" PaddingY="16">
                    <TwFlex Direction="FlexDirection.Col" Gap="16">
                        <section aria-labelledby="showcase-traits-heading">
                            <p class="text-xs font-semibold uppercase tracking-wide @neutralText.Muted">About this example</p>
                            <h2 id="showcase-traits-heading" class="mt-1 @sectionHeadingClass">What this theme changes</h2>
                            <p class="mt-2 max-w-2xl @neutralText.Secondary">@Brand.Summary</p>
                            <TwGrid Element="LayoutElement.Dl" Cols="1" ColsSm="2" ColsLg="4" Gap="4" Class="mt-6">
                                @foreach (var trait in Brand.Traits)
                                {
                                    <TwCard>
                                        <dt class="text-xs uppercase tracking-wide @neutralText.Muted">@trait.Label</dt>
                                        <dd class="mt-1 font-semibold @neutralText.Heading">@trait.Value</dd>
                                    </TwCard>
                                }
                            </TwGrid>
                        </section>

                        <section id="showcase-components" class="scroll-mt-6" aria-labelledby="showcase-components-heading">
                            <h2 id="showcase-components-heading" class="@sectionHeadingClass">The same components, restyled</h2>
                            <p class="mt-2 max-w-2xl @neutralText.Secondary">None of the components below is given a color, a corner or a shadow. Each takes its look from the theme file.</p>
                            <div class="mt-6">
                                <ShowcaseGallery Brand="@Brand" />
                            </div>
                        </section>

                        <section id="showcase-theme" class="scroll-mt-6" aria-labelledby="showcase-theme-heading">
                            <h2 id="showcase-theme-heading" class="@sectionHeadingClass">The code behind this page</h2>
                            <p class="mt-2 max-w-2xl @neutralText.Secondary">
                                The page is plain Razor using twblazor components, and its look comes from one theme file, the same shape as the default <code>Theme.cs</code>. This page's stylesheet is compiled by Tailwind from these two files.
                            </p>
                            <div class="mt-6">
                                <TwTabContainer TabColor="Color.Primary">
                                    <TwTab Label="Showcase.razor">
                                        <div id="showcase-razor">
                                            <TwCodeBlock Content="@razorSource" Language="html" Title="Showcase.razor" Class="max-h-150 overflow-y-scroll" />
                                        </div>
                                    </TwTab>
                                    <TwTab Label="Theme.cs">
                                        <div id="showcase-theme-file">
                                            <TwCodeBlock Content="@CodeExamples.Get(Brand.CodeExample)" Language="csharp" Title="Theme.cs" Class="max-h-150 overflow-y-scroll" />
                                        </div>
                                    </TwTab>
                                </TwTabContainer>
                            </div>
                        </section>
                    </TwFlex>
                </TwContainer>
            </div>

            @Footer
        </div>
    }

    @* A note, not a footer: the page's footer landmark is the brand's own TwFooter above. *@
    <TwFlexItem PushEnd role="note" Class="border-t border-gray-200 bg-white px-6 py-6 dark:border-gray-800 dark:bg-gray-950">
        <p id="showcase-disclaimer" class="mx-auto max-w-7xl text-xs text-gray-600 dark:text-gray-400">@ShowcaseBrand.Disclaimer</p>
    </TwFlexItem>
</TwFlex>
