@page "/showcase/apple"
@layout EmptyLayout
@using TwBlazor.Docs.Pages.Showcase.Shared
@using TwBlazor.Models
@using IconEnum = TwBlazor.Enums.Icon

<ShowcasePage Brand="_brand">
    <ChildContent>
        <TwNavbar AriaLabel="Apple example navigation">
            <BrandContent>
                <a href="@_brand.Path" class="@focusClass"><ShowcaseLogo Brand="_brand" /></a>
            </BrandContent>
            <NavigationContent>
                <TwFlex Wrap="FlexWrap.Wrap" Justify="JustifyContent.Center" ColGap="1" Class="flex-1">
                    @foreach (var link in _navigation)
                    {
                        <a href="@Anchor("showcase-products")" class="px-2.5 py-2 text-xs opacity-80 hover:opacity-100 @focusClass">@link</a>
                    }
                </TwFlex>
            </NavigationContent>
            <ActionsContent>
                <TwIcon Icon="IconEnum.Search" AriaLabel="Search" OnClick="@OnIconClick" />
                <TwIcon Icon="IconEnum.Bag" AriaLabel="@($"Shopping bag, {basket} items")" OnClick="@OnIconClick" />
            </ActionsContent>
        </TwNavbar>

        <TwFlex Element="LayoutElement.Main" Id="showcase-main" Direction="FlexDirection.Col" Gap="3">
            @* Each band takes the background of its own picture, black then white, so the picture runs edge to edge with no seam.
               The white band opts out of dark mode, since its picture is on white whatever the visitor's setting. *@
            <section class="bg-black text-center text-[#f5f5f7]" aria-labelledby="showcase-hero-heading">
                <TwContainer MaxWidth="ContainerSize.Xl5" Gutter="6" PaddingTop="14">
                    <TwFlex Direction="FlexDirection.Col" Align="AlignItems.Center">
                        <h1 id="showcase-hero-heading" class="text-5xl font-semibold tracking-tight md:text-[56px]">iPhone 18 Pro</h1>
                        <p class="mt-1 text-xl md:text-[28px]">Built for brilliance.</p>
                        <TwFlex Wrap="FlexWrap.Wrap" Justify="JustifyContent.Center" Gap="4" Class="mt-5">
                            <TwButton Label="Learn more" Color="Color.Primary" Href="@Anchor("showcase-products")" />
                            <TwButton Label="Buy" Color="Color.Light" Variant="ButtonVariant.Outlined" Href="@Anchor("showcase-products")" />
                        </TwFlex>
                    </TwFlex>
                </TwContainer>
                <ShowcaseImage Url="@_brand.HeroImage" Alt="iPhone 18 Pro lying across the word Pro" Icon="IconEnum.Phone" Class="h-64 w-full object-cover object-center md:h-[26rem]" FallbackClass="items-end text-[14rem] leading-none text-[#86868b]" />
            </section>

            <section class="theme-light bg-white text-center text-[#1d1d1f]" aria-labelledby="showcase-second-heading">
                <TwContainer MaxWidth="ContainerSize.Xl5" Gutter="6" PaddingTop="14">
                    <TwFlex Direction="FlexDirection.Col" Align="AlignItems.Center">
                        <h2 id="showcase-second-heading" class="text-5xl font-semibold tracking-tight md:text-[56px]">iPad Air</h2>
                        <p class="mt-1 text-xl md:text-[28px]">Thin. Light. Ready for anything.</p>
                        <TwFlex Wrap="FlexWrap.Wrap" Justify="JustifyContent.Center" Gap="4" Class="mt-5">
                            <TwButton Label="Learn more" Color="Color.Primary" Href="@Anchor("showcase-products")" />
                            <TwButton Label="Buy" Color="Color.Primary" Variant="ButtonVariant.Outlined" Href="@Anchor("showcase-products")" />
                        </TwFlex>
                    </TwFlex>
                </TwContainer>
                <img src="@($"{ShowcaseBrand.LocalImages}/ipad-hero.jpg")" alt="iPad Air in blue, with the other colors fanned out behind it" loading="lazy" decoding="async" width="1260" height="680" class="mx-auto h-auto w-full max-w-5xl" />
            </section>

            <TwContainer Element="LayoutElement.Section" Id="showcase-products" AriaLabelledBy="showcase-products-heading" MaxWidth="ContainerSize.None" Gutter="3" PaddingBottom="3" Class="scroll-mt-6">
                <h2 id="showcase-products-heading" class="sr-only">More from the store</h2>
                <TwGrid Cols="1" ColsMd="2" Gap="3">
                    @foreach (var product in _brand.Products)
                    {
                        <TwCard>
                        <TwFlex Element="LayoutElement.Article" Direction="FlexDirection.Col" Align="AlignItems.Center" Class="text-center">
                            <TwChip Label="@product.Tag" Color="Color.Warning" Variant="ButtonVariant.Text" Size="ChipSize.Small" Class="font-semibold uppercase tracking-wide text-[#bf4800] dark:text-[#f56300]" />
                            <h3 class="mt-1 text-[40px] font-semibold tracking-tight">@product.Name</h3>
                            <p class="mt-1 text-[21px]">@product.Description</p>
                            <p class="mt-2 text-sm text-[#6e6e73] dark:text-[#a1a1a6]">@product.Price</p>
                            <TwFlex Wrap="FlexWrap.Wrap" Justify="JustifyContent.Center" Gap="3" Class="mt-4">
                                <TwButton Label="Learn more" AriaLabel="@($"Learn more about {product.Name}")" Color="Color.Primary" Href="@Anchor("showcase-components")" />
                                <TwButton Label="Buy" AriaLabel="@($"Buy {product.Name}")" Color="Color.Primary" Variant="ButtonVariant.Outlined" OnClick="@(() => basket++)" />
                            </TwFlex>
                            <ShowcaseImage Url="@product.Image" Alt="@product.Name" Icon="product.Icon" Class="mt-8 h-56 w-full rounded-2xl object-cover" FallbackClass="items-end text-[9rem] leading-none text-[#86868b]" />
                        </TwFlex>
                        </TwCard>
                    }
                </TwGrid>
                <p class="mt-6 text-center text-sm" aria-live="polite">@(basket == 0 ? "Your bag is empty." : $"{basket} in your bag.")</p>
            </TwContainer>
        </TwFlex>
    </ChildContent>
    <Footer>
        <TwFooter Sections="@_footer" BottomLinks="@_legal" Copyright="An example page, not an Apple website." NavigationLabel="Apple example footer">
            <BrandContent>
                <p class="border-b border-[#d2d2d7] pb-4 text-xs dark:border-[#424245]">Prices shown are examples only. Trade-in values, finance and availability on this page are illustrative.</p>
            </BrandContent>
        </TwFooter>
    </Footer>
</ShowcasePage>

@code {
    private const string focusClass = "rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current";

    private static readonly ShowcaseBrand _brand = ShowcaseBrand.Apple;

    private static readonly string[] _navigation = ["Store", "Mac", "iPad", "iPhone", "Watch", "Vision", "AirPods", "TV & Home", "Entertainment", "Accessories", "Support"];

    private static readonly (string Title, string[] Links)[] _footerColumns =
    [
        ("Shop and Learn", ["Store", "Mac", "iPad", "iPhone", "Watch"]),
        ("Account", ["Manage Your Account", "Apple Store Account", "iCloud.com"]),
        ("Apple Store", ["Find a Store", "Genius Bar", "Today at Apple", "Order Status"]),
        ("About Apple", ["Newsroom", "Apple Leadership", "Career Opportunities", "Contact Apple"])
    ];

    // The same columns as the component's own models. Every link leads back to the top of this example.
    private static readonly FooterSection[] _footer =
        [.. _footerColumns.Select(column => new FooterSection(column.Title, [.. column.Links.Select(link => new FooterLink(link, Anchor("showcase-main")))]))];

    private static readonly FooterLink[] _legal = [("Privacy", Anchor("showcase-main")), ("Terms of use", Anchor("showcase-main")), ("Accessibility", Anchor("showcase-main"))];

    private int basket;

    private static void OnIconClick()
    {
        // The icon buttons are for show: this example has no search, account or wishlist behind them.
    }

    private static string Anchor(string id) => $"{_brand.Path}#{id}";
}
