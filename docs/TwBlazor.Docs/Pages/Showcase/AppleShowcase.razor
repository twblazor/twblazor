@page "/showcase/apple"
@layout EmptyLayout
@using TwBlazor.Docs.Pages.Showcase.Shared
@using IconEnum = TwBlazor.Enums.Icon

<ShowcasePage Brand="brand">
    <ChildContent>
        <TwNavbar AriaLabel="Apple example navigation">
            <BrandContent>
                <a href="@brand.Path" class="@focusClass"><ShowcaseLogo Brand="brand" /></a>
            </BrandContent>
            <NavigationContent>
                <div class="flex flex-1 flex-wrap justify-center gap-x-1">
                    @foreach (var link in navigation)
                    {
                        <a href="@Anchor("showcase-products")" class="px-2.5 py-2 text-xs opacity-80 hover:opacity-100 @focusClass">@link</a>
                    }
                </div>
            </NavigationContent>
            <ActionsContent>
                <TwIcon Icon="IconEnum.Search" AriaLabel="Search" OnClick="@OnIconClick" />
                <TwIcon Icon="IconEnum.Bag" AriaLabel="@($"Shopping bag, {basket} items")" OnClick="@OnIconClick" />
            </ActionsContent>
        </TwNavbar>

        <main id="showcase-main" class="flex flex-col gap-3">
            <section class="bg-[#f5f5f7] text-center text-[#1d1d1f] dark:bg-[#161617] dark:text-[#f5f5f7]" aria-labelledby="showcase-hero-heading">
                <div class="mx-auto flex max-w-5xl flex-col items-center px-6 pt-14">
                    <h1 id="showcase-hero-heading" class="text-5xl font-semibold tracking-tight md:text-[56px]">iPhone 18 Pro</h1>
                    <p class="mt-1 text-xl md:text-[28px]">Built for brilliance.</p>
                    <div class="mt-5 flex flex-wrap justify-center gap-4">
                        <TwButton Label="Learn more" Color="Color.Primary" Href="@Anchor("showcase-products")" />
                        <TwButton Label="Buy" Color="Color.Primary" Variant="ButtonVariant.Outlined" Href="@Anchor("showcase-products")" />
                    </div>
                    <ShowcaseImage Url="@brand.HeroImage" Alt="iPhone 18 Pro" Icon="IconEnum.Phone" Class="mt-10 h-72 w-full max-w-3xl object-cover" FallbackClass="items-end text-[14rem] leading-none text-[#86868b]" />
                </div>
            </section>

            <section class="bg-black text-center text-[#f5f5f7]" aria-labelledby="showcase-second-heading">
                <div class="mx-auto flex max-w-5xl flex-col items-center px-6 pt-14">
                    <h2 id="showcase-second-heading" class="text-5xl font-semibold tracking-tight md:text-[56px]">MacBook</h2>
                    <p class="mt-1 text-xl md:text-[28px]">iPhone and Mac. Better together.</p>
                    <div class="mt-5 flex flex-wrap justify-center gap-4">
                        <TwButton Label="Learn more" Color="Color.Primary" Href="@Anchor("showcase-products")" />
                        <TwButton Label="Buy" Color="Color.Light" Variant="ButtonVariant.Outlined" Href="@Anchor("showcase-products")" />
                    </div>
                    <ShowcaseImage Url="@brand.Products[^1].Image" Alt="MacBook beside an iPhone" Icon="IconEnum.Laptop" Class="mt-10 h-64 w-full max-w-3xl object-cover" FallbackClass="items-end text-[13rem] leading-none text-[#6e6e73]" />
                </div>
            </section>

            <section id="showcase-products" class="scroll-mt-6 px-3 pb-3" aria-labelledby="showcase-products-heading">
                <h2 id="showcase-products-heading" class="sr-only">More from the store</h2>
                <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                    @foreach (var product in brand.Products)
                    {
                        <TwCard>
                        <article class="flex flex-col items-center text-center">
                            <TwChip Label="@product.Tag" Color="Color.Warning" Variant="ButtonVariant.Text" Size="ChipSize.Small" Class="font-semibold uppercase tracking-wide text-[#bf4800] dark:text-[#f56300]" />
                            <h3 class="mt-1 text-[40px] font-semibold tracking-tight">@product.Name</h3>
                            <p class="mt-1 text-[21px]">@product.Description</p>
                            <p class="mt-2 text-sm text-[#6e6e73] dark:text-[#a1a1a6]">@product.Price</p>
                            <div class="mt-4 flex flex-wrap justify-center gap-3">
                                <TwButton Label="Learn more" AriaLabel="@($"Learn more about {product.Name}")" Color="Color.Primary" Href="@Anchor("showcase-components")" />
                                <TwButton Label="Buy" AriaLabel="@($"Buy {product.Name}")" Color="Color.Primary" Variant="ButtonVariant.Outlined" OnClick="@(() => basket++)" />
                            </div>
                            <ShowcaseImage Url="@product.Image" Alt="@product.Name" Icon="product.Icon" Class="mt-8 h-56 w-full rounded-2xl object-cover" FallbackClass="items-end text-[9rem] leading-none text-[#86868b]" />
                        </article>
                        </TwCard>
                    }
                </div>
                <p class="mt-6 text-center text-sm" aria-live="polite">@(basket == 0 ? "Your bag is empty." : $"{basket} in your bag.")</p>
            </section>
        </main>
    </ChildContent>
    <Footer>
        <footer class="bg-[#f5f5f7] text-xs text-[#6e6e73] dark:bg-[#161617] dark:text-[#a1a1a6]">
            <div class="mx-auto max-w-5xl px-6 py-8">
                <p class="border-b border-[#d2d2d7] pb-4 dark:border-[#424245]">Prices shown are examples only. Trade-in values, finance and availability on this page are illustrative.</p>
                <div class="grid grid-cols-2 gap-6 py-6 md:grid-cols-4">
                    @foreach (var (title, links) in footer)
                    {
                        <div>
                            <h2 class="font-semibold text-[#1d1d1f] dark:text-[#f5f5f7]">@title</h2>
                            <ul class="mt-2 flex flex-col gap-2">
                                @foreach (var link in links)
                                {
                                    <li><a href="@Anchor("showcase-main")" class="underline-offset-4 hover:underline @focusClass">@link</a></li>
                                }
                            </ul>
                        </div>
                    }
                </div>
            </div>
        </footer>
    </Footer>
</ShowcasePage>

@code {
    private const string focusClass = "rounded-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-current";

    private static readonly ShowcaseBrand brand = ShowcaseBrand.Apple;

    private static readonly string[] navigation = ["Store", "Mac", "iPad", "iPhone", "Watch", "Vision", "AirPods", "TV & Home", "Entertainment", "Accessories", "Support"];

    private static readonly (string Title, string[] Links)[] footer =
    [
        ("Shop and Learn", ["Store", "Mac", "iPad", "iPhone", "Watch"]),
        ("Account", ["Manage Your Account", "Apple Store Account", "iCloud.com"]),
        ("Apple Store", ["Find a Store", "Genius Bar", "Today at Apple", "Order Status"]),
        ("About Apple", ["Newsroom", "Apple Leadership", "Career Opportunities", "Contact Apple"])
    ];

    private int basket;

    // The icon buttons are for show: this example has no search, account or wishlist behind them.
    private static void OnIconClick()
    {
    }

    private static string Anchor(string id) => $"{brand.Path}#{id}";
}
