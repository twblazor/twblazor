@page "/tabs"

<PageContainer Title="TwTabs" Path="/tabs" Description="TwTabs is a Blazor tabs component, built from TwTabContainer and TwTab. Set Label, Color, Dense and Disabled, and colour the whole container or single tabs." ThemeType="typeof(TwTabTheme)">
    <PageCard Title="Basic tabs">
        <Description>Use <code>TwTabContainer</code> and <code>TwTab</code> to split content into switchable panels.</Description>
        <CodeExample Name="TabsBasic">
            <TwTabContainer AriaLabel="Example tabs 1">
                <TwTab Label="Tab 1">
                    <p>This is the content of Tab 1.</p>
                </TwTab>
                <TwTab Label="Tab 2">
                    <p>This is the content of Tab 2.</p>
                </TwTab>
            </TwTabContainer>
        </CodeExample>
    </PageCard>

    <PageCard Title="Container tab colors">
        <Description>Set <code>TabColor</code> on <code>TwTabContainer</code> to choose the colour of the selected tab's label and underline. Unselected tabs stay neutral, so the selected tab is always the one that stands out.</Description>
        <CodeExample Name="TabContainerColors">
            <TwTabContainer AriaLabel="Example tabs 2" TabColor="Color.Accent">
                <TwTab Label="Tab 1">
                    <p>Setting the <code>TabColor</code> property on the <code>TwTabContainer</code> sets the selected colour for every tab within that container.</p>
                </TwTab>
                <TwTab Label="Tab 2">
                    <p>This is the content of Tab 2.</p>
                </TwTab>
                <TwTab Label="Tab 3">
                    <p>This is the content of Tab 2.</p>
                </TwTab>
            </TwTabContainer>
        </CodeExample>
    </PageCard>

    <PageCard Title="Single tab colors">
        <Description>Set <code>Color</code> on an individual <code>TwTab</code> to give just that tab its own selected colour. Select each tab below to see it.</Description>
        <CodeExample Name="TabColors">
            <TwTabContainer AriaLabel="Example tabs 3">
                <TwTab Label="Tab 1" Color="Color.Danger">
                    <p>Setting the <code>Color</code> property on an individual tab sets the colour it uses while it is selected.</p>
                </TwTab>
                <TwTab Label="Tab 2" Color="Color.Success">
                    <p>This is the content of Tab 2.</p>
                </TwTab>
                <TwTab Label="Tab 3" Color="Color.Primary">
                    <p>This is the content of Tab 3.</p>
                </TwTab>
            </TwTabContainer>
        </CodeExample>
    </PageCard>

    <PageCard Title="Dense tabs">
        <Description>Set <code>Dense</code> on <code>TwTabContainer</code> to render more compact tabs.</Description>
        <CodeExample Name="TabsDense">
            <TwTabContainer AriaLabel="Example tabs 4" Dense>
                <TwTab Label="Tab 1">
                    <p>This is the content of Tab 1.</p>
                </TwTab>
                <TwTab Label="Tab 2">
                    <p>This is the content of Tab 2.</p>
                </TwTab>
            </TwTabContainer>
        </CodeExample>
    </PageCard>

    <PageCard Title="Disabled tabs">
        <Description>Set <code>Disabled</code> on a <code>TwTab</code> to prevent it from being selected.</Description>
        <CodeExample Name="TabsDisabled">
            <TwTabContainer AriaLabel="Example tabs 5" Dense>
                <TwTab Label="Tab 1">
                    <p>This is the content of Tab 1.</p>
                </TwTab>
                <TwTab Label="Disabled" Disabled>
                    <p>This is the content of Tab 2.</p>
                </TwTab>
            </TwTabContainer>
        </CodeExample>
    </PageCard>
</PageContainer>