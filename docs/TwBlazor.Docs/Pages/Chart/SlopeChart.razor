@page "/chart/slope"
@using TwBlazor.Models

<PageContainer Title="TwSlopeChart" Path="/chart/slope" Description="TwSlopeChart is a Blazor slope chart: a labelled line per series between two points in time, showing the direction and size of each change.">
    <PageCard Title="Basic usage">
        <Description><code>TwSlopeChart</code> draws a straight line per series between two points in time and labels both ends, so the direction and size of each change is read from the slope. Use two categories for the classic form.</Description>

        <CodeExample Name="SlopeChartBasic" CSharpName="SlopeChartData">
            <TwChart Title="Market share" Description="Percent">
                <TwSlopeChart Categories="@_years" Series="@_share" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="More than two points">
        <Description>Extra categories add intermediate points. The first is labelled with the series name and value, and the last with its value.</Description>

        <CodeExample Name="SlopeChartThree" CSharpName="SlopeChartThreeData">
            <TwChart Title="Market share">
                <TwSlopeChart Categories="@_threeYears" Series="@_shareByYear" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Formatting">
        <Description><code>ValueFormat</code> applies to the end labels as well as the tooltips and table view.</Description>

        <CodeExample Name="SlopeChartFormat">
            <TwChart Title="Market share">
                <TwSlopeChart Categories="@_years" Series="@_share" ValueFormat="0\%" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Summary">
        <Description>Tooltips and the table view give the value of every series for each category.</Description>
    </PageCard>

    <PageCard Title="Shared features">
        <Description>The legend, tooltips, keyboard navigation, table view, value formatting, height and empty state work the same on every chart. See <TwLink Href="/chart" Class="underline">TwChart</TwLink> for those options.</Description>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample SlopeChartData
    private readonly string[] _years = ["2020", "2025"];

    private readonly ChartSeries[] _share =
    [
        new("Aster", [34, 41]),
        new("Birch", [28, 19]),
        new("Cedar", [15, 26])
    ];
    #endregion

    #region CodeExample SlopeChartThreeData
    private readonly string[] _threeYears = ["2015", "2020", "2025"];

    private readonly ChartSeries[] _shareByYear =
    [
        new("Aster", [22, 34, 41]),
        new("Birch", [37, 28, 19]),
        new("Cedar", [9, 15, 26])
    ];
    #endregion
}
