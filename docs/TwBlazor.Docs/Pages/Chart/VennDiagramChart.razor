@page "/chart/venn-diagram"
@using TwBlazor.Models

<PageContainer Title="TwVennDiagramChart" Path="/chart/venn-diagram" Description="TwVennDiagramChart is a Blazor Venn diagram: up to three sets as equal overlapping circles, with the shared count where each pair meets.">
    <PageCard Title="Basic usage">
        <Description><code>TwVennDiagramChart</code> draws each <code>ChartSet</code> as a circle and overlaps them all. A <code>ChartSetIntersection</code> names two sets and how many elements they share; that number is written where the two circles meet.</Description>

        <CodeExample Name="VennDiagramChartBasic" CSharpName="VennDiagramChartData">
            <TwChart Title="Skills on the team" Description="People with each skill">
                <TwVennDiagramChart Sets="@_skills" Intersections="@_sharedSkills" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Two sets">
        <Description>With two sets the circles sit side by side. Intersections can name their sets in either order.</Description>

        <CodeExample Name="VennDiagramChartTwo" CSharpName="VennDiagramChartTwoData">
            <TwChart Title="Newsletter and app users" Description="Thousands of customers">
                <TwVennDiagramChart Sets="@_audiences" Intersections="@_sharedAudience" LabelHeader="Audience" ValueHeader="Customers" Height="ChartHeight.Small" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Missing overlaps">
        <Description>A Venn diagram always draws every possible overlap. A pair with no intersection given still overlaps on the plot but shows no number. To draw only the overlaps that exist, with circles sized by their sets, use <TwLink Href="/chart/euler-diagram" Class="underline">TwEulerDiagramChart</TwLink>.</Description>

        <CodeExample Name="VennDiagramChartPartial" CSharpName="VennDiagramChartPartialData">
            <TwChart Title="Features used last month" Description="Accounts">
                <TwVennDiagramChart Sets="@_features" Intersections="@_sharedFeatures" ValueFormat="#,0" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="When to use">
        <Description>Use a Venn diagram to show which sets overlap. The circles are all the same size, so read the numbers, not the areas. Up to three sets are drawn, and sets with no size are left out. To size the circles by their sets, use <TwLink Href="/chart/euler-diagram" Class="underline">TwEulerDiagramChart</TwLink>.</Description>
    </PageCard>

    <PageCard Title="Summary">
        <Description>Tooltips and the table view give the size of each set and of each overlap.</Description>
    </PageCard>

    <PageCard Title="Shared features">
        <Description>The legend, tooltips, keyboard navigation, table view, value formatting, height and empty state work the same on every chart. See <TwLink Href="/chart" Class="underline">TwChart</TwLink> for those options.</Description>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample VennDiagramChartData
    private readonly ChartSet[] _skills = [new("Research", 38), new("Design", 32), new("Engineering", 44)];

    private readonly ChartSetIntersection[] _sharedSkills =
    [
        new("Research", "Design", 14),
        new("Design", "Engineering", 9),
        new("Research", "Engineering", 6)
    ];
    #endregion

    #region CodeExample VennDiagramChartTwoData
    private readonly ChartSet[] _audiences = [new("Newsletter", 120), new("App", 85)];

    private readonly ChartSetIntersection[] _sharedAudience = [new("App", "Newsletter", 40)];
    #endregion

    #region CodeExample VennDiagramChartPartialData
    private readonly ChartSet[] _features = [new("Reports", 2400), new("Exports", 1100), new("Alerts", 860)];

    private readonly ChartSetIntersection[] _sharedFeatures = [new("Reports", "Exports", 940), new("Reports", "Alerts", 310)];
    #endregion
}
