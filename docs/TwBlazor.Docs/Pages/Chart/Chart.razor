@page "/chart"
@using TwBlazor.Models

<PageContainer Title="TwChart" Path="/chart" Beta Description="TwChart is a Blazor chart container with over thirty chart types: bar, column, line, area, pie, radar, waterfall, heatmap and more. Accessible, themeable and script-free." ThemeType="typeof(TwChartTheme)">
    <PageCard Title="Basic usage">
        <Description>
            <code>TwChart</code> is the container: it adds a title, a description and a loading state. Place one
            chart component inside it and pass the data. Every chart supplies its own legend, tooltips on hover
            and keyboard focus, and a table view of the same data. Tab into a chart, then use the arrow,
            <kbd>Home</kbd> and <kbd>End</kbd> keys to move between data points.
        </Description>

        <CodeExample Name="ChartBasic" CSharpName="ChartCategoryData">
            <TwChart Title="Revenue by region" Description="Thousands of pounds, last quarter">
                <TwColumnChart Categories="@regions" Series="@revenue" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Bar and column">
        <Description>
            <code>TwBarChart</code> draws horizontal bars and <code>TwColumnChart</code> draws vertical ones. Pass
            more than one series for a grouped chart. Set <code>ShowValues</code> to label each bar.
        </Description>

        <CodeExample Name="ChartBar">
            <TwChart Title="Revenue by region">
                <TwBarChart Categories="@regions" Series="@revenue" ShowValues="true" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartGrouped">
            <TwChart Title="Revenue by region and year">
                <TwColumnChart Categories="@regions" Series="@yearly" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Stacked and diverging">
        <Description>
            Set <code>Stacking</code> to <code>ChartStacking.Stacked</code> to show totals, or
            <code>ChartStacking.Percent</code> to show shares. Negative values grow the other way from the
            baseline, which makes a diverging chart.
        </Description>

        <CodeExample Name="ChartStacked">
            <TwChart Title="Revenue by region and year">
                <TwColumnChart Categories="@regions" Series="@yearly" Stacking="ChartStacking.Stacked" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartPercent">
            <TwChart Title="Share of revenue by year">
                <TwBarChart Categories="@regions" Series="@yearly" Stacking="ChartStacking.Percent" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartDiverging" CSharpName="ChartDivergingData">
            <TwChart Title="Survey: the new layout is easier to use">
                <TwBarChart Categories="@teams" Series="@sentiment" Stacking="ChartStacking.Stacked" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Lollipop, dot plot and dumbbell">
        <Description>
            <code>TwLollipopChart</code> is a lighter bar chart. <code>TwDotPlotChart</code> compares series by
            position on a scale that does not have to start at zero, and <code>TwDumbbellChart</code> joins the
            dots to draw attention to the gap between them.
        </Description>

        <CodeExample Name="ChartLollipop">
            <TwChart Title="Revenue by region">
                <TwLollipopChart Categories="@regions" Series="@revenue" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartDotPlot">
            <TwChart Title="Revenue by region and year">
                <TwDotPlotChart Categories="@regions" Series="@yearly" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartDumbbell">
            <TwChart Title="Revenue change by region">
                <TwDumbbellChart Categories="@regions" Series="@yearly" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Range and Gantt">
        <Description>
            <code>TwRangeChart</code> draws a floating bar from a low to a high value.
            <code>TwGanttChart</code> does the same for tasks between two dates.
        </Description>

        <CodeExample Name="ChartRange" CSharpName="ChartRangeData">
            <TwChart Title="Salary bands" Description="Thousands of pounds">
                <TwRangeChart Ranges="@salaryBands" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartGantt" CSharpName="ChartGanttData">
            <TwChart Title="Release plan">
                <TwGanttChart Tasks="@tasks" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Bullet">
        <Description>
            <code>TwBulletChart</code> benchmarks an actual value against a target, with optional shaded bands
            for qualitative ranges. Each measure has its own scale.
        </Description>

        <CodeExample Name="ChartBullet" CSharpName="ChartBulletData">
            <TwChart Title="Quarterly targets">
                <TwBulletChart Items="@bullets" Height="ChartHeight.Small" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Waterfall">
        <Description>
            <code>TwWaterfallChart</code> shows how increases and decreases build up to a total. Each value is a
            change; the total column is added for you.
        </Description>

        <CodeExample Name="ChartWaterfall" CSharpName="ChartWaterfallData">
            <TwChart Title="Profit bridge" Description="Thousands of pounds">
                <TwWaterfallChart Data="@bridge" ShowValues="true" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Line and area">
        <Description>
            <code>TwLineChart</code> shows a trend. Set <code>Curve</code> to <code>ChartCurve.Smooth</code> for
            a spline or <code>ChartCurve.Step</code> for a step line. <code>TwAreaChart</code> fills the space
            under the line, and <code>Stacked</code> shows how the series add up.
        </Description>

        <CodeExample Name="ChartLine" CSharpName="ChartTrendData">
            <TwChart Title="Monthly visitors" Description="Thousands">
                <TwLineChart Categories="@months" Series="@visitors" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartSpline">
            <TwChart Title="Monthly visitors" Description="Thousands">
                <TwLineChart Categories="@months" Series="@visitors" Curve="ChartCurve.Smooth" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartStep">
            <TwChart Title="Monthly visitors" Description="Thousands">
                <TwLineChart Categories="@months" Series="@visitors" Curve="ChartCurve.Step" ShowMarkers="false" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartArea">
            <TwChart Title="Monthly visitors" Description="Thousands">
                <TwAreaChart Categories="@months" Series="@visitors" Stacked="true" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Slope and bump">
        <Description>
            <code>TwSlopeChart</code> shows change between two points in time, labelled at both ends.
            <code>TwBumpChart</code> tracks how the series rank against each other.
        </Description>

        <CodeExample Name="ChartSlope" CSharpName="ChartSlopeData">
            <TwChart Title="Market share" Description="Percent">
                <TwSlopeChart Categories="@years" Series="@share" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartBump">
            <TwChart Title="Visitor ranking by month">
                <TwBumpChart Categories="@months" Series="@visitors" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Small multiples">
        <Description>
            <code>TwSmallMultiplesChart</code> repeats one simple chart per series on a shared scale. Reach for it
            when a single plot would hold too many series. <code>Kind</code> picks columns, a line or an area.
        </Description>

        <CodeExample Name="ChartSmallMultiples">
            <TwChart Title="Monthly visitors by channel" Description="Thousands">
                <TwSmallMultiplesChart Categories="@months" Series="@visitors" Kind="SmallMultipleKind.Area" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Radar and parallel coordinates">
        <Description>
            Both compare items across several variables. <code>TwRadarChart</code> uses one shared scale around
            a center. <code>TwParallelCoordinatesChart</code> gives every variable its own axis and scale.
        </Description>

        <CodeExample Name="ChartRadar" CSharpName="ChartProfileData">
            <TwChart Title="Laptop comparison" Description="Score out of 10">
                <TwRadarChart Categories="@attributes" Series="@laptops" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartParallel">
            <TwChart Title="Laptop comparison" Description="Score out of 10">
                <TwParallelCoordinatesChart Categories="@attributes" Series="@laptops" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Heatmap and matrix">
        <Description>
            Both lay series out as rows and categories as columns. <code>TwHeatmapChart</code> shows the value by
            color intensity and <code>TwMatrixChart</code> by the size of a dot.
        </Description>

        <CodeExample Name="ChartHeatmap" CSharpName="ChartGridData">
            <TwChart Title="Support tickets by day and shift">
                <TwHeatmapChart Categories="@days" Series="@shifts" ShowValues="true" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartMatrix">
            <TwChart Title="Support tickets by day and shift">
                <TwMatrixChart Categories="@days" Series="@shifts" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Scatter, bubble and quadrant">
        <Description>
            <code>TwScatterChart</code> positions points by two values. Give points a <code>Size</code> for a
            bubble chart, or set <code>Connect</code> to join them in order. <code>TwQuadrantChart</code> adds
            two thresholds and a label for each of the four regions.
        </Description>

        <CodeExample Name="ChartScatter" CSharpName="ChartPointData">
            <TwChart Title="Price against rating">
                <TwScatterChart Series="@products" XTitle="Price" YTitle="Rating" SizeTitle="Units sold" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartQuadrant">
            <TwChart Title="Backlog priorities">
                <TwQuadrantChart Series="@backlog" XTitle="Effort" YTitle="Impact" XThreshold="5" YThreshold="5"
                                 TopLeftLabel="Quick wins" TopRightLabel="Major projects" BottomLeftLabel="Fill-ins" BottomRightLabel="Reconsider" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Pie, donut and Nightingale">
        <Description>
            <code>TwPieChart</code> shows parts of a whole. Set <code>InnerRadius</code> for a donut and
            <code>Semicircle</code> for a half donut. <code>TwNightingaleChart</code> uses equal angles and
            varies the radius instead. Past eight values, the smallest fold into one "Other" slice.
        </Description>

        <CodeExample Name="ChartPie" CSharpName="ChartShareData">
            <TwChart Title="Traffic by source">
                <TwPieChart Data="@sources" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartDonut">
            <TwChart Title="Traffic by source">
                <TwPieChart Data="@sources" InnerRadius="0.6" CenterText="1,000" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartSemicircle">
            <TwChart Title="Traffic by source">
                <TwPieChart Data="@sources" InnerRadius="0.6" Semicircle="true" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartNightingale">
            <TwChart Title="Traffic by source">
                <TwNightingaleChart Data="@sources" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Waffle, treemap and funnel">
        <Description>
            <code>TwWaffleChart</code> shows shares as squares worth one percent each.
            <code>TwTreemapChart</code> tiles the plot with rectangles sized by value.
            <code>TwFunnelChart</code> shows what remains at each stage of a process; set <code>Inverted</code>
            for a pyramid.
        </Description>

        <CodeExample Name="ChartWaffle">
            <TwChart Title="Traffic by source">
                <TwWaffleChart Data="@sources" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartTreemap">
            <TwChart Title="Traffic by source">
                <TwTreemapChart Data="@sources" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartFunnel" CSharpName="ChartFunnelData">
            <TwChart Title="Checkout funnel">
                <TwFunnelChart Data="@funnel" LabelHeader="Stage" ValueHeader="Visitors" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Radial bar and gauge">
        <Description>
            <code>TwRadialBarChart</code> bends bars around a circle. <code>TwGaugeChart</code> shows one value
            between a minimum and a maximum.
        </Description>

        <CodeExample Name="ChartRadialBar">
            <TwChart Title="Traffic by source">
                <TwRadialBarChart Data="@sources" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartGauge">
            <TwChart Title="Storage used">
                <TwGaugeChart Value="68" Label="Percent used" Height="ChartHeight.Small" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Icon chart">
        <Description>
            <code>TwIconChart</code> draws values with any <code>Icon</code>. By default it repeats the icon
            (a pictogram). Set <code>Mode</code> to <code>IconChartMode.Size</code> to scale one icon per value.
        </Description>

        <CodeExample Name="ChartIcon" CSharpName="ChartIconData">
            <TwChart Title="Team size by office">
                <TwIconChart Data="@offices" Icon="Icon.Person" LabelHeader="Office" ValueHeader="People" Height="ChartHeight.Small" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartIconSize">
            <TwChart Title="Team size by office">
                <TwIconChart Data="@offices" Icon="Icon.Person" Mode="IconChartMode.Size" Height="ChartHeight.Small" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Distributions">
        <Description>
            <code>TwHistogramChart</code> groups raw values into bins. <code>TwBoxPlotChart</code> summarises
            each group by its quartiles, and <code>TwStripPlotChart</code> shows every observation; set
            <code>Jitter</code> to spread overlapping dots.
        </Description>

        <CodeExample Name="ChartHistogram" CSharpName="ChartSampleData">
            <TwChart Title="Response times" Description="Milliseconds">
                <TwHistogramChart Values="@responseTimes" BinCount="8" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartBoxPlot">
            <TwChart Title="Response times by service" Description="Milliseconds">
                <TwBoxPlotChart Samples="@services" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartStripPlot">
            <TwChart Title="Response times by service" Description="Milliseconds">
                <TwStripPlotChart Samples="@services" Jitter="true" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Candlestick and OHLC">
        <Description>
            <code>TwCandlestickChart</code> shows the open, high, low and close of each period. Set
            <code>Kind</code> to <code>CandlestickStyle.Ohlc</code> for open and close ticks instead of a body.
        </Description>

        <CodeExample Name="ChartCandlestick" CSharpName="ChartOhlcData">
            <TwChart Title="Share price" Description="Pounds">
                <TwCandlestickChart Items="@prices" />
            </TwChart>
        </CodeExample>

        <CodeExample Name="ChartOhlc">
            <TwChart Title="Share price" Description="Pounds">
                <TwCandlestickChart Items="@prices" Kind="CandlestickStyle.Ohlc" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Formatting values">
        <Description>
            Set <code>ValueFormat</code> to any .NET numeric format string, or <code>ValueFormatter</code> for
            full control. The format applies to the axis, tooltips, value labels and table view alike.
        </Description>

        <CodeExample Name="ChartFormat">
            <TwChart Title="Revenue by region">
                <TwColumnChart Categories="@regions" Series="@revenue" ValueFormat="C0" ShowValues="true" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Height, loading and empty states">
        <Description>
            <code>Height</code> on the container or on a chart sets the plot height. <code>Loading</code> shows a
            placeholder while data is fetched, and a chart with no data shows <code>EmptyText</code>.
        </Description>

        <CodeExample Name="ChartStates">
            <div class="grid gap-8 md:grid-cols-2">
                <TwChart Title="Loading" Height="ChartHeight.Small" Loading="true" />
                <TwChart Title="No data" Height="ChartHeight.Small">
                    <TwColumnChart EmptyText="Nothing to show for this period" />
                </TwChart>
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Accessibility">
        <Description>
            The chart is named by the container's <code>Title</code>. Each data point is announced with its
            values and is reachable by keyboard: the plot is one tab stop, and the arrow, <kbd>Home</kbd> and
            <kbd>End</kbd> keys move between points, showing the same tooltip as hover. Tooltips can be
            dismissed with <kbd>Esc</kbd>. "View as table" presents the same data without the plot; only set
            <code>ShowTableToggle</code> to <code>false</code> when that data is available elsewhere on the page.
            Legend entries are buttons that hide and show a series, and a series keeps its color while others
            are hidden. Colors are assigned in a fixed order chosen so neighboring series stay distinguishable
            for color-blind readers; keep to eight series or fewer.
        </Description>
    </PageCard>

    <PageCard Title="Adding your own chart type">
        <Description>
            Every chart is a small class that describes what to draw. Derive from <code>TwCategoryChartBase</code>
            (categories and series), <code>TwValueChartBase</code> (labelled values) or <code>TwChartBase</code>,
            and add marks with the <code>ChartSceneBuilder</code>. Positions are percentages of the plot area.
            The legend, tooltips, keyboard support, table view and theming come from the base class.
        </Description>

        <TwChart Title="Onboarding progress" Description="Percent complete">
            <CompletionChart Data="@onboarding" LabelHeader="Step" ValueHeader="Complete" Height="ChartHeight.Small" />
        </TwChart>

        <TwCodeBlock Content="@CodeExamples.Get("ChartCustomCode")" Language="csharp" Class="mt-4" />
    </PageCard>
</PageContainer>

