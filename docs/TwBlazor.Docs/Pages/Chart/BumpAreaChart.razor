    #endregion

    #region CodeExample BumpAreaChartRaceData
    private readonly string[] quarters = ["Q1 23", "Q2 23", "Q3 23", "Q4 23", "Q1 24", "Q2 24", "Q3 24", "Q4 24"];

    private readonly ChartSeries[] browsers =
    [
        new("Falcon", [38, 36, 33, 30, 27, 25, 22, 20]),
        new("Otter", [24, 26, 29, 32, 35, 37, 40, 43]),
