@page "/chart/network-diagram"
@using TwBlazor.Models

<PageContainer Title="TwNetworkDiagramChart" Path="/chart/network-diagram" Beta Description="TwNetworkDiagramChart is a Blazor network diagram that arranges linked nodes close together and unrelated ones apart.">
    <PageCard Title="Basic usage">
        <Description><code>TwNetworkDiagramChart</code> draws each <code>ChartGraphNode</code> as a named dot and each <code>ChartGraphLink</code> as a line. You give no positions: linked nodes pull together and all nodes push apart until the layout settles. Links refer to nodes by <code>Id</code>.</Description>

        <CodeExample Name="NetworkDiagramChartBasic" CSharpName="NetworkDiagramChartData">
            <TwChart Title="Service dependencies">
                <TwNetworkDiagramChart Nodes="@services" Links="@dependencies" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Hubs and clusters">
        <Description>The layout brings structure out of a plain list of links. Here two tightly linked groups separate, joined through the one node that belongs to both.</Description>

        <CodeExample Name="NetworkDiagramChartClusters" CSharpName="NetworkDiagramChartClustersData">
            <TwChart Title="Who works with whom" Description="People who shared a project this year">
                <TwNetworkDiagramChart Nodes="@people" Links="@collaborations" SourceHeader="Person" TargetHeader="Worked with" ValueHeader="Projects" Height="ChartHeight.Large" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="A star">
        <Description>A single hub with many spokes settles into a star, and nodes with no links drift to the edge.</Description>

        <CodeExample Name="NetworkDiagramChartStar" CSharpName="NetworkDiagramChartStarData">
            <TwChart Title="Office network">
                <TwNetworkDiagramChart Nodes="@devices" Links="@cables" ShowTableToggle="false" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Reading the chart">
        <Description>The arrangement is worked out from the links alone and is the same every time for the same data; only closeness carries meaning, not left, right, up or down. Each dot is a data point whose tooltip lists every link of that node with the node at the other end and the link's value. The table view lists every link. Links that name a missing node, or join a node to itself, are left out.</Description>
    </PageCard>

    <PageCard Title="Shared features">
        <Description>The legend, tooltips, keyboard navigation, table view, value formatting, height and empty state work the same on every chart. See <TwLink Href="/chart" Class="underline">TwChart</TwLink> for those options.</Description>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample NetworkDiagramChartData
    private readonly ChartGraphNode[] services = [new("ui", "UI"), new("api", "API"), new("auth", "Auth"), new("db", "Database"), new("cache", "Cache")];

    private readonly ChartGraphLink[] dependencies =
    [
        new("ui", "api"), new("ui", "auth"), new("api", "auth"), new("api", "db"), new("api", "cache")
    ];
    #endregion

    #region CodeExample NetworkDiagramChartClustersData
    private readonly ChartGraphNode[] people =
    [
        new("ana", "Ana"), new("bo", "Bo"), new("cy", "Cy"), new("di", "Di"), new("eli", "Eli"),
        new("fay", "Fay"), new("gus", "Gus"), new("hal", "Hal"), new("ivy", "Ivy")
    ];

    private readonly ChartGraphLink[] collaborations =
    [
        new("ana", "bo", 3), new("ana", "cy", 2), new("bo", "cy", 4), new("bo", "di", 1), new("cy", "di", 2),
        new("eli", "di", 2),
        new("eli", "fay", 3), new("eli", "gus", 1), new("fay", "gus", 2), new("gus", "hal", 4), new("fay", "hal", 1), new("hal", "ivy", 2)
    ];
    #endregion

    #region CodeExample NetworkDiagramChartStarData
    private readonly ChartGraphNode[] devices =
    [
        new("switch", "Switch"), new("router", "Router"), new("printer", "Printer"), new("nas", "Storage"),
        new("desk1", "Desk 1"), new("desk2", "Desk 2"), new("desk3", "Desk 3"), new("spare", "Spare laptop")
    ];

    private readonly ChartGraphLink[] cables =
    [
        new("switch", "router"), new("switch", "printer"), new("switch", "nas"),
        new("switch", "desk1"), new("switch", "desk2"), new("switch", "desk3")
    ];
    #endregion
}
