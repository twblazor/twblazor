@page "/chart/word-cloud"
@using TwBlazor.Models

<PageContainer Title="TwWordCloudChart" Path="/chart/word-cloud" Description="TwWordCloudChart is a Blazor word cloud: words sized by their values and gathered around the middle of the plot.">
    <PageCard Title="Basic usage">
        <Description><code>TwWordCloudChart</code> takes labelled values as <code>Data</code> and draws each label as a word sized by its value, with the largest in the middle. It gives a quick impression of which terms dominate.</Description>

        <CodeExample Name="WordCloudChartBasic" CSharpName="WordCloudChartData">
            <TwChart Title="Search terms" Description="Searches last month">
                <TwWordCloudChart Data="@_terms" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Many words">
        <Description>As words are added they all shrink together to fit. A larger <code>Height</code> gives them more room. Use <code>LabelHeader</code> and <code>ValueHeader</code> to name the columns of the table view; the value heading also labels tooltips.</Description>

        <CodeExample Name="WordCloudChartMany" CSharpName="WordCloudChartManyData">
            <TwChart Title="Words in customer feedback" Description="Mentions this quarter">
                <TwWordCloudChart Data="@_feedback" LabelHeader="Word" ValueHeader="Mentions" Height="ChartHeight.Large" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Compact">
        <Description>At <code>ChartHeight.Small</code> the words are set smaller to match, which suits a card on a dashboard.</Description>

        <CodeExample Name="WordCloudChartSmall" CSharpName="WordCloudChartSmallData">
            <TwChart Title="Top tags">
                <TwWordCloudChart Data="@_tags" Height="ChartHeight.Small" ShowTableToggle="false" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="When to use">
        <Description>Use a word cloud for a quick impression, not for exact comparison. The area of a word, not its height, follows its value. When there are more words than fit, the smallest are left out of the plot, and negative and zero values are always left out. For exact comparison use <TwLink Href="/chart/bar" Class="underline">TwBarChart</TwLink>.</Description>
    </PageCard>

    <PageCard Title="Summary">
        <Description>Tooltips and the table view give the value of each word. The arrow keys step through the words from largest to smallest.</Description>
    </PageCard>

    <PageCard Title="Shared features">
        <Description>The legend, tooltips, keyboard navigation, table view, value formatting, height and empty state work the same on every chart. See <TwLink Href="/chart" Class="underline">TwChart</TwLink> for those options.</Description>
    </PageCard>
</PageContainer>

