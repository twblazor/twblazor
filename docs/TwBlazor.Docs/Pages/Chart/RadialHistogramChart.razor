@page "/chart/radial-histogram"
@using TwBlazor.Models

<PageContainer Title="TwRadialHistogramChart" Path="/chart/radial-histogram" Beta Description="TwRadialHistogramChart is a Blazor radial histogram that wraps equal-width bins around a circle, for cyclical values such as hours or bearings.">
    <PageCard Title="Basic usage">
        <Description><code>TwRadialHistogramChart</code> takes raw <code>Values</code>, groups them into equal ranges and wraps the bars around a circle starting at the top. It suits values that cycle, where the last range sits naturally beside the first.</Description>

        <CodeExample Name="RadialHistogramChartBasic" CSharpName="RadialHistogramChartData">
            <TwChart Title="Support tickets by hour" Description="Hour of the day each ticket was opened">
                <TwRadialHistogramChart Values="@_ticketHours" BinCount="12" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Choosing the bins">
        <Description><code>BinCount</code> sets how many ranges the values are split into, from 4 to 36. Match it to the cycle: 24 for hours of the day, 12 for months, 8 or 16 for compass points.</Description>

        <CodeExample Name="RadialHistogramChartBins">
            <TwChart Title="Support tickets by hour" Description="One bar per hour">
                <TwRadialHistogramChart Values="@_ticketHours" BinCount="24" RangeLabel="Hour" CountLabel="Tickets" Height="ChartHeight.Large" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Directions">
        <Description>Bearings are the classic use: with eight bins each bar is a compass sector, north at the top.</Description>

        <CodeExample Name="RadialHistogramChartWind" CSharpName="RadialHistogramChartWindData">
            <TwChart Title="Wind direction" Description="Bearing in degrees, hourly readings">
                <TwRadialHistogramChart Values="@_bearings" BinCount="8" RangeLabel="Bearing" CountLabel="Readings" ValueFormat="0°" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="When to use">
        <Description>Use a radial histogram for values that cycle, such as hours or bearings. Bars grow from an inner ring so small counts stay visible. For values that do not wrap around, prefer <TwLink Href="/chart/histogram" Class="underline">TwHistogramChart</TwLink>, whose bars are easier to compare.</Description>
    </PageCard>

    <PageCard Title="Summary">
        <Description>Tooltips and the table view give the range and count of each bin.</Description>
    </PageCard>

    <PageCard Title="Shared features">
        <Description>The legend, tooltips, keyboard navigation, table view, value formatting, height and empty state work the same on every chart. See <TwLink Href="/chart" Class="underline">TwChart</TwLink> for those options.</Description>
    </PageCard>
</PageContainer>

