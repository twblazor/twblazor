@page "/chart/horizon"
@using TwBlazor.Models

<PageContainer Title="TwHorizonChart" Path="/chart/horizon" Beta Description="TwHorizonChart is a Blazor horizon chart that folds each series into a compact row of layered bands, fitting many series into little height.">
    <PageCard Title="Basic usage">
        <Description><code>TwHorizonChart</code> gives each series its own short row. Values are cut into bands and the bands are layered, so a strong value shows as a darker color instead of a taller mark. Series are named on the axis.</Description>

        <CodeExample Name="HorizonChartBasic" CSharpName="HorizonChartData">
            <TwChart Title="Requests by service" Description="Thousands per hour">
                <TwHorizonChart Categories="@hours" Series="@services" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Bands">
        <Description><code>BandCount</code> sets how many bands the values are cut into, from 1 to 6. More bands show finer differences in the same height but are harder to tell apart; three is a good default.</Description>

        <CodeExample Name="HorizonChartBands">
            <TwChart Title="Requests by service" Description="Five bands">
                <TwHorizonChart Categories="@hours" Series="@services" BandCount="5" CategoryHeader="Hour" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Above and below zero">
        <Description>Negative values are drawn in the color for an unfavourable change, growing from the same baseline, so a row shows at a glance when a series was up and when it was down.</Description>

        <CodeExample Name="HorizonChartNegative" CSharpName="HorizonChartNegativeData">
            <TwChart Title="Change in sales against last year" Description="Percent, by week">
                <TwHorizonChart Categories="@weeks" Series="@regions" ValueFormat="+0.0;-0.0" Height="ChartHeight.Small" />
            </TwChart>
        </CodeExample>
    </PageCard>

    <PageCard Title="Reading the chart">
        <Description>Every row shares one scale, so the same darkness means the same magnitude in each. Hover or focus a category for the exact value of every series there; the arrow keys move from one category to the next. The table view lists every value, with its sign.</Description>
    </PageCard>

    <PageCard Title="Shared features">
        <Description>The legend, tooltips, keyboard navigation, table view, value formatting, height and empty state work the same on every chart. See <TwLink Href="/chart" Class="underline">TwChart</TwLink> for those options.</Description>
    </PageCard>
</PageContainer>

