@page "/select"

<PageContainer Title="TwSelect" Path="/select" Description="TwSelect is a Blazor select component for complex objects and numbers. Bind SelectedValue, or SelectedValues with Multiple, and set Placeholder and Required." ThemeType="typeof(TwInputTheme)">
    <PageCard Title="Basic Select">
        <Description>Bind <code>SelectedValue</code> and use <code>Variant</code> to switch between default, filled and outlined styles.</Description>
        <CodeExample Name="SelectBasic" CSharpName="SelectBasicCode">
            <div class="w-full flex flex-row">
                <div class="flex-col lg:flex-row flex grow gap-4 mb-4">
                    <TwSelect T="string"
                              Label="Country"
                              Values="@countries"
                              Variant="InputVariant.Default"
                              @bind-SelectedValue="@selectedCountry"
                              Placeholder="Select a country..."
                              AriaLabel="Country select"
                              RootClass="flex-1"/>

                    <TwSelect T="string"
                              Label="Country"
                              Values="@countries"
                              Variant="InputVariant.Filled"
                              @bind-SelectedValue="@selectedCountry"
                              Placeholder="Select a city..."
                              AriaLabel="City select"
                              RootClass="flex-1" />

                    <TwSelect T="string"
                              Label="Country"
                              Values="@countries"
                              Variant="InputVariant.Outlined"
                              @bind-SelectedValue="@selectedCountry"
                              Placeholder="Select a city..."
                              AriaLabel="City select"
                              RootClass="flex-1" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(selectedCountry))
            {
                <p class="text-sm text-gray-600 dark:text-gray-400 pb-4">Selected Country: <strong>@selectedCountry</strong></p>
            }
        </CodeExample>
    </PageCard>

    <PageCard Title="Select with Complex Objects">
        <Description>Use <code>PropertyName</code> to display a specific property when binding to a list of complex objects.</Description>
        <CodeExample Name="SelectComplexObjects" CSharpName="SelectComplexObjectsCode">
            <TwSelect T="Person"
                      Label="Select Person"
                      Values="@people"
                      @bind-SelectedValue="@selectedPerson"
                      PropertyName="Name"
                      Placeholder="Choose a person..."
                      AriaLabel="Person select" />

            @if (selectedPerson != null)
            {
                <div class="mt-3 p-3 rounded border border-gray-200 dark:border-gray-600">
                    <p class="text-sm text-gray-600 dark:text-gray-400">Name: <strong>@selectedPerson.Name</strong></p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">City: <strong>@selectedPerson.City</strong></p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">Age: <strong>@selectedPerson.Age</strong></p>
                </div>
            }
        </CodeExample>
    </PageCard>

    <PageCard Title="Required Select">
        <Description>Set the <code>Required</code> property to mark the select as a required field.</Description>
        <CodeExample Name="SelectRequired">
            <TwSelect T="string"
                      Label="Favourite Color"
                      Values="@colors"
                      @bind-SelectedValue="@selectedColor"
                      Required
                      AriaLabel="Color select" />

            @if (!string.IsNullOrEmpty(selectedColor))
            {
                <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">Selected Color: <strong>@selectedColor</strong></p>
            }
        </CodeExample>
    </PageCard>

    <PageCard Title="Disabled and Readonly Select">
        <Description>Use the <code>Disabled</code> and <code>ReadOnly</code> properties to restrict interaction with the select.</Description>
        <CodeExample Name="SelectReadonlyDisabled">
            <div class="flex flex-col gap-3">
                <TwSelect T="string"
                          Label="Disabled Select"
                          Values="@countries"
                          @bind-SelectedValue="@selectedCountry"
                          Placeholder="Cannot select..."
                          Disabled
                          AriaLabel="Disabled select" />

                <TwSelect T="string"
                          Label="Readonly Select"
                          Values="@countries"
                          SelectedValue="@readonlyValue"
                          Placeholder="Cannot change..."
                          ReadOnly
                          AriaLabel="Readonly select" />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Select with Numbers">
        <Description>TwSelect works with numeric types as well as strings and objects.</Description>
        <CodeExample Name="SelectNumeric">
            <TwSelect T="int"
                      Label="Quantity"
                      Values="@quantities"
                      @bind-SelectedValue="@selectedQuantity"
                      Placeholder="Select quantity..."
                      AriaLabel="Quantity select" />

            @if (selectedQuantity > 0)
            {
                <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">Selected Quantity: <strong>@selectedQuantity</strong></p>
                <p class="text-sm text-gray-600 dark:text-gray-400">Total Price: <strong>$@(selectedQuantity * 10)</strong></p>
            }
        </CodeExample>
    </PageCard>

    <PageCard Title="Dense Select">
        <Description>Set <code>Dense</code> for a more compact select with a smaller height and text size, matching the other dense inputs. Multi-select is not affected, as its height follows its selected chips.</Description>
        <CodeExample Name="SelectDense" CSharpName="SelectDenseCode">
            <TwSelect T="string"
                      Label="Country"
                      Values="@countries"
                      Dense
                      @bind-SelectedValue="@denseCountry"
                      AriaLabel="Dense country select" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Multi-select">
        <Description>
            Set <code>Multiple</code> and bind <code>SelectedValues</code> (instead of <code>SelectedValue</code>) to let more than
            one option be selected at once. It renders as a native <code>&lt;select multiple&gt;</code>, so mobile/touch browsers
            still get their own platform multi-select UI rather than a bespoke one.
        </Description>
        <CodeExample Name="SelectMultiple">
            <TwSelect T="string"
                      Label="Skills"
                      Values="@skills"
                      Multiple
                      @bind-SelectedValues="@selectedSkills"
                      AriaLabel="Skills select" />

            @if (selectedSkills.Any())
            {
                <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">Selected Skills: <strong>@string.Join(", ", selectedSkills)</strong></p>
            }
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample SelectBasicCode
    private string selectedCountry = string.Empty;
    private readonly string[] countries = ["USA", "Canada", "UK", "Germany", "France", "Japan", "Australia"];
    #endregion

    #region CodeExample SelectDenseCode
    private string denseCountry = string.Empty;
    #endregion

    #region CodeExample SelectComplexObjectsCode
    private Person? selectedPerson = null;

    private readonly Person[] people =
    [
        new Person { Id = 1, Name = "John Doe", City = "London", Age = 30 },
        new Person { Id = 2, Name = "Jane Smith", City = "Toronto", Age = 25 },
        new Person { Id = 3, Name = "Bob Johnson", City = "Sydney", Age = 35 },
        new Person { Id = 4, Name = "Alice Williams", City = "Dublin", Age = 28 }
    ];

    private sealed class Person
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public int Age { get; set; }
    }
    #endregion

    private readonly string readonlyValue = "Canada";

    private string selectedColor = string.Empty;
    private readonly string[] colors = ["Red", "Blue", "Green", "Yellow", "Purple", "Orange"];

    private int selectedQuantity = 0;
    private readonly int[] quantities = [1, 2, 3, 4, 5, 10, 15, 20, 25, 50];

    private IEnumerable<string> selectedSkills = ["C#"];
    private readonly string[] skills =
    [
        "C#", "JavaScript", "TypeScript", "Python", "Go", "Rust", "SQL", "HTML", "CSS", "Docker"
    ];
}
