@page "/select"

<PageContainer Title="TwSelect" Path="/select" Description="TwSelect is a Blazor select component for complex objects and numbers. Bind SelectedValue, or SelectedValues with Multiple, and set Placeholder and Required." ThemeType="typeof(TwInputTheme)">
    <PageCard Title="Basic select">
        <Description>Bind <code>SelectedValue</code> and use <code>Variant</code> to switch between default, filled and outlined styles.</Description>
        <CodeExample Name="SelectBasic" CSharpName="SelectBasicCode">
            <div class="w-full flex flex-row">
                <div class="flex-col lg:flex-row flex grow gap-4 mb-4">
                    <TwSelect T="string"
                              Label="Country"
                              Values="@_countries"
                              Variant="InputVariant.Default"
                              @bind-SelectedValue="@selectedCountry"
                              Placeholder="Select a country..."
                              AriaLabel="Country select"
                              RootClass="flex-1"/>

                    <TwSelect T="string"
                              Label="Country"
                              Values="@_countries"
                              Variant="InputVariant.Filled"
                              @bind-SelectedValue="@selectedCountry"
                              Placeholder="Select a city..."
                              AriaLabel="City select"
                              RootClass="flex-1" />

                    <TwSelect T="string"
                              Label="Country"
                              Values="@_countries"
                              Variant="InputVariant.Outlined"
                              @bind-SelectedValue="@selectedCountry"
                              Placeholder="Select a city..."
                              AriaLabel="City select"
                              RootClass="flex-1" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(selectedCountry))
            {
                <p class="text-sm text-gray-600 dark:text-gray-400 pb-4">Selected Country: <strong>@selectedCountry</strong></p>
            }
        </CodeExample>
    </PageCard>

    <PageCard Title="Desktop and mobile behavior">
        <Description>
            On desktop, a single select opens an accessible listbox popover that you can drive with the arrow keys, <code>Home</code>, <code>End</code>, type-ahead and <code>Enter</code>.
            On iOS and Android it renders the browser's native <code>&lt;select&gt;</code> instead, so people get the platform's own picker.
            Set <code>PreferNativePicker</code> to <code>true</code> or <code>false</code> to override the detection.
        </Description>
    </PageCard>

    <PageCard Title="Select with complex objects">
        <Description>Use <code>PropertyName</code> to display a specific property when binding to a list of complex objects.</Description>
        <CodeExample Name="SelectComplexObjects" CSharpName="SelectComplexObjectsCode">
            <TwSelect T="Person"
                      Label="Select Person"
                      Values="@_people"
                      @bind-SelectedValue="@selectedPerson"
                      PropertyName="Name"
                      Placeholder="Choose a person..."
                      AriaLabel="Person select" />

            @if (selectedPerson != null)
            {
                <div class="mt-3 p-3 rounded border border-gray-200 dark:border-gray-600">
                    <p class="text-sm text-gray-600 dark:text-gray-400">Name: <strong>@selectedPerson.Name</strong></p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">City: <strong>@selectedPerson.City</strong></p>
                    <p class="text-sm text-gray-600 dark:text-gray-400">Age: <strong>@selectedPerson.Age</strong></p>
                </div>
            }
        </CodeExample>
    </PageCard>

    <PageCard Title="Clearable select">
        <Description>
            Set <code>Clearable</code> for a button at the end of the field that clears the selection: <code>SelectedValue</code> goes back to its default, such as <code>null</code>, and a <code>Multiple</code> select's <code>SelectedValues</code> becomes empty. <code>OnClear</code> runs afterwards.
            The button is shown in every mode, the native picker on iOS and Android included, and is disabled while nothing is selected. It is left out of the Tab order, so from the keyboard press <code>Delete</code> or <code>Backspace</code> on the field instead.
            A <code>Required</code> single select always keeps a value, so it shows no clear button.
        </Description>
        <CodeExample Name="SelectClearable" CSharpName="SelectClearableCode">
            <div class="flex flex-col lg:flex-row gap-4">
                <TwSelect T="string"
                          Label="Country"
                          Values="@_countries"
                          Clearable
                          @bind-SelectedValue="@clearableCountry"
                          RootClass="flex-1" />

                <TwSelect T="string"
                          Label="Skills"
                          Values="@_skills"
                          Multiple
                          Clearable
                          @bind-SelectedValues="@clearableSkills"
                          RootClass="flex-1" />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Item templates">
        <Description>
            Add an <code>ItemTemplate</code> to draw each option in the list your own way. The closed field, and the chips of a <code>Multiple</code> select, still show the option's display text from <code>PropertyName</code>.
        </Description>
        <TwAlert Color="Color.Primary" StartIcon="Icon.Info_Circle" Class="mb-4 ps-3">
            <p class="font-semibold">The native picker falls back to the display text</p>
            On iOS and Android the select uses the browser's native picker (see <a href="#desktop-and-mobile-behavior">Desktop and mobile behavior</a>), and a native <code>&lt;option&gt;</code> can only hold text.
            There the template is not used: each option falls back to its display text from <code>PropertyName</code>, or <code>ToString()</code> when no property is named. The same happens when <code>PreferNativePicker</code> is <code>true</code>.
            Keep the display text meaningful on its own, so the select still reads well on a phone.
        </TwAlert>
        <CodeExample Name="SelectItemTemplate" CSharpName="SelectItemTemplateCode">
            <TwSelect T="Person"
                      Label="Select Person"
                      Values="@_people"
                      PropertyName="Name"
                      @bind-SelectedValue="@templatedPerson">
                <ItemTemplate>
                    <span class="flex flex-col">
                        <span>@context.Name</span>
                        <span class="text-xs text-gray-600 dark:text-gray-400">@context.City, age @context.Age</span>
                    </span>
                </ItemTemplate>
            </TwSelect>
        </CodeExample>
    </PageCard>

    <PageCard Title="Required select">
        <Description>Set the <code>Required</code> property to mark the select as a required field. A select that is not required lists its <code>Placeholder</code> as the first option, and choosing it clears the selection, setting <code>SelectedValue</code> back to its default, such as <code>null</code>. A required select leaves the placeholder out, so a value always stays chosen.</Description>
        <CodeExample Name="SelectRequired">
            <TwSelect T="string"
                      Label="Favourite Color"
                      Values="@_colors"
                      @bind-SelectedValue="@selectedColor"
                      Required
                      AriaLabel="Color select" />

            @if (!string.IsNullOrEmpty(selectedColor))
            {
                <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">Selected Color: <strong>@selectedColor</strong></p>
            }
        </CodeExample>
    </PageCard>

    <PageCard Title="Disabled and readonly select">
        <Description>Use the <code>Disabled</code> and <code>ReadOnly</code> properties to restrict interaction with the select.</Description>
        <CodeExample Name="SelectReadonlyDisabled">
            <div class="flex flex-col gap-3">
                <TwSelect T="string"
                          Label="Disabled Select"
                          Values="@_countries"
                          @bind-SelectedValue="@selectedCountry"
                          Placeholder="Cannot select..."
                          Disabled
                          AriaLabel="Disabled select" />

                <TwSelect T="string"
                          Label="Readonly Select"
                          Values="@_countries"
                          SelectedValue="@_readonlyValue"
                          Placeholder="Cannot change..."
                          ReadOnly
                          AriaLabel="Readonly select" />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Select with numbers">
        <Description>TwSelect works with numeric types as well as strings and objects.</Description>
        <CodeExample Name="SelectNumeric">
            <TwSelect T="int"
                      Label="Quantity"
                      Values="@_quantities"
                      @bind-SelectedValue="@selectedQuantity"
                      Placeholder="Select quantity..."
                      AriaLabel="Quantity select" />

            @if (selectedQuantity > 0)
            {
                <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">Selected Quantity: <strong>@selectedQuantity</strong></p>
                <p class="text-sm text-gray-600 dark:text-gray-400">Total Price: <strong>$@(selectedQuantity * 10)</strong></p>
            }
        </CodeExample>
    </PageCard>

    <PageCard Title="Dense select">
        <Description>Set <code>Dense</code> for a more compact select with a smaller height and text size, matching the other dense inputs. Multi-select is not affected, as its height follows its selected chips.</Description>
        <CodeExample Name="SelectDense" CSharpName="SelectDenseCode">
            <TwSelect T="string"
                      Label="Country"
                      Values="@_countries"
                      Dense
                      @bind-SelectedValue="@denseCountry"
                      AriaLabel="Dense country select" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Multi-select">
        <Description>
            Set <code>Multiple</code> and bind <code>SelectedValues</code> (instead of <code>SelectedValue</code>) to let more than
            one option be selected at once. On desktop it opens the same listbox as a single select, with a tick beside each chosen option, and picking an option leaves the list open. It falls back to a native <code>&lt;select multiple&gt;</code> on iOS and Android, so mobile/touch browsers
            still get their own platform multi-select UI rather than a bespoke one.
        </Description>
        <CodeExample Name="SelectMultiple">
            <TwSelect T="string"
                      Label="Skills"
                      Values="@_skills"
                      Multiple
                      @bind-SelectedValues="@selectedSkills"
                      AriaLabel="Skills select" />

            @if (selectedSkills.Any())
            {
                <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">Selected Skills: <strong>@string.Join(", ", selectedSkills)</strong></p>
            }
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample SelectBasicCode
    private string selectedCountry = string.Empty;
    private readonly string[] _countries = ["USA", "Canada", "UK", "Germany", "France", "Japan", "Australia"];
    #endregion

    #region CodeExample SelectClearableCode
    private string? clearableCountry = "Canada";
    private IEnumerable<string> clearableSkills = ["C#", "SQL"];
    #endregion

    #region CodeExample SelectItemTemplateCode
    private Person? templatedPerson;
    #endregion

    #region CodeExample SelectDenseCode
    private string denseCountry = string.Empty;
    #endregion

    #region CodeExample SelectComplexObjectsCode
    private Person? selectedPerson = null;

    private readonly Person[] _people =
    [
        new Person { Id = 1, Name = "John Doe", City = "London", Age = 30 },
        new Person { Id = 2, Name = "Jane Smith", City = "Toronto", Age = 25 },
        new Person { Id = 3, Name = "Bob Johnson", City = "Sydney", Age = 35 },
        new Person { Id = 4, Name = "Alice Williams", City = "Dublin", Age = 28 }
    ];

    private sealed class Person
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public int Age { get; set; }
    }
    #endregion

    private readonly string _readonlyValue = "Canada";

    private string selectedColor = string.Empty;
    private readonly string[] _colors = ["Red", "Blue", "Green", "Yellow", "Purple", "Orange"];

    private int selectedQuantity = 0;
    private readonly int[] _quantities = [1, 2, 3, 4, 5, 10, 15, 20, 25, 50];

    private IEnumerable<string> selectedSkills = ["C#"];
    private readonly string[] _skills =
    [
        "C#", "JavaScript", "TypeScript", "Python", "Go", "Rust", "SQL", "HTML", "CSS", "Docker"
    ];
}
