@page "/spinner"

<PageContainer Title="TwSpinner" Path="/spinner" Description="TwSpinner is a Blazor loading spinner component. Set Size, Color, Label and ShowLabel, or use it inside a button." ThemeType="typeof(TwSpinnerTheme)">
    <PageCard Title="Basic Usage">
        <Description>An animated loading indicator rendered as an <code>&lt;output&gt;</code> element, so status changes are announced to assistive technology. The <code>Label</code> ("Loading..." by default) is always in the DOM for assistive technology, even when not shown visually.</Description>

        <CodeExample Name="SpinnerBasic">
            <TwSpinner AriaLabel="Loading" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Sizes">
        <Description>Use <code>Size</code> to control the spinner's dimensions.</Description>

        <CodeExample Name="SpinnerSizes">
            <div class="flex items-center gap-6">
                <TwSpinner Size="SpinnerSize.Small" AriaLabel="Loading, small" />
                <TwSpinner Size="SpinnerSize.Medium" AriaLabel="Loading, medium" />
                <TwSpinner Size="SpinnerSize.Large" AriaLabel="Loading, large" />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Colors">
        <Description>Use <code>Color</code> to match the spinner to its surrounding context.</Description>

        <CodeExample Name="SpinnerColors">
            @foreach (Color c in ((Color[])Enum.GetValues(typeof(Color))).Take(10))
            {
                @if (c != Color.Light && c != Color.Dark)
                {
                    <div class="p-3 inline-flex">
                        <TwSpinner AriaLabel="@c.ToString()" Color="@c" />
                    </div>
                }
                else
                {
                    <div class="@(c == Color.Light ? "bg-gray-900 p-3 rounded-lg inline-flex" : "bg-white p-3 rounded-lg inline-flex")">
                        <TwSpinner AriaLabel="@c.ToString()" Color="@c" />
                    </div>
                }
            }
        </CodeExample>
    </PageCard>

    <PageCard Title="Visible Label">
        <Description>By default the label text is only announced to assistive technology. Set <code>ShowLabel</code> to display it next to the spinner too.</Description>

        <CodeExample Name="SpinnerVisibleLabel">
            <div class="flex flex-col gap-4">
                <TwSpinner Label="Loading..." ShowLabel Color="Color.Primary" />
                <TwSpinner Label="Uploading files..." ShowLabel Size="SpinnerSize.Small" Color="Color.Success" />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Inside a Button">
        <Description>A common pattern: swap a button's label for a small spinner while an async action is in flight.</Description>

        <CodeExample Name="SpinnerButton" CSharpName="SpinnerButtonCode">
            <TwButton Color="Color.Primary" Variant="ButtonVariant.Outlined" Disabled="@isSaving" OnClick="Save">
                @if (isSaving)
                {
                    <TwSpinner Size="SpinnerSize.Small" AriaLabel="Saving" />
                }
                else
                {
                    @: Save changes
                }
            </TwButton>
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample SpinnerButtonCode
    private bool isSaving;

    private async Task Save()
    {
        isSaving = true;
        await Task.Delay(1500);
        isSaving = false;
    }
    #endregion
}
