@page "/color-picker"
@using TwBlazor.Docs.Services
@using TwBlazor.Enums

<PageContainer Title="TwColorPicker" Path="/color-picker" Description="TwColorPicker is a Blazor colour picker component. Bind Value, choose an OutputFormat, and toggle ShowAlpha and ShowModeSwitch. Supports input variants." ThemeType="typeof(TwColorPickerTheme)">
    <PageCard Title="Basic color picker">
        <Description>Bind <code>Value</code> to let users pick a color from a labeled color picker input.</Description>
        <CodeExample Name="ColorPickerBasic" CSharpName="ColorPickerBasicCode">
            <TwColorPicker Label="Choose Color" @bind-Value="selectedColor" />
        </CodeExample>
    </PageCard>

    <PageCard Title="With mode switch">
        <Description>Set <code>ShowModeSwitch</code> to let users toggle between color input modes (e.g. hex and RGB).</Description>
        <CodeExample Name="ColorPickerMode" CSharpName="ColorPickerModeCode">
            <TwColorPicker Label="Primary Color" @bind-Value="primaryColor" ShowModeSwitch />
        </CodeExample>
    </PageCard>

    <PageCard Title="With alpha channel">
        <Description>Set <code>ShowAlpha</code> to add an alpha channel slider for transparency.</Description>
        <CodeExample Name="ColorPickerAlpha" CSharpName="ColorPickerAlphaCode">
            <TwColorPicker Label="Overlay Color" @bind-Value="overlayColor" ShowAlpha ShowModeSwitch />
        </CodeExample>
    </PageCard>

    <PageCard Title="Input variants">
        <Description>Use the <code>Variant</code> property to switch between default, outlined and filled input styles.</Description>
        <CodeExample Name="ColorPickerVariants" CSharpName="ColorPickerVariantsCode">
            <div class="grid gap-4">
                <TwColorPicker Label="Primary Color" @bind-Value="primaryColor" Variant="InputVariant.Default" ShowModeSwitch />
                <TwColorPicker Label="Accent Color" @bind-Value="accentColor" Variant="InputVariant.Outlined" ShowModeSwitch />
                <TwColorPicker Label="Theme Color" @bind-Value="themeColor" Variant="InputVariant.Filled" />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Dense color picker">
        <Description>Set <code>Dense</code> for a more compact input with a smaller height and text size. Every single-line input shares the same dense height, so they line up when used side by side.</Description>
        <CodeExample Name="ColorPickerDense">
            <TwColorPicker Label="Dense Color" @bind-Value="primaryColor" Dense />
        </CodeExample>
    </PageCard>

    <PageCard Title="Disabled state">
        <Description>Use the <code>Disabled</code> property to prevent interaction with the color picker.</Description>
        <CodeExample Name="ColorPickerDisabled">
            <TwColorPicker Label="Disabled Color" Value="#cccccc" Disabled />
        </CodeExample>
    </PageCard>

    <PageCard Title="Output format">
        <Description>Use <code>OutputFormat</code> to control whether the bound value is emitted as hex or RGB, regardless of the input format.</Description>
        <CodeExample Name="ColorPickerOutput" CSharpName="ColorPickerOutputCode">
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @* Output as Hex (default) *@
                <div>
                    <TwColorPicker Label="Hex (default)" @bind-Value="hexColor" />
                    <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">Value: @hexColor</p>
                </div>

                @* Output as RGB with alpha *@
                <div>
                    <TwColorPicker Label="RGB with Alpha"
                                   @bind-Value="rgbColor"
                                   OutputFormat="ColorMode.Rgb"
                                   ShowAlpha="true" />
                    <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">Value: @rgbColor</p>
                </div>

                @* Input format is auto-detected, independent of output format *@
                <div>
                    <TwColorPicker Label="HSL Input → RGB Output"
                                   @bind-Value="hslToRgbColor"
                                   OutputFormat="ColorMode.Rgb" />
                    <p class="text-sm text-gray-600 dark:text-gray-400 mt-2">Value: @hslToRgbColor</p>
                </div>
            </div>
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample ColorPickerBasicCode
    private string selectedColor { get; set; } = "#3b82f6";
    #endregion

    #region CodeExample ColorPickerModeCode
    private string primaryColor { get; set; } = "#10b981";
    #endregion

    #region CodeExample ColorPickerVariantsCode
    private string themeColor { get; set; } = "#8b5cf6";
    private string accentColor { get; set; } = "#ec4899";
    #endregion

    #region CodeExample ColorPickerAlphaCode
    private string overlayColor { get; set; } = "#f59e0bff";
    #endregion

    #region CodeExample ColorPickerOutputCode
    private string hexColor { get; set; } = "#3b82f6";
    private string rgbColor { get; set; } = "rgba(16, 185, 129, 0.8)";
    private string hslToRgbColor { get; set; } = "hsl(262, 83%, 58%)";
    #endregion
}
