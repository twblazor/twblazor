@page "/footer"
@using TwBlazor.Models

<PageContainer Title="TwFooter" Path="/footer" Beta Description="TwFooter is an accessible Blazor page footer with columns of links, a brand slot, free-form content and a bottom row for copyright and legal links." ThemeType="typeof(TwFooterTheme)">
    <PageCard Title="Basic usage">
        <Description>
            <code>TwFooter</code> draws a page footer from data. Pass <code>Sections</code>, each a title and its links, and every section becomes a column. A link can be written as a label and an address, so a whole footer fits in a few lines.
        </Description>
        <CodeExample Name="FooterBasic" CSharpName="FooterBasicCode">
            <TwFooter Sections="@_sections" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Copyright and legal links">
        <Description>
            <code>Copyright</code> and <code>BottomLinks</code> fill a row along the bottom, under a divider. Either can be used alone, and with no sections the row is the whole footer.
        </Description>
        <CodeExample Name="FooterBottom" CSharpName="FooterBottomCode">
            <TwFooter Sections="@_sections" Copyright="© 2026 Acme Ltd. All rights reserved." BottomLinks="@_legal" />
        </CodeExample>
        <CodeExample Name="FooterBottomOnly">
            <TwFooter Copyright="© 2026 Acme Ltd. All rights reserved." BottomLinks="@_legal" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Brand, content and extras">
        <Description>
            Three slots take your own markup. <code>BrandContent</code> sits above the sections, for a logo and a line about the company. <code>ChildContent</code> comes after the sections, for anything the data model does not cover, such as a newsletter form. <code>BottomContent</code> joins the bottom row, for social links or a language picker.
        </Description>
        <CodeExample Name="FooterSlots">
            <TwFooter Sections="@_sections" Copyright="© 2026 Acme Ltd." BottomLinks="@_legal">
                <BrandContent>
                    <p class="flex items-center gap-2 text-lg font-bold text-gray-900 dark:text-white"><TwIcon Icon="Icon.Lightning_Charge_Fill" /> Acme</p>
                    <p class="mt-2 max-w-sm text-sm">Tools that help small teams ship faster.</p>
                </BrandContent>
                <ChildContent>
                    <form class="flex max-w-md flex-wrap items-end gap-3" @onsubmit:preventDefault @onsubmit="@(() => subscribed = true)">
                        <div class="min-w-0 flex-1">
                            <TwTextfield Id="footer-newsletter" Label="Get our newsletter" @bind-Value="email" Placeholder="you@example.com" type="email" autocomplete="email" />
                        </div>
                        <TwButton Label="Subscribe" Color="Color.Primary" Type="submit" />
                        <p class="w-full text-sm" role="status">@(subscribed ? "Thanks. This form is only an example, so nothing was sent." : string.Empty)</p>
                    </form>
                </ChildContent>
                <BottomContent>
                    <div class="flex gap-1">
                        <TwIcon Icon="Icon.Github" AriaLabel="Acme on GitHub" OnClick="@(() => { })" />
                        <TwIcon Icon="Icon.Rss" AriaLabel="Acme news feed" OnClick="@(() => { })" />
                    </div>
                </BottomContent>
            </TwFooter>
        </CodeExample>
    </PageCard>

    <PageCard Title="Icons and links that open elsewhere">
        <Description>
            Use the full <code>FooterLink</code> to give a link an <code>Icon</code> or set <code>OpensInNewTab</code>. A link that opens in a new tab tells assistive technology so, and is given <code>rel="noopener noreferrer"</code>.
        </Description>
        <CodeExample Name="FooterLinks" CSharpName="FooterLinksCode">
            <TwFooter Sections="@_community" NavigationLabel="Community links" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Heading level">
        <Description>
            Section titles are real headings, so they appear in a screen reader's heading list. They are level 2 by default. Set <code>HeadingLevel</code> so they follow on from the headings above the footer on your page.
        </Description>
        <CodeExample Name="FooterHeadingLevel">
            <TwFooter Sections="@_sections" HeadingLevel="3" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Accessibility">
        <Description>
            The component renders a <code>footer</code> element, which is the page's content information landmark as long as it is not inside an <code>article</code>, <code>section</code> or <code>main</code>. Use one per page. The sections sit in a navigation landmark named "Footer links"; change the name with <code>NavigationLabel</code> if the page has another landmark with the same name. Each section is a heading followed by a list named by that heading, so the group and the number of links in it are announced. Give the footer itself a name with <code>AriaLabel</code> if the page has more than one.
        </Description>
        <Description>
            Every link is an ordinary tab stop in reading order. The focus outline takes the footer's own text color, so it stays visible on any background a theme gives it. Icons beside links are decorative and hidden from assistive technology.
        </Description>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample FooterBasicCode
    private readonly FooterSection[] _sections =
    [
        new("Product", [("Features", "/footer"), ("Pricing", "/footer"), ("Changelog", "/footer")]),
        new("Company", [("About", "/footer"), ("Careers", "/footer"), ("Contact", "/footer")]),
        new("Resources", [("Documentation", "/footer"), ("Guides", "/footer"), ("Support", "/footer")]),
        new("Legal", [("Privacy", "/footer"), ("Terms", "/footer")])
    ];
    #endregion

    #region CodeExample FooterBottomCode
    private readonly FooterLink[] _legal = [("Privacy", "/footer"), ("Terms", "/footer"), ("Cookies", "/footer")];
    #endregion

    #region CodeExample FooterLinksCode
    private readonly FooterSection[] _community =
    [
        new("Community",
        [
            new("GitHub", "https://github.com/twblazor/twblazor", Icon.Github, OpensInNewTab: true),
            new("News feed", "/footer", Icon.Rss)
        ]),
        new("Help", [("Documentation", "/footer"), new FooterLink("Status page", "https://example.com/status", OpensInNewTab: true)])
    ];
    #endregion

    private string email = string.Empty;
    private bool subscribed;
}