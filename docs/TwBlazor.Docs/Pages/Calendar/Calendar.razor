    #region CodeExample CalendarEnabledViewsCode
    private DateTime enabledViewsSelectedDate = DateTime.Today;
    private TwCalendarView enabledViewsView = TwCalendarView.Week;

    private readonly TwCalendarView[] enabledViews = [TwCalendarView.Week, TwCalendarView.Month];
    #endregion

    #region CodeExample CalendarAllDayCode
    private DateTime allDaySelectedDate = DateTime.Today.AddDays(1);
    private TwCalendarView allDayView = TwCalendarView.Week;

    private List<Schedule<EventDetails>> AllDaySchedules = BuildSampleSchedules();
    #endregion

    #region CodeExample CalendarEditableCode
    private DateTime editableSelectedDate = DateTime.Today;
    private TwCalendarView editableView = TwCalendarView.Day;

    private List<Schedule<EventDetails>> EditableSchedules = BuildSampleSchedules();
    #endregion

    #region CodeExample CalendarDialogPropertiesCode
    private DateTime detailsSelectedDate = DateTime.Today;
    private TwCalendarView detailsView = TwCalendarView.Day;

    private List<Schedule<EventDetails>> DetailsSchedules = BuildSampleSchedules();

    private readonly Dictionary<string, string> detailsDialogProperties = new()
    {
        [nameof(EventDetails.Notes)] = "Notes",
        [nameof(EventDetails.Location)] = "Location",
        [nameof(EventDetails.Attendees)] = "Guests",
        [nameof(EventDetails.Priority)] = "",
        [nameof(EventDetails.IsOnline)] = "Online meeting"
    };
    #endregion

    #region CodeExample CalendarCustomContentCode
    private DateTime customContentSelectedDate = DateTime.Today;
    private TwCalendarView customContentView = TwCalendarView.Week;
    #endregion

    #region CodeExample CalendarSearchCode
    private DateTime searchSelectedDate = DateTime.Today;
    private TwCalendarView searchView = TwCalendarView.Week;

    private async Task OnSearchAsync()
    {
        var reference = await DialogService.ShowAsync<CalendarSearchDialog<EventDetails>>("Search events", new TwDialogParameters
        {
            ["Schedules"] = Schedules
        });

        var selected = await reference.GetReturnValueAsync<Schedule<EventDetails>>();
        if (selected is not null)
        {
            searchSelectedDate = selected.DateTimeStart.Date;
            searchView = TwCalendarView.Day;
        }
    }
    #endregion
}
