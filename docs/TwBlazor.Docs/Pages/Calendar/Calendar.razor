@page "/calendar"
@using TwBlazor.Models
@using TwBlazor.Services

@inject ITwDialogService DialogService

<PageContainer Title="TwCalendar"
    ThemeType="typeof(TwCalendarTheme)"
    Path="/calendar"
    Description="TwCalendar is a Blazor Day, Week and Month calendar with drag and drop, all-day events, a built-in create and edit dialog, and configurable event details.">
    <PageCard Title="Views">
        <Description>
            Bind <code>SelectedDate</code> and <code>View</code> to switch between Day, Week and Month.
            The header names what you're looking at: the day, the week or the month. "Today" is on the
            left and the previous and next buttons are on the right. Events that overlap in time sit side
            by side. The Day and Week grids scroll once they pass <code>MaxHeight</code> (<code>40rem</code>
            by default), and you can pass any CSS length, such as <code>"30rem"</code> or <code>"600px"</code>.
            They open scrolled to <code>ScrollToTime</code>, 8am by default, so you land on the working day
            instead of midnight.
            <br /><br />
            Click an event to see its details. This calendar isn't editable, so every event opens read-only,
            and the extra details come from <code>DialogProperties</code> (see "Event Details in the Dialog"
            below).
        </Description>
        <CodeExample Name="CalendarBasic" CSharpName="CalendarBasicCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="selectedDate" @bind-View="view" Schedules="Schedules" DialogProperties="dialogProperties" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Choosing Which Views to Offer">
        <Description>
            All three views are available by default. Pass <code>EnabledViews</code> an array of
            <code>TwCalendarView</code> values to offer only some of them. The switcher in the header only
            shows the views you list, always in the order Day, Week, Month. With a single view the switcher
            disappears, and the calendar just shows that view. If <code>View</code> isn't in the list, the
            first enabled view is shown instead. When the Day view is turned off, clicking a day in the Week
            or Month view only selects the date. This example offers just Week and Month.
        </Description>
        <CodeExample Name="CalendarEnabledViews" CSharpName="CalendarEnabledViewsCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="enabledViewsSelectedDate" @bind-View="enabledViewsView" EnabledViews="enabledViews" Schedules="Schedules" DialogProperties="dialogProperties" />
        </CodeExample>
    </PageCard>

    <PageCard Title="All-Day and Multi-Day Events">
        <Description>
            An event that runs from midnight to midnight is an all-day event, and anything that lasts a day
            or longer is treated the same way. In the Day and Week views these sit in an "All day" strip
            above the time grid, like Microsoft Teams, so they don't cover the hours below. An event that
            covers several days is one bar across those days. In the Month view every event that covers
            more than one day is drawn as a bar across its days too, and it breaks at the end of each week
            and carries on in the next. An event that crosses midnight but lasts less than a day stays in the
            time grid and shows on both days.
            <br /><br />
            To make an event all day, turn on "All day" in the edit dialog, or set it to start and end at
            midnight yourself. The dialog then asks for dates instead of times, and the end date is the last
            day you want to cover. You can drag an all-day event onto another day, and it keeps its length.
            In the example below, "Company holiday", "Product conference" and "Release weekend" are all-day
            events.
        </Description>
        <CodeExample Name="CalendarAllDay" CSharpName="CalendarAllDayCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="allDaySelectedDate" @bind-View="allDayView" Editable="true" DialogProperties="dialogProperties" @bind-Schedules="AllDaySchedules" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Adding & Editing Events">
        <Description>
            Set <code>Editable</code> to get the "+" button in the header and let people open events in an
            edit dialog. Click an empty time slot to create an event there, or click an existing event to
            change it. An event with <code>ReadOnly</code> set always opens read-only, like "Lunch" and
            "Payroll run" below, even when <code>Editable</code> is on. Editable events can also be dragged.
            Move them between time slots (and between days in Week view), or between days in Month view,
            where the time of day stays the same. A dashed placeholder shows where the event will land, even
            over a slot that already has an event. The dialog's color picker sets
            <code>Schedule&lt;T&gt;.Color</code>, which tints the event in every view. Leave it empty to use
            the theme color.
        </Description>
        <CodeExample Name="CalendarEditable" CSharpName="CalendarEditableCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="editableSelectedDate" @bind-View="editableView" Editable="true" DialogProperties="dialogProperties" @bind-Schedules="EditableSchedules" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Event Details in the Dialog">
        <Description>
            Your own data lives in <code>Schedule&lt;T&gt;.Value</code>. To show it in the dialog, pass
            <code>DialogProperties</code>: a dictionary that maps a property name on your type to the label
            you want. The read-only dialog lists each value that isn't empty. The edit dialog gives each
            property an editor that fits its type: a text field for strings, a number field for numbers, a
            switch for <code>bool</code>, a date and time picker for dates, and a select for enums. A
            property with no public setter shows as plain text. Names that don't match a property are
            skipped, and an empty label turns <code>OrderNumber</code> into "Order number". The properties
            appear in the order you list them, after Name, Start, End and Color.
            <br /><br />
            The dialog finds properties with reflection. Your type needs a public parameterless constructor
            so new events have something to edit, and the dialog works on a shallow copy of
            <code>Value</code>, so cancelling never changes the original. If you need something this can't
            express, such as a field that depends on another, use <code>EventDialogContent</code> to add
            your own markup. In this example, the empty label for <code>Priority</code> falls back to
            "Priority" and <code>Attendees</code> is relabeled "Guests".
        </Description>
        <CodeExample Name="CalendarDialogProperties" CSharpName="CalendarDialogPropertiesCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="detailsSelectedDate" @bind-View="detailsView" Editable="true" DialogProperties="detailsDialogProperties" @bind-Schedules="DetailsSchedules" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Custom Event Content">
        <Description>
            Use <code>EventContentTemplate</code> to change how each event looks in all three views.
        </Description>
        <CodeExample Name="CalendarCustomContent" CSharpName="CalendarCustomContentCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="customContentSelectedDate" @bind-View="customContentView" Schedules="Schedules" DialogProperties="dialogProperties">
                <EventContentTemplate>
                    <span class="text-xs font-semibold">@context.Name</span>
                    <span class="block text-xs opacity-80">@context.DateTimeStart.ToString("h:mm tt")</span>
                </EventContentTemplate>
            </TwCalendar>
        </CodeExample>
    </PageCard>

    <PageCard Title="Search Events">
        <Description>
            <code>TwCalendar</code> has no search of its own. Set <code>OnSearch</code> and the header shows
            a search icon that calls your handler. This example opens a small dialog, built like any other
            <code>TwDialog</code> content, that filters <code>Schedules</code> by name. When you pick a
            result, it jumps to that event by setting <code>@@bind-SelectedDate</code> and
            <code>@@bind-View</code> on the calendar.
        </Description>
        <CodeExample Name="CalendarSearch" CSharpName="CalendarSearchCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="searchSelectedDate" @bind-View="searchView" Schedules="Schedules" DialogProperties="dialogProperties" OnSearch="OnSearchAsync" />
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample CalendarBasicCode
    private DateTime selectedDate = DateTime.Today;
    private TwCalendarView view = TwCalendarView.Week;

    private List<Schedule<EventDetails>> Schedules = BuildSampleSchedules();

    public enum EventPriority
    {
        Low,
        Medium,
        High
    }

    public class EventDetails
    {
        public string? Notes { get; set; }
        public string? Location { get; set; }
        public string? Organizer { get; set; }
        public int Attendees { get; set; }
        public EventPriority Priority { get; set; }
        public bool IsOnline { get; set; }
    }

    private readonly Dictionary<string, string> dialogProperties = new()
    {
        [nameof(EventDetails.Notes)] = "Notes",
        [nameof(EventDetails.Location)] = "Location",
        [nameof(EventDetails.Organizer)] = "Organizer",
        [nameof(EventDetails.Attendees)] = "Attendees",
        [nameof(EventDetails.Priority)] = "Priority",
        [nameof(EventDetails.IsOnline)] = "Online meeting"
    };

    private static Schedule<EventDetails> Event(string name, int dayOffset, double startHour, double hours, string color, EventDetails details, bool readOnly = false)
    {
        var start = DateTime.Today.AddDays(dayOffset).AddHours(startHour);
        return new() { Name = name, DateTimeStart = start, DateTimeEnd = start.AddHours(hours), Color = color, ReadOnly = readOnly, Value = details };
    }

    private static Schedule<EventDetails> AllDay(string name, int firstDayOffset, int days, string color, EventDetails details)
    {
        var start = DateTime.Today.AddDays(firstDayOffset);
        return new() { Name = name, DateTimeStart = start, DateTimeEnd = start.AddDays(days), Color = color, Value = details };
    }

