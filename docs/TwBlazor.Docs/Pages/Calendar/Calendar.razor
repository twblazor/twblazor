@page "/calendar"
@using TwBlazor.Models
@using TwBlazor.Services

<PageTitle>TwCalendar | twblazor</PageTitle>
<HeadContent>
    <meta name="description" content="TwCalendar is a Blazor Day, Week and Month calendar with drag and drop, a built-in create and edit dialog, and configurable event details." />
    <link rel="canonical" href="https://twblazor.com/calendar" />
</HeadContent>

@inject ITwDialogService DialogService

<PageContainer Title="TwCalendar" ThemeType="typeof(TwCalendarTheme)">
    <PageCard Title="Views">
        <Description>
            Bind <code>SelectedDate</code> and <code>View</code> to switch between Day, Week and Month.
            Events that overlap in time sit side by side. The Day and Week grids scroll once they pass
            <code>MaxHeight</code> (<code>40rem</code> by default), and you can pass any CSS length, such
            as <code>"30rem"</code> or <code>"600px"</code>. They open scrolled to <code>ScrollToTime</code>,
            8am by default, so you land on the working day instead of midnight.
        </Description>
        <CodeExample Name="CalendarBasic" CSharpName="CalendarBasicCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="selectedDate" @bind-View="view" Schedules="Schedules" />
        </CodeExample>
    </PageCard>

    <PageCard Title="All-Day and Multi-Day Events">
        <Description>
            An event that runs from midnight to midnight is an all-day event, and anything that lasts a day
            or longer is treated the same way. In the Day and Week views these sit in an "All day" strip
            above the time grid, like Microsoft Teams, so they don't cover the hours below. An event that
            covers several days is one bar across those days. In the Month view every event that covers
            more than one day is drawn as a bar across its days too, and it breaks at the end of each week
            and carries on in the next. An event that crosses midnight but lasts less than a day stays in the
            time grid and shows on both days.
            <br /><br />
            To make an event all day, turn on "All day" in the edit dialog, or set it to start and end at
            midnight yourself. The dialog then asks for dates instead of times, and the end date is the last
            day you want to cover. You can drag an all-day event onto another day, and it keeps its length.
            In the example below, "Company holiday", "Product conference" and "Release weekend" are all-day
            events.
        </Description>
        <CodeExample Name="CalendarAllDay" CSharpName="CalendarAllDayCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="allDaySelectedDate" @bind-View="allDayView" Editable="true" DialogProperties="dialogProperties" @bind-Schedules="AllDaySchedules" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Day Calendar">
        <Description>
            The Day view can show a small month calendar next to the time grid, handy for jumping to
            another date. It's hidden by default. Set <code>ShowDayCalendar</code> to show it.
        </Description>
        <CodeExample Name="CalendarDayCalendar" CSharpName="CalendarDayCalendarCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="dayCalendarSelectedDate" View="TwCalendarView.Day" ShowDayCalendar="true" Schedules="Schedules" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Adding & Editing Events">
        <Description>
            Set <code>Editable</code> to get the "+" button in the header and let people open events in an
            edit dialog. Click an empty time slot to create an event there, or click an existing event to
            change it. An event with <code>ReadOnly</code> set always opens read-only, like "Lunch" below,
            even when <code>Editable</code> is on. Editable events can also be dragged. Move them between
            time slots (and between days in Week view), or between days in Month view, where the time of
            day stays the same. A dashed placeholder shows where the event will land, even over a slot
            that already has an event. The dialog's color picker sets <code>Schedule&lt;T&gt;.Color</code>,
            which tints the event in every view. Leave it empty to use the theme color.
        </Description>
        <CodeExample Name="CalendarEditable" CSharpName="CalendarEditableCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="editableSelectedDate" @bind-View="editableView" Editable="true" @bind-Schedules="EditableSchedules" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Event Details in the Dialog">
        <Description>
            Your own data lives in <code>Schedule&lt;T&gt;.Value</code>. To show it in the dialog, pass
            <code>DialogProperties</code>: a dictionary that maps a property name on your type to the label
            you want. The read-only dialog lists each value that isn't empty. The edit dialog gives each
            property an editor that fits its type: a text field for strings, a number field for numbers, a
            switch for <code>bool</code>, a date and time picker for dates, and a select for enums. A
            property with no public setter shows as plain text. Names that don't match a property are
            skipped, and an empty label turns <code>OrderNumber</code> into "Order number". The properties
            appear in the order you list them, after Name, Start, End and Color.
            <br /><br />
            The dialog finds properties with reflection. Your type needs a public parameterless constructor
            so new events have something to edit, and the dialog works on a shallow copy of
            <code>Value</code>, so cancelling never changes the original. If you need something this can't
            express, such as a field that depends on another, use <code>EventDialogContent</code> to add
            your own markup.
        </Description>
        <CodeExample Name="CalendarDialogProperties" CSharpName="CalendarDialogPropertiesCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="detailsSelectedDate" @bind-View="detailsView" Editable="true" DialogProperties="dialogProperties" @bind-Schedules="DetailsSchedules" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Custom Event Content">
        <Description>
            Use <code>EventContentTemplate</code> to change how each event looks in all three views.
        </Description>
        <CodeExample Name="CalendarCustomContent" CSharpName="CalendarCustomContentCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="customContentSelectedDate" @bind-View="customContentView" Schedules="Schedules">
                <EventContentTemplate>
                    <span class="text-xs font-semibold">@context.Name</span>
                    <span class="block text-xs opacity-80">@context.DateTimeStart.ToString("h:mm tt")</span>
                </EventContentTemplate>
            </TwCalendar>
        </CodeExample>
    </PageCard>

    <PageCard Title="Search Events">
        <Description>
            <code>TwCalendar</code> has no search of its own. Set <code>OnSearch</code> and the header shows
            a search icon that calls your handler. This example opens a small dialog, built like any other
            <code>TwDialog</code> content, that filters <code>Schedules</code> by name. When you pick a
            result, it jumps to that event by setting <code>@@bind-SelectedDate</code> and
            <code>@@bind-View</code> on the calendar.
        </Description>
        <CodeExample Name="CalendarSearch" CSharpName="CalendarSearchCode">
            <TwCalendar T="EventDetails" @bind-SelectedDate="searchSelectedDate" @bind-View="searchView" Schedules="Schedules" OnSearch="OnSearchAsync" />
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample CalendarBasicCode
    private DateTime selectedDate = DateTime.Today;
    private TwCalendarView view = TwCalendarView.Week;

    private List<Schedule<EventDetails>> Schedules = BuildSampleSchedules();

    public class EventDetails
    {
        public string? Notes { get; set; }
        public string? Location { get; set; }
        public bool IsOnline { get; set; }
    }

    private static List<Schedule<EventDetails>> BuildSampleSchedules()
    {
        var today = DateTime.Today;
        return
        [
            new() { Name = "Team standup", DateTimeStart = today.AddHours(9), DateTimeEnd = today.AddHours(9.5), Color = "#2563eb", Value = new() { Notes = "Quick round of blockers. Keep it to 15 minutes.", Location = "Meeting room 2" } },
            new() { Name = "Design review", DateTimeStart = today.AddHours(10), DateTimeEnd = today.AddHours(11), Color = "#9333ea", Value = new() { Notes = "Walk through the new dashboard mockups and collect feedback.", Location = "Studio", IsOnline = true } },
            new() { Name = "1:1 with Sam", DateTimeStart = today.AddHours(10.5), DateTimeEnd = today.AddHours(11.25), Color = "#db2777", Value = new() { Notes = "Talk about the Q4 goals and the conference talk.", IsOnline = true } },
            new() { Name = "Lunch", DateTimeStart = today.AddHours(12), DateTimeEnd = today.AddHours(13), ReadOnly = true, Color = "#f59e0b", Value = new() { Notes = "Team lunch. Booked under Shuter.", Location = "The Corner Cafe" } },
            new() { Name = "Sprint planning", DateTimeStart = today.AddDays(1).AddHours(14), DateTimeEnd = today.AddDays(1).AddHours(15.5), Color = "#16a34a", Value = new() { Notes = "Bring estimates for the top ten backlog items.", Location = "Meeting room 1" } },
            new() { Name = "Client call", DateTimeStart = today.AddDays(2).AddHours(9), DateTimeEnd = today.AddDays(2).AddHours(9.75), Color = "#0d9488", Value = new() { Notes = "Share the revised timeline and ask about the sign-off date.", IsOnline = true } },
            new() { Name = "Retro", DateTimeStart = today.AddDays(4).AddHours(16), DateTimeEnd = today.AddDays(4).AddHours(17), Color = "#4f46e5", Value = new() { Notes = "What went well, what didn't, and one thing to try next sprint.", Location = "Meeting room 2" } },
            new() { Name = "Launch", DateTimeStart = today.AddDays(-2).AddHours(9), DateTimeEnd = today.AddDays(-2).AddHours(10), Color = "#dc2626", Value = new() { Notes = "Version 2.0 goes live. Support is on standby.", IsOnline = true } },
            new() { Name = "Budget review", DateTimeStart = today.AddDays(3).AddHours(9), DateTimeEnd = today.AddDays(3).AddHours(9.5), Color = "#0891b2", Value = new() { Notes = "Check spend against the quarterly forecast.", Location = "Finance office" } },
            new() { Name = "Interview", DateTimeStart = today.AddDays(3).AddHours(10), DateTimeEnd = today.AddDays(3).AddHours(10.5), Color = "#7c3aed", Value = new() { Notes = "Frontend candidate, second round. Questions are in the hiring doc.", Location = "Meeting room 1" } },
            new() { Name = "All hands", DateTimeStart = today.AddDays(3).AddHours(11), DateTimeEnd = today.AddDays(3).AddHours(12), Color = "#ea580c", Value = new() { Notes = "Company update and Q&A with the leadership team.", Location = "Main hall", IsOnline = true } },
            new() { Name = "Extra sync", DateTimeStart = today.AddDays(3).AddHours(13), DateTimeEnd = today.AddDays(3).AddHours(13.5), Color = "#059669", Value = new() { Notes = "Follow up on the open questions from the all hands." } },
            new() { Name = "Company holiday", DateTimeStart = today.AddDays(1), DateTimeEnd = today.AddDays(2), Color = "#f59e0b", Value = new() { Notes = "Offices are closed. Support is on call." } },
            new() { Name = "Product conference", DateTimeStart = today.AddDays(2), DateTimeEnd = today.AddDays(5), Color = "#be185d", Value = new() { Notes = "Three days of talks. Our slot is on the second morning.", Location = "Convention centre" } },
            new() { Name = "Release weekend", DateTimeStart = today.AddDays(5), DateTimeEnd = today.AddDays(8), Color = "#0369a1", Value = new() { Notes = "Freeze on Friday night. Roll out on Saturday.", IsOnline = true } },
        ];
    }
    #endregion

    #region CodeExample CalendarAllDayCode
    private DateTime allDaySelectedDate = DateTime.Today.AddDays(1);
    private TwCalendarView allDayView = TwCalendarView.Week;

    private List<Schedule<EventDetails>> AllDaySchedules = BuildSampleSchedules();
    #endregion

    #region CodeExample CalendarDayCalendarCode
    private DateTime dayCalendarSelectedDate = DateTime.Today;
    #endregion

    #region CodeExample CalendarEditableCode
    private DateTime editableSelectedDate = DateTime.Today;
    private TwCalendarView editableView = TwCalendarView.Day;

    private List<Schedule<EventDetails>> EditableSchedules = BuildSampleSchedules();
    #endregion

    #region CodeExample CalendarDialogPropertiesCode
    private DateTime detailsSelectedDate = DateTime.Today;
    private TwCalendarView detailsView = TwCalendarView.Day;

    private List<Schedule<EventDetails>> DetailsSchedules = BuildSampleSchedules();

    private readonly Dictionary<string, string> dialogProperties = new()
    {
        [nameof(EventDetails.Notes)] = "Notes",
        [nameof(EventDetails.Location)] = "Location",
        [nameof(EventDetails.IsOnline)] = "Online meeting"
    };
    #endregion

    #region CodeExample CalendarCustomContentCode
    private DateTime customContentSelectedDate = DateTime.Today;
    private TwCalendarView customContentView = TwCalendarView.Week;
    #endregion

    #region CodeExample CalendarSearchCode
    private DateTime searchSelectedDate = DateTime.Today;
    private TwCalendarView searchView = TwCalendarView.Week;

    private async Task OnSearchAsync()
    {
        var reference = await DialogService.ShowAsync<CalendarSearchDialog<EventDetails>>("Search events", new TwDialogParameters
        {
            ["Schedules"] = Schedules
        });

        var selected = await reference.GetReturnValueAsync<Schedule<EventDetails>>();
        if (selected is not null)
        {
            searchSelectedDate = selected.DateTimeStart.Date;
            searchView = TwCalendarView.Day;
        }
    }
    #endregion
}
