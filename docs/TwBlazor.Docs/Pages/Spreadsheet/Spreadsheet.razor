    #region CodeExample SpreadsheetFreezeCode
    private readonly List<Sheet> sales = [SalesSheet()];

    private static Sheet SalesSheet()
    {
        string[] months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        var sheet = new Sheet { Name = "Sales", FrozenRows = 1, FrozenColumns = 1, ColumnWidths = { ["A"] = 140 } };
        sheet.Cells["A1"] = new() { Value = "Store", Bold = true };
        for (var m = 0; m < months.Length; m++)
        {
            sheet.Cells[$"{(char)('B' + m)}1"] = new() { Value = months[m], Bold = true, Alignment = SheetCellAlignment.End };
        }

        for (var store = 1; store <= 30; store++)
        {
            sheet.Cells[$"A{store + 1}"] = new() { Value = $"Store {store:00}" };
            for (var m = 0; m < months.Length; m++)
            {
                var amount = ((store * 37) + (m * 53)) % 900 + 100;
                sheet.Cells[$"{(char)('B' + m)}{store + 1}"] = new() { Value = amount.ToString(System.Globalization.CultureInfo.InvariantCulture) };
            }
        }

        return sheet;
    }
    #endregion

