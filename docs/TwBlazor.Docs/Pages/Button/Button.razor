@page "/button"
@using TwBlazor
@using TwBlazor.Components
@using TwBlazor.Enums

<PageContainer Title="TwButton" 
    Path="/button" 
    Description="TwButton is a Blazor button component. Use Variant, Color, StartIcon, EndIcon, Href, Disabled and IconButton, or group buttons horizontally or vertically." 
    ThemeType="typeof(TwButtonTheme)">
    <PageCard Title="Buttons">
        <Description>Usage of the button component is simple, you can use it to trigger actions. Below are some common actions:</Description>

        <CodeExample Name="ButtonBasic" CSharpName="ButtonBasicCode">
            <TwButtonGroup>
                <TwButton Label="@($"Clicked {ClickCount} times")" Color="Color.Accent" StartIcon="Icon.Chat_Square_Dots" OnClick="HandleClick" />
                <TwButton AriaLabel="Submit Type" Label="Submit" Color="Color.Primary" StartIcon="Icon.Mailbox" OnClick="@(() => { /* your action */ })" Type="submit" />
            </TwButtonGroup>
        </CodeExample>
    </PageCard>

    <PageCard Title="Icon buttons">
        <Description>The button component can also be used with icons only:</Description>

        <CodeExample Name="ButtonIconOnly" CSharpName="ButtonIconOnlyCode">
            <TwButtonGroup>
                <TwIcon Icon="@(darkMode ? Icon.Sun : Icon.Moon)" AriaLabel="Set light mode" OnClick="ToggleMode" Color="@(darkMode ? Color.Dark : Color.Light)" ButtonVariant="ButtonVariant.Filled" />
            </TwButtonGroup>
        </CodeExample>
    </PageCard>

    <PageCard Title="Tooltips">
        <Description>
            Set <code>Tooltip</code> to show a short description when the button is hovered or
            keyboard-focused. It renders a <code>role="tooltip"</code> element linked to the button with
            <code>aria-describedby</code>, stays visible while the pointer moves onto it, and can be
            dismissed with <kbd>Escape</kbd>. A tooltip only supplements the accessible name, so icon-only
            buttons still need an <code>AriaLabel</code>. The same <code>Tooltip</code> property works on an
            icon button (<code>TwIcon</code> with <code>OnClick</code>).
        </Description>

        <CodeExample Name="ButtonTooltip">
            <TwButtonGroup>
                <TwButton Label="Save" Color="Color.Primary" StartIcon="Icon.Save" Tooltip="Save your changes" />
                <TwButton Label="Delete" Variant="ButtonVariant.Outlined" Color="Color.Danger" Tooltip="This cannot be undone" />
                <TwIcon Icon="Icon.Question_Circle" AriaLabel="Help" Tooltip="Open the help centre" OnClick="@(() => { /* your action */ })" />
            </TwButtonGroup>
        </CodeExample>
    </PageCard>

    <PageCard Title="Buttons variants & colors">
        <Description>There are multiple different button variants.</Description>

        <CodeExample Name="ButtonVariants">
            <div class="flex flex-col gap-4">
                @foreach (Color c in Enum.GetValues<Color>())
                {
                    <div class="@(c == Color.Light ? "grid grid-cols-2 gap-2 sm:flex sm:flex-wrap -mx-3 rounded-lg bg-gray-900 dark:bg-transparent p-3" : "grid grid-cols-2 gap-2 sm:flex sm:flex-wrap")">
                        <TwButton Label="@c.ToString()" Color="@c" Variant="@ButtonVariant.Filled" />
                        <TwButton Label="@c.ToString()" Color="@c" Variant="@ButtonVariant.Outlined" />
                        <TwButton Label="@c.ToString()" Color="@c" Variant="@ButtonVariant.Text" />
                        <TwButton Label="@c.ToString()" Color="@c" Variant="@ButtonVariant.Elevated" />
                    </div>
                }
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Buttons with icons">
        <Description>
            Buttons can include icons at the start or end for better visual communication:
        </Description>

        <CodeExample Name="ButtonIcons">
            <div class="flex flex-wrap gap-2">
                <TwButton Label="Download" StartIcon="Icon.Download" Variant="ButtonVariant.Filled" Color="Color.Primary" />
                <TwButton Label="Next" EndIcon="Icon.Arrow_Right" Variant="ButtonVariant.Filled" Color="Color.Success" />
                <TwButton Label="Delete" StartIcon="Icon.Trash" Variant="ButtonVariant.Outlined" Color="Color.Danger" />
                <TwButton Label="Settings" StartIcon="Icon.Gear" Variant="ButtonVariant.Filled" Color="Color.Primary" />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="All colors">
        <Description>
            Buttons support all color themes from the color palette:
        </Description>

        <CodeExample Name="ButtonColors">
            <div class="flex flex-wrap gap-2">
                @foreach (Color c in Enum.GetValues<Color>())
                {
                    <TwButton Label="@c.ToString()" Color="@c" />
                }
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Button states">
        <Description>
            Buttons can be disabled or set to readonly mode:
        </Description>

        <CodeExample Name="ButtonReadonlyDisabled">
            <div class="flex flex-wrap gap-2">
                <TwButton Label="Filled Disabled" Variant="ButtonVariant.Filled" Color="Color.Primary" Disabled />
                <TwButton Label="Outlined Disabled" Variant="ButtonVariant.Outlined" Color="Color.Primary" Disabled />
                <TwButton Label="Text Disabled" Variant="ButtonVariant.Text" Color="Color.Primary" Disabled />
                <TwButton Label="Readonly Button" Color="Color.Success" Readonly />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Basic button groups">
        <Description>Group related buttons together with consistent spacing.</Description>

        <CodeExample Name="ButtonGroup">
            <TwButtonGroup>
                <TwButton Label="First" Color="Color.Primary" />
                <TwButton Label="Second" Color="Color.Primary" />
                <TwButton Label="Third" Color="Color.Primary" />
            </TwButtonGroup>
        </CodeExample>
    </PageCard>

    <PageCard Title="Vertical button groups">
        <Description>Stack buttons vertically.</Description>

        <CodeExample Name="ButtonGroupVertical">
            <TwButtonGroup Vertical>
                <TwButton Label="Top" Color="Color.Success" StartIcon="Icon.Arrow_Up" />
                <TwButton Label="Middle" Color="Color.Success" />
                <TwButton Label="Bottom" Color="Color.Success" EndIcon="Icon.Arrow_Down" />
            </TwButtonGroup>
        </CodeExample>
    </PageCard>

    <PageCard Title="Full width button groups">
        <Description>Make buttons fill the container width equally.</Description>

        <CodeExample Name="ButtonGroupFullWidth">
            <TwButtonGroup FullWidth>
                <TwButton Label="Option 1" Color="Color.Accent" Variant="ButtonVariant.Outlined" />
                <TwButton Label="Option 2" Color="Color.Accent" Variant="ButtonVariant.Outlined" />
                <TwButton Label="Option 3" Color="Color.Accent" Variant="ButtonVariant.Outlined" />
            </TwButtonGroup>
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample ButtonBasicCode
    public int ClickCount { get; set; } = 0;
    private void HandleClick() => ClickCount++;
    #endregion

    #region CodeExample ButtonIconOnlyCode
    private bool darkMode { get; set; }
    private void ToggleMode() => darkMode = !darkMode;
    #endregion
}