@page "/time-picker"

<PageContainer Title="TwTimePicker" Path="/time-picker" Description="TwTimePicker is a Blazor time picker component with 12 hour and 24 hour formats. Bind Value or SelectedTime, and set Placeholder and Variant." ThemeType="typeof(TwTimePickerTheme)">
    <PageCard Title="Basic Time Picker">
        <Description>Bind <code>SelectedTime</code> for a <code>TimeOnly</code> value, or <code>Value</code> for a plain string.</Description>
        <CodeExample Name="TimePickerBasic" CSharpName="TimePickerBasicCode">
            <div class="space-y-4">
                <p><b>@@bind-SelectedTime (TimeOnly):</b> @SelectedTime.ToString()</p>
                <TwTimePicker Id="basic-timepicker" @bind-SelectedTime="SelectedTime" @bind-Value="SelectedTimeTextValue" Label="Select a time" Class="mt-3" />
                <p><b>@@bind-Value (string):</b> @SelectedTimeTextValue</p>
                <TwTimePicker Id="basic-timepicker-string" @bind-Value="SelectedTimeTextValue" Label="Select a time" Class="mt-3" />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Input Variants">
        <Description>The DatePicker supports different visual variants for the input field.</Description>

        <CodeExample Name="TimePickerVariants" CSharpName="TimePickerBasicCode">
            <div class="space-y-4">
                <TwTimePicker Id="default-variant" @bind-SelectedTime="SelectedTime" Label="Default Variant" Variant="InputVariant.Default" />
                <TwTimePicker Id="outlined-variant" @bind-SelectedTime="SelectedTime" Label="Outlined Variant" Variant="InputVariant.Outlined" />
                <TwTimePicker Id="filled-variant" @bind-SelectedTime="SelectedTime" Label="Filled Variant" Variant="InputVariant.Filled" />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="12hr Time Picker">
        <Description>Set <code>Is12HourFormat</code> to display and enter time in a 12-hour format.</Description>
        <CodeExample Name="TimePicker12Hr" CSharpName="TimePickerBasicCode">
            <p><b>@@bind-SelectedTime (TimeOnly):</b> @SelectedTime.ToString()</p>
            <TwTimePicker Id="basic-12hr-timepicker" @bind-SelectedTime="SelectedTime" Label="Select a time" Class="mt-3" Is12HourFormat />
        </CodeExample>
    </PageCard>

    <PageCard Title="Dense Time Picker">
        <Description>Set <code>Dense</code> for a more compact input with a smaller height and text size. Every single-line input shares the same dense height, so they line up when used side by side.</Description>
        <CodeExample Name="TimePickerDense">
            <TwTimePicker Id="dense-timepicker" @bind-SelectedTime="SelectedTime" Label="Dense Time Picker" Dense />
        </CodeExample>
    </PageCard>

    <PageCard Title="Disabled and Readonly Time Picker">
        <Description>Use the <code>Disabled</code> and <code>ReadOnly</code> properties to restrict interaction with the time picker.</Description>
        <CodeExample Name="TimePickerReadonlyDisabled">
            <TwTimePicker Id="disabled-timepicker" @bind-SelectedTime="SelectedTime" Label="Disabled Time Picker" Disabled Class="mt-3" />
            <TwTimePicker Id="readonly-timepicker" @bind-SelectedTime="SelectedTime" Label="Readonly Time Picker" ReadOnly Class="mt-3" />
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample TimePickerBasicCode
    public TimeOnly SelectedTime { get; set; } = TimeOnly.FromDateTime(DateTime.Now);
    public string SelectedTimeTextValue { get; set; } = TimeOnly.FromDateTime(DateTime.Now).ToString("HH:mm");
    #endregion
}