@page "/data-table"

<PageContainer Title="TwDataTable" Path="/data-table" Description="TwDataTable is a Blazor data table component with pagination, search, sortable columns and custom row classes for displaying structured data." ThemeType="typeof(TwTableTheme)">
    <PageCard Title="Basic data table with pagination">
        <Description>A feature-rich data table with pagination and search functionality.</Description>

        <CodeExample Name="DataTablePagination" CSharpName="DataTableProduct">
            <TwDataTable TItem="Product"
                         Items="@products"
                         Pageable
                         RowsPerPage="5">
                <TableHeader>
                    <tr>
                        <th scope="col" class="px-6 py-3">Product</th>
                        <th scope="col" class="px-6 py-3">Category</th>
                        <th scope="col" class="px-6 py-3">Price</th>
                        <th scope="col" class="px-6 py-3">Stock</th>
                    </tr>
                </TableHeader>
                <TableRow Context="product">
                    <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">@product.Name</td>
                    <td class="px-6 py-4">@product.Category</td>
                    <td class="px-6 py-4">£@product.Price.ToString("N2")</td>
                    <td class="px-6 py-4">@product.Stock</td>
                </TableRow>
            </TwDataTable>
        </CodeExample>
    </PageCard>

    <PageCard Title="Searchable data table">
        <Description>Data table with search functionality to filter results.</Description>

        <CodeExample Name="DataTableSearchable" CSharpName="DataTableProduct">
            <TwDataTable TItem="Product"
                         Items="@products"
                         Searchable
                         Pageable
                         RowsPerPage="10">
                <TableHeader>
                    <tr>
                        <th scope="col" class="px-6 py-3">Product</th>
                        <th scope="col" class="px-6 py-3">Category</th>
                        <th scope="col" class="px-6 py-3">Price</th>
                        <th scope="col" class="px-6 py-3">Stock</th>
                    </tr>
                </TableHeader>
                <TableRow Context="product">
                    <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">@product.Name</td>
                    <td class="px-6 py-4">@product.Category</td>
                    <td class="px-6 py-4">£@product.Price.ToString("N2")</td>
                    <td class="px-6 py-4">@product.Stock</td>
                </TableRow>
                <EmptyContent>
                    <div class="text-center py-8">
                        <p class="text-gray-500 dark:text-gray-400">No products found matching your search.</p>
                    </div>
                </EmptyContent>
            </TwDataTable>
        </CodeExample>
    </PageCard>

    <PageCard Title="Data table without pagination">
        <Description>Display all data without pagination controls.</Description>

        <CodeExample Name="DataTableWithoutPagination" CSharpName="DataTableUser">
            <TwDataTable TItem="User"
                         Items="@users"
                         Pageable="false"
                         Searchable
                         SearchPlaceholder="Search users...">
                <TableHeader>
                    <tr>
                        <th scope="col" class="px-6 py-3">Name</th>
                        <th scope="col" class="px-6 py-3">Department</th>
                        <th scope="col" class="px-6 py-3">Role</th>
                    </tr>
                </TableHeader>
                <TableRow Context="user">
                    <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">@user.Name</td>
                    <td class="px-6 py-4">@user.Department</td>
                    <td class="px-6 py-4">@user.Role</td>
                </TableRow>
            </TwDataTable>
        </CodeExample>
    </PageCard>

    <PageCard Title="Custom row classes">
        <Description>Data table with custom row styling based on conditions.</Description>

        <CodeExample Name="DataTableCustomClasses" CSharpName="DataTableProduct">
            <TwDataTable TItem="Product"
                         Items="@products"
                         RowsPerPage="5"
                         Pageable
                         DefineTableRows>
                <TableHeader>
                    <tr>
                        <th scope="col" class="px-6 py-3">Product</th>
                        <th scope="col" class="px-6 py-3">Category</th>
                        <th scope="col" class="px-6 py-3">Price</th>
                        <th scope="col" class="px-6 py-3">Stock</th>
                    </tr>
                </TableHeader>
                <TableRow Context="product">
                    @{
                        var rowClass = product.Stock < 10 ? "bg-red-50 dark:bg-red-900/20" : "";
                    }
                    <tr class="@rowClass">
                        <td class="px-6 py-4 font-medium text-gray-900 whitespace-nowrap dark:text-white">@product.Name</td>
                        <td class="px-6 py-4">@product.Category</td>
                        <td class="px-6 py-4">£@product.Price.ToString("N2")</td>
                        <td class="px-6 py-4">
                            @if (product.Stock < 10)
                            {
                                <span class="text-red-700 dark:text-red-400 font-semibold">@product.Stock (Low Stock)</span>
                            }
                            else
                            {
                                <span>@product.Stock</span>
                            }
                        </td>
                    </tr>
                </TableRow>
            </TwDataTable>
        </CodeExample>
    </PageCard>

    <PageCard Title="Sortable data table with columns">
        <Description>
            Data table with per-column sortability. Click column headers to sort. Some columns are sortable (with icons), others are not.
        </Description>

        <CodeExample Name="DataTableSortableColumns" CSharpName="DataTableProductColumns">
            <TwDataTable TItem="Product"
                         Items="@products"
                         Columns="@_productColumns"
                         Searchable
                         Pageable
                         RowsPerPage="10">
                <EmptyContent>
                    <div class="text-center py-8">
                        <p class="text-gray-500 dark:text-gray-400">No products found.</p>
                    </div>
                </EmptyContent>
            </TwDataTable>
        </CodeExample>
    </PageCard>

    <PageCard Title="Column widths and fixed layout">
        <Description>
            Give a column a <code>Width</code> to size it. Any CSS length works, such as <code>40%</code> or <code>8rem</code>, and columns without a width share the rest. Add <code>FixedLayout</code> so the columns keep their widths as you page, sort and search, instead of jumping to fit each page's content. With <code>TableHeader</code> and <code>TableRow</code>, pass a <code>ColumnGroup</code> of <code>TwTableColumn</code> elements instead, as on <code>TwTable</code>.
        </Description>

        <CodeExample Name="DataTableColumnWidths" CSharpName="DataTableSizedColumns">
            <TwDataTable TItem="Product"
                         Items="@products"
                         Columns="@_sizedColumns"
                         FixedLayout
                         Searchable
                         RowsPerPage="5"
                         AriaLabel="Products with fixed column widths" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Showing, hiding and reordering columns">
        <Description>
            Set <code>ColumnPanel</code> to add a Columns button. It opens a panel with a checkbox for each column and buttons that move a column up or down the order. Set <code>Hideable = false</code> on a column that identifies each row so it cannot be hidden, and <code>Visible = false</code> on a column that should start hidden. The last visible column cannot be hidden, and Reset columns puts everything back. Every change is announced to screen readers, and Escape closes the panel.
        </Description>

        <CodeExample Name="DataTableColumnPanel" CSharpName="DataTablePanelColumns">
            <TwDataTable TItem="Product"
                         Id="column-panel-table"
                         Items="@products"
                         Columns="@_panelColumns"
                         ColumnPanel
                         RowsPerPage="5"
                         AriaLabel="Products with a column panel" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Resizable columns">
        <Description>
            Set <code>ResizableColumns</code> to let people drag the edge of a column header to resize it. Dragging needs a pointer, so the column panel gains Make narrower and Make wider buttons for each column too, and the Columns button appears even without <code>ColumnPanel</code>. Resizing turns on <code>FixedLayout</code>, and <code>Resizable = false</code> keeps a column at its width.
        </Description>

        <CodeExample Name="DataTableResizableColumns">
            <TwDataTable TItem="Product"
                         Id="resizable-columns-table"
                         Items="@products"
                         Columns="@_productColumns"
                         ResizableColumns
                         RowsPerPage="5"
                         AriaLabel="Products with resizable columns" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Exporting to CSV and Excel">
        <Description>
            Set <code>Exportable</code> to add Export CSV and Export Excel buttons. An export holds the columns on screen in their current order, and by default every row that matches the search in its current sort, across all pages. Change that with <code>ExportScope</code>, or pick the buttons with <code>ExportFormats</code>. The Excel file keeps numbers, dates and true or false values as their own types, so they can be summed and filtered. Give a column an <code>ExportFormatter</code> to write a different value from the one on screen, or set <code>Exportable = false</code> to leave it out. Text that a spreadsheet would run as a formula is escaped.
        </Description>

        <CodeExample Name="DataTableExport" CSharpName="DataTableExportColumns">
            <TwDataTable TItem="Product"
                         Id="export-table"
                         Items="@products"
                         Columns="@_exportColumns"
                         Exportable
                         ExportFileName="products"
                         Searchable
                         RowsPerPage="5"
                         AriaLabel="Products you can export" />
        </CodeExample>

        <p class="mt-4 mb-2">
            To build the file yourself, call <code>GetCsv</code> or <code>GetExcel</code> on the table, or use <code>TwDataTableExport</code> with any rows and columns, for example to send a report from the server.
        </p>
        <TwCodeBlock Content="@exportServerExample" Language="csharp" />
    </PageCard>

    <PageCard Title="Saving the table's state">
        <Description>
            Give the table a <code>StateStorageKey</code> and it remembers its sort, search, page, page size and columns in the browser, so it comes back the way the person left it. Sort or hide a column below, then reload the page. <code>ResetStateAsync</code> puts it back to how the parameters define it.
        </Description>

        <CodeExample Name="DataTableStateStorage" CSharpName="DataTableStateStorageCode">
            <TwDataTable @ref="storedTable"
                         TItem="Product"
                         Id="stored-state-table"
                         Items="@products"
                         Columns="@_panelColumns"
                         StateStorageKey="docs-products-table"
                         ColumnPanel
                         ResizableColumns
                         Searchable
                         RowsPerPage="5"
                         AriaLabel="Products that remember their state" />
            <TwButton Class="mt-4" Label="Reset table" Variant="ButtonVariant.Outlined" OnClick="ResetStoredTableAsync" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Managing the state yourself">
        <Description>
            To keep the state somewhere else, such as a user's profile or the page address, bind <code>@@bind-State</code>. The table raises a new <code>TwDataTableState</code> after every change, and restores whichever state you pass in. It is made of plain values, so it serializes to JSON as it is. Columns are matched by <code>Name</code>, so a saved state survives columns being added or removed.
        </Description>

        <CodeExample Name="DataTableBoundState" CSharpName="DataTableBoundStateCode">
            <TwDataTable TItem="Product"
                         Id="bound-state-table"
                         Items="@products"
                         Columns="@_productColumns"
                         @bind-State="tableState"
                         Searchable
                         RowsPerPage="5"
                         AriaLabel="Products with state you manage" />
            <p class="mt-4 mb-2 font-medium">The current state:</p>
            <TwCodeBlock Content="@tableStateJson" Language="json" />
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    private List<Product> products = new();
    private List<User> users = new();

    #region CodeExample DataTableProductColumns
    // Define columns with per-column sortability
    private readonly List<TwDataTableColumn<Product>> _productColumns = new()
    {
        new TwDataTableColumn<Product>
        {
            Name = "name",
            Title = "Product Name",
            PropertySelector = p => p.Name,
            IsSortable = true,  // Sortable with alpha icons (auto-detected)
        },
        new TwDataTableColumn<Product>
        {
            Name = "category",
            Title = "Category",
            PropertySelector = p => p.Category,
            IsSortable = false,  // Sortable disabled.
        },
        new TwDataTableColumn<Product>
        {
            Name = "price",
            Title = "Price",
            PropertySelector = p => p.Price,
            IsSortable = true,  // Sortable with numeric icons (auto-detected from decimal type)
            CellFormatter = p => $"£{p.Price:N2}"
        },
        new TwDataTableColumn<Product>
        {
            Name = "stock",
            Title = "Stock",
            PropertySelector = p => p.Stock,
            CellFormatter = p => p.Stock < 10
                ? $"{p.Stock} (Low Stock)"
                : p.Stock.ToString(),
            IsSortable = true
        }
    };
    #endregion

    #region CodeExample DataTableSizedColumns
    private readonly List<TwDataTableColumn<Product>> _sizedColumns = new()
    {
        new TwDataTableColumn<Product> { Name = "name", Title = "Product Name", PropertySelector = p => p.Name, IsSortable = true },
        new TwDataTableColumn<Product> { Name = "category", Title = "Category", PropertySelector = p => p.Category, Width = "25%" },
        new TwDataTableColumn<Product> { Name = "price", Title = "Price", PropertySelector = p => p.Price, IsSortable = true, Width = "8rem", CellFormatter = p => $"£{p.Price:N2}" }
    };
    #endregion

    #region CodeExample DataTablePanelColumns
    private readonly List<TwDataTableColumn<Product>> _panelColumns = new()
    {
        // The name identifies each row, so it always stays visible.
        new TwDataTableColumn<Product> { Name = "name", Title = "Product Name", PropertySelector = p => p.Name, IsSortable = true, Hideable = false },
        new TwDataTableColumn<Product> { Name = "category", Title = "Category", PropertySelector = p => p.Category },
        new TwDataTableColumn<Product> { Name = "price", Title = "Price", PropertySelector = p => p.Price, IsSortable = true, CellFormatter = p => $"£{p.Price:N2}" },
        // Starts hidden; people can show it from the panel.
        new TwDataTableColumn<Product> { Name = "stock", Title = "Stock", PropertySelector = p => p.Stock, IsSortable = true, Visible = false }
    };
    #endregion

    #region CodeExample DataTableExportColumns
    private readonly List<TwDataTableColumn<Product>> _exportColumns = new()
    {
        new TwDataTableColumn<Product> { Name = "name", Title = "Product Name", PropertySelector = p => p.Name, IsSortable = true },
        new TwDataTableColumn<Product> { Name = "category", Title = "Category", PropertySelector = p => p.Category },
        // On screen the price reads "£2,999.00"; the export keeps the number so a spreadsheet can total it.
        new TwDataTableColumn<Product> { Name = "price", Title = "Price", PropertySelector = p => p.Price, IsSortable = true, CellFormatter = p => $"£{p.Price:N2}" },
        new TwDataTableColumn<Product> { Name = "stock", Title = "Stock", PropertySelector = p => p.Stock, ExportFormatter = p => p.Stock < 10 ? "Low" : "In stock" }
    };
    #endregion

    private const string exportServerExample = """
        byte[] workbook = TwDataTableExport.ToExcel(orders, columns, sheetName: "Orders");
        string csv = TwDataTableExport.ToCsv(orders, columns);
        """;

    #region CodeExample DataTableStateStorageCode
    private TwDataTable<Product>? storedTable;

    private async Task ResetStoredTableAsync()
    {
        if (storedTable is not null)
        {
            await storedTable.ResetStateAsync();
        }
    }
    #endregion

    #region CodeExample DataTableBoundStateCode
    private TwDataTableState? tableState;

    private string tableStateJson => tableState is null
        ? "Sort, search or change page to see the state."
        : System.Text.Json.JsonSerializer.Serialize(tableState, new System.Text.Json.JsonSerializerOptions(System.Text.Json.JsonSerializerDefaults.Web) { WriteIndented = true });
    #endregion

    protected override void OnInitialized()
    {
        // Sample product data
        products = new List<Product>
        {
            new Product { Id = 1, Name = "Apple MacBook Pro 17\"", Category = "Laptop", Price = 2999, Stock = 15 },
            new Product { Id = 2, Name = "Microsoft Surface Pro", Category = "Laptop", Price = 1999, Stock = 8 },
            new Product { Id = 3, Name = "Magic Mouse 2", Category = "Accessories", Price = 99, Stock = 50 },
            new Product { Id = 4, Name = "Apple Watch Series 9", Category = "Wearables", Price = 499, Stock = 25 },
            new Product { Id = 5, Name = "iPad Air", Category = "Tablet", Price = 799, Stock = 5 },
            new Product { Id = 6, Name = "Samsung Galaxy S24", Category = "Phone", Price = 1199, Stock = 30 },
            new Product { Id = 7, Name = "Sony WH-1000XM5", Category = "Accessories", Price = 399, Stock = 12 },
            new Product { Id = 8, Name = "Dell XPS 15", Category = "Laptop", Price = 2199, Stock = 18 },
            new Product { Id = 9, Name = "Google Pixel 8 Pro", Category = "Phone", Price = 999, Stock = 22 },
            new Product { Id = 10, Name = "AirPods Pro", Category = "Accessories", Price = 249, Stock = 40 },
            new Product { Id = 11, Name = "Kindle Paperwhite", Category = "E-Reader", Price = 149, Stock = 35 },
            new Product { Id = 12, Name = "Nintendo Switch", Category = "Gaming", Price = 299, Stock = 7 },
            new Product { Id = 13, Name = "PlayStation 5", Category = "Gaming", Price = 499, Stock = 3 },
            new Product { Id = 14, Name = "Xbox Series X", Category = "Gaming", Price = 499, Stock = 6 },
            new Product { Id = 15, Name = "Canon EOS R6", Category = "Camera", Price = 2499, Stock = 9 }
        };

        // Sample user data
        users = new List<User>
        {
            new User { Id = 1, Name = "John Doe", Department = "Engineering", Role = "Developer" },
            new User { Id = 2, Name = "Jane Smith", Department = "Product", Role = "Designer" },
            new User { Id = 3, Name = "Bob Johnson", Department = "Operations", Role = "Manager" },
            new User { Id = 4, Name = "Alice Williams", Department = "Engineering", Role = "Developer" },
            new User { Id = 5, Name = "Charlie Brown", Department = "Quality", Role = "QA Engineer" }
        };
    }

    #region CodeExample DataTableProduct
    public class Product
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Category { get; set; } = string.Empty;
        public decimal Price { get; set; }
        public int Stock { get; set; }
    }
    #endregion

    #region CodeExample DataTableUser
    public class User
    {
        public int Id { get; set; }
        public string Name { get; set; } = string.Empty;
        public string Department { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }
    #endregion
}
