@page "/breadcrumb"
@using TwBlazor.Models

<PageContainer Title="TwBreadcrumb" Path="/breadcrumb" Description="TwBreadcrumb is a Blazor breadcrumb component that shows the current page location. Build trails automatically with Auto, or manually with Label, Href and Icon." ThemeType="typeof(TwBreadcrumbTheme)">
    <PageCard Title="Breadcrumbs">
        <Description>Usage of breadcrumb is simplified, you can use the component and allow for automatic breadcrumbs based on the current uri structure:</Description>

        <CodeExample Name="BreadcrumbAuto">
            <TwBreadcrumb Auto />
        </CodeExample>
    </PageCard>

    <PageCard Title="Manual Breadcrumbs">
        <Description>You can also manually configure the breadcrumbs:</Description>

        <CodeExample Name="BreadcrumbManual" CSharpName="BreadcrumbManualCode">
            <TwBreadcrumb Breadcrumbs="@breadcrumbs" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Inline Breadcrumbs">
        <Description>You can also manually configure the breadcrumbs inline like so:</Description>

        <CodeExample Name="BreadcrumbInline">
            <TwBreadcrumb>
                <TwBreadcrumbItem Label="Home" Href="/" />
                <TwBreadcrumbItem Label="Docs" Href="/" />
                <TwBreadcrumbItem Label="Breadcrumb" Href="/breadcrumb" Icon="Icon.Segmented_Nav" AriaCurrent />
            </TwBreadcrumb>
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample BreadcrumbManualCode
    private readonly List<BreadcrumbItem> breadcrumbs = new()
    {
        new()
        {
            Icon = Icon.House,
            Label = "Home",
            Href = "/"
        },
        new ()
        {
            Icon = Icon.Wrench,
            Label = "Settings",
            Href = "/"
        }
    };
    #endregion
}