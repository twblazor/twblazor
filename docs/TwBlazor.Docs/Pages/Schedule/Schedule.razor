@page "/schedule"
@using TwBlazor.Models
@using TwBlazor.Services

<PageTitle>TwSchedule | twblazor</PageTitle>
<HeadContent>
    <meta name="description" content="TwSchedule is a Blazor Day/Week/Month schedule component with time-slot event positioning, a built-in create/edit dialog, and searchable events." />
    <link rel="canonical" href="https://twblazor.com/schedule" />
</HeadContent>

@inject ITwDialogService DialogService

<PageContainer Title="TwSchedule" ThemeType="typeof(TwScheduleTheme)">
    <PageCard Title="Views">
        <Description>
            Bind <code>SelectedDate</code> and <code>View</code> to switch between the Day, Week, and
            Month views. Overlapping events on the Day/Week views lay out side by side automatically.
            The Day/Week views' time grid scrolls once it exceeds <code>MaxHeight</code> (default
            <code>40rem</code>) - pass your own CSS length (e.g. <code>"30rem"</code>, <code>"600px"</code>)
            to change it. It's scrolled to <code>ScrollToTime</code> (default 8am) the first time a Day
            or Week view mounts, so it opens on a useful part of the day instead of midnight.
        </Description>
        <CodeExample Name="ScheduleBasic" CSharpName="ScheduleBasicCode">
            <TwSchedule T="string" @bind-SelectedDate="selectedDate" @bind-View="view" Schedules="Schedules" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Adding & Editing Events">
        <Description>
            Set <code>Editable</code> to show the header's "+" button and let events open the
            built-in dialog in edit mode. Click an empty time slot to create an event there, or an
            existing event to edit it. An individual entry's own <code>ReadOnly</code> overrides
            <code>Editable</code>, always opening read-only - see "Lunch" below. While
            <code>Editable</code>, non-read-only events can also be dragged to reschedule them: drag
            between time slots (and, in Week view, between days) on the Day/Week views, or between
            days (keeping the same time) on the Month view. The dialog also includes a
            <code>TwColorPicker</code> for <code>Schedule&lt;T&gt;.Color</code> - a per-event hex color
            that overrides the chip's default background across all three views; leave it unset to
            fall back to the theme's own color.
        </Description>
        <CodeExample Name="ScheduleEditable" CSharpName="ScheduleEditableCode">
            <TwSchedule T="string" @bind-SelectedDate="editableSelectedDate" @bind-View="editableView" Editable="true" @bind-Schedules="EditableSchedules" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Custom Event Content">
        <Description>
            Use <code>EventContentTemplate</code> to customize how each event chip renders across all
            three views.
        </Description>
        <CodeExample Name="ScheduleCustomContent" CSharpName="ScheduleCustomContentCode">
            <TwSchedule T="string" @bind-SelectedDate="customContentSelectedDate" @bind-View="customContentView" Schedules="Schedules">
                <EventContentTemplate>
                    <span class="text-xs font-semibold">@context.Name</span>
                    <span class="block text-xs opacity-80">@context.DateTimeStart.ToString("h:mm tt")</span>
                </EventContentTemplate>
            </TwSchedule>
        </CodeExample>
    </PageCard>

    <PageCard Title="Search Events">
        <Description>
            <code>TwSchedule</code> doesn't own any search logic itself - set <code>OnSearch</code>
            and it shows a search icon in the header that invokes your callback. This example opens a
            small dialog (composed the same way as any other <code>TwDialog</code> content component)
            that filters <code>Schedules</code> by name, then jumps to the selected event by setting
            <code>@@bind-SelectedDate</code>/<code>@@bind-View</code> on the schedule.
        </Description>
        <CodeExample Name="ScheduleSearch" CSharpName="ScheduleSearchCode">
            <TwSchedule T="string" @bind-SelectedDate="searchSelectedDate" @bind-View="searchView" Schedules="Schedules" OnSearch="OnSearchAsync" />
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample ScheduleBasicCode
    private DateTime selectedDate = DateTime.Today;
    private TwScheduleView view = TwScheduleView.Week;

    private List<Schedule<string>> Schedules = BuildSampleSchedules();

    private static List<Schedule<string>> BuildSampleSchedules()
    {
        var today = DateTime.Today;
        return
        [
            new() { Name = "Team standup", DateTimeStart = today.AddHours(9), DateTimeEnd = today.AddHours(9.5), Color = "#2563eb" },
            new() { Name = "Design review", DateTimeStart = today.AddHours(10), DateTimeEnd = today.AddHours(11), Color = "#9333ea" },
            new() { Name = "1:1 with Sam", DateTimeStart = today.AddHours(10.5), DateTimeEnd = today.AddHours(11.25), Color = "#db2777" },
            new() { Name = "Lunch", DateTimeStart = today.AddHours(12), DateTimeEnd = today.AddHours(13), ReadOnly = true, Color = "#f59e0b" },
            new() { Name = "Sprint planning", DateTimeStart = today.AddDays(1).AddHours(14), DateTimeEnd = today.AddDays(1).AddHours(15.5), Color = "#16a34a" },
            new() { Name = "Client call", DateTimeStart = today.AddDays(2).AddHours(9), DateTimeEnd = today.AddDays(2).AddHours(9.75), Color = "#0d9488" },
            new() { Name = "Retro", DateTimeStart = today.AddDays(4).AddHours(16), DateTimeEnd = today.AddDays(4).AddHours(17), Color = "#4f46e5" },
            new() { Name = "Launch", DateTimeStart = today.AddDays(-2).AddHours(9), DateTimeEnd = today.AddDays(-2).AddHours(10), Color = "#dc2626" },
            new() { Name = "Budget review", DateTimeStart = today.AddDays(3).AddHours(9), DateTimeEnd = today.AddDays(3).AddHours(9.5), Color = "#0891b2" },
            new() { Name = "Interview", DateTimeStart = today.AddDays(3).AddHours(10), DateTimeEnd = today.AddDays(3).AddHours(10.5), Color = "#7c3aed" },
            new() { Name = "All hands", DateTimeStart = today.AddDays(3).AddHours(11), DateTimeEnd = today.AddDays(3).AddHours(12), Color = "#ea580c" },
            new() { Name = "Extra sync", DateTimeStart = today.AddDays(3).AddHours(13), DateTimeEnd = today.AddDays(3).AddHours(13.5), Color = "#059669" },
        ];
    }
    #endregion

    #region CodeExample ScheduleEditableCode
    private DateTime editableSelectedDate = DateTime.Today;
    private TwScheduleView editableView = TwScheduleView.Day;

    private List<Schedule<string>> EditableSchedules = BuildSampleSchedules();
    #endregion

    #region CodeExample ScheduleCustomContentCode
    private DateTime customContentSelectedDate = DateTime.Today;
    private TwScheduleView customContentView = TwScheduleView.Week;
    #endregion

    #region CodeExample ScheduleSearchCode
    private DateTime searchSelectedDate = DateTime.Today;
    private TwScheduleView searchView = TwScheduleView.Week;

    private async Task OnSearchAsync()
    {
        var reference = await DialogService.ShowAsync<ScheduleSearchDialog>("Search events", new TwDialogParameters
        {
            ["Schedules"] = Schedules
        });

        var selected = await reference.GetReturnValueAsync<Schedule<string>>();
        if (selected is not null)
        {
            searchSelectedDate = selected.DateTimeStart.Date;
            searchView = TwScheduleView.Day;
        }
    }
    #endregion
}
