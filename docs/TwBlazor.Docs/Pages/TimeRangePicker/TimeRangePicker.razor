@page "/time-range-picker"

<PageContainer Title="TwTimeRangePicker" Path="/time-range-picker" Description="TwTimeRangePicker is a Blazor component for choosing a start and end time from one popover. Bind Value or SelectedRange and set Format and Placeholder.">
    <PageCard Title="Basic time range picker">
        <Description>Bind <code>SelectedRange</code> for a <code>KeyValuePair&lt;TimeOnly?, TimeOnly?&gt;</code> value (<code>Key</code> = start, <code>Value</code> = end). The popover reuses the same hour/minute editor as <a href="/time-picker" class="underline">TwTimePicker</a>, switching between the start and end with the Start/End tab at the top. Unlike the date-based range pickers, an end time earlier than the start is left as-is rather than swapped - it just represents a range that crosses midnight (e.g. an overnight shift).</Description>
        <CodeExample Name="TimeRangePickerBasic" CSharpName="TimeRangePickerBasicCode">
            <div class="space-y-4">
                <p><b>@@bind-SelectedRange:</b> @(SelectedRange.Key?.ToString("t") ?? "-") - @(SelectedRange.Value?.ToString("t") ?? "-")</p>
                <TwTimeRangePicker Id="basic-timerangepicker" @bind-SelectedRange="SelectedRange" Label="Select a shift" Class="mt-3" />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="12-hour format">
        <Description>Set <code>Is12HourFormat</code> to display and edit the time with an AM/PM toggle instead of 24-hour time.</Description>
        <CodeExample Name="TimeRangePicker12Hour" CSharpName="TimeRangePickerBasicCode">
            <TwTimeRangePicker Id="12hr-timerangepicker" @bind-SelectedRange="SelectedRange" Is12HourFormat Label="Select a shift" Class="mt-3" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Step">
        <Description>Set <code>Step</code> to the number of minutes the start and end time arrow buttons and the <kbd>Arrow Up</kbd>/<kbd>Arrow Down</kbd> keys move by. Under an hour, the minutes step (15 gives :00, :15, :30 and :45). From 60 upwards, the hours step instead (120 moves two hours at a time) and the minute field is locked. The step must divide an hour (1, 2, 3, 4, 5, 6, 10, 12, 15, 20 or 30) or be a whole number of hours that divides a day (60, 120, 180, 240, 360, 480 or 720). A time typed into the field is kept as entered. When the browser's native picker is used, the step is passed on to it.</Description>
        <CodeExample Name="TimeRangePickerStep" CSharpName="TimeRangePickerBasicCode">
            <TwTimeRangePicker Id="step-timerangepicker" @bind-SelectedRange="SelectedRange" Step="15" Label="Select a shift" Class="mt-3" />
        </CodeExample>
    </PageCard>

    <PageCard Title="Input variants">
        <Description>The time range picker supports the same visual variants as the other text inputs.</Description>
        <CodeExample Name="TimeRangePickerVariants" CSharpName="TimeRangePickerBasicCode">
            <div class="space-y-4">
                <TwTimeRangePicker Id="default-variant" @bind-SelectedRange="SelectedRange" Label="Default Variant" Variant="InputVariant.Default" />
                <TwTimeRangePicker Id="outlined-variant" @bind-SelectedRange="SelectedRange" Label="Outlined Variant" Variant="InputVariant.Outlined" />
                <TwTimeRangePicker Id="filled-variant" @bind-SelectedRange="SelectedRange" Label="Filled Variant" Variant="InputVariant.Filled" />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Dense time range picker">
        <Description>Set <code>Dense</code> for a more compact input with a smaller height and text size. Every single-line input shares the same dense height, so they line up when used side by side.</Description>
        <CodeExample Name="TimeRangePickerDense" CSharpName="TimeRangePickerBasicCode">
            <TwTimeRangePicker Id="dense-timerangepicker" @bind-SelectedRange="SelectedRange" Label="Dense Time Range Picker" Dense />
        </CodeExample>
    </PageCard>

    <PageCard Title="Disabled and readonly time range picker">
        <Description>Use the <code>Disabled</code> and <code>ReadOnly</code> properties to restrict interaction with the time range picker.</Description>
        <CodeExample Name="TimeRangePickerReadonlyDisabled" CSharpName="TimeRangePickerBasicCode">
            <TwTimeRangePicker Id="disabled-timerangepicker" @bind-SelectedRange="SelectedRange" Label="Disabled Time Range Picker" Disabled Class="mt-3" />
            <TwTimeRangePicker Id="readonly-timerangepicker" @bind-SelectedRange="SelectedRange" Label="Readonly Time Range Picker" ReadOnly Class="mt-3" />
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample TimeRangePickerBasicCode
    public KeyValuePair<TimeOnly?, TimeOnly?> SelectedRange { get; set; }
    #endregion
}
