    /// <summary>
    /// Picked hex color per semantic color name, as held by the theme builder page.
    /// </summary>
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, string> Colors { get; set; } = new Dictionary<string, string>();

    /// <summary>
    /// The text mode on each filled color, per semantic color name.
    /// </summary>
    [Parameter, EditorRequired] public IReadOnlyDictionary<string, OnColorMode> OnColors { get; set; } = new Dictionary<string, OnColorMode>();

    /// <summary>
    /// The enum defaults to show. They are passed to each sample as explicit parameters, because the preview
    /// runs on the docs site's own registered theme and never replaces it.
    /// </summary>
    [Parameter, EditorRequired] public ThemeDefaults Defaults { get; set; } = ThemeDefaults.Default;

    /// <summary>
    /// The ticked component names. A sample is shown only while its component is ticked.
    /// </summary>
    [Parameter, EditorRequired] public IReadOnlySet<string> Selected { get; set; } = new HashSet<string>();

    private string headingClass => $"mb-3 text-xl font-bold tracking-tight {Options.Theme.Colors.NeutralText.Heading}";

    private string secondaryText => Options.Theme.Colors.NeutralText.Secondary;

    private Dictionary<string, object> look => new()
    {
        [nameof(TwCard.Rounded)] = Defaults.Rounded,
        [nameof(TwCard.Shadow)] = Defaults.Shadow
    };

    private Dictionary<string, object> inputLook => new(look) { [nameof(TwTextfield<string>.Variant)] = Defaults.InputVariant };

    private bool Has(params string[] names) => names.Any(Selected.Contains);

    private string? FilledStyle(ThemeColorFamily family, bool isFilled) =>
        isFilled ? ThemePreviewStyle.FilledText(family, Colors, OnColors) : null;

    private static Color ToColor(ThemeColorFamily family) => Enum.Parse<Color>(family.Name);
