@page "/theme"
@using TwBlazor.Configuration
@using TwBlazor.Configuration.Color
@inject TwBlazorOptions Options

<PageContainer Title="Theme" Path="/theme" Category="Design tokens" Description="Explore the twblazor live theme tokens: semantic colours, neutral surface and text tokens, shadows and border radius, as registered by your app theme." SeoTitle="Theme | twblazor - Colours, Surfaces and Design Tokens for Blazor">
    <PageCard Title="Semantic Colors">
        <Description>
            Every color-aware component accepts a <code>Color</code> from the <code>Color</code> enum: <code>Primary</code>, <code>Accent</code>, <code>Success</code>, <code>Danger</code>, <code>Warning</code>, <code>Info</code>, <code>Light</code> and <code>Dark</code>. Each button below is rendered with that color, so what you see is exactly what your registered theme produces - the border class underneath is read live from <code>TwBlazorTheme.Border.Colors</code>.
        </Description>

        <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
            @foreach (var c in Colors)
            {
                <div class="flex flex-col items-center gap-2 @SwatchWrapperClass(c)">
                    <TwButton Label="@c.ToString()" Color="c" Variant="ButtonVariant.Filled" Class="w-full justify-center" />
                    @* Light/Dark swatches keep a fixed background regardless of page theme (they're demonstrating
                       what those colors look like on their usual opposite backdrop), so their caption needs a
                       fixed contrasting color too rather than the page-theme-responsive default. *@
                    <code class="text-[11px] text-center break-all @(c switch { Color.Light => "text-gray-400", Color.Dark => "text-gray-700", _ => "text-gray-500 dark:text-gray-400" })">@Resolve(Options.Theme.Border.Colors, c)</code>
                </div>
            }
        </div>
    </PageCard>

    <PageCard Title="Neutral Surface & Text">
        <Description>
            Components that aren't tied to a semantic color - cards, dialogs, popovers, sidebars - share a small set of neutral tokens instead, defined once on <code>TwBlazorColor.NeutralSurface</code> and <code>TwBlazorColor.NeutralText</code> and reused everywhere so a single change restyles every consumer.
        </Description>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
                <h4 class="text-sm font-semibold mb-1 @Options.Theme.Colors.NeutralText.Heading">Surfaces</h4>
                @foreach (var token in SurfaceTokens)
                {
                    <div class="flex items-center gap-3 p-3 rounded-lg border @Options.Theme.Colors.NeutralSurface.Border @token.Value">
                        <span class="text-sm font-medium @Options.Theme.Colors.NeutralText.Heading">@token.Label</span>
                        <code class="ml-auto text-xs text-right @Options.Theme.Colors.NeutralText.Muted">@token.Value</code>
                    </div>
                }
            </div>

            <div class="space-y-2">
                <h4 class="text-sm font-semibold mb-1 @Options.Theme.Colors.NeutralText.Heading">Text</h4>
                @foreach (var token in TextTokens)
                {
                    <div class="flex items-center gap-3 p-3 rounded-lg border @Options.Theme.Colors.NeutralSurface.Border">
                        @* Label always stays legible - Subtle is intentionally quieter than body-text contrast
                           requirements demand (it's meant for icons/separators, not this label itself), so the
                           actual class string below is the accurate way to see what it resolves to. *@
                        <span class="font-medium @Options.Theme.Colors.NeutralText.Heading">@token.Label</span>
                        <code class="ml-auto text-xs text-right @Options.Theme.Colors.NeutralText.Muted">@token.Value</code>
                    </div>
                }
            </div>
        </div>
    </PageCard>

    <PageCard Title="Shadows & Rounding">
        <Description>
            Every component resolves its shadow and border radius from these scales via <code>Shadows.DefaultShadow</code> and <code>Rounded.DefaultRounded</code>, unless overridden per-instance with the <code>Shadow</code> or <code>Rounded</code> parameter. The current default of each scale is marked below.
        </Description>

        <h4 class="text-sm font-semibold mb-3 @Options.Theme.Colors.NeutralText.Heading">Shadow Scale</h4>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
            @foreach (var token in ShadowTokens)
            {
                <div class="flex flex-col items-center gap-2">
                    <div class="w-16 h-16 rounded-lg @Options.Theme.Colors.NeutralSurface.Background @token.Value"></div>
                    <span class="text-xs @Options.Theme.Colors.NeutralText.Muted">@token.Label@(token.IsDefault ? " (default)" : "")</span>
                </div>
            }
        </div>

        <h4 class="text-sm font-semibold mb-3 @Options.Theme.Colors.NeutralText.Heading">Rounded Scale</h4>
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
            @foreach (var token in RoundedTokens)
            {
                <div class="flex flex-col items-center gap-2">
                    <div class="w-16 h-16 border @Options.Theme.Colors.NeutralSurface.Border @token.Value"></div>
                    <span class="text-xs @Options.Theme.Colors.NeutralText.Muted">@token.Label@(token.IsDefault ? " (default)" : "")</span>
                </div>
            }
        </div>
    </PageCard>

    <PageCard Title="Customizing the Theme">
        <Description NoMargin>
            Every class shown on this page comes from a single <code>TwBlazorTheme</code>, registered once via <code>AddTwBlazor()</code>. Copy the default theme into your own project and change any string to restyle every component that reads it - see <a href="/get-started" class="underline">Get Started</a> for the full setup, including the complete theme source.
        </Description>
    </PageCard>
</PageContainer>

@code {
    private static readonly Color[] Colors = Enum.GetValues<Color>();

    private static string SwatchWrapperClass(Color c) => c switch
    {
        Color.Light => "bg-gray-900 p-3 rounded-lg",
        Color.Dark => "bg-white p-3 rounded-lg",
        _ => "p-3"
    };

    private static string Resolve(TwBlazorPalette palette, Color c) => c switch
    {
        Color.Primary => palette.Primary,
        Color.Accent => palette.Accent,
        Color.Success => palette.Success,
        Color.Danger => palette.Danger,
        Color.Warning => palette.Warning,
        Color.Info => palette.Info,
        Color.Light => palette.Light,
        Color.Dark => palette.Dark,
        _ => string.Empty
    };

    private (string Label, string Value)[] SurfaceTokens => new[]
    {
        ("Background", Options.Theme.Colors.NeutralSurface.Background),
        ("Background Subtle", Options.Theme.Colors.NeutralSurface.BackgroundSubtle),
        ("Border", Options.Theme.Colors.NeutralSurface.Border),
        ("Border Subtle", Options.Theme.Colors.NeutralSurface.BorderSubtle),
        ("Hover", Options.Theme.Colors.NeutralSurface.Hover),
    };

    private (string Label, string Value)[] TextTokens => new[]
    {
        ("Heading", Options.Theme.Colors.NeutralText.Heading),
        ("Secondary", Options.Theme.Colors.NeutralText.Secondary),
        ("Muted", Options.Theme.Colors.NeutralText.Muted),
        ("Subtle", Options.Theme.Colors.NeutralText.Subtle),
    };

    private (string Label, string Value, bool IsDefault)[] ShadowTokens => new[]
    {
        ("None", Options.Theme.Shadows.None, Options.Theme.Shadows.DefaultShadow == Shadow.None),
        ("Sm", Options.Theme.Shadows.Sm, Options.Theme.Shadows.DefaultShadow == Shadow.Sm),
        ("Md", Options.Theme.Shadows.Md, Options.Theme.Shadows.DefaultShadow == Shadow.Md),
        ("Lg", Options.Theme.Shadows.Lg, Options.Theme.Shadows.DefaultShadow == Shadow.Lg),
    };

    private (string Label, string Value, bool IsDefault)[] RoundedTokens => new[]
    {
        ("None", Options.Theme.Rounded.None, Options.Theme.Rounded.DefaultRounded == Rounded.None),
        ("Sm", Options.Theme.Rounded.Sm, Options.Theme.Rounded.DefaultRounded == Rounded.Sm),
        ("Md", Options.Theme.Rounded.Md, Options.Theme.Rounded.DefaultRounded == Rounded.Md),
        ("Lg", Options.Theme.Rounded.Lg, Options.Theme.Rounded.DefaultRounded == Rounded.Lg),
        ("Full", Options.Theme.Rounded.Full, Options.Theme.Rounded.DefaultRounded == Rounded.Full),
    };
}
