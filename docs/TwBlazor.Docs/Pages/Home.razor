                </div>
            </div>
            <DiscordInviteLink Id="landing-discord" Class="inline-flex w-full shrink-0 items-center justify-center gap-2 rounded-md border border-purple-300 bg-white px-5 py-2.5 font-semibold text-purple-900 transition-colors hover:border-purple-400 hover:bg-purple-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 sm:w-auto dark:border-purple-400/40 dark:bg-transparent dark:text-purple-100 dark:hover:border-purple-300/60 dark:hover:bg-purple-400/10 dark:focus-visible:outline-purple-300">
                <TwIcon Icon="IconEnum.Discord" Plain /> @Loc.Text("Home_Community_Join", "Join the Discord")
            </DiscordInviteLink>
        </div>
    </section>

    <!-- CTA -->
    <section class="reveal mx-auto max-w-6xl px-6 pt-16 md:pt-24">
        <div class="relative isolate animate-gradient-pan overflow-hidden rounded-2xl bg-linear-to-r from-purple-700 via-fuchsia-700 to-purple-700 bg-size-[200%_auto] px-6 py-10 text-white shadow-xl shadow-purple-900/10 dark:shadow-black/30 motion-reduce:animate-none md:px-10">
            <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-24 -z-10 size-72 rounded-full bg-white/10 blur-2xl"></div>
            <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-white"><Loc Key="Home_Cta_Heading">Ready to build something great?</Loc></h2>
                    <p class="mt-1 max-w-xl text-white"><Loc Key="Home_Cta_Sub">Start with the docs.</Loc></p>
                </div>
                <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
                    <a id="cta-get-started" href="/get-started" class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-white px-5 py-2.5 font-semibold text-purple-900 transition-colors hover:bg-purple-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto"><TwIcon Icon="IconEnum.Rocket_Takeoff" Plain /> @Loc.Text("Home_GetStarted", "Get started")</a>
                    <a id="cta-github" href="https://github.com/twblazor/twblazor" target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/70 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto"><TwIcon Icon="IconEnum.Github" Plain /> @Loc.Text("Home_Cta_Star", "Star on GitHub")<span class="sr-only"> @Loc.Text("Footer_NewTab", "(opens in a new tab)")</span></a>
                </div>
            </div>
        </div>
    </section>

    <!-- Open source commitment -->
    <section class="mx-auto max-w-6xl px-6 pb-12 pt-8">
        <p class="max-w-2xl text-sm text-gray-700 md:text-base dark:text-gray-400">
            <Loc Key="Home_OpenSource">Free and MIT licensed, always. Built in the open with the community.</Loc>
        </p>
    </section>
</div>

@code {
    /// <summary>
    /// One tab of the showcase: its heading, the live preview and a footer linking to the docs.
    /// </summary>
    private static RenderFragment ShowcasePane(string title, string description, string docsHref, RenderFragment preview) =>
        @<div>
            <div class="min-h-[30rem] p-4 sm:p-6">
                <div class="mb-5">
                    <h3 class="text-lg font-semibold text-gray-950 dark:text-white">@title</h3>
                    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">@description</p>
                </div>
                @preview
            </div>
            <div class="flex flex-col gap-3 rounded-b-2xl border-t border-purple-200/70 bg-purple-50/50 px-4 py-3 text-sm sm:flex-row sm:items-center sm:justify-between dark:border-white/10 dark:bg-white/[0.03]">
                <p class="text-gray-600 dark:text-gray-400"><Loc Key="Home_Feature_Composable_Body">Plain Blazor parameters. No surprises.</Loc></p>
                <a id="showcase-docs" href="@docsHref" class="@showcaseFooterButtonClasses">
                    <Loc Key="Home_Showcase_Docs">Open docs</Loc>
                    <TwIcon Icon="IconEnum.Arrow_Up_Right" Plain Class="rtl:-scale-x-100" />
                </a>
            </div>
        </div>;
}
