@page "/"
@layout LandingLayout
@using IconEnum = TwBlazor.Enums.Icon

<PageSeo Title="twblazor | Tailwind Blazor Component Library" Description="twblazor is a free, open-source Blazor components library built on Tailwind CSS. Accessible, themeable, with dark mode, for Server and WebAssembly." Path="/" JsonLd="_jsonLd" />

<!-- Hero -->
<section class="relative isolate overflow-hidden border-b border-purple-200/60 bg-white dark:border-white/10 dark:bg-gray-950">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgb(168_85_247/0.12)_1px,transparent_1px),linear-gradient(to_bottom,rgb(168_85_247/0.12)_1px,transparent_1px)] bg-[size:3rem_3rem] [mask-image:radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)] dark:bg-[linear-gradient(to_right,rgb(168_85_247/0.18)_1px,transparent_1px),linear-gradient(to_bottom,rgb(168_85_247/0.18)_1px,transparent_1px)]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-0 -z-10 h-80 w-[56rem] max-w-full -translate-x-1/2 rounded-full bg-linear-to-r from-purple-500/30 via-fuchsia-500/30 to-pink-400/30 blur-3xl dark:from-purple-600/30 dark:via-fuchsia-600/25 dark:to-pink-500/20"></div>

    <div class="mx-auto max-w-6xl px-6 pb-14 pt-14 md:pb-20 md:pt-20">
        <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
            <a href="/get-started" class="inline-flex items-center gap-2 rounded-full border border-purple-200 bg-white/80 px-3 py-1 text-sm font-medium text-purple-800 shadow-xs transition-colors hover:border-fuchsia-400 hover:text-fuchsia-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:border-purple-500/30 dark:bg-purple-500/10 dark:text-purple-200 dark:hover:border-fuchsia-400">
                <span class="size-1.5 rounded-full bg-fuchsia-500" aria-hidden="true"></span>
                Free, open source and MIT licensed
            </a>
            <h1 class="mt-6 text-4xl font-bold leading-[1.05] tracking-tight text-balance text-gray-950 sm:text-5xl md:text-6xl dark:text-white">
                The Tailwind CSS component library for Blazor
            </h1>
            <p class="mt-5 max-w-xl text-lg/7 text-gray-600 text-pretty dark:text-gray-300">
                Accessible, themeable components for Blazor Server and WebAssembly.
                Ship polished UI without wrestling with CSS.
            </p>

            <div class="mt-8 flex w-full flex-col justify-center gap-3 sm:w-auto sm:flex-row">
                <TwButton Id="get-started" Class="w-full justify-center sm:w-auto" Color="Color.Primary" Label="Get started" StartIcon="IconEnum.Rocket_Takeoff" Href="/get-started" />
                <TwButton Id="github" Class="w-full justify-center sm:w-auto" Color="Color.Accent" Variant="ButtonVariant.Outlined" Label="View on GitHub" StartIcon="IconEnum.Github" Href="https://github.com/twblazor/twblazor" Target="_blank" rel="noopener noreferrer" />
            </div>

            <TwCodeBlock Language="pwsh" Content="@quickStartInstall" Class="mt-8 w-full max-w-md text-left" Title="Install" />
        </div>

        <div class="relative mx-auto mt-14 max-w-4xl">
            <div aria-hidden="true" class="absolute -inset-x-4 -inset-y-4 -z-10 rounded-3xl bg-linear-to-br from-purple-500/25 via-fuchsia-500/20 to-pink-400/25 blur-2xl"></div>
            <div class="rounded-2xl border border-purple-200/80 bg-white/70 p-2 shadow-2xl shadow-purple-900/10 backdrop-blur dark:border-white/10 dark:bg-white/5">
                <TwCard Title="Components" Shadow="Shadow.None" Class="rounded-xl">
                    <div class="mt-3">
                        <TwDataTable TItem="ComponentInfo" Items="catalog" Columns="catalogColumns" Searchable Pageable RowsPerPage="5" SearchPlaceholder="Search components…">
                            <EmptyContent>
                                <div class="py-8 text-center">
                                    <p class="text-gray-500 dark:text-gray-400">No components found.</p>
                                </div>
                            </EmptyContent>
                        </TwDataTable>
                    </div>
                </TwCard>
            </div>
        </div>
    </div>
</section>

<div class="text-gray-950 dark:text-white">

    <!-- Features -->
    <section class="bg-linear-to-b from-purple-50 to-fuchsia-50/60 dark:from-purple-950/30 dark:to-fuchsia-950/20" aria-labelledby="features-heading">
        <div class="mx-auto max-w-6xl px-6 py-14 md:py-20">
            <h2 id="features-heading" class="text-2xl font-bold tracking-tight text-purple-900 md:text-3xl dark:text-white">Why twblazor?</h2>
            <p class="mt-2 max-w-xl text-gray-700 dark:text-gray-400">
                Everything you need to build clean, consistent interfaces.
            </p>

            <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <TwCard Shadow="Shadow.None" Class="border border-purple-200/70 transition-colors hover:border-fuchsia-400 dark:border-white/10">
                <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-purple-600 to-purple-500 text-xl text-white shadow-lg shadow-purple-500/30"><TwIcon Icon="IconEnum.Lightning_Charge_Fill" Plain /></span>
                <h3 class="mt-4 text-lg font-semibold text-purple-900 dark:text-white">Fast to build</h3>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">25+ ready-made components mean you're shipping features, not fighting CSS.</p>
            </TwCard>
            <TwCard Shadow="Shadow.None" Class="border border-purple-200/70 transition-colors hover:border-fuchsia-400 dark:border-white/10">
                <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-fuchsia-600 to-pink-500 text-xl text-white shadow-lg shadow-fuchsia-500/30"><TwIcon Icon="IconEnum.Palette_Fill" Plain /></span>
                <h3 class="mt-4 text-lg font-semibold text-purple-900 dark:text-white">Fully customisable</h3>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Tailwind-powered styling that adapts to your brand, in light and dark mode.</p>
            </TwCard>
            <TwCard Shadow="Shadow.None" Class="border border-purple-200/70 transition-colors hover:border-fuchsia-400 dark:border-white/10">
                <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-indigo-600 to-purple-500 text-xl text-white shadow-lg shadow-indigo-500/30"><TwIcon Icon="IconEnum.Puzzle_Fill" Plain /></span>
                <h3 class="mt-4 text-lg font-semibold text-purple-900 dark:text-white">Composable</h3>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Simple, parameter-driven APIs that feel natural if you already know Blazor.</p>
            </TwCard>
            <TwCard Shadow="Shadow.None" Class="border border-purple-200/70 transition-colors hover:border-fuchsia-400 dark:border-white/10">
                <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-pink-600 to-fuchsia-500 text-xl text-white shadow-lg shadow-pink-500/30"><TwIcon Icon="IconEnum.Shield_Check" Plain /></span>
                <h3 class="mt-4 text-lg font-semibold text-purple-900 dark:text-white">Accessible by default</h3>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Sensible ARIA attributes and keyboard support baked into every component.</p>
            </TwCard>
            </div>
        </div>
    </section>

    <!-- Guides -->
    <section class="mx-auto max-w-6xl px-6 pt-14 md:pt-20" aria-labelledby="guides-heading">
        <h2 id="guides-heading" class="text-2xl font-bold tracking-tight text-purple-900 md:text-3xl dark:text-white">Tailwind and Blazor, working together</h2>
        <p class="mt-2 max-w-2xl text-gray-700 dark:text-gray-400">
            twblazor is a Blazor components library for teams who already use Tailwind CSS.
        </p>

        <div class="mt-8 grid grid-cols-1 gap-4 md:grid-cols-3">
            <a href="/tailwind-blazor" class="flex items-start gap-4 rounded-xl border border-purple-200 bg-white p-5 transition-colors hover:border-purple-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:border-purple-900 dark:bg-gray-900 dark:hover:border-purple-400">
                <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-purple-100 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Wind" Plain /></span>
                <span>
                    <span class="block font-semibold text-purple-900 dark:text-white">Tailwind CSS with Blazor</span>
                    <span class="mt-1 block text-sm text-gray-600 dark:text-gray-400">How Tailwind finds your classes and how twblazor themes them.</span>
                </span>
            </a>
            <a href="/blazor-component-library-comparison" class="flex items-start gap-4 rounded-xl border border-fuchsia-200 bg-white p-5 transition-colors hover:border-fuchsia-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-fuchsia-600 dark:border-fuchsia-900 dark:bg-gray-900 dark:hover:border-fuchsia-400">
                <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-fuchsia-100 text-xl text-fuchsia-700 dark:bg-fuchsia-500/15 dark:text-fuchsia-300"><TwIcon Icon="IconEnum.Layers_Fill" Plain /></span>
                <span>
                    <span class="block font-semibold text-purple-900 dark:text-white">Blazor component library comparison</span>
                    <span class="mt-1 block text-sm text-gray-600 dark:text-gray-400">See how twblazor compares with MudBlazor, Radzen and others.</span>
                </span>
            </a>
            <a href="/get-started" class="flex items-start gap-4 rounded-xl border border-purple-200 bg-white p-5 transition-colors hover:border-purple-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:border-purple-900 dark:bg-gray-900 dark:hover:border-purple-400">
                <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-purple-100 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Rocket_Takeoff" Plain /></span>
                <span>
                    <span class="block font-semibold text-purple-900 dark:text-white">Install guide</span>
                    <span class="mt-1 block text-sm text-gray-600 dark:text-gray-400">Add the package to a Server or WebAssembly app in nine steps.</span>
                </span>
            </a>
        </div>
    </section>

    <!-- Showcase -->
    <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24" aria-labelledby="examples-heading">
        <h2 id="examples-heading" class="text-2xl font-bold tracking-tight text-purple-900 md:text-3xl dark:text-white">Real components. Ready for your app.</h2>
        <p class="mt-2 max-w-xl text-gray-700 dark:text-gray-400">
            Go ahead and try them. Every example here is a live twblazor component.
        </p>

        <div class="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-2 lg:items-start">
            <div class="flex flex-col gap-4">
                <TwCard Title="Sign in">
                    <form class="mt-3 flex flex-col gap-4" @onsubmit="SignIn" @onsubmit:preventDefault>
                        <TwTextfield Label="Email" @bind-Value="signInEmail" InputType="email" Placeholder="you@example.com" />
                        <TwTextfield Label="Password" @bind-Value="signInPassword" InputType="password" Placeholder="Enter your password" />
                        <TwCheckbox T="bool" @bind-Value="rememberMe" Label="Remember me" />
                        <TwButton Type="submit" Class="w-full justify-center" Color="Color.Primary" Label="Sign in" />
                    </form>
                </TwCard>
            </div>

            <TwCard Title="Checkout stepper">
                <div class="mt-3">
                    <TwStepper @ref="checkoutStepper" @bind-ActiveStepIndex="checkoutStep" AriaLabel="Checkout progress">
                        <TwStep Label="Account" Description="Create your login">
                            <TwTextfield Label="Email" @bind-Value="email" Placeholder="Enter your email address" AriaLabel="Email" />
                        </TwStep>
                        <TwStep Label="Preferences" Description="Tune your setup">
                            <TwSwitch @bind-Value="notificationsEnabled" Label="Email notifications" AriaLabel="Toggle notifications" Color="Color.Primary" />
                        </TwStep>
                        <TwStep Label="Done" Description="All set">
                            <p class="text-sm">Thanks, you're ready to go.</p>
                        </TwStep>
                    </TwStepper>
                    <div class="mt-4 flex gap-2">
                        <TwButton Label="Back" Variant="ButtonVariant.Outlined" Color="Color.Primary" Disabled="@(checkoutStep <= 0)" OnClick="@(async () => { if (checkoutStepper is not null) await checkoutStepper.PreviousStep(); })" />
                        <TwButton Label="Next" Variant="ButtonVariant.Filled" Color="Color.Primary" Disabled="@(checkoutStep >= 2)" OnClick="@(async () => { if (checkoutStepper is not null) await checkoutStepper.NextStep(); })" />
                    </div>
                </div>
            </TwCard>

        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2 lg:items-start">
            <TwCard>
                <div class="flex items-center gap-3">
                    <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-purple-50 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Gear_Fill" Plain /></span>
                    <div>
                        <h3 class="font-semibold text-gray-950 dark:text-white">Project settings</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Manage how your team ships</p>
                    </div>
                </div>

                <form class="mt-5 flex flex-col gap-5" @onsubmit="SaveSettings" @onsubmit:preventDefault>
                    <TwTextfield Label="Project name" @bind-Value="projectName" />

                    <TwRadioGroup T="string" Legend="Visibility" Name="visibility" Horizontal>
                        <TwRadioButton Value="@("private")" Label="Private" @bind-SelectedValue="visibility" />
                        <TwRadioButton Value="@("team")" Label="Team" @bind-SelectedValue="visibility" />
                        <TwRadioButton Value="@("public")" Label="Public" @bind-SelectedValue="visibility" />
                    </TwRadioGroup>

                    <TwSelect T="string" Label="Environment" Values="environments" @bind-SelectedValue="environment" Required />

                    <div class="flex flex-col gap-3">
                        <TwSwitch @bind-Value="emailAlerts" Label="Email alerts" AriaLabel="Email alerts" />
                        <TwSwitch @bind-Value="autoDeploy" Label="Deploy on push" AriaLabel="Deploy on push" />
                    </div>

                    <div>
                        <div class="mb-2 flex items-baseline justify-between text-sm">
                            <span class="font-medium text-gray-950 dark:text-white">Storage used</span>
                            <span class="tabular-nums text-gray-600 dark:text-gray-400">7.2 of 10 GB</span>
                        </div>
                        <TwProgress Value="72" Max="100" Color="Color.Primary" AriaLabel="Storage used" />
                    </div>

                    @if (settingsSaved)
                    {
                        <TwAlert Dense Color="Color.Success" StartIcon="IconEnum.Check_Circle">Settings saved.</TwAlert>
                    }

                    <div class="flex justify-end gap-2 border-t border-gray-200 pt-4 dark:border-gray-800">
                        <TwButton Type="button" Label="Reset" Variant="ButtonVariant.Outlined" Color="Color.Primary" OnClick="ResetSettings" />
                        <TwButton Type="submit" Label="Save changes" Color="Color.Primary" />
                    </div>
                </form>
            </TwCard>

            <TwCard>
                <div class="flex items-center justify-between gap-3">
                    <h3 class="font-semibold text-gray-950 dark:text-white">Release health</h3>
                    <TwChip Label="v2.4.0" Color="Color.Success" Variant="ButtonVariant.Filled" Size="ChipSize.Small" StartIcon="IconEnum.Check" />
                </div>

                <TwAlert Dense Color="Color.Accent" StartIcon="IconEnum.Exclamation_Circle" Class="mt-4">Storage nearing capacity.</TwAlert>

                <dl class="mt-5 grid grid-cols-3 divide-x divide-gray-200 text-center dark:divide-gray-800">
                    @foreach (var figure in releaseFigures)
                    {
                        <div class="px-2">
                            <dd class="text-2xl font-bold tabular-nums text-gray-950 dark:text-white">@figure.Value</dd>
                            <dt class="text-sm text-gray-600 dark:text-gray-400">@figure.Label</dt>
                        </div>
                    }
                </dl>

                <h4 class="mt-6 text-sm font-medium text-gray-950 dark:text-white">Services</h4>
                <ul class="mt-2 divide-y divide-gray-200 dark:divide-gray-800">
                    @foreach (var service in services)
                    {
                        <li class="grid grid-cols-[minmax(0,1fr)_5rem_6.5rem] items-center gap-3 py-3 text-sm">
                            <span class="min-w-0">
                                <span class="block truncate font-medium text-gray-950 dark:text-white">@service.Name</span>
                                <span class="block text-xs tabular-nums text-gray-600 dark:text-gray-400">@service.Uptime.ToString("0.0")% uptime</span>
                            </span>
                            <TwProgress Value="@service.Uptime" Max="@(100d)" Size="ProgressSize.Small" Color="@service.Color" AriaLabel="@($"{service.Name} uptime")" />
                            <span class="justify-self-end"><TwChip Label="@service.Status" Color="@service.Color" Variant="ButtonVariant.Outlined" Size="ChipSize.Small" /></span>
                        </li>
                    }
                </ul>
            </TwCard>
        </div>
    </section>

    <!-- Theming -->
    <section class="mt-16 bg-purple-950 text-white md:mt-24" aria-labelledby="theming-heading">
        <div class="relative isolate overflow-hidden">
            <div aria-hidden="true" class="pointer-events-none absolute -right-32 -top-32 -z-10 size-[30rem] rounded-full bg-fuchsia-600/25 blur-3xl"></div>
            <div class="mx-auto max-w-6xl px-6 py-14 md:py-20">
                <h2 id="theming-heading" class="max-w-2xl text-2xl font-bold tracking-tight text-white text-balance md:text-3xl">The deepest Tailwind theming of any Blazor library</h2>
                <p class="mt-2 max-w-2xl text-purple-200">
                    twblazor is the first and only Tailwind CSS component library for Blazor built
                    around full, typed, component-level theming. Every visual detail of every component is a
                    plain Tailwind class you own and can override, not a black box baked into a compiled DLL.
                </p>

                <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
                    <dl class="flex flex-col justify-between gap-4">
                <div class="flex items-start gap-4">
                    <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-fuchsia-500 to-purple-500 text-xl text-white shadow-lg shadow-fuchsia-500/20"><TwIcon Icon="IconEnum.Braces" Plain /></span>
                    <div>
                        <dt class="font-semibold text-white">Every class, typed and overridable</dt>
                        <dd class="mt-1 text-sm text-purple-200">Each component has its own C# theme class, like <code>TwButtonTheme</code>, with every class exposed as a named property.</dd>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-fuchsia-500 to-purple-500 text-xl text-white shadow-lg shadow-fuchsia-500/20"><TwIcon Icon="IconEnum.Layers_Fill" Plain /></span>
                    <div>
                        <dt class="font-semibold text-white">Reusable design tokens</dt>
                        <dd class="mt-1 text-sm text-purple-200">Set a color or shade once and every component stays in sync.</dd>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-fuchsia-500 to-purple-500 text-xl text-white shadow-lg shadow-fuchsia-500/20"><TwIcon Icon="IconEnum.Sliders" Plain /></span>
                    <div>
                        <dt class="font-semibold text-white">Global defaults, local overrides</dt>
                        <dd class="mt-1 text-sm text-purple-200">Set a default once, and any single instance can still override it.</dd>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-fuchsia-500 to-purple-500 text-xl text-white shadow-lg shadow-fuchsia-500/20"><TwIcon Icon="IconEnum.Wind" Plain /></span>
                    <div>
                        <dt class="font-semibold text-white">Real Tailwind, real JIT</dt>
                        <dd class="mt-1 text-sm text-purple-200">Themes are plain C# string literals, so Tailwind always sees them. No safelists or build workarounds.</dd>
                    </div>
                </div>
                    </dl>

                    <div class="min-w-0">
                        <TwCodeBlock Language="csharp" Content="@themingSnippet" />
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Quick start -->
    <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24" aria-labelledby="quickstart-heading">
        <h2 id="quickstart-heading" class="text-2xl font-bold tracking-tight text-purple-900 md:text-3xl dark:text-white">Up and running in minutes</h2>
        <p class="mt-2 max-w-xl text-gray-700 dark:text-gray-400">
            Install the package, register the services, start dropping in components.
        </p>

        <div class="mt-8 max-w-2xl">
            <TwCodeBlock Language="html" Content="@quickStartSnippet" />
        </div>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24">
        <div class="relative isolate overflow-hidden rounded-2xl bg-linear-to-r from-purple-700 via-purple-600 to-fuchsia-600 px-6 py-10 text-white shadow-xl shadow-purple-900/20 md:px-10">
            <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-24 -z-10 size-72 rounded-full bg-white/10 blur-2xl"></div>
            <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-white">Ready to build something great?</h2>
                    <p class="mt-1 max-w-xl text-white">
                        Jump into the docs and start assembling your UI with twblazor components.
                    </p>
                </div>
                <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
                    <a id="cta-get-started" href="/get-started" class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-white px-5 py-2.5 font-semibold text-purple-900 transition-colors hover:bg-purple-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto"><TwIcon Icon="IconEnum.Rocket_Takeoff" Plain /> Get started</a>
                    <a id="cta-github" href="https://github.com/twblazor/twblazor" target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/70 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto"><TwIcon Icon="IconEnum.Github" Plain /> Star on GitHub<span class="sr-only"> (opens in a new tab)</span></a>
                </div>
            </div>
        </div>
    </section>

    <!-- Open source commitment -->
    <section class="mx-auto max-w-6xl px-6 pb-12 pt-8">
        <p class="max-w-2xl text-sm text-gray-700 md:text-base dark:text-gray-400">
            twblazor is and always will be free and open source. We believe great tooling
            should be accessible to every developer, so the library is released under the MIT
            license and built in the open, with contributions from the community.
        </p>
    </section>
</div>

@code {
    private static readonly IReadOnlyList<string> _jsonLd = [TwBlazor.Docs.Services.SiteMetadata.HomeJsonLd()];

    private string email = string.Empty;
    private bool notificationsEnabled = true;

    private TwStepper? checkoutStepper;
    private int checkoutStep;

    private string signInEmail = string.Empty;
    private string signInPassword = string.Empty;
    private bool rememberMe = true;

    private readonly List<ComponentInfo> catalog =
    [
        new() { Name = "Button", Category = "Inputs", Status = "Stable" },
        new() { Name = "Data table", Category = "Data display", Status = "Stable" },
        new() { Name = "Date picker", Category = "Inputs", Status = "Stable" },
        new() { Name = "Dialog", Category = "Overlays", Status = "Stable" },
        new() { Name = "Stepper", Category = "Navigation", Status = "Stable" },
        new() { Name = "Carousel", Category = "Data display", Status = "New" },
