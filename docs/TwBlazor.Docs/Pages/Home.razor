@page "/"
@layout LandingLayout
@using IconEnum = TwBlazor.Enums.Icon
@using TwBlazor.Docs.Pages.Showcase.Shared

<PageSeo Title="twblazor | Tailwind Blazor Component Library" Description="twblazor is a free, open-source Blazor components library built on Tailwind CSS. Accessible, themeable, with dark mode, for Server and WebAssembly." Path="/" JsonLd="_jsonLd" />

<!-- Hero -->
<section class="relative isolate overflow-hidden border-b border-purple-200/60 bg-white dark:border-white/10 dark:bg-gray-950">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgb(168_85_247/0.12)_1px,transparent_1px),linear-gradient(to_bottom,rgb(168_85_247/0.12)_1px,transparent_1px)] bg-size-[3rem_3rem] mask-[radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)] dark:bg-[linear-gradient(to_right,rgb(168_85_247/0.18)_1px,transparent_1px),linear-gradient(to_bottom,rgb(168_85_247/0.18)_1px,transparent_1px)]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-0 -z-10 h-80 w-4xl max-w-full -translate-x-1/2">
        <div class="size-full animate-glow-drift rounded-full bg-linear-to-r from-purple-500/30 via-fuchsia-500/30 to-pink-400/30 blur-3xl motion-reduce:animate-none dark:from-purple-600/30 dark:via-fuchsia-600/25 dark:to-pink-500/20"></div>
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 top-24 -z-10 size-72 md:size-96">
        <div class="size-full animate-glow-drift-alt rounded-full bg-fuchsia-400/20 blur-3xl motion-reduce:animate-none dark:bg-fuchsia-600/15"></div>
    </div>

    <div class="mx-auto max-w-6xl px-6 pb-16 pt-16 md:pb-24 md:pt-24">
        <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
            <a href="/get-started" class="inline-flex animate-fade-up items-center gap-2 rounded-full border border-purple-200 bg-white/80 px-3 py-1 text-sm font-medium text-purple-800 shadow-xs transition-colors hover:border-fuchsia-400 hover:text-fuchsia-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 motion-reduce:animate-none dark:focus-visible:outline-purple-300 dark:border-purple-500/30 dark:bg-purple-500/10 dark:text-purple-200 dark:hover:border-fuchsia-400">
                <span class="relative flex size-1.5" aria-hidden="true">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-fuchsia-400 opacity-75 motion-reduce:hidden"></span>
                    <span class="relative inline-flex size-1.5 rounded-full bg-fuchsia-500"></span>
                </span>
                <Loc Key="Home_Hero_Badge">Free, open source and MIT licensed</Loc>
            </a>
            @* Kept on one line: the words are separate spans, and line breaks between them would change the heading's text. *@
            @if (_heroWords is null)
            {
            <h1 dir="auto" class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-balance text-gray-950 perspective-[900px] sm:text-5xl md:text-6xl dark:text-white"><span class="@heroWordClasses [animation-delay:100ms]">The</span> <span class="@heroWordClasses [animation-delay:180ms]">Tailwind</span> <span class="@heroWordClasses [animation-delay:260ms]">CSS</span> <span class="@heroWordClasses [animation-delay:340ms]">component</span> <span class="@heroWordClasses [animation-delay:420ms]">library</span> <span class="@heroWordClasses [animation-delay:500ms]"><span class="animate-gradient-pan bg-linear-to-r from-purple-700 via-fuchsia-600 to-purple-700 bg-size-[200%_auto] bg-clip-text text-transparent motion-reduce:animate-none dark:from-purple-400 dark:via-fuchsia-300 dark:to-purple-400">for Blazor</span></span></h1>
            }
            else
            {
                @* A translated heading: its words rise in turn like the English one, delayed inline because the delay classes above are written out for the English words only. *@
                <h1 dir="auto" class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-balance text-gray-950 perspective-[900px] sm:text-5xl md:text-6xl dark:text-white">@for (var i = 0; i < _heroWords.Length; i++) { <span class="@heroWordClasses" style="@($"animation-delay:{100 + i * 80}ms")">@_heroWords[i]</span><text> </text> }<span class="@heroWordClasses" style="@($"animation-delay:{100 + _heroWords.Length * 80}ms")"><span class="animate-gradient-pan bg-linear-to-r from-purple-700 via-fuchsia-600 to-purple-700 bg-size-[200%_auto] bg-clip-text text-transparent motion-reduce:animate-none dark:from-purple-400 dark:via-fuchsia-300 dark:to-purple-400">@Loc.Text("Home_Hero_TitleAccent", "for Blazor")</span></span></h1>
            }
            <p class="mt-5 max-w-xl animate-fade-up text-lg/7 text-gray-600 text-pretty [animation-delay:650ms] motion-reduce:animate-none dark:text-gray-300">
                <Loc Key="Home_Hero_Subtitle">Accessible, themeable components for Blazor Server and WebAssembly.</Loc>
            </p>

            <div class="mt-8 flex w-full animate-fade-up flex-col justify-center gap-3 [animation-delay:750ms] motion-reduce:animate-none sm:w-auto sm:flex-row">
                <TwButton Id="get-started" Class="w-full justify-center sm:w-auto" Color="Color.Primary" Label="@Loc.Text("Home_GetStarted", "Get started")" StartIcon="IconEnum.Rocket_Takeoff" Href="/get-started" />
                <TwButton Id="github" Class="w-full justify-center sm:w-auto" Color="Color.Accent" Variant="ButtonVariant.Outlined" Label="@Loc.Text("Home_Hero_GitHub", "View on GitHub")" StartIcon="IconEnum.Github" Href="https://github.com/twblazor/twblazor" Target="_blank" rel="noopener noreferrer" />
            </div>

            <div class="mt-8 w-full max-w-md animate-fade-up [animation-delay:850ms] motion-reduce:animate-none">
                @* The beam is a conic gradient behind a 1px gap around the code block; its start angle turns. *@
                <div class="animate-beam rounded-[calc(var(--radius-xl)+1px)] bg-[conic-gradient(from_var(--beam-angle),rgb(168_85_247/0.25)_0%,rgb(168_85_247/0.25)_65%,var(--color-fuchsia-500)_80%,var(--color-purple-500)_90%,rgb(168_85_247/0.25)_100%)] p-px shadow-xl shadow-purple-500/15 [animation-delay:1.6s] motion-reduce:animate-none">
                    <TwCodeBlock Language="pwsh" Content="@quickStartInstall" Class="w-full rounded-xl text-left" PanelClass="rounded-lg" Title="@Loc.Text("Home_Hero_Install", "Install")" />
                </div>
            </div>
        </div>

        <!-- Live build: markup types out and each component springs into the preview -->
        <figure class="mx-auto mt-14 w-full max-w-4xl animate-fade-up [animation-delay:1s] motion-reduce:animate-none" aria-labelledby="live-build-caption">
            <figcaption id="live-build-caption" class="sr-only"><Loc Key="Home_Live_Caption">Four lines of twblazor markup and the live components they render.</Loc></figcaption>
            <div @key="liveBuildRun" data-stage style="--stage-delay:1.6s" class="grid overflow-hidden rounded-2xl border border-purple-200/70 bg-white/80 text-left shadow-2xl shadow-purple-500/15 backdrop-blur md:grid-cols-2 dark:border-white/10 dark:bg-gray-900/80">
                <div class="bg-gray-950 p-5 font-mono text-[13px] leading-7 text-gray-300">
                    <div class="mb-3 flex items-center gap-2" aria-hidden="true">
                        <span class="size-3 rounded-full bg-red-400/80"></span>
                        <span class="size-3 rounded-full bg-amber-400/80"></span>
                        <span class="size-3 rounded-full bg-green-400/80"></span>
                        <span class="ms-3 text-xs text-gray-400">Deploy.razor</span>
                    </div>
                    <pre class="overflow-x-auto"><code><span class="stage-line block" style="--i:0"><span class="text-fuchsia-300">&lt;TwButton</span> <span class="text-sky-300">Color</span>=<span class="text-emerald-300">"Primary"</span> <span class="text-sky-300">Label</span>=<span class="text-emerald-300">"Deploy"</span> <span class="text-fuchsia-300">/&gt;</span></span><span class="stage-line block" style="--i:1"><span class="text-fuchsia-300">&lt;TwSwitch</span> <span class="text-sky-300">Label</span>=<span class="text-emerald-300">"Auto deploy"</span> <span class="text-fuchsia-300">/&gt;</span></span><span class="stage-line block" style="--i:2"><span class="text-fuchsia-300">&lt;TwChip</span> <span class="text-sky-300">Label</span>=<span class="text-emerald-300">"Healthy"</span> <span class="text-sky-300">Color</span>=<span class="text-emerald-300">"Success"</span> <span class="text-fuchsia-300">/&gt;</span></span><span class="stage-line block" style="--i:3"><span class="text-fuchsia-300">&lt;TwProgress</span> <span class="text-sky-300">Value</span>=<span class="text-emerald-300">"@@progress"</span> <span class="text-fuchsia-300">/&gt;</span><span class="stage-caret ms-0.5 inline-block h-4 w-2 translate-y-0.5 bg-fuchsia-400" aria-hidden="true"></span></span></code></pre>
                </div>

                <div class="flex flex-col gap-5 p-6">
                    <div class="flex items-center justify-between gap-3">
                        <span class="text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400"><Loc Key="Home_Preview">Preview</Loc></span>
                        <span class="stage-done inline-flex items-center gap-1.5 rounded-full bg-green-50 px-2.5 py-0.5 text-xs font-medium text-green-800 dark:bg-green-500/15 dark:text-green-300" style="--i:4">
                            <TwIcon Icon="IconEnum.Check_Circle_Fill" Plain />
                            <Loc Key="Home_Live_Rendered">4 components rendered</Loc>
                        </span>
                    </div>
                    <div class="stage-pop w-fit" style="--i:0">
                        <TwButton Color="Color.Primary" Label="@(liveBuildDeployed ? "Deployed" : "Deploy")" StartIcon="IconEnum.Rocket_Takeoff" OnClick="Deploy" Disabled="liveBuildDeployed" />
                    </div>
                    <div class="stage-pop w-fit" style="--i:1">
                        <TwSwitch @bind-Value="liveBuildAutoDeploy" Label="Auto deploy" />
                    </div>
                    <div class="stage-pop w-fit" style="--i:2">
                        <TwChip Label="@(liveBuildDeployed ? "Deployed" : "Healthy")" Color="Color.Success" StartIcon="IconEnum.Check" Size="ChipSize.Small" />
                    </div>
                    <div class="stage-pop" style="--i:3">
                        <TwProgress Value="@liveBuildProgress" Max="100" Color="Color.Primary" AriaLabel="Deploy progress" />
                    </div>
                    <button type="button" id="live-build-replay" class="mt-auto inline-flex w-fit cursor-pointer items-center gap-1.5 rounded-md text-sm font-medium text-purple-800 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 motion-reduce:hidden dark:text-purple-300 dark:focus-visible:outline-purple-300" @onclick="ReplayLiveBuild">
                        <TwIcon Icon="IconEnum.Arrow_Repeat" Plain />
                        <Loc Key="Home_Live_Replay">Replay</Loc><span class="sr-only"> @Loc.Text("Home_Live_ReplayTarget", "the live build")</span>
                    </button>
                </div>
            </div>
        </figure>
    </div>
</section>

<div class="text-gray-950 dark:text-white">

    <!-- Features -->
    <section class="bg-linear-to-b from-purple-50 to-fuchsia-50/60 dark:from-purple-950/30 dark:to-fuchsia-950/20" aria-labelledby="features-heading">
        <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
            <div class="reveal flex flex-wrap items-end justify-between gap-4">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-wide text-fuchsia-700 dark:text-fuchsia-300"><Loc Key="Home_Why_Title">Why twblazor?</Loc></p>
                    <h2 id="features-heading" class="mt-2 text-3xl font-bold leading-[1.3] tracking-tight text-purple-900 md:text-4xl dark:text-white">
                        <span class="sr-only">@Loc.Format("Home_Features_HeadingFull", "Built for your next {0} or {1}.", string.Join(", ", _cycleWords.Take(_cycleWords.Count - 1)), _cycleWords[^1])</span>
                        <span aria-hidden="true">@Loc.Text("Home_Features_HeadingLead", "Built for your next") <span class="@(wordCyclePaused ? "word-cycle is-paused" : "word-cycle")"><span class="word-cycle-track">@foreach (var word in _cycleWords){<span class="bg-linear-to-r from-purple-700 to-fuchsia-600 bg-clip-text text-transparent dark:from-purple-300 dark:to-fuchsia-300">@(word).</span>}<span class="bg-linear-to-r from-purple-700 to-fuchsia-600 bg-clip-text text-transparent dark:from-purple-300 dark:to-fuchsia-300">@(_cycleWords[0]).</span></span></span>@Loc.Text("Home_Features_HeadingTrail", "")</span>
                    </h2>
                </div>
                <button type="button" id="word-cycle-toggle" class="inline-flex size-9 cursor-pointer items-center justify-center rounded-full border border-purple-200 bg-white/80 text-purple-800 transition-colors hover:border-fuchsia-400 hover:text-fuchsia-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 motion-reduce:hidden dark:border-purple-500/30 dark:bg-purple-500/10 dark:text-purple-200 dark:focus-visible:outline-purple-300" aria-label="@(wordCyclePaused ? Loc.Text("Home_Features_Play", "Play the changing heading") : Loc.Text("Home_Features_Pause", "Pause the changing heading"))" @onclick="@(() => wordCyclePaused = !wordCyclePaused)">
                    <TwIcon Icon="@(wordCyclePaused ? IconEnum.Play_Fill : IconEnum.Pause_Fill)" Plain />
                </button>
            </div>

            <div class="reveal-group mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
                <TwCard Shadow="Shadow.None" Class="@featureCardClasses">
                    <span class="@($"{featureIconClasses} from-purple-600 to-purple-500 shadow-purple-500/30")"><TwIcon Icon="IconEnum.Lightning_Charge_Fill" Plain /></span>
                    <h3 class="mt-4 text-lg font-semibold text-purple-900 dark:text-white"><Loc Key="Home_Feature_Fast_Title">Fast to build</Loc></h3>
                    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><Loc Key="Home_Feature_Fast_Body">25+ components, ready to ship.</Loc></p>
                </TwCard>
                <TwCard Shadow="Shadow.None" Class="@featureCardClasses">
                    <span class="@($"{featureIconClasses} from-fuchsia-600 to-pink-500 shadow-fuchsia-500/30")"><TwIcon Icon="IconEnum.Palette_Fill" Plain /></span>
                    <h3 class="mt-4 text-lg font-semibold text-purple-900 dark:text-white"><Loc Key="Home_Feature_Custom_Title">Fully customisable</Loc></h3>
                    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><Loc Key="Home_Feature_Custom_Body">Your brand, in light and dark mode.</Loc></p>
                </TwCard>
                <TwCard Shadow="Shadow.None" Class="@featureCardClasses">
                    <span class="@($"{featureIconClasses} from-indigo-600 to-purple-500 shadow-indigo-500/30")"><TwIcon Icon="IconEnum.Puzzle_Fill" Plain /></span>
                    <h3 class="mt-4 text-lg font-semibold text-purple-900 dark:text-white"><Loc Key="Home_Feature_Composable_Title">Composable</Loc></h3>
                    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><Loc Key="Home_Feature_Composable_Body">Plain Blazor parameters. No surprises.</Loc></p>
                </TwCard>
                <TwCard Shadow="Shadow.None" Class="@featureCardClasses">
                    <span class="@($"{featureIconClasses} from-pink-600 to-fuchsia-500 shadow-pink-500/30")"><TwIcon Icon="IconEnum.Shield_Check" Plain /></span>
                    <h3 class="mt-4 text-lg font-semibold text-purple-900 dark:text-white"><Loc Key="Home_Feature_A11y_Title">Accessible by default</Loc></h3>
                    <p class="mt-1 text-sm text-gray-600 dark:text-gray-400"><Loc Key="Home_Feature_A11y_Body">ARIA and keyboard support built in.</Loc></p>
                </TwCard>
            </div>
        </div>
    </section>

    <!-- Guides -->
    <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24" aria-labelledby="guides-heading">
        <h2 id="guides-heading" class="reveal text-2xl font-bold tracking-tight text-purple-900 md:text-3xl dark:text-white"><Loc Key="Home_Guides_Heading">Tailwind and Blazor, working together</Loc></h2>

        <div class="reveal-group mt-8 grid grid-cols-1 gap-6 md:grid-cols-3">
            <a href="/tailwind-blazor" class="@guideCardClasses">
                <span class="@($"{guideIconClasses} bg-purple-100 text-purple-700 dark:bg-purple-500/15 dark:text-purple-300")"><TwIcon Icon="IconEnum.Wind" Plain /></span>
                <span>
                    <span class="block font-semibold text-purple-900 dark:text-white"><Loc Key="Home_Guides_Tailwind_Title">Tailwind CSS with Blazor</Loc></span>
                    <span class="mt-1 block text-sm text-gray-600 dark:text-gray-400"><Loc Key="Home_Guides_Tailwind">How your classes are found and themed.</Loc></span>
                </span>
            </a>
            <a href="/why-twblazor" class="@guideCardClasses">
                <span class="@($"{guideIconClasses} bg-fuchsia-100 text-fuchsia-700 dark:bg-fuchsia-500/15 dark:text-fuchsia-300")"><TwIcon Icon="IconEnum.Layers_Fill" Plain /></span>
                <span>
                    <span class="block font-semibold text-purple-900 dark:text-white"><Loc Key="Home_Why_Title">Why twblazor?</Loc></span>
                    <span class="mt-1 block text-sm text-gray-600 dark:text-gray-400"><Loc Key="Home_Guides_Why">MIT licensed and Tailwind native.</Loc></span>
                </span>
            </a>
            <a href="/get-started" class="@guideCardClasses">
                <span class="@($"{guideIconClasses} bg-purple-100 text-purple-700 dark:bg-purple-500/15 dark:text-purple-300")"><TwIcon Icon="IconEnum.Rocket_Takeoff" Plain /></span>
                <span>
                    <span class="block font-semibold text-purple-900 dark:text-white"><Loc Key="Home_Guides_Install_Title">Install guide</Loc></span>
                    <span class="mt-1 block text-sm text-gray-600 dark:text-gray-400"><Loc Key="Home_Guides_Install">Server or WebAssembly in nine steps.</Loc></span>
                </span>
            </a>
        </div>
    </section>

    <!-- Showcase -->
    <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24" aria-labelledby="examples-heading">
        <div class="reveal">
            <h2 id="examples-heading" class="text-2xl font-bold tracking-tight text-purple-900 md:text-3xl dark:text-white"><Loc Key="Home_Examples_Heading">Real components. Ready for your app.</Loc></h2>
            <p class="mt-3 max-w-xl text-gray-700 dark:text-gray-400"><Loc Key="Home_Examples_Sub">Every example is live. Try them.</Loc></p>
        </div>

        <div class="reveal-group mt-8 grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-start">
            <div class="flex flex-col gap-6">
                <TwCard Title="@Loc.Text("Home_SignIn", "Sign in")" Class="@cardClasses">
                    <form class="mt-3 flex flex-col gap-4" @onsubmit="SignIn" @onsubmit:preventDefault>
                        <TwTextfield Label="@Loc.Text("Home_Email", "Email")" @bind-Value="signInEmail" InputType="email" Placeholder="you@example.com" />
                        <TwTextfield Label="@Loc.Text("Home_Password", "Password")" @bind-Value="signInPassword" InputType="password" autocomplete="current-password" Placeholder="@Loc.Text("Home_PasswordPlaceholder", "Enter your password")" />
                        <TwCheckbox T="bool" @bind-Value="rememberMe" Label="@Loc.Text("Home_RememberMe", "Remember me")" />
                        <TwButton Type="submit" Class="w-full justify-center" Color="Color.Primary" Label="@Loc.Text("Home_SignIn", "Sign in")" />
                    </form>
                </TwCard>
            </div>

            <TwCard Title="@Loc.Text("Home_Checkout_Title", "Checkout stepper")" Class="@cardClasses">
                <div class="mt-3">
                    <TwStepper @ref="checkoutStepper" @bind-ActiveStepIndex="checkoutStep" AriaLabel="@Loc.Text("Home_Checkout_Progress", "Checkout progress")">
                        <TwStep Label="@Loc.Text("Home_Checkout_Account", "Account")" Description="@Loc.Text("Home_Checkout_AccountDesc", "Create your login")">
                            <TwTextfield Label="@Loc.Text("Home_Email", "Email")" @bind-Value="email" Placeholder="@Loc.Text("Home_EmailPlaceholder", "Enter your email address")" AriaLabel="@Loc.Text("Home_Email", "Email")" />
                        </TwStep>
                        <TwStep Label="@Loc.Text("Home_Checkout_Preferences", "Preferences")" Description="@Loc.Text("Home_Checkout_PreferencesDesc", "Tune your setup")">
                            <TwSwitch @bind-Value="notificationsEnabled" Label="@Loc.Text("Home_Checkout_Notifications", "Email notifications")" Color="Color.Primary" />
                        </TwStep>
                        <TwStep Label="@Loc.Text("Home_Checkout_Done", "Done")" Description="@Loc.Text("Home_Checkout_DoneDesc", "All set")">
                            <p class="text-sm"><Loc Key="Home_Checkout_Thanks">Thanks, you're ready to go.</Loc></p>
                        </TwStep>
                    </TwStepper>
                    <div class="mt-4 flex gap-2">
                        <TwButton Label="@Loc.Text("Home_Back", "Back")" Variant="ButtonVariant.Outlined" Color="Color.Primary" Disabled="@(checkoutStep <= 0)" OnClick="@(async () => { if (checkoutStepper is not null) await checkoutStepper.PreviousStep(); })" />
                        <TwButton Label="@Loc.Text("Home_Next", "Next")" Variant="ButtonVariant.Filled" Color="Color.Primary" Disabled="@(checkoutStep >= 2)" OnClick="@(async () => { if (checkoutStepper is not null) await checkoutStepper.NextStep(); })" />
                    </div>
                </div>
            </TwCard>

        </div>

        <div class="reveal-group mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2 lg:items-start">
            <TwCard Class="@cardClasses">
                <div class="flex items-center gap-3">
                    <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-purple-50 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Gear_Fill" Plain /></span>
                    <div>
                        <h3 class="font-semibold text-gray-950 dark:text-white"><Loc Key="Home_Settings_Title">Project settings</Loc></h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400"><Loc Key="Home_Settings_Sub">Manage how your team ships</Loc></p>
                    </div>
                </div>

                <form class="mt-5 flex flex-col gap-5" @onsubmit="SaveSettings" @onsubmit:preventDefault>
                    <TwTextfield Label="@Loc.Text("Home_Settings_ProjectName", "Project name")" @bind-Value="projectName" />

                    <TwRadioGroup T="string" Legend="@Loc.Text("Home_Settings_Visibility", "Visibility")" Name="visibility" Horizontal>
                        <TwRadioButton Value="@("private")" Label="@Loc.Text("Home_Settings_Private", "Private")" @bind-SelectedValue="visibility" />
                        <TwRadioButton Value="@("team")" Label="@Loc.Text("Home_Settings_Team", "Team")" @bind-SelectedValue="visibility" />
                        <TwRadioButton Value="@("public")" Label="@Loc.Text("Home_Settings_Public", "Public")" @bind-SelectedValue="visibility" />
                    </TwRadioGroup>

                    <TwSelect T="string" Label="@Loc.Text("Home_Settings_Environment", "Environment")" Values="_environments" @bind-SelectedValue="environment" Required />

                    <div class="flex flex-col gap-3">
                        <TwSwitch @bind-Value="emailAlerts" Label="@Loc.Text("Home_Settings_EmailAlerts", "Email alerts")" AriaLabel="@Loc.Text("Home_Settings_EmailAlerts", "Email alerts")" />
                        <TwSwitch @bind-Value="autoDeploy" Label="@Loc.Text("Home_Settings_DeployOnPush", "Deploy on push")" AriaLabel="@Loc.Text("Home_Settings_DeployOnPush", "Deploy on push")" />
                    </div>

                    <div>
                        <div class="mb-2 flex items-baseline justify-between text-sm">
                            <span class="font-medium text-gray-950 dark:text-white"><Loc Key="Home_Settings_Storage">Storage used</Loc></span>
                            <span class="tabular-nums text-gray-600 dark:text-gray-400"><Loc Key="Home_Settings_StorageAmount">7.2 of 10 GB</Loc></span>
                        </div>
                        <TwProgress Value="72" Max="100" Color="Color.Primary" AriaLabel="@Loc.Text("Home_Settings_Storage", "Storage used")" />

                        <TwChart Title="@Loc.Text("Home_Chart_Storage", "Storage by folder")" Description="@Loc.Text("Home_Chart_StorageDesc", "7.2 GB across 10 folders")" Height="ChartHeight.Small" Class="mt-4">
                            <TwTreemapChart Data="@_storageFolders" ValueFormat="0.0 GB" LabelHeader="@Loc.Text("Home_Chart_Folder", "Folder")" ValueHeader="@Loc.Text("Home_Chart_Size", "Size")" />
                        </TwChart>
                    </div>

                    @if (settingsSaved)
                    {
                        <TwAlert Dense Color="Color.Success" StartIcon="IconEnum.Check_Circle"><Loc Key="Home_Settings_Saved">Settings saved.</Loc></TwAlert>
                    }

                    <div class="flex justify-end gap-2 border-t border-gray-200 pt-4 dark:border-gray-800">
                        <TwButton Type="button" Label="@Loc.Text("Home_Settings_Reset", "Reset")" Variant="ButtonVariant.Outlined" Color="Color.Primary" OnClick="ResetSettings" />
                        <TwButton Type="submit" Label="@Loc.Text("Home_SaveChanges", "Save changes")" Color="Color.Primary" />
                    </div>
                </form>
            </TwCard>

            <TwCard Class="@cardClasses">
                <div class="flex items-center justify-between gap-3">
                    <h3 class="font-semibold text-gray-950 dark:text-white"><Loc Key="Home_Release_Title">Release health</Loc></h3>
                    <TwChip Label="v2.4.0" Color="Color.Success" Variant="ButtonVariant.Filled" Size="ChipSize.Small" StartIcon="IconEnum.Check" />
                </div>

                <TwAlert Dense Role="none" Color="Color.Accent" StartIcon="IconEnum.Exclamation_Circle" Class="mt-4"><Loc Key="Home_Release_Storage">Storage nearing capacity.</Loc></TwAlert>

                <dl class="mt-5 grid grid-cols-3 divide-x divide-gray-200 text-center dark:divide-gray-800">
                    @foreach (var figure in _releaseFigures)
                    {
                        <div class="flex flex-col-reverse px-2">
                            <dt class="text-sm text-gray-600 dark:text-gray-400">@figure.Label</dt>
                            <dd class="text-2xl font-bold tabular-nums text-gray-950 dark:text-white">@figure.Value</dd>
                        </div>
                    }
                </dl>

                <div class="mt-6 grid grid-cols-1 gap-6">
                    <TwChart Title="@Loc.Text("Home_Chart_Response", "Response time")" Description="@Loc.Text("Home_Chart_ResponseDesc", "95th percentile, last 24 hours")" Height="ChartHeight.Small" Class="min-w-0">
                        <TwLineChart Categories="@_responseHours" Series="@_responseTimes" Curve="ChartCurve.Smooth" ValueFormat="#,0 ms" CategoryHeader="@Loc.Text("Home_Chart_Hour", "Hour")" />
                    </TwChart>
                    <TwChart Title="@Loc.Text("Home_Chart_Deploys", "Deploys per day")" Description="@Loc.Text("Home_Chart_DeploysDesc", "Last 14 days")" Height="ChartHeight.Small" Class="min-w-0">
                        <TwColumnChart Categories="@_deployDays" Series="@_deploys" Stacking="ChartStacking.Stacked" CategoryHeader="@Loc.Text("Home_Chart_Day", "Day")" />
                    </TwChart>
                </div>
            </TwCard>
        </div>
    </section>

    <!-- Theming -->
    <section class="mt-16 bg-purple-950 text-white md:mt-24" aria-labelledby="theming-heading">
        <div class="relative isolate overflow-hidden">
            <div aria-hidden="true" class="pointer-events-none absolute -right-32 -top-32 -z-10 size-120 rounded-full bg-fuchsia-600/25 blur-3xl"></div>
            <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
                <div class="reveal">
                    <h2 id="theming-heading" class="max-w-2xl text-2xl font-bold tracking-tight text-white text-balance md:text-3xl"><Loc Key="Home_Theming_Heading">The deepest Tailwind theming of any Blazor library</Loc></h2>
                    <p class="mt-3 max-w-2xl text-purple-200">
                        <Loc Key="Home_Theming_Sub">Every visual detail is a plain Tailwind class you own, typed per component. No black box in a DLL.</Loc>
                    </p>
                </div>

                <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-14">
                    <div class="reveal-group flex flex-col justify-between gap-4">
                        @foreach (var point in _themingPoints)
                        {
                            <div class="flex items-start gap-4">
                                <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-fuchsia-500 to-purple-500 text-xl text-white shadow-lg shadow-fuchsia-500/20"><TwIcon Icon="@point.Icon" Plain /></span>
                                <div>
                                    <h3 class="font-semibold text-white">@point.Title</h3>
                                    <p class="mt-1 text-sm text-purple-200">@point.Description</p>
                                </div>
                            </div>
                        }
                    </div>

                    <figure class="reveal min-w-0" aria-labelledby="theme-build-caption">
                        <figcaption id="theme-build-caption" class="sr-only"><Loc Key="Home_Theming_Caption">Three lines of Theme.cs restyling a live button: fully rounded, a large shadow and a new primary colour.</Loc></figcaption>
                        <div data-stage class="overflow-hidden rounded-xl border border-white/10 bg-gray-950 shadow-2xl shadow-fuchsia-950/40">
                            <div class="flex items-center gap-2 px-5 pt-4" aria-hidden="true">
                                <span class="size-3 rounded-full bg-red-400/80"></span>
                                <span class="size-3 rounded-full bg-amber-400/80"></span>
                                <span class="size-3 rounded-full bg-green-400/80"></span>
                                <span class="ms-3 text-xs text-gray-400">Theme.cs</span>
                            </div>
                            <pre class="overflow-x-auto px-5 py-4 font-mono text-[13px] leading-7 text-gray-300"><code><span class="block text-gray-400">// Change the theme, not the component</span><span class="stage-line block" style="--i:0"><span class="text-sky-300">DefaultRounded</span> = <span class="text-fuchsia-300">Rounded</span>.Full,</span><span class="stage-line block" style="--i:1"><span class="text-sky-300">DefaultShadow</span> = <span class="text-fuchsia-300">Shadow</span>.Lg,</span><span class="stage-line block" style="--i:2"><span class="text-sky-300">Primary</span> = <span class="text-emerald-300">"bg-fuchsia-600"</span>,<span class="stage-caret ms-0.5 inline-block h-4 w-2 translate-y-0.5 bg-fuchsia-400" aria-hidden="true"></span></span></code></pre>
                            <div class="flex flex-col items-center gap-4 border-t border-white/10 bg-white/5 px-5 py-10">
                                <TwButton Color="Color.Primary" Label="@Loc.Text("Home_SaveChanges", "Save changes")" StartIcon="IconEnum.Check_Lg" Class="theme-morph" />
                                <span class="stage-done inline-flex items-center gap-1.5 text-xs font-medium text-fuchsia-200" style="--i:2">
                                    <TwIcon Icon="IconEnum.Stars" Plain />
                                    <Loc Key="Home_Theming_Restyled">Restyled from Theme.cs, no CSS</Loc>
                                </span>
                            </div>
                        </div>
                    </figure>
                </div>

                <div id="theme-case-study" class="mt-14 border-t border-white/15 pt-12">
                    <div class="reveal">
                        <p class="text-sm font-semibold uppercase tracking-wide text-fuchsia-300"><Loc Key="Home_Case_Eyebrow">See it in action</Loc></p>
                        <h3 id="theme-case-study-heading" class="mt-2 max-w-2xl text-xl font-bold tracking-tight text-white text-balance md:text-2xl"><Loc Key="Home_Case_Heading">Five well-known looks, one component library</Loc></h3>
                        <p class="mt-3 max-w-2xl text-purple-200">
                            <Loc Key="Home_Case_Sub">The same components with a different <code>Theme.cs</code>. No CSS overrides.</Loc>
                        </p>
                    </div>

                    <ul class="reveal-group mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5" aria-labelledby="theme-case-study-heading">
                        @foreach (var brand in ShowcaseBrand.All)
                        {
                            <li class="flex">
                                <a id="@($"theme-case-study-{brand.Slug}")" href="@brand.Path" class="group flex w-full flex-col gap-3 rounded-xl border border-white/15 bg-white/5 p-5 transition duration-300 hover:-translate-y-1 hover:border-fuchsia-300/60 hover:bg-white/10 hover:shadow-xl hover:shadow-fuchsia-950/40 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white motion-reduce:transition-none motion-reduce:hover:translate-y-0">
                                    <span class="flex gap-1.5" aria-hidden="true">
                                        @foreach (var swatch in brand.Swatches)
                                        {
                                            <span class="size-5 rounded-full ring-1 ring-white/40" style="@($"background-color: {swatch};")"></span>
                                        }
                                    </span>
                                    <span class="font-semibold text-white">@((MarkupString)Loc.Format("Home_Case_Inspired", "{0}<span class=\"font-normal text-purple-200\">-inspired</span>", brand.Name))</span>
                                    <span class="text-sm text-purple-200">@Loc.Text("Home_Brand_" + brand.Slug, brand.Summary)</span>
                                    <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-fuchsia-200 underline-offset-4 group-hover:underline">@Loc.Text("Home_Case_SeeTheme", "See the theme") <TwIcon Icon="IconEnum.Arrow_Right" Plain /></span>
                                </a>
                            </li>
                        }
                    </ul>

                    <p id="theme-case-study-disclaimer" class="mt-6 max-w-4xl text-xs text-purple-200">@Loc.Text("Home_Brand_Disclaimer", ShowcaseBrand.Disclaimer)</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Class merging -->
    <section class="relative isolate overflow-hidden bg-linear-to-b from-fuchsia-50/70 to-white dark:from-fuchsia-950/25 dark:to-gray-950" aria-labelledby="merge-heading">
        <div aria-hidden="true" class="pointer-events-none absolute -left-24 top-10 -z-10 size-80">
            <div class="size-full animate-glow-drift-alt rounded-full bg-purple-400/20 blur-3xl motion-reduce:animate-none dark:bg-purple-600/20"></div>
        </div>

        <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 py-16 md:py-24 lg:grid-cols-2 lg:items-center lg:gap-14">
            <div class="reveal">
                <p class="inline-flex items-center gap-2 rounded-full border border-purple-200 bg-white/80 px-3 py-1 text-sm font-medium text-purple-800 shadow-xs dark:border-purple-500/30 dark:bg-purple-500/10 dark:text-purple-200">
                    <span class="size-1.5 rounded-full bg-fuchsia-500" aria-hidden="true"></span>
                    <Loc Key="Home_Merge_Badge">Built in. No npm, no JavaScript.</Loc>
                </p>
                <h2 id="merge-heading" class="mt-5 text-2xl font-bold tracking-tight text-balance text-purple-900 md:text-3xl dark:text-white">
                    @Loc.Text("Home_Merge_HeadingLead", "Tailwind class merging,")
                    <span class="bg-linear-to-r from-purple-700 to-fuchsia-600 bg-clip-text text-transparent dark:from-purple-400 dark:to-fuchsia-300">@Loc.Text("Home_Merge_HeadingAccent", "built right in")</span>
                </h2>
                <p class="mt-3 max-w-xl text-gray-700 text-pretty dark:text-gray-400">
                    <Loc Key="Home_Merge_Sub">Pass <code>Class="px-3"</code> and it replaces the theme's <code>px-6</code>. Your class always wins.</Loc>
                </p>

                <ul class="mt-6 flex flex-col gap-4">
                    @foreach (var point in _mergePoints)
                    {
                        <li class="flex items-start gap-3">
                            <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-purple-600 to-fuchsia-500 text-sm text-white shadow-sm shadow-fuchsia-500/30"><TwIcon Icon="IconEnum.Check" Plain /></span>
                            <span>
                                <span class="block font-semibold text-purple-900 dark:text-white">@point.Title</span>
                                <span class="mt-0.5 block text-sm text-gray-600 dark:text-gray-400">@point.Description</span>
                            </span>
                        </li>
                    }
                </ul>

                <a id="merge-docs" href="/class-merge" class="mt-7 inline-flex items-center gap-2 rounded-md font-semibold text-purple-800 underline-offset-4 transition-colors hover:text-fuchsia-700 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-600 dark:focus-visible:outline-purple-300 dark:text-purple-300 dark:hover:text-fuchsia-300">
                    @Loc.Text("Home_Merge_Link", "See how class merging works") <TwIcon Icon="IconEnum.Arrow_Right" Plain />
                </a>
            </div>

            <figure class="reveal min-w-0 rounded-2xl bg-linear-to-br from-purple-500 via-fuchsia-500 to-pink-400 p-px shadow-xl shadow-purple-500/20 dark:shadow-fuchsia-900/30">
                <figcaption class="sr-only"><Loc Key="Home_Merge_Caption">A live example of class merging. Choose an example to change the class passed to the component.</Loc></figcaption>
                <div class="rounded-[calc(var(--radius-2xl)-1px)] bg-white p-6 dark:bg-gray-950">
                    <div class="flex flex-wrap gap-1.5" role="group" aria-label="@Loc.Text("Home_Merge_GroupLabel", "Class merging example")">
                        @foreach (var example in _mergeExamples)
                        {
                            var isSelected = example == mergeExample;
                            <button type="button" id="@($"merge-example-{example.Id}")" aria-pressed="@(isSelected ? "true" : "false")" @onclick="@(() => mergeExample = example)"
                                    class="@(isSelected ? mergeTabSelectedClasses : mergeTabClasses)">
                                @MergeLabel(example)
                            </button>
                        }
                    </div>

                    <dl class="mt-5 flex flex-col gap-4">
                        <div>
                            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400"><Loc Key="Home_Merge_Theme">Theme</Loc></dt>
                            <dd class="mt-2 flex flex-wrap gap-1.5">
                                @foreach (var themeClass in mergeThemeClassResults)
                                {
                                    if (themeClass.Kept)
                                    {
                                        <span class="@mergeThemeChipClasses">@themeClass.Name</span>
                                    }
                                    else
                                    {
                                        <del class="@mergeRemovedChipClasses"><span class="sr-only">@(Loc.Text("Home_Merge_Replaced", "Replaced:") + " ")</span>@themeClass.Name</del>
                                    }
                                }
                            </dd>
                        </div>
                        <div>
                            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400"><Loc Key="Home_Merge_YourClass">Your Class</Loc></dt>
                            <dd class="mt-2 flex flex-wrap gap-1.5">
                                @foreach (var yourClass in mergeExample.YourClass.Split(' '))
                                {
                                    <span class="@mergeYourChipClasses">@yourClass</span>
                                }
                            </dd>
                        </div>
                    </dl>

                    <div class="mt-5 flex items-center gap-3" aria-hidden="true">
                        <span class="h-px flex-1 bg-linear-to-r from-transparent to-fuchsia-300 dark:to-fuchsia-500/50"></span>
                        <span class="inline-flex size-8 items-center justify-center rounded-full bg-linear-to-br from-purple-600 to-fuchsia-500 text-white shadow-md shadow-fuchsia-500/30"><TwIcon Icon="IconEnum.Arrow_Down" Plain /></span>
                        <span class="h-px flex-1 bg-linear-to-l from-transparent to-fuchsia-300 dark:to-fuchsia-500/50"></span>
                    </div>

                    <div class="mt-5 rounded-xl border border-purple-200/70 bg-purple-50/60 p-4 dark:border-white/10 dark:bg-white/5" aria-live="polite">
                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400"><Loc Key="Home_Rendered">Rendered</Loc></p>
                        <p id="merge-result" class="mt-2 font-mono text-sm break-words text-purple-950 dark:text-purple-100">@mergedClasses</p>
                        <div class="mt-4 flex min-h-14 items-center justify-center rounded-lg border border-dashed border-purple-300/70 bg-white p-3 dark:border-white/15 dark:bg-gray-950">
                            <span id="merge-preview" class="@mergedClasses">@Loc.Text("Home_SaveChanges", "Save changes")</span>
                        </div>
                    </div>
                </div>
            </figure>
        </div>
    </section>

    <!-- Localization -->
    <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24" aria-labelledby="localization-heading">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-14">
            <div class="reveal">
                <p class="inline-flex items-center gap-2 rounded-full border border-purple-200 bg-white/80 px-3 py-1 text-sm font-medium text-purple-800 shadow-xs dark:border-purple-500/30 dark:bg-purple-500/10 dark:text-purple-200">
                    <TwIcon Icon="IconEnum.Translate" Plain />
                    @Loc.Format("Home_Loc_Badge", "{0} languages, built in", _localizationLanguages.Count)
                </p>
                <h2 id="localization-heading" class="mt-5 text-2xl font-bold tracking-tight text-balance text-purple-900 md:text-3xl dark:text-white">
                    @Loc.Text("Home_Loc_HeadingLead", "Speaks your users' language,")
                    <span class="bg-linear-to-r from-purple-700 to-fuchsia-600 bg-clip-text text-transparent dark:from-purple-400 dark:to-fuchsia-300">@Loc.Text("Home_Loc_HeadingAccent", "out of the box")</span>
                </h2>
                <p class="mt-3 max-w-xl text-gray-700 text-pretty dark:text-gray-400">
                    <Loc Key="Home_Loc_Sub">Every label, message and screen reader announcement is translated, and dates follow the culture. Nothing to set up.</Loc>
                </p>

                <ul class="mt-6 flex flex-col gap-4">
                    @foreach (var point in _localizationPoints)
                    {
                        <li class="flex items-start gap-3">
                            <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-purple-600 to-fuchsia-500 text-sm text-white shadow-sm shadow-fuchsia-500/30"><TwIcon Icon="IconEnum.Check" Plain /></span>
                            <span>
                                <span class="block font-semibold text-purple-900 dark:text-white">@point.Title</span>
                                <span class="mt-0.5 block text-sm text-gray-600 dark:text-gray-400">@point.Description</span>
                            </span>
                        </li>
                    }
                </ul>

                <a id="localization-docs" href="/localization" class="mt-7 inline-flex items-center gap-2 rounded-md font-semibold text-purple-800 underline-offset-4 transition-colors hover:text-fuchsia-700 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-600 dark:text-purple-300 dark:hover:text-fuchsia-300">
                    @Loc.Text("Home_Loc_Link", "See how localization works") <TwIcon Icon="IconEnum.Arrow_Right" Plain />
                </a>
            </div>

            <div class="reveal min-w-0">
                <ul id="localization-languages" class="flex flex-wrap gap-2" aria-label="@Loc.Text("Home_Loc_LanguagesLabel", "Supported languages")">
                    @for (var i = 0; i < _localizationLanguages.Count; i++)
                    {
                        var language = _localizationLanguages[i];
                        @* Beside the text column the full list runs long, so a wide screen shows the first few and links to the rest. *@
                        <li class="@(i < desktopLanguageCount ? languageChipClasses : languageChipCollapsedClasses)">
                            <span lang="@language.Culture" dir="auto" class="font-medium text-purple-900 dark:text-white">@language.NativeName</span>
                            <span class="text-xs text-gray-600 dark:text-gray-400">@Loc.Text("Home_Lang_" + language.Culture.Replace("-", ""), language.Name)</span>
                        </li>
                    }
                    <li class="hidden lg:inline-flex">
                        <a id="localization-more-languages" href="/localization#localization-languages" class="inline-flex items-baseline rounded-full border border-purple-200 bg-white px-3 py-1.5 text-sm font-medium text-purple-900 shadow-xs transition-colors hover:border-fuchsia-300 hover:text-fuchsia-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:border-fuchsia-400/50 dark:hover:text-fuchsia-300 dark:focus-visible:outline-purple-300">
                            <span aria-hidden="true">...</span>
                            <span class="sr-only">@Loc.Format("Home_Loc_More", "and {0} more languages", _localizationLanguages.Count - desktopLanguageCount)</span>
                        </a>
                    </li>
                </ul>
                <p id="localization-disclaimer" class="mt-4 text-sm text-gray-600 dark:text-gray-400">
                    <Loc Key="Home_Loc_Disclaimer">Non-English translations were produced by AI and are not yet reviewed. <a href="/localization#localization-contributing" class="font-medium text-purple-800 underline underline-offset-2 dark:text-purple-300">Suggest a correction</a>.</Loc>
                </p>
                <div class="mt-6">
                    <TwCodeBlock Language="csharp" Content="@localizationSnippet" Class="rounded-xl" PanelClass="rounded-lg" />
                </div>
            </div>
        </div>
    </section>

    <!-- Right to left -->
    <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24" aria-labelledby="rtl-heading">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
            <div class="reveal lg:order-2">
                <p class="inline-flex items-center gap-2 rounded-full border border-purple-200 bg-white/80 px-3 py-1 text-sm font-medium text-purple-800 shadow-xs dark:border-purple-500/30 dark:bg-purple-500/10 dark:text-purple-200">
                    <TwIcon Icon="IconEnum.Arrow_Left_Right" Plain />
                    <Loc Key="Home_Rtl_Badge">Right to left, built in</Loc>
                </p>
                <h2 id="rtl-heading" class="mt-5 text-2xl font-bold tracking-tight text-balance text-purple-900 md:text-3xl dark:text-white">
                    @Loc.Text("Home_Rtl_HeadingLead", "Reads right to left,")
                    <span class="bg-linear-to-r from-purple-700 to-fuchsia-600 bg-clip-text text-transparent dark:from-purple-400 dark:to-fuchsia-300">@Loc.Text("Home_Rtl_HeadingAccent", "without a second stylesheet")</span>
                </h2>
                <p class="mt-3 max-w-xl text-gray-700 text-pretty dark:text-gray-400">
                    <Loc Key="Home_Rtl_Sub">Arabic, Hebrew, Persian and Urdu mirror every component: spacing, icons, panels and arrow keys.</Loc>
                </p>

                <ul class="mt-6 flex flex-col gap-4">
                    @foreach (var point in _rtlPoints)
                    {
                        <li class="flex items-start gap-3">
                            <span class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full bg-linear-to-br from-purple-600 to-fuchsia-500 text-sm text-white shadow-sm shadow-fuchsia-500/30"><TwIcon Icon="IconEnum.Check" Plain /></span>
                            <span>
                                <span class="block font-semibold text-purple-900 dark:text-white">@point.Title</span>
                                <span class="mt-0.5 block text-sm text-gray-600 dark:text-gray-400">@point.Description</span>
                            </span>
                        </li>
                    }
                </ul>

                <a id="rtl-docs" href="/direction-provider" class="mt-7 inline-flex items-center gap-2 rounded-md font-semibold text-purple-800 underline-offset-4 transition-colors hover:text-fuchsia-700 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-600 dark:focus-visible:outline-purple-300 dark:text-purple-300 dark:hover:text-fuchsia-300">
                    @Loc.Text("Home_Rtl_Link", "See how right to left works") <TwIcon Icon="IconEnum.Arrow_Right" Plain />
                </a>
            </div>

            <figure class="reveal min-w-0 rounded-2xl bg-linear-to-br from-purple-500 via-fuchsia-500 to-pink-400 p-px shadow-xl shadow-purple-500/20 lg:order-1 dark:shadow-fuchsia-900/30">
                <figcaption class="sr-only"><Loc Key="Home_Rtl_Caption">A live example of the same components laid out left to right and right to left. Choose a direction to switch.</Loc></figcaption>
                <div class="rounded-[calc(var(--radius-2xl)-1px)] bg-white p-6 dark:bg-gray-950">
                    <div class="flex flex-wrap gap-1.5" role="group" aria-label="@Loc.Text("Home_Rtl_GroupLabel", "Layout direction")">
                        @foreach (var option in _rtlDemoOptions)
                        {
                            var isSelected = option.Direction == rtlDemoDirection;
                            <button type="button" id="@($"rtl-demo-{option.Id}")" aria-pressed="@(isSelected ? "true" : "false")" @onclick="@(() => rtlDemoDirection = option.Direction)"
                                    class="@(isSelected ? mergeTabSelectedClasses : mergeTabClasses)">
                                @option.Label
                            </button>
                        }
                    </div>

                    <div class="mt-5 rounded-xl border border-purple-200/70 bg-purple-50/60 p-4 dark:border-white/10 dark:bg-white/5">
                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400"><Loc Key="Home_Rendered">Rendered</Loc></p>
                        <p id="rtl-demo-markup" class="mt-2 font-mono text-sm break-words text-purple-950 dark:text-purple-100" aria-live="polite">@rtlDemoMarkup</p>
                        <TwDirectionProvider Id="rtl-demo-preview" Direction="@rtlDemoDirection" Class="mt-4 flex flex-col gap-4 rounded-lg border border-dashed border-purple-300/70 bg-white p-4 dark:border-white/15 dark:bg-gray-950" lang="@rtlDemoText.Culture">
                            <TwAlert Color="TwBlazor.Enums.Color.Info" Dense>@rtlDemoText.Alert</TwAlert>
                            <TwTextfield Id="rtl-demo-name" Label="@rtlDemoText.NameLabel" Placeholder="@rtlDemoText.NamePlaceholder" @bind-Value="rtlDemoName" />
                            <TwSwitch Id="rtl-demo-notifications" Label="@rtlDemoText.SwitchLabel" @bind-Value="rtlDemoNotifications" />
                            <TwPagination Id="rtl-demo-pagination" TotalPages="5" @bind-ActivePage="rtlDemoPage" AriaLabel="@rtlDemoText.PaginationLabel" />
                        </TwDirectionProvider>
                    </div>
                </div>
            </figure>
        </div>
    </section>

    <!-- Quick start -->
    <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24" aria-labelledby="quickstart-heading">
        <div class="reveal">
            <h2 id="quickstart-heading" class="text-2xl font-bold tracking-tight text-purple-900 md:text-3xl dark:text-white"><Loc Key="Home_Quick_Heading">Up and running in minutes</Loc></h2>
            <p class="mt-3 max-w-xl text-gray-700 dark:text-gray-400"><Loc Key="Home_Quick_Sub">Install, register, build.</Loc></p>
        </div>

        <figure class="reveal mt-8" aria-labelledby="quickstart-build-caption">
            <figcaption id="quickstart-build-caption" class="sr-only"><Loc Key="Home_Quick_Caption">Installing twblazor, then two lines of markup and the button and alert they render.</Loc></figcaption>
            <div data-stage class="grid overflow-hidden rounded-2xl border border-purple-200/70 bg-white text-left shadow-xl shadow-purple-500/10 md:grid-cols-2 dark:border-white/10 dark:bg-gray-900">
                <div class="bg-gray-950 p-5 font-mono text-[13px] leading-7 text-gray-300">
                    <div class="mb-3 flex items-center gap-2" aria-hidden="true">
                        <span class="size-3 rounded-full bg-red-400/80"></span>
                        <span class="size-3 rounded-full bg-amber-400/80"></span>
                        <span class="size-3 rounded-full bg-green-400/80"></span>
                        <span class="ms-3 text-xs text-gray-400"><Loc Key="Home_Quick_Window">Terminal and Home.razor</Loc></span>
                    </div>
                    <pre class="overflow-x-auto"><code><span class="stage-line block" style="--i:0"><span class="text-gray-500">$</span> dotnet add package <span class="text-emerald-300">twblazor</span></span><span class="stage-line block" style="--i:1"><span class="text-fuchsia-300">&lt;TwButton</span> <span class="text-sky-300">Label</span>=<span class="text-emerald-300">"Get Started"</span> <span class="text-fuchsia-300">/&gt;</span></span><span class="stage-line block" style="--i:2"><span class="text-fuchsia-300">&lt;TwAlert</span> <span class="text-sky-300">Color</span>=<span class="text-emerald-300">"Success"</span><span class="text-fuchsia-300">&gt;</span>Working!<span class="text-fuchsia-300">&lt;/TwAlert&gt;</span><span class="stage-caret ms-0.5 inline-block h-4 w-2 translate-y-0.5 bg-fuchsia-400" aria-hidden="true"></span></span></code></pre>
                </div>

                <div class="flex flex-col gap-5 p-6">
                    <span class="text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400"><Loc Key="Home_Preview">Preview</Loc></span>
                    <div class="stage-pop inline-flex w-fit items-center gap-2 rounded-full bg-purple-50 px-3 py-1 text-sm font-medium text-purple-800 dark:bg-purple-500/15 dark:text-purple-200" style="--i:0">
                        <TwIcon Icon="IconEnum.Box_Seam" Plain />
                        <Loc Key="Home_Quick_Installed">twblazor installed</Loc>
                    </div>
                    <div class="stage-pop w-fit" style="--i:1">
                        <TwButton Color="Color.Primary" Label="Get Started" Href="/get-started" />
                    </div>
                    <div class="stage-pop" style="--i:2">
                        <TwAlert Color="Color.Success" Dense Role="none" StartIcon="IconEnum.Check_Circle">Working!</TwAlert>
                    </div>
                </div>
            </div>
        </figure>
    </section>

    <!-- Community -->
    <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24" aria-labelledby="community-heading">
        <div class="reveal flex flex-col items-start gap-5 rounded-2xl border border-purple-200/70 bg-white p-6 sm:flex-row sm:items-center sm:justify-between dark:border-purple-500/30 dark:bg-purple-500/10">
            <div class="flex items-center gap-4">
                <span class="inline-flex size-11 shrink-0 items-center justify-center rounded-xl bg-linear-to-br from-indigo-600 to-purple-500 text-xl text-white shadow-lg shadow-indigo-500/30"><TwIcon Icon="IconEnum.Discord" Plain /></span>
                <div>
                    <h2 id="community-heading" class="text-lg font-semibold text-purple-900 dark:text-white"><Loc Key="Home_Community_Heading">Join the discussion on Discord</Loc></h2>
                    <p class="mt-0.5 text-sm text-gray-600 text-pretty dark:text-gray-400"><Loc Key="Home_Community_Sub">Ask questions and share what you're building.</Loc></p>
                </div>
            </div>
            <DiscordInviteLink Id="landing-discord" Class="inline-flex w-full shrink-0 items-center justify-center gap-2 rounded-md border border-purple-300 bg-white px-5 py-2.5 font-semibold text-purple-900 transition-colors hover:border-fuchsia-400 hover:bg-purple-50 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:focus-visible:outline-purple-300 sm:w-auto dark:border-purple-400/50 dark:bg-transparent dark:text-purple-100 dark:hover:border-fuchsia-400 dark:hover:bg-purple-500/15">
                <TwIcon Icon="IconEnum.Discord" Plain /> @Loc.Text("Home_Community_Join", "Join the Discord")
            </DiscordInviteLink>
        </div>
    </section>

    <!-- CTA -->
    <section class="reveal mx-auto max-w-6xl px-6 pt-16 md:pt-24">
        <div class="relative isolate animate-gradient-pan overflow-hidden rounded-2xl bg-linear-to-r from-purple-700 via-fuchsia-700 to-purple-700 bg-size-[200%_auto] px-6 py-10 text-white shadow-xl shadow-purple-900/20 motion-reduce:animate-none md:px-10">
            <div aria-hidden="true" class="pointer-events-none absolute -right-16 -top-24 -z-10 size-72 rounded-full bg-white/10 blur-2xl"></div>
            <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-center">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-white"><Loc Key="Home_Cta_Heading">Ready to build something great?</Loc></h2>
                    <p class="mt-1 max-w-xl text-white"><Loc Key="Home_Cta_Sub">Start with the docs.</Loc></p>
                </div>
                <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
                    <a id="cta-get-started" href="/get-started" class="inline-flex w-full items-center justify-center gap-2 rounded-md bg-white px-5 py-2.5 font-semibold text-purple-900 transition-colors hover:bg-purple-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto"><TwIcon Icon="IconEnum.Rocket_Takeoff" Plain /> @Loc.Text("Home_GetStarted", "Get started")</a>
                    <a id="cta-github" href="https://github.com/twblazor/twblazor" target="_blank" rel="noopener noreferrer" class="inline-flex w-full items-center justify-center gap-2 rounded-md border border-white/70 px-5 py-2.5 font-semibold text-white transition-colors hover:bg-white/15 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white sm:w-auto"><TwIcon Icon="IconEnum.Github" Plain /> @Loc.Text("Home_Cta_Star", "Star on GitHub")<span class="sr-only"> @Loc.Text("Footer_NewTab", "(opens in a new tab)")</span></a>
                </div>
            </div>
        </div>
    </section>

    <!-- Open source commitment -->
    <section class="mx-auto max-w-6xl px-6 pb-12 pt-8">
        <p class="max-w-2xl text-sm text-gray-700 md:text-base dark:text-gray-400">
            <Loc Key="Home_OpenSource">Free and MIT licensed, always. Built in the open with the community.</Loc>
        </p>
    </section>
</div>
