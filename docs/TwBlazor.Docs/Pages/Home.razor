                <div class="min-w-0 bg-gray-950 font-mono text-xs leading-6 text-gray-300 sm:text-[13px] sm:leading-7">
                    <CodeWindowBar Title="@Loc.Text("Home_Quick_Window", "Terminal and Home.razor")" Icon="IconEnum.Terminal" />
                    <pre dir="ltr" class="overflow-x-auto whitespace-pre-wrap break-words p-4 sm:p-5 md:whitespace-pre"><code><span class="stage-line block" style="--i:0"><span class="text-gray-500">$</span> dotnet add package <span class="text-emerald-300">twblazor</span></span><span class="stage-line block" style="--i:1"><span class="text-fuchsia-300">&lt;TwButton</span> <span class="text-sky-300">Label</span>=<span class="text-emerald-300">"Get Started"</span> <span class="text-fuchsia-300">/&gt;</span></span><span class="stage-line block" style="--i:2"><span class="text-fuchsia-300">&lt;TwAlert</span> <span class="text-sky-300">Color</span>=<span class="text-emerald-300">"Success"</span><span class="text-fuchsia-300">&gt;</span>Working!<span class="text-fuchsia-300">&lt;/TwAlert&gt;</span><span class="stage-caret ms-0.5 inline-block h-4 w-2 translate-y-0.5 bg-fuchsia-400" aria-hidden="true"></span></span></code></pre>
                </div>

                <div class="flex min-w-0 flex-col gap-5 p-5 sm:p-6">
