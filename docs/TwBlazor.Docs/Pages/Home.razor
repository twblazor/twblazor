            <figure class="@($"reveal min-w-0 lg:order-1 {LandingStyles.Figure}")">
                <figcaption class="sr-only"><Loc Key="Home_Rtl_Caption">A live example of the same components laid out left to right and right to left. Choose a direction to switch.</Loc></figcaption>
                <div class="p-6">
                    <div class="flex flex-wrap gap-1.5" role="group" aria-label="@Loc.Text("Home_Rtl_GroupLabel", "Layout direction")">
                        @foreach (var option in _rtlDemoOptions)
                        {
                            var isSelected = option.Direction == rtlDemoDirection;
                            <button type="button" id="@($"rtl-demo-{option.Id}")" aria-pressed="@(isSelected ? "true" : "false")" @onclick="@(() => rtlDemoDirection = option.Direction)"
                                    class="@(isSelected ? mergeTabSelectedClasses : mergeTabClasses)">
                                @option.Label
                            </button>
                        }
                    </div>

                    <div class="@($"mt-5 p-4 {LandingStyles.Well}")">
                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400"><Loc Key="Home_Rendered">Rendered</Loc></p>
