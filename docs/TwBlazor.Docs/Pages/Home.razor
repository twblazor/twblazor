@page "/"
@layout LandingLayout
@using IconEnum = TwBlazor.Enums.Icon

<PageSeo Title="twblazor | Tailwind Blazor Component Library" Description="twblazor is a free, open-source Blazor components library built on Tailwind CSS. Accessible, themeable, with dark mode, for Server and WebAssembly." Path="/" JsonLd="_jsonLd" />

<!-- Hero -->
<section class="relative isolate overflow-hidden border-b border-gray-200 dark:border-gray-800">
    <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(70%_60%_at_20%_0%,var(--color-purple-100),transparent)] dark:bg-[radial-gradient(70%_60%_at_20%_0%,color-mix(in_oklab,var(--color-purple-500)_22%,transparent),transparent)]"></div>

    <div class="mx-auto grid max-w-6xl items-center gap-10 px-6 py-14 md:py-20 lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)] lg:gap-14">
        <div>
            <h1 class="text-4xl font-bold leading-[1.05] tracking-tight text-purple-700 md:text-5xl dark:text-white">
                The Tailwind CSS component library for Blazor
            </h1>
            <p class="mt-5 max-w-lg text-lg/7 text-gray-600 dark:text-gray-300">
                Professional-grade components for modern Blazor development.
                Ship polished, accessible UI without wrestling with CSS.
            </p>

            <div class="mt-8 flex flex-col gap-3 sm:flex-row">
                <TwButton Id="get-started" Class="w-full justify-center sm:w-auto" Color="Color.Primary" Label="Get started" StartIcon="IconEnum.Rocket_Takeoff" Href="/get-started" />
                <TwButton Id="github" Class="w-full justify-center sm:w-auto" Color="Color.Accent" Variant="ButtonVariant.Outlined" Label="View on GitHub" StartIcon="IconEnum.Github" Href="https://github.com/twblazor/twblazor" Target="_blank" rel="noopener noreferrer" />
            </div>

            <TwCodeBlock Language="pwsh" Content="@quickStartInstall" Class="mt-8 max-w-lg text-left" Title="Install" />
        </div>

        <div class="min-w-0">
            <TwCard Title="Orders" Class="shadow-lg">
                <div class="mt-3">
                    <TwDataTable TItem="Order" Items="orders" Columns="orderColumns" Searchable Pageable RowsPerPage="5" SearchPlaceholder="Search orders...">
                        <EmptyContent>
                            <div class="py-8 text-center">
                                <p class="text-gray-500 dark:text-gray-400">No orders found.</p>
                            </div>
                        </EmptyContent>
                    </TwDataTable>
                </div>
            </TwCard>
        </div>
    </div>
</section>

<div class="mx-auto max-w-6xl px-6 text-gray-950 dark:text-white">

    <!-- Features -->
    <section class="mt-14 md:mt-20" aria-labelledby="features-heading">
        <h2 id="features-heading" class="text-2xl font-bold tracking-tight text-purple-700 md:text-3xl dark:text-white">Why twblazor?</h2>
        <p class="mt-2 max-w-xl text-gray-600 dark:text-gray-400">
            Everything you need to build clean, consistent interfaces.
        </p>

        <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <TwCard Shadow="Shadow.None">
                <span class="inline-flex size-10 items-center justify-center rounded-lg bg-purple-50 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Lightning_Charge_Fill" Plain /></span>
                <h3 class="mt-4 text-lg font-semibold text-purple-700 dark:text-white">Fast to build</h3>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">25+ ready-made components mean you're shipping features, not fighting CSS.</p>
            </TwCard>
            <TwCard Shadow="Shadow.None">
                <span class="inline-flex size-10 items-center justify-center rounded-lg bg-purple-50 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Palette_Fill" Plain /></span>
                <h3 class="mt-4 text-lg font-semibold text-purple-700 dark:text-white">Fully customisable</h3>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Tailwind-powered styling that adapts to your brand, in light and dark mode.</p>
            </TwCard>
            <TwCard Shadow="Shadow.None">
                <span class="inline-flex size-10 items-center justify-center rounded-lg bg-purple-50 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Puzzle_Fill" Plain /></span>
                <h3 class="mt-4 text-lg font-semibold text-purple-700 dark:text-white">Composable</h3>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Simple, parameter-driven APIs that feel natural if you already know Blazor.</p>
            </TwCard>
            <TwCard Shadow="Shadow.None">
                <span class="inline-flex size-10 items-center justify-center rounded-lg bg-purple-50 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Shield_Check" Plain /></span>
                <h3 class="mt-4 text-lg font-semibold text-purple-700 dark:text-white">Accessible by default</h3>
                <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Sensible ARIA attributes and keyboard support baked into every component.</p>
            </TwCard>
        </div>
    </section>

    <!-- Guides -->
    <section class="mt-14 md:mt-20" aria-labelledby="guides-heading">
        <h2 id="guides-heading" class="text-2xl font-bold tracking-tight text-purple-700 md:text-3xl dark:text-white">Tailwind and Blazor, working together</h2>
        <p class="mt-2 max-w-2xl text-gray-600 dark:text-gray-400">
            twblazor is a Blazor components library for teams who already use Tailwind CSS. Read how
            <a href="/tailwind-blazor" class="font-semibold underline hover:no-underline">Tailwind CSS works with Blazor</a>,
            see how it stacks up in our
            <a href="/blazor-component-library-comparison" class="font-semibold underline hover:no-underline">Blazor component library comparison</a>,
            or jump straight to the <a href="/get-started" class="font-semibold underline hover:no-underline">install guide</a>.
        </p>
    </section>

    <!-- Showcase -->
    <section class="mt-16 md:mt-24" aria-labelledby="examples-heading">
        <h2 id="examples-heading" class="text-2xl font-bold tracking-tight text-purple-700 md:text-3xl dark:text-white">Real components. Ready for your app.</h2>
        <p class="mt-2 max-w-xl text-gray-600 dark:text-gray-400">
            Go ahead and try them. Every example here is a live twblazor component.
        </p>

        <div class="mt-8 grid grid-cols-1 gap-4 lg:grid-cols-2 lg:items-start">
            <div class="flex flex-col gap-4">
                <TwCard Title="Sign in">
                    <form class="mt-3 flex flex-col gap-4" @onsubmit="SignIn" @onsubmit:preventDefault>
                        <TwTextfield Label="Email" @bind-Value="signInEmail" InputType="email" Placeholder="you@example.com" />
                        <TwTextfield Label="Password" @bind-Value="signInPassword" InputType="password" Placeholder="Enter your password" />
                        <TwCheckbox T="bool" @bind-Value="rememberMe" Label="Remember me" />
                        <TwButton Type="submit" Class="w-full justify-center" Color="Color.Primary" Label="Sign in" />
                    </form>
                </TwCard>
            </div>

            <TwCard Title="Checkout stepper">
                <div class="mt-3">
                    <TwStepper @ref="checkoutStepper" @bind-ActiveStepIndex="checkoutStep" AriaLabel="Checkout progress">
                        <TwStep Label="Account" Description="Create your login">
                            <TwTextfield Label="Email" @bind-Value="email" Placeholder="Enter your email address" AriaLabel="Email" />
                        </TwStep>
                        <TwStep Label="Preferences" Description="Tune your setup">
                            <TwSwitch @bind-Value="notificationsEnabled" Label="Email notifications" AriaLabel="Toggle notifications" Color="Color.Primary" />
                        </TwStep>
                        <TwStep Label="Done" Description="All set">
                            <p class="text-sm">Thanks, you're ready to go.</p>
                        </TwStep>
                    </TwStepper>
                    <div class="mt-4 flex gap-2">
                        <TwButton Label="Back" Variant="ButtonVariant.Outlined" Color="Color.Primary" Disabled="@(checkoutStep <= 0)" OnClick="@(async () => { if (checkoutStepper is not null) await checkoutStepper.PreviousStep(); })" />
                        <TwButton Label="Next" Variant="ButtonVariant.Filled" Color="Color.Primary" Disabled="@(checkoutStep >= 2)" OnClick="@(async () => { if (checkoutStepper is not null) await checkoutStepper.NextStep(); })" />
                    </div>
                </div>
            </TwCard>

        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-2 lg:items-start">
            <TwCard>
                <div class="flex items-center gap-3">
                    <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-purple-50 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Gear_Fill" Plain /></span>
                    <div>
                        <h3 class="font-semibold text-gray-950 dark:text-white">Project settings</h3>
                        <p class="text-sm text-gray-600 dark:text-gray-400">Manage how your team ships</p>
                    </div>
                </div>

                <form class="mt-5 flex flex-col gap-5" @onsubmit="SaveSettings" @onsubmit:preventDefault>
                    <TwTextfield Label="Project name" @bind-Value="projectName" />

                    <TwRadioGroup T="string" Legend="Visibility" Name="visibility" Horizontal>
                        <TwRadioButton Value="@("private")" Label="Private" @bind-SelectedValue="visibility" />
                        <TwRadioButton Value="@("team")" Label="Team" @bind-SelectedValue="visibility" />
                        <TwRadioButton Value="@("public")" Label="Public" @bind-SelectedValue="visibility" />
                    </TwRadioGroup>

                    <TwSelect T="string" Label="Environment" Values="environments" @bind-SelectedValue="environment" Required />

                    <div class="flex flex-col gap-3">
                        <TwSwitch @bind-Value="emailAlerts" Label="Email alerts" AriaLabel="Email alerts" />
                        <TwSwitch @bind-Value="autoDeploy" Label="Deploy on push" AriaLabel="Deploy on push" />
                    </div>

                    <div>
                        <div class="mb-2 flex items-baseline justify-between text-sm">
                            <span class="font-medium text-gray-950 dark:text-white">Storage used</span>
                            <span class="tabular-nums text-gray-600 dark:text-gray-400">7.2 of 10 GB</span>
                        </div>
                        <TwProgress Value="72" Max="100" Color="Color.Primary" AriaLabel="Storage used" />
                    </div>

                    @if (settingsSaved)
                    {
                        <TwAlert Dense Color="Color.Success" StartIcon="IconEnum.Check_Circle">Settings saved.</TwAlert>
                    }

                    <div class="flex justify-end gap-2 border-t border-gray-200 pt-4 dark:border-gray-800">
                        <TwButton Type="button" Label="Reset" Variant="ButtonVariant.Outlined" Color="Color.Primary" OnClick="ResetSettings" />
                        <TwButton Type="submit" Label="Save changes" Color="Color.Primary" />
                    </div>
                </form>
            </TwCard>

            <TwCard>
                <div class="flex items-center justify-between gap-3">
                    <h3 class="font-semibold text-gray-950 dark:text-white">Release health</h3>
                    <TwChip Label="v2.4.0" Color="Color.Success" Variant="ButtonVariant.Filled" Size="ChipSize.Small" StartIcon="IconEnum.Check" />
                </div>

                <TwAlert Dense Color="Color.Accent" StartIcon="IconEnum.Exclamation_Circle" Class="mt-4">Storage nearing capacity.</TwAlert>

                <dl class="mt-5 grid grid-cols-3 divide-x divide-gray-200 text-center dark:divide-gray-800">
                    @foreach (var figure in releaseFigures)
                    {
                        <div class="px-2">
                            <dd class="text-2xl font-bold tabular-nums text-gray-950 dark:text-white">@figure.Value</dd>
                            <dt class="text-sm text-gray-600 dark:text-gray-400">@figure.Label</dt>
                        </div>
                    }
                </dl>

                <h4 class="mt-6 text-sm font-medium text-gray-950 dark:text-white">Services</h4>
                <ul class="mt-2 divide-y divide-gray-200 dark:divide-gray-800">
                    @foreach (var service in services)
                    {
                        <li class="grid grid-cols-[minmax(0,1fr)_5rem_6.5rem] items-center gap-3 py-3 text-sm">
                            <span class="min-w-0">
                                <span class="block truncate font-medium text-gray-950 dark:text-white">@service.Name</span>
                                <span class="block text-xs tabular-nums text-gray-600 dark:text-gray-400">@service.Uptime.ToString("0.0")% uptime</span>
                            </span>
                            <TwProgress Value="@service.Uptime" Max="@(100d)" Size="ProgressSize.Small" Color="@service.Color" AriaLabel="@($"{service.Name} uptime")" />
                            <span class="justify-self-end"><TwChip Label="@service.Status" Color="@service.Color" Variant="ButtonVariant.Outlined" Size="ChipSize.Small" /></span>
                        </li>
                    }
                </ul>
            </TwCard>
        </div>
    </section>

    <!-- Theming -->
    <section class="mt-16 md:mt-24" aria-labelledby="theming-heading">
        <h2 id="theming-heading" class="max-w-2xl text-2xl font-bold tracking-tight text-purple-700 md:text-3xl dark:text-white">The deepest Tailwind theming of any Blazor library</h2>
        <p class="mt-2 max-w-2xl text-gray-600 dark:text-gray-400">
            twblazor is the first and only Tailwind CSS component library for Blazor built
            around full, typed, component-level theming. Every visual detail of every component is a
            plain Tailwind class you own and can override, not a black box baked into a compiled DLL.
        </p>

        <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-2">
            <dl class="flex flex-col justify-between gap-4">
                <div class="flex items-start gap-4">
                    <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-purple-50 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Braces" Plain /></span>
                    <div>
                        <dt class="font-semibold text-purple-700 dark:text-white">Every class, typed and overridable</dt>
                        <dd class="mt-1 text-sm text-gray-600 dark:text-gray-400">Each component has its own C# theme class, like <code>TwButtonTheme</code>, with every class exposed as a named property.</dd>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-purple-50 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Layers_Fill" Plain /></span>
                    <div>
                        <dt class="font-semibold text-purple-700 dark:text-white">Reusable design tokens</dt>
                        <dd class="mt-1 text-sm text-gray-600 dark:text-gray-400">Set a color or shade once and every component stays in sync.</dd>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-purple-50 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Sliders" Plain /></span>
                    <div>
                        <dt class="font-semibold text-purple-700 dark:text-white">Global defaults, local overrides</dt>
                        <dd class="mt-1 text-sm text-gray-600 dark:text-gray-400">Set a default once, and any single instance can still override it.</dd>
                    </div>
                </div>
                <div class="flex items-start gap-4">
                    <span class="inline-flex size-10 shrink-0 items-center justify-center rounded-lg bg-purple-50 text-xl text-purple-700 dark:bg-purple-500/15 dark:text-purple-300"><TwIcon Icon="IconEnum.Wind" Plain /></span>
                    <div>
                        <dt class="font-semibold text-purple-700 dark:text-white">Real Tailwind, real JIT</dt>
                        <dd class="mt-1 text-sm text-gray-600 dark:text-gray-400">Themes are plain C# string literals, so Tailwind always sees them. No safelists or build workarounds.</dd>
                    </div>
                </div>
            </dl>

            <div class="min-w-0">
                <TwCodeBlock Language="csharp" Content="@themingSnippet" />
            </div>
        </div>
    </section>

    <!-- Quick start -->
    <section class="mt-16 md:mt-24" aria-labelledby="quickstart-heading">
        <h2 id="quickstart-heading" class="text-2xl font-bold tracking-tight text-purple-700 md:text-3xl dark:text-white">Up and running in minutes</h2>
        <p class="mt-2 max-w-xl text-gray-600 dark:text-gray-400">
            Install the package, register the services, start dropping in components.
        </p>

        <div class="mt-8 max-w-2xl">
            <TwCodeBlock Language="html" Content="@quickStartSnippet" />
        </div>
    </section>

    <!-- CTA -->
    <section class="mb-8 mt-16 md:mt-24">
        <TwCard Shadow="Shadow.None">
            <div class="flex flex-col items-start justify-between gap-6 py-4 md:flex-row md:items-center">
                <div>
                    <h2 class="text-2xl font-bold tracking-tight text-purple-700 dark:text-white">Ready to build something great?</h2>
                    <p class="mt-1 max-w-xl text-gray-600 dark:text-gray-400">
                        Jump into the docs and start assembling your UI with twblazor components.
                    </p>
                </div>
                <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
                    <TwButton Id="cta-get-started" Class="w-full justify-center sm:w-auto" Color="Color.Primary" Label="Get started" StartIcon="IconEnum.Rocket_Takeoff" Href="/get-started" />
                    <TwButton Id="cta-github" Class="w-full justify-center sm:w-auto" Color="Color.Accent" Variant="ButtonVariant.Outlined" Label="Star on GitHub" StartIcon="IconEnum.Github" Href="https://github.com/twblazor/twblazor" Target="_blank" rel="noopener noreferrer" />
                </div>
            </div>
        </TwCard>
    </section>

    <!-- Open source commitment -->
    <section class="mb-12 max-w-2xl">
        <p class="text-sm text-gray-600 md:text-base dark:text-gray-400">
            twblazor is and always will be free and open source. We believe great tooling
            should be accessible to every developer, so the library is released under the MIT
            license and built in the open, with contributions from the community.
        </p>
    </section>
</div>

@code {
    private static readonly IReadOnlyList<string> _jsonLd = [TwBlazor.Docs.Services.SiteMetadata.HomeJsonLd()];

    private string email = string.Empty;
    private bool notificationsEnabled = true;

    private TwStepper? checkoutStepper;
    private int checkoutStep;

    private string signInEmail = string.Empty;
    private string signInPassword = string.Empty;
    private bool rememberMe = true;

    private readonly List<Order> orders =
    [
        new() { Number = "#1042", Customer = "Ava Thompson", Status = "Shipped", Total = 249.00m },
        new() { Number = "#1043", Customer = "Noah Patel", Status = "Pending", Total = 89.50m },
        new() { Number = "#1044", Customer = "Mia Garcia", Status = "Delivered", Total = 1299.00m },
        new() { Number = "#1045", Customer = "Liam Chen", Status = "Shipped", Total = 59.99m },
        new() { Number = "#1046", Customer = "Sofia Rossi", Status = "Refunded", Total = 399.00m },
        new() { Number = "#1047", Customer = "Ethan Brown", Status = "Pending", Total = 749.25m },
        new() { Number = "#1048", Customer = "Isla Wright", Status = "Delivered", Total = 24.00m }
    ];

    private readonly List<TwDataTableColumn<Order>> orderColumns =
    [
        new() { Name = "number", Title = "Order", PropertySelector = o => o.Number, IsSortable = true },
        new() { Name = "customer", Title = "Customer", PropertySelector = o => o.Customer, IsSortable = true },
        new() { Name = "status", Title = "Status", PropertySelector = o => o.Status },
        new() { Name = "total", Title = "Total", PropertySelector = o => o.Total, IsSortable = true, CellFormatter = o => $"£{o.Total:N2}" }
    ];

    /// <summary>
    /// A sample order shown in the landing page data table.
    /// </summary>
    public class Order
    {
        public string Number { get; set; } = string.Empty;
        public string Customer { get; set; } = string.Empty;
        public string Status { get; set; } = string.Empty;
        public decimal Total { get; set; }
    }

    private sealed record Figure(string Label, string Value);

    private sealed record Service(string Name, double Uptime, string Status, Color Color);

    private readonly List<string> environments = ["Production", "Staging", "Development"];

    private string projectName = "Atlas";
    private string visibility = "team";
    private string environment = "Production";
    private bool emailAlerts = true;
    private bool autoDeploy;
    private bool settingsSaved;

    private readonly List<Figure> releaseFigures =
    [
        new("Deploys", "128"),
        new("Failed", "3"),
        new("Avg. time", "4m")
    ];

    private readonly List<Service> services =
    [
        new("Web app", 99.98, "Operational", Color.Success),
        new("API", 99.2, "Degraded", Color.Warning),
        new("Database", 100, "Operational", Color.Success),
        new("Workers", 94.1, "Outage", Color.Danger)
    ];

    /// <summary>
    /// Handles the sample settings form. It only demonstrates the controls, so it just confirms the save.
    /// </summary>
    private void SaveSettings() => settingsSaved = true;

    private void ResetSettings()
    {
        projectName = "Atlas";
        visibility = "team";
        environment = "Production";
        emailAlerts = true;
        autoDeploy = false;
        settingsSaved = false;
    }

    /// <summary>
    /// Handles the sample sign-in form. It only demonstrates the controls, so it just clears the password.
    /// </summary>
    private void SignIn() => signInPassword = string.Empty;

    private const string quickStartInstall =
        "dotnet add package twblazor";

    private const string quickStartSnippet =
        "<TwButton Label=\"Get Started\" Color=\"Color.Primary\" />\n" +
        "<TwAlert Color=\"Color.Success\" Dense>Everything is working!</TwAlert>";

    private const string themingSnippet =
        "builder.Services.AddTwBlazor(_ => { }, () => new TwBlazorTheme\n" +
        "{\n" +
        "    // ...position, colors, shadows, rounded...\n" +
        "    Components =\n" +
        "    [\n" +
        "        new TwButtonTheme\n" +
        "        {\n" +
        "            Base = \"inline-flex items-center gap-2 rounded-full font-semibold\",\n" +
        "            Padding = \"px-8\"\n" +
        "        },\n" +
        "        new TwInputTheme\n" +
        "        {\n" +
        "            DefaultInputVariant = InputVariant.Outlined\n" +
        "        }\n" +
        "        // ...every other component you use\n" +
        "    ]\n" +
        "});";
}
