    <!-- Class merging -->
    <section class="@($"relative isolate overflow-hidden {LandingStyles.Band}")" aria-labelledby="merge-heading">
        <div aria-hidden="true" class="pointer-events-none absolute -left-24 top-10 -z-10 size-80">
            <div class="size-full animate-glow-drift-alt rounded-full bg-purple-400/15 blur-3xl motion-reduce:animate-none dark:bg-purple-600/10"></div>
        </div>

        <div class="mx-auto grid max-w-6xl grid-cols-1 gap-10 px-6 py-16 md:py-24 lg:grid-cols-2 lg:items-center lg:gap-14">
            <div class="reveal">
                <p class="inline-flex items-center gap-2 rounded-full border border-purple-200 bg-white/80 px-3 py-1 text-sm font-medium text-purple-800 shadow-xs dark:border-purple-400/30 dark:bg-purple-400/10 dark:text-purple-200">
                    <span class="size-1.5 rounded-full bg-fuchsia-500" aria-hidden="true"></span>
                    <Loc Key="Home_Merge_Badge">Built in. No npm, no JavaScript.</Loc>
                </p>
                <h2 id="merge-heading" class="mt-5 text-2xl font-bold tracking-tight text-balance text-purple-900 md:text-3xl dark:text-white">
                    @Loc.Text("Home_Merge_HeadingLead", "Tailwind class merging,")
                    <span class="@LandingStyles.TextGradient">@Loc.Text("Home_Merge_HeadingAccent", "built right in")</span>
                </h2>
                <p class="mt-3 max-w-xl text-gray-700 text-pretty dark:text-gray-400">
                    <Loc Key="Home_Merge_Sub">Pass <code>Class="px-3"</code> and it replaces the theme's <code>px-6</code>. Your class always wins.</Loc>
                </p>

                <ul class="mt-6 flex flex-col gap-4">
                    @foreach (var point in _mergePoints)
                    {
                        <li class="flex items-start gap-3">
                            <span class="@LandingStyles.Bullet"><TwIcon Icon="IconEnum.Check" Plain /></span>
                            <span>
                                <span class="block font-semibold text-purple-900 dark:text-white">@point.Title</span>
                                <span class="mt-0.5 block text-sm text-gray-600 dark:text-gray-400">@point.Description</span>
                            </span>
                        </li>
                    }
                </ul>

                <a id="merge-docs" href="/class-merge" class="mt-7 inline-flex items-center gap-2 rounded-md font-semibold text-purple-800 underline-offset-4 transition-colors hover:text-fuchsia-700 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-600 dark:focus-visible:outline-purple-300 dark:text-purple-300 dark:hover:text-fuchsia-300">
                    @Loc.Text("Home_Merge_Link", "See how class merging works") <TwIcon Icon="IconEnum.Arrow_Right" Plain />
                </a>
            </div>

            <figure class="@($"reveal min-w-0 {LandingStyles.Figure}")">
                <figcaption class="sr-only"><Loc Key="Home_Merge_Caption">A live example of class merging. Choose an example to change the class passed to the component.</Loc></figcaption>
                <div class="p-6">
                    <div class="flex flex-wrap gap-1.5" role="group" aria-label="@Loc.Text("Home_Merge_GroupLabel", "Class merging example")">
                        @foreach (var example in _mergeExamples)
                        {
                            var isSelected = example == mergeExample;
                            <button type="button" id="@($"merge-example-{example.Id}")" aria-pressed="@(isSelected ? "true" : "false")" @onclick="@(() => mergeExample = example)"
                                    class="@(isSelected ? mergeTabSelectedClasses : mergeTabClasses)">
                                @MergeLabel(example)
                            </button>
                        }
                    </div>

                    <dl class="mt-5 flex flex-col gap-4">
                        <div>
                            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400"><Loc Key="Home_Merge_Theme">Theme</Loc></dt>
                            <dd class="mt-2 flex flex-wrap gap-1.5">
                                @foreach (var themeClass in mergeThemeClassResults)
                                {
                                    if (themeClass.Kept)
                                    {
                                        <span class="@mergeThemeChipClasses">@themeClass.Name</span>
                                    }
                                    else
                                    {
                                        <del class="@mergeRemovedChipClasses"><span class="sr-only">@(Loc.Text("Home_Merge_Replaced", "Replaced:") + " ")</span>@themeClass.Name</del>
                                    }
                                }
                            </dd>
                        </div>
                        <div>
                            <dt class="text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400"><Loc Key="Home_Merge_YourClass">Your Class</Loc></dt>
                            <dd class="mt-2 flex flex-wrap gap-1.5">
                                @foreach (var yourClass in mergeExample.YourClass.Split(' '))
                                {
                                    <span class="@mergeYourChipClasses">@yourClass</span>
                                }
                            </dd>
                        </div>
                    </dl>

                    <div class="mt-5 flex items-center gap-3" aria-hidden="true">
                        <span class="h-px flex-1 bg-linear-to-r from-transparent to-purple-300 dark:to-white/20"></span>
                        <span class="inline-flex size-8 items-center justify-center rounded-full bg-linear-to-br from-purple-600 to-fuchsia-500 text-white"><TwIcon Icon="IconEnum.Arrow_Down" Plain /></span>
                        <span class="h-px flex-1 bg-linear-to-l from-transparent to-purple-300 dark:to-white/20"></span>
                    </div>

                    <div class="@($"mt-5 p-4 {LandingStyles.Well}")" aria-live="polite">
                        <p class="text-xs font-semibold uppercase tracking-wide text-gray-600 dark:text-gray-400"><Loc Key="Home_Rendered">Rendered</Loc></p>
                        <p id="merge-result" class="mt-2 font-mono text-sm break-words text-purple-950 dark:text-purple-100">@mergedClasses</p>
                        <div class="mt-4 flex min-h-14 items-center justify-center rounded-lg border border-dashed border-purple-300/70 bg-white p-3 dark:border-white/15 dark:bg-[oklch(28%_0.016_252.42)]">
                            <span id="merge-preview" class="@mergedClasses">@Loc.Text("Home_SaveChanges", "Save changes")</span>
                        </div>
                    </div>
                </div>
            </figure>
        </div>
    </section>

    <!-- Localization -->
    <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24" aria-labelledby="localization-heading">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-start lg:gap-14">
            <div class="reveal">
                <p class="inline-flex items-center gap-2 rounded-full border border-purple-200 bg-white/80 px-3 py-1 text-sm font-medium text-purple-800 shadow-xs dark:border-purple-400/30 dark:bg-purple-400/10 dark:text-purple-200">
                    <TwIcon Icon="IconEnum.Translate" Plain />
                    @Loc.Format("Home_Loc_Badge", "{0} languages, built in", _localizationLanguages.Count)
                </p>
                <h2 id="localization-heading" class="mt-5 text-2xl font-bold tracking-tight text-balance text-purple-900 md:text-3xl dark:text-white">
                    @Loc.Text("Home_Loc_HeadingLead", "Speaks your users' language,")
                    <span class="@LandingStyles.TextGradient">@Loc.Text("Home_Loc_HeadingAccent", "out of the box")</span>
                </h2>
                <p class="mt-3 max-w-xl text-gray-700 text-pretty dark:text-gray-400">
                    <Loc Key="Home_Loc_Sub">Every label, message and screen reader announcement is translated, and dates follow the culture. Nothing to set up.</Loc>
                </p>

                <ul class="mt-6 flex flex-col gap-4">
                    @foreach (var point in _localizationPoints)
                    {
                        <li class="flex items-start gap-3">
                            <span class="@LandingStyles.Bullet"><TwIcon Icon="IconEnum.Check" Plain /></span>
                            <span>
                                <span class="block font-semibold text-purple-900 dark:text-white">@point.Title</span>
                                <span class="mt-0.5 block text-sm text-gray-600 dark:text-gray-400">@point.Description</span>
                            </span>
                        </li>
                    }
                </ul>

                <a id="localization-docs" href="/localization" class="mt-7 inline-flex items-center gap-2 rounded-md font-semibold text-purple-800 underline-offset-4 transition-colors hover:text-fuchsia-700 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-600 dark:text-purple-300 dark:hover:text-fuchsia-300">
                    @Loc.Text("Home_Loc_Link", "See how localization works") <TwIcon Icon="IconEnum.Arrow_Right" Plain />
                </a>
            </div>

            <div class="reveal min-w-0">
                <ul id="localization-languages" class="flex flex-wrap gap-2" aria-label="@Loc.Text("Home_Loc_LanguagesLabel", "Supported languages")">
                    @foreach (var language in _localizationLanguages.Take(shownLanguageCount))
                    {
                        <li class="@languageChipClasses">
                            <span lang="@language.Culture" dir="auto" class="font-medium text-purple-900 dark:text-white">@language.NativeName</span>
                            <span class="text-xs text-gray-600 dark:text-gray-400">@Loc.Text("Home_Lang_" + language.Culture.Replace("-", ""), language.Name)</span>
                        </li>
                    }
                    <li class="inline-flex">
                        <a id="localization-more-languages" href="/localization#localization-languages" class="inline-flex items-baseline rounded-full border border-purple-200 bg-white px-3 py-1.5 text-sm font-medium text-purple-900 shadow-xs transition-colors hover:border-purple-400 hover:text-purple-950 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:border-white/10 dark:bg-white/5 dark:text-white dark:hover:border-fuchsia-400/50 dark:hover:text-fuchsia-300 dark:focus-visible:outline-purple-300">
                            <span aria-hidden="true">...</span>
                            <span class="sr-only">@Loc.Format("Home_Loc_More", "and {0} more languages", _localizationLanguages.Count - shownLanguageCount)</span>
                        </a>
                    </li>
                </ul>
                <p id="localization-disclaimer" class="mt-4 text-sm text-gray-600 dark:text-gray-400">
                    <Loc Key="Home_Loc_Disclaimer">Non-English translations were produced by AI and are not yet reviewed. <a href="/localization#localization-contributing" class="font-medium text-purple-800 underline underline-offset-2 dark:text-purple-300">Suggest a correction</a>.</Loc>
                </p>
                <div class="mt-6">
                    <TwCodeBlock Language="csharp" Content="@localizationSnippet" Class="rounded-xl" PanelClass="rounded-lg" />
                </div>
            </div>
        </div>
    </section>

    <!-- Right to left -->
    <section class="mx-auto max-w-6xl px-6 pt-16 md:pt-24" aria-labelledby="rtl-heading">
        <div class="grid grid-cols-1 gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
            <div class="reveal lg:order-2">
                <p class="inline-flex items-center gap-2 rounded-full border border-purple-200 bg-white/80 px-3 py-1 text-sm font-medium text-purple-800 shadow-xs dark:border-purple-400/30 dark:bg-purple-400/10 dark:text-purple-200">
                    <TwIcon Icon="IconEnum.Arrow_Left_Right" Plain />
                    <Loc Key="Home_Rtl_Badge">Right to left, built in</Loc>
