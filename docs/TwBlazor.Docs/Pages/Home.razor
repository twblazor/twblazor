@page "/"
@layout LandingLayout
@using IconEnum = TwBlazor.Enums.Icon
@using TwBlazor.Docs.Pages.Showcase.Shared

<PageSeo Title="twblazor | Tailwind Blazor Component Library" Description="twblazor is a free, open-source Blazor components library built on Tailwind CSS. Accessible, themeable, with dark mode, for Server and WebAssembly." Path="/" JsonLd="_jsonLd" />

<!-- Hero -->
<section class="@($"relative isolate overflow-hidden border-b {LandingStyles.Border}")">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 bg-[linear-gradient(to_right,rgb(168_85_247/0.12)_1px,transparent_1px),linear-gradient(to_bottom,rgb(168_85_247/0.12)_1px,transparent_1px)] bg-size-[3rem_3rem] mask-[radial-gradient(ellipse_70%_60%_at_50%_0%,black,transparent)] dark:bg-[linear-gradient(to_right,rgb(168_85_247/0.18)_1px,transparent_1px),linear-gradient(to_bottom,rgb(168_85_247/0.18)_1px,transparent_1px)]"></div>
    <div aria-hidden="true" class="pointer-events-none absolute left-1/2 top-0 -z-10 h-80 w-4xl max-w-full -translate-x-1/2">
        <div class="size-full animate-glow-drift rounded-full bg-linear-to-r from-purple-500/25 via-fuchsia-500/25 to-purple-400/25 blur-3xl motion-reduce:animate-none dark:from-purple-600/20 dark:via-fuchsia-600/15 dark:to-purple-500/15"></div>
    </div>
    <div aria-hidden="true" class="pointer-events-none absolute -right-24 top-24 -z-10 size-72 md:size-96">
        <div class="size-full animate-glow-drift-alt rounded-full bg-fuchsia-400/15 blur-3xl motion-reduce:animate-none dark:bg-fuchsia-600/10"></div>
    </div>

    <div class="mx-auto max-w-6xl px-6 pb-16 pt-16 md:pb-24 md:pt-24">
        <div class="mx-auto flex max-w-3xl flex-col items-center text-center">
            <a href="/get-started" class="inline-flex animate-fade-up items-center gap-2 rounded-full border border-purple-200 bg-white/80 px-3 py-1 text-sm font-medium text-purple-800 shadow-xs transition-colors hover:border-purple-400 hover:text-purple-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 motion-reduce:animate-none dark:border-purple-400/30 dark:bg-purple-400/10 dark:text-purple-200 dark:hover:border-purple-300/60 dark:hover:text-white dark:focus-visible:outline-purple-300">
                <span class="relative flex size-1.5" aria-hidden="true">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-fuchsia-400 opacity-75 motion-reduce:hidden"></span>
                    <span class="relative inline-flex size-1.5 rounded-full bg-fuchsia-500"></span>
                </span>
                <Loc Key="Home_Hero_Badge">Free, open source and MIT licensed</Loc>
            </a>
            @* Kept on one line: the words are separate spans, and line breaks between them would change the heading's text. *@
            @if (_heroWords is null)
            {
            <h1 dir="auto" class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-balance text-gray-950 perspective-[900px] sm:text-5xl md:text-6xl dark:text-white"><span class="@heroWordClasses [animation-delay:100ms]">The</span> <span class="@heroWordClasses [animation-delay:180ms]">Tailwind</span> <span class="@heroWordClasses [animation-delay:260ms]">CSS</span> <span class="@heroWordClasses [animation-delay:340ms]">component</span> <span class="@heroWordClasses [animation-delay:420ms]">library</span> <span class="@heroWordClasses [animation-delay:500ms]"><span class="animate-gradient-pan bg-linear-to-r from-purple-700 via-fuchsia-600 to-purple-700 bg-size-[200%_auto] bg-clip-text text-transparent motion-reduce:animate-none dark:from-purple-300 dark:via-fuchsia-300 dark:to-purple-300">for Blazor</span></span></h1>
            }
            else
            {
                @* A translated heading: its words rise in turn like the English one, delayed inline because the delay classes above are written out for the English words only. *@
                <h1 dir="auto" class="mt-6 text-4xl font-bold leading-[1.1] tracking-tight text-balance text-gray-950 perspective-[900px] sm:text-5xl md:text-6xl dark:text-white">@for (var i = 0; i < _heroWords.Length; i++) { <span class="@heroWordClasses" style="@($"animation-delay:{100 + i * 80}ms")">@_heroWords[i]</span><text> </text> }<span class="@heroWordClasses" style="@($"animation-delay:{100 + _heroWords.Length * 80}ms")"><span class="animate-gradient-pan bg-linear-to-r from-purple-700 via-fuchsia-600 to-purple-700 bg-size-[200%_auto] bg-clip-text text-transparent motion-reduce:animate-none dark:from-purple-300 dark:via-fuchsia-300 dark:to-purple-300">@Loc.Text("Home_Hero_TitleAccent", "for Blazor")</span></span></h1>
            }
            <p class="mt-5 max-w-xl animate-fade-up text-lg/7 text-gray-600 text-pretty [animation-delay:650ms] motion-reduce:animate-none dark:text-gray-300">
                <Loc Key="Home_Hero_Subtitle">Accessible, themeable components for Blazor Server and WebAssembly.</Loc>
            </p>

            <div class="mt-8 flex w-full animate-fade-up flex-col justify-center gap-3 [animation-delay:750ms] motion-reduce:animate-none sm:w-auto sm:flex-row">
                <TwButton Id="get-started" Class="w-full justify-center sm:w-auto" Color="Color.Primary" Label="@Loc.Text("Home_GetStarted", "Get started")" StartIcon="IconEnum.Rocket_Takeoff" Href="/get-started" />
                <TwButton Id="github" Class="w-full justify-center sm:w-auto" Color="Color.Accent" Variant="ButtonVariant.Outlined" Label="@Loc.Text("Home_Hero_GitHub", "View on GitHub")" StartIcon="IconEnum.Github" Href="https://github.com/twblazor/twblazor" Target="_blank" rel="noopener noreferrer" />
            </div>

            <div class="mt-8 w-full max-w-md animate-fade-up [animation-delay:850ms] motion-reduce:animate-none">
                @* The beam is a conic gradient behind a 1px gap around the code block; its start angle turns. *@
                <div class="animate-beam rounded-[calc(var(--radius-xl)+1px)] bg-[conic-gradient(from_var(--beam-angle),rgb(168_85_247/0.25)_0%,rgb(168_85_247/0.25)_65%,var(--color-fuchsia-500)_80%,var(--color-purple-500)_90%,rgb(168_85_247/0.25)_100%)] p-px shadow-xl shadow-purple-900/10 dark:shadow-black/30 [animation-delay:1.6s] motion-reduce:animate-none">
                    <TwCodeBlock Language="pwsh" Content="@quickStartInstall" Class="w-full rounded-xl text-left" PanelClass="rounded-lg" Title="@Loc.Text("Home_Hero_Install", "Install")" />
                </div>
            </div>
        </div>

        <!-- Live examples: one framed, tabbed showcase with its own colour and light or dark mode -->
        <section class="mt-16 animate-fade-up text-left [animation-delay:950ms] motion-reduce:animate-none md:mt-20" aria-labelledby="examples-heading">
            <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-3">
                <div>
                    <p class="text-sm font-semibold uppercase tracking-wide text-fuchsia-700 dark:text-fuchsia-300"><Loc Key="Home_Examples_Heading">Real components. Ready for your app.</Loc></p>
                    <h2 id="examples-heading" class="mt-2 text-3xl font-bold leading-[1.3] tracking-tight text-purple-900 md:text-4xl dark:text-white">
                        <span class="sr-only">@Loc.Format("Home_Features_HeadingFull", "Built for your next {0} or {1}.", string.Join(", ", _cycleWords.Take(_cycleWords.Count - 1)), _cycleWords[^1])</span>
                        <span aria-hidden="true">@Loc.Text("Home_Features_HeadingLead", "Built for your next") <span class="@(wordCyclePaused ? "word-cycle is-paused" : "word-cycle")"><span class="word-cycle-track">@foreach (var word in _cycleWords){<span class="@LandingStyles.TextGradient">@(word).</span>}<span class="@LandingStyles.TextGradient">@(_cycleWords[0]).</span></span></span>@Loc.Text("Home_Features_HeadingTrail", "")</span>
                    </h2>
                </div>
                <div class="flex items-center gap-3">
                    <p class="inline-flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
                        <span class="size-2 rounded-full bg-emerald-500" aria-hidden="true"></span>
                        <Loc Key="Home_Examples_Sub">Every example is live. Try them.</Loc>
                    </p>
                    <button type="button" id="word-cycle-toggle" class="inline-flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-full border border-purple-200 bg-white/80 text-purple-800 transition-colors hover:border-purple-400 hover:text-purple-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 motion-reduce:hidden dark:border-purple-400/30 dark:bg-purple-400/10 dark:text-purple-200 dark:hover:border-purple-300/60 dark:hover:text-white dark:focus-visible:outline-purple-300" aria-label="@(wordCyclePaused ? Loc.Text("Home_Features_Play", "Play the changing heading") : Loc.Text("Home_Features_Pause", "Pause the changing heading"))" @onclick="@(() => wordCyclePaused = !wordCyclePaused)">
                        <TwIcon Icon="@(wordCyclePaused ? IconEnum.Play_Fill : IconEnum.Pause_Fill)" Plain />
                    </button>
                </div>
            </div>

            <div id="showcase" class="@showcaseFrameClasses">
                <TwTabContainer Id="showcase-tabs" Scrollable AriaLabel="@Loc.Text("Home_Showcase_Tabs", "Examples")"
                                TabBarClass="@($"rounded-t-2xl border-b px-3 py-3 lg:px-4 {LandingStyles.Border}")"
                                ContainerClass="mt-0 rounded-none rounded-b-2xl focus-visible:ring-inset">
                    <TabBarContent>
                        <div class="flex items-center gap-2.5" role="radiogroup" aria-labelledby="showcase-colour-label">
                            <span id="showcase-colour-label" class="me-1 text-xs text-gray-600 dark:text-gray-400"><Loc Key="Home_Showcase_Theme">Example colour</Loc></span>
                            @foreach (var swatch in _showcaseSwatches)
                            {
                                <label class="relative inline-flex size-7 cursor-pointer items-center justify-center" title="@swatch.Label">
                                    <input type="radio" name="showcase-colour" class="peer sr-only" checked="@(swatch == showcaseSwatch)" @onchange="() => SelectSwatch(swatch)" aria-label="@swatch.Label" />
                                    <span class="@($"flex size-6 items-center justify-center rounded-full text-xs text-white ring-offset-2 ring-offset-white transition-shadow peer-checked:ring-2 peer-checked:ring-gray-950/70 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-4 peer-focus-visible:outline-purple-600 dark:ring-offset-gray-900 dark:peer-checked:ring-white/80 {swatch.SwatchClass}")" aria-hidden="true">
                                        @if (swatch == showcaseSwatch)
                                        {
                                            <TwIcon Icon="IconEnum.Check_Lg" Plain />
                                        }
                                    </span>
                                </label>
                            }
                        </div>
                        <span class="h-6 w-px bg-gray-200 dark:bg-white/10" aria-hidden="true"></span>
                        <button type="button" id="showcase-mode" class="inline-flex size-9 cursor-pointer items-center justify-center rounded-lg text-gray-700 transition-colors hover:bg-gray-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:text-gray-200 dark:hover:bg-white/10 dark:focus-visible:outline-purple-300"
                                aria-label="@(showcaseDark ? Loc.Text("Home_Showcase_Light", "Show the example in light mode") : Loc.Text("Home_Showcase_Dark", "Show the example in dark mode"))"
                                @onclick="ToggleShowcaseMode">
                            <TwIcon Icon="@(showcaseDark ? IconEnum.Sun : IconEnum.Moon)" Plain />
                        </button>
                    </TabBarContent>
                    <ChildContent>
                        <TwTab Id="showcase-tab-forms" Label="@Loc.Text("Nav_Group_forms", "Forms")" Icon="IconEnum.Ui_Checks">
                            @ShowcasePane(Loc.Text("Nav_Group_forms", "Forms"), Loc.Text("Home_Showcase_Forms_Desc", "Sign-in, checkout and settings forms, built from the same inputs."), "/form",
                                @<ShowcaseForms BrandColour="@showcaseSwatch.Hex" />)
                        </TwTab>

                        <TwTab Id="showcase-tab-dashboard" Label="@Loc.Text("Home_Showcase_DashboardTab", "Dashboard")" Icon="IconEnum.Speedometer2">
                            @ShowcasePane(Loc.Text("Home_Release_Title", "Release health"), Loc.Text("Home_Showcase_Dashboard_Desc", "Alerts, figures and charts, ready for a dashboard."), "/chart",
                                @<div class="flex flex-col gap-5">
                                    <div class="flex flex-wrap items-center justify-between gap-3">
                                        <TwBreadcrumb Id="showcase-breadcrumb" Breadcrumbs="@_dashboardCrumbs" />
                                        <TwChip Label="v2.4.0" Color="Color.Success" Variant="ButtonVariant.Filled" Size="ChipSize.Small" StartIcon="IconEnum.Check" />
                                    </div>
                                    <TwAlert Dense Role="none" Color="Color.Accent" StartIcon="IconEnum.Exclamation_Circle"><Loc Key="Home_Release_Storage">Storage nearing capacity.</Loc></TwAlert>
                                    <dl class="grid grid-cols-3 gap-3">
                                        @foreach (var figure in _releaseFigures)
                                        {
                                            <div class="flex flex-col-reverse rounded-xl border border-gray-200 px-4 py-3 dark:border-white/10">
                                                <dt class="text-xs text-gray-600 sm:text-sm dark:text-gray-400">@figure.Label</dt>
                                                <dd class="text-xl font-bold tabular-nums text-gray-950 sm:text-2xl dark:text-white">@figure.Value</dd>
                                            </div>
                                        }
                                    </dl>
                                    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
                                        <TwChart Title="@Loc.Text("Home_Chart_Response", "Response time")" Description="@Loc.Text("Home_Chart_ResponseDesc", "95th percentile, last 24 hours")" Height="ChartHeight.Small" Class="min-w-0">
                                            <TwLineChart Categories="@_responseHours" Series="@_responseTimes" Curve="ChartCurve.Smooth" ValueFormat="#,0 ms" CategoryHeader="@Loc.Text("Home_Chart_Hour", "Hour")" />
                                        </TwChart>
                                        <TwChart Title="@Loc.Text("Home_Chart_Deploys", "Deploys per day")" Description="@Loc.Text("Home_Chart_DeploysDesc", "Last 14 days")" Height="ChartHeight.Small" Class="min-w-0">
                                            <TwColumnChart Categories="@_deployDays" Series="@_deploys" Stacking="ChartStacking.Stacked" CategoryHeader="@Loc.Text("Home_Chart_Day", "Day")" />
                                        </TwChart>
                                    </div>
                                </div>)
                        </TwTab>

                        <TwTab Id="showcase-tab-charts" Label="@Loc.Text("Nav_Group_charts", "Charts")" Icon="IconEnum.Bar_Chart_Line">
                            @ShowcasePane(Loc.Text("Nav_Group_charts", "Charts"), Loc.Format("Home_Showcase_Charts_Desc", "{0}+ chart types with one consistent look. Try nine of them here.", _chartTypeCount), $"/chart/{showcaseChartType.ToLowerInvariant()}",
                                @<div>
                                    @* The chart types are component names, so they stay in English like the sidebar's. *@
                                    <div class="-mx-4 overflow-x-auto px-4 [scrollbar-width:none] sm:-mx-6 sm:px-6 [&::-webkit-scrollbar]:hidden">
                                        <div class="inline-flex w-max gap-1 rounded-xl bg-gray-100 p-1 dark:bg-white/5" role="group" aria-label="@Loc.Text("Home_Showcase_ChartTypes", "Chart type")">
                                            @foreach (var type in _showcaseChartTypes)
                                            {
                                                var isSelected = type == showcaseChartType;
                                                <button type="button" id="@($"showcase-chart-{type.ToLowerInvariant()}")" aria-pressed="@(isSelected ? "true" : "false")"
                                                        class="@(isSelected ? chartTypeActiveClasses : chartTypeClasses)" @onclick="() => showcaseChartType = type">
                                                    @type
                                                </button>
                                            }
                                        </div>
                                    </div>
                                    <div class="mt-5 min-w-0">
                                        @switch (showcaseChartType)
                                        {
                                            case "Area":
                                                <TwChart Title="@Loc.Text("Home_Chart_Response", "Response time")" Description="@Loc.Text("Home_Chart_ResponseDesc", "95th percentile, last 24 hours")" Class="min-w-0">
                                                    <TwAreaChart Categories="@_responseHours" Series="@_responseTimes" />
                                                </TwChart>
                                                break;
                                            case "Column":
                                                <TwChart Title="@Loc.Text("Home_Chart_Deploys", "Deploys per day")" Description="@Loc.Text("Home_Chart_DeploysDesc", "Last 14 days")" Class="min-w-0">
                                                    <TwColumnChart Categories="@_deployDays" Series="@_deploys" Stacking="ChartStacking.Stacked" />
                                                </TwChart>
                                                break;
                                            case "Line":
                                                <TwChart Title="@Loc.Text("Home_Chart_Response", "Response time")" Description="@Loc.Text("Home_Chart_ResponseDesc", "95th percentile, last 24 hours")" Class="min-w-0">
                                                    <TwLineChart Categories="@_responseHours" Series="@_responseTimes" Curve="ChartCurve.Smooth" ValueFormat="#,0 ms" />
                                                </TwChart>
                                                break;
                                            case "Bar":
                                                <TwChart Title="@Loc.Text("Home_Release_Deploys", "Deploys")" Class="min-w-0">
                                                    <TwBarChart Categories="@_environments" Series="@_environmentDeploys" />
                                                </TwChart>
                                                break;
                                            case "Pie":
                                                <TwChart Title="@Loc.Text("Home_Chart_Storage", "Storage by folder")" Description="@Loc.Text("Home_Chart_StorageDesc", "7.2 GB across 10 folders")" Class="min-w-0">
                                                    <TwPieChart Data="@_storageFolders" InnerRadius="0.6" CenterText="7.2 GB" />
                                                </TwChart>
                                                break;
                                            case "Treemap":
                                                <TwChart Title="@Loc.Text("Home_Chart_Storage", "Storage by folder")" Description="@Loc.Text("Home_Chart_StorageDesc", "7.2 GB across 10 folders")" Class="min-w-0">
                                                    <TwTreemapChart Data="@_storageFolders" ValueFormat="0.0 GB" LabelHeader="@Loc.Text("Home_Chart_Folder", "Folder")" ValueHeader="@Loc.Text("Home_Chart_Size", "Size")" />
                                                </TwChart>
                                                break;
                                            case "Funnel":
                                                <TwChart Title="@Loc.Text("Home_Checkout_Progress", "Checkout progress")" Class="min-w-0">
                                                    <TwFunnelChart Data="@_checkoutFunnel" />
                                                </TwChart>
                                                break;
                                            case "Gauge":
                                                <TwChart Title="@Loc.Text("Home_Settings_Storage", "Storage used")" Class="min-w-0">
                                                    <TwGaugeChart Value="72" Label="@Loc.Text("Home_Settings_StorageAmount", "7.2 of 10 GB")" />
                                                </TwChart>
                                                break;
                                            case "Heatmap":
                                                <TwChart Title="@Loc.Text("Home_Release_Deploys", "Deploys")" Class="min-w-0">
                                                    <TwHeatmapChart Categories="@_weekdays" Series="@_environmentWeek" ShowValues="true" />
                                                </TwChart>
                                                break;
                                        }
                                    </div>
                                </div>)
                        </TwTab>
                    </ChildContent>
                </TwTabContainer>
            </div>

            @* What the library holds, counted from components.json so the numbers keep up as components are added. *@
            <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-3 text-sm text-gray-600 dark:text-gray-400" aria-label="@Loc.Text("Home_Stats_Label", "twblazor at a glance")">
                @foreach (var stat in _stats)
                {
                    <li class="inline-flex items-center gap-2">
                        <TwIcon Icon="@stat.Icon" Plain Class="text-purple-600 dark:text-purple-300" />
                        <span class="font-medium text-gray-950 dark:text-white">@stat.Text</span>
                    </li>
                }
            </ul>
        </section>
    </div>
</section>

<div class="text-gray-950 dark:text-white">

    <!-- Accessibility -->
    <section class="@LandingStyles.Band" aria-labelledby="accessibility-heading">
        <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
            <div class="reveal max-w-2xl">
                <p class="@($"inline-flex items-center gap-2 rounded-full px-3 py-1 text-sm font-medium {LandingStyles.Pill}")">
                    <TwIcon Icon="IconEnum.Universal_Access" Plain />
                    <Loc Key="Home_A11y_Badge">Accessible by default</Loc>
                </p>
                <h2 id="accessibility-heading" class="mt-5 text-2xl font-bold tracking-tight text-balance text-purple-900 md:text-3xl dark:text-white">
                    @Loc.Text("Home_A11y_HeadingLead", "Built for everyone,")
                    <span class="@LandingStyles.TextGradient">@Loc.Text("Home_A11y_HeadingAccent", "keyboard to screen reader")</span>
                </h2>
                <p class="mt-3 text-gray-700 text-pretty dark:text-gray-400">
                    <Loc Key="Home_A11y_Sub">Every component follows the WAI-ARIA patterns, so the people using your app can do it their way. Nothing to switch on.</Loc>
                </p>
            </div>

            <ul class="reveal-group mt-10 grid auto-rows-fr grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3" aria-labelledby="accessibility-heading">
                @foreach (var point in _accessibilityPoints)
                {
                    <li class="@($"flex items-center gap-4 p-5 {LandingStyles.Card}")">
                        <span class="@LandingStyles.IconTileSoft"><TwIcon Icon="@point.Icon" Plain /></span>
                        <span>
                            <span class="block font-semibold text-purple-900 dark:text-white">@point.Title</span>
                            <span class="mt-1 block text-sm text-gray-600 dark:text-gray-400">@point.Description</span>
                        </span>
                    </li>
                }
            </ul>
        </div>
    </section>

    <!-- Theming -->
    <section class="bg-purple-950 text-white" aria-labelledby="theming-heading">
        <div class="relative isolate overflow-hidden">
            <div aria-hidden="true" class="pointer-events-none absolute -right-32 -top-32 -z-10 size-120 rounded-full bg-fuchsia-600/25 blur-3xl"></div>
            <div class="mx-auto max-w-6xl px-6 py-16 md:py-24">
                <div class="reveal">
                    <h2 id="theming-heading" class="max-w-2xl text-2xl font-bold tracking-tight text-white text-balance md:text-3xl"><Loc Key="Home_Theming_Heading">The deepest Tailwind theming of any Blazor library</Loc></h2>
                    <p class="mt-3 max-w-2xl text-purple-200">
                        <Loc Key="Home_Theming_Sub">Every visual detail is a plain Tailwind class you own, typed per component. No black box in a DLL.</Loc>
                    </p>
                </div>

                <div class="mt-8 grid grid-cols-1 gap-10 lg:grid-cols-2 lg:gap-14">
                    <div class="reveal-group grid auto-rows-fr gap-6">
                        @foreach (var point in _themingPoints)
                        {
                            <div class="flex items-start gap-4">
                                <span class="@LandingStyles.IconTile"><TwIcon Icon="@point.Icon" Plain /></span>
                                <div>
                                    <h3 class="font-semibold text-white">@point.Title</h3>
                                    <p class="mt-1 text-sm text-purple-200">@point.Description</p>
                                </div>
                            </div>
                        }
                    </div>

                    <figure class="reveal min-w-0" aria-labelledby="theme-build-caption">
                        <figcaption id="theme-build-caption" class="sr-only"><Loc Key="Home_Theming_Caption">Three lines of Theme.cs restyling a live button, shown beside the button as it was: fully rounded corners, a large shadow and a pink primary colour.</Loc></figcaption>
                        <div data-stage class="overflow-hidden rounded-lg border border-white/10 bg-gray-950 shadow-xl shadow-black/30">
                            <CodeWindowBar Title="Theme.cs" Icon="IconEnum.Filetype_Cs" />
                            <pre dir="ltr" class="overflow-x-auto whitespace-pre-wrap break-words px-4 py-4 font-mono text-xs leading-6 text-gray-300 sm:px-5 sm:text-[13px] sm:leading-7 md:whitespace-pre"><code><span class="block text-gray-400">// Change the theme, not the component</span><span class="stage-line block" style="--i:0"><span class="text-sky-300">DefaultRounded</span> = <span class="text-fuchsia-300">Rounded</span>.Full,</span><span class="stage-line block" style="--i:1"><span class="text-sky-300">DefaultShadow</span> = <span class="text-fuchsia-300">Shadow</span>.Lg,</span><span class="stage-line block" style="--i:2"><span class="text-sky-300">Primary</span> = <span class="text-emerald-300">"bg-pink-700"</span>,<span class="stage-caret ms-0.5 inline-block h-4 w-2 translate-y-0.5 bg-fuchsia-400" aria-hidden="true"></span></span></code></pre>
                            <div class="flex flex-col items-center gap-6 border-t border-white/10 bg-white/5 px-4 py-8 sm:px-5">
                                <div class="flex flex-col items-center gap-3 sm:flex-row sm:items-end sm:gap-6">
                                    <div class="flex flex-col items-center gap-3">
                                        <span class="text-xs font-semibold uppercase tracking-wide text-purple-200"><Loc Key="Home_Theming_Before">Before</Loc></span>
                                        <TwButton Id="theme-build-before" Color="Color.Primary" Label="@Loc.Text("Home_SaveChanges", "Save changes")" StartIcon="IconEnum.Check_Lg" />
                                    </div>
                                    <span class="rotate-90 text-xl text-fuchsia-300 sm:mb-2 sm:rotate-0 sm:rtl:-scale-x-100" aria-hidden="true"><TwIcon Icon="IconEnum.Arrow_Right" Plain /></span>
                                    <div class="flex flex-col items-center gap-3">
                                        <span class="text-xs font-semibold uppercase tracking-wide text-fuchsia-200"><Loc Key="Home_Theming_After">After</Loc></span>
                                        <TwButton Id="theme-build-after" Color="Color.Primary" Label="@Loc.Text("Home_SaveChanges", "Save changes")" StartIcon="IconEnum.Check_Lg" Class="theme-morph" />
                                    </div>
                                </div>
                                @* Each tag appears as its line of Theme.cs takes effect on the After button. *@
                                <ul id="theme-build-changes" class="flex flex-wrap justify-center gap-2" aria-label="@Loc.Text("Home_Theming_WhatChanged", "What changed")">
                                    @foreach (var (change, index) in _themeBuildChanges.Select((change, index) => (change, index)))
                                    {
                                        <li class="stage-pop grid" style="@($"--i:{index}; --stage-radius:9999px")">
                                            <span class="inline-flex items-center gap-1.5 rounded-full border border-fuchsia-300/40 bg-fuchsia-500/15 px-2.5 py-1 text-xs font-medium text-fuchsia-100"><TwIcon Icon="IconEnum.Check" Plain />@change</span>
                                        </li>
                                    }
                                </ul>
                                <span class="stage-done inline-flex items-center gap-1.5 text-xs font-medium text-fuchsia-200" style="--i:2">
                                    <TwIcon Icon="IconEnum.Stars" Plain />
                                    <Loc Key="Home_Theming_Restyled">Restyled from Theme.cs, no CSS</Loc>
                                </span>
                            </div>
                        </div>
                    </figure>
                </div>

                <div id="theme-case-study" class="mt-14 border-t border-white/15 pt-12">
                    <div class="reveal">
                        <p class="text-sm font-semibold uppercase tracking-wide text-fuchsia-300"><Loc Key="Home_Case_Eyebrow">See it in action</Loc></p>
                        <h3 id="theme-case-study-heading" class="mt-2 max-w-2xl text-xl font-bold tracking-tight text-white text-balance md:text-2xl"><Loc Key="Home_Case_Heading">Well-known looks, one component library</Loc></h3>
                        <p class="mt-3 max-w-2xl text-purple-200"><Loc Key="Home_Case_Sub">Same components, different <code>Theme.cs</code>.</Loc></p>
                    </div>

                    <ul class="reveal-group mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4" aria-labelledby="theme-case-study-heading">
                        @foreach (var brand in ShowcaseBrand.All)
                        {
                            <li class="flex">
                                <a id="@($"theme-case-study-{brand.Slug}")" href="@brand.Path" class="group flex w-full flex-col gap-3 rounded-xl border border-white/15 bg-white/5 p-5 transition duration-300 hover:-translate-y-0.5 hover:border-white/30 hover:bg-white/10 hover:shadow-lg hover:shadow-black/30 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white motion-reduce:transition-none motion-reduce:hover:translate-y-0">
                                    <span class="flex gap-1.5" aria-hidden="true">
                                        @foreach (var swatch in brand.Swatches)
                                        {
                                            <span class="size-5 rounded-full ring-1 ring-white/40" style="@($"background-color: {swatch};")"></span>
                                        }
                                    </span>
                                    <span class="font-semibold text-white">@((MarkupString)Loc.Format("Home_Case_Inspired", "{0}<span class=\"font-normal text-purple-200\">-inspired</span>", brand.Name))</span>
                                    <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-fuchsia-200 underline-offset-4 group-hover:underline">@Loc.Text("Home_Case_SeeTheme", "See the theme") <TwIcon Icon="IconEnum.Arrow_Right" Plain /></span>
                                </a>
                            </li>
                        }
                    </ul>

                    @* The full disclaimer is at the bottom of each example page. *@
                    <p id="theme-case-study-disclaimer" class="mt-6 text-xs text-purple-200">@Loc.Text("Home_Brand_ShortDisclaimer", ShowcaseBrand.ShortDisclaimer)</p>
                </div>
            </div>
        </div>
    </section>

