@page "/file-upload"
@using Microsoft.AspNetCore.Components.Forms
@using System.Linq

<PageContainer Title="TwFileUpload" Path="/file-upload" Description="TwFileUpload is a Blazor file upload component. Bind Files, restrict types with AllowedFileTypes, allow Multiple files and handle OnChange." ThemeType="typeof(TwButtonTheme)">
    <PageCard Title="Basic File Upload">
        <Description>Use <code>Icon</code>, <code>Label</code>, <code>Variant</code> and <code>Color</code> to style the upload button, and <code>Multiple</code> to allow more than one file.</Description>
        <CodeExample Name="FileUploadBasic">
            <div class="space-y-4">
                <TwFileUpload Id="basic-file-upload" Icon="@Icon.Upload" Label="Upload file" Variant="ButtonVariant.Outlined" Color="Color.Success" />
                <TwFileUpload Id="multiple-file-upload" Icon="@Icon.Files" Label="Upload multiple files" Multiple Variant="ButtonVariant.Filled" Color="Color.Accent" />
                <TwFileUpload Id="basic-file-upload-2" Icon="Icon.Cloud_Upload" Label="Upload a document" Color="Color.Primary" Variant="ButtonVariant.Outlined" />
                <TwFileUpload Id="basic-file-upload-3" Icon="Icon.Airplane_Fill" Disabled Label="Disabled upload input" Variant="ButtonVariant.Filled" Color="Color.Accent" />
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Binding">
        <Description>Bind <code>@("@bind-Files")</code> to access the list of selected files.</Description>
        <CodeExample Name="FileUploadBinding" CSharpName="FileUploadBindingCode">
            <div class="space-y-4">
                <TwFileUpload Id="binding-upload" Icon="@Icon.Upload" Label="Bind files" Multiple @bind-Files="@boundFiles" Variant="ButtonVariant.Outlined" Color="Color.Primary" />

                <div class="mt-2">
                    <strong>Selected files</strong>
                    <ul>
                        @foreach (var f in boundFiles ?? Enumerable.Empty<IBrowserFile>())
                        {
                            <li>@f.Name (@(f.Size) bytes)</li>
                        }
                    </ul>
                </div>
            </div>
        </CodeExample>
    </PageCard>

    <PageCard Title="Accept (Allowed file types)">
        <Description>Use <code>AllowedFileTypes</code> to restrict which file types can be selected, via the <code>accept</code> attribute.</Description>
        <CodeExample Name="FileUploadAllowedTypes">
            <div class="space-y-4">
                <TwFileUpload Id="accept-upload" Icon="@Icon.Upload" Label="Upload images only" AllowedFileTypes="@(new[] { ".png", ".jpg", "image/png", "image/jpeg" })" Variant="ButtonVariant.Filled" Color="Color.Primary" />
            </div>
        </CodeExample>
    </PageCard>
</PageContainer>

@code {
    #region CodeExample FileUploadBindingCode
    private List<IBrowserFile>? boundFiles = new();
    #endregion
}