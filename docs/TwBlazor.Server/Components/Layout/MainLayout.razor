@inherits LayoutComponentBase

@Body

<div id="blazor-error-ui" data-nosnippet role="alert" class="hidden fixed inset-x-0 bottom-0 z-130 box-border px-5 py-3 pr-10 text-sm shadow-[0_-1px_2px_rgba(0,0,0,0.2)] bg-amber-50 text-gray-900 dark:bg-neutral-800 dark:text-neutral-100">
    An unhandled error has occurred.
    <a href="." class="reload underline font-medium hover:no-underline">Reload</a>
    <button type="button" class="dismiss absolute right-3 top-2 cursor-pointer leading-none" aria-label="Dismiss"><span aria-hidden="true">🗙</span></button>
</div>
