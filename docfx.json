{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "src/TwBlazor/bin/Release/net10.0",
          "files": [
            "TwBlazor.dll"
          ]
        }
      ],
      "dest": "api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "**/*.{md,yml}"
        ],
        "exclude": [
          "_site/**",
          "obj/**",
          "bin/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      },
      {
        "src": "docs/TwBlazor.Docs/wwwroot/fonts",
        "files": [
          "**/*.woff2"
        ],
        "dest": "fonts"
      }
    ],
    "fileMetadata": {
      "title": {
        "index.md": "API Documentation"
      },
      "description": {
        "index.md": "API reference for twblazor, the Tailwind CSS component library for Blazor. Browse every component, parameter and type in the TwBlazor namespace."
      }
    },
    "output": "_site",
    "template": [
      "default",
      "modern",
      "docs/templates"
    ],
    "globalMetadata": {
      "_appName": "twblazor",
      "_appTitle": "twblazor",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/logo.svg",
      "_appFooter": "<span>twblazor &bullet; Tailwind CSS components for Blazor. <a href=\"https://twblazor.com/\" target=\"_blank\" rel=\"noopener noreferrer\">Documentation</a> &bullet; <a href=\"https://github.com/twblazor/twblazor\" target=\"_blank\" rel=\"noopener noreferrer\">GitHub</a> &bullet; Built with <a href=\"https://dotnet.github.io/docfx\" target=\"_blank\" rel=\"noopener noreferrer\">docfx</a></span>",
      "_enableSearch": true,
      "pdf": false
    }
  }
}