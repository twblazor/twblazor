@namespace TwBlazor.Components
@inherits TwBlazorComponentBase

<div id="@Id" class="@cardClasses" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy">
    @if (hasMedia)
    {
        <div class="@mediaClasses">
            @if (hasImage)
            {
                <img src="@ImageSrc" alt="@(ImageAlt ?? string.Empty)" class="@imageClasses" loading="lazy" decoding="async" />
            }
            @MediaContent
        </div>
    }

    @if (hasContent)
    {
        <div class="@theme.Content">
            @if (hasHeader)
            {
                <div class="@theme.Header">
                    @if (!string.IsNullOrEmpty(Title))
                    {
                        @renderTitle
                    }
                    @HeaderContent
                </div>
            }

            @ChildContent
        </div>
    }

    @if (FooterContent is not null)
    {
        <div class="@theme.Footer">
            @FooterContent
        </div>
    }
</div>
