@namespace TwBlazor.Components
@inherits TwBlazorComponentBase

@if (matrix is not null)
{
    <svg id="@Id" class="@classes" style="@Style" xmlns="http://www.w3.org/2000/svg" viewBox="@viewBox" shape-rendering="crispEdges" focusable="false" role="img" aria-label="@accessibleName" aria-labelledby="@AriaLabelledBy" @attributes="Attributes">
        <rect class="@theme.Light" width="100%" height="100%" />
        <path class="@theme.Dark" d="@path" />
    </svg>
}
