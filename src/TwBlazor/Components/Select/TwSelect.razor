@typeparam T
@inherits TwPopoverPickerComponentBase
@namespace TwBlazor.Components
@using TwBlazor.Enums

<TwInputRoot @ref="@InputRoot" RootId="@RootId" RootClass="@RootClass" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy" RootErrorMessage="@fieldErrorMessage" RootErrorId="@errorId">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" Class="@LabelClasses" @attributes="@LabelAttributes" />
    }

    @if (!Multiple && UseNativePicker)
    {
        <div class="@options.Theme.Position.Relative">
        <select id="@Id"
                class="@classes"
                style="@clearPaddingStyle"
                value="@selectedValueId"
                required="@Required"
                @onchange="@HandleChange"
                @attributes="@Attributes"
                aria-required="@(Required ? "true" : null)"
                aria-readonly="@(ReadOnly ? "true" : null)"
                aria-invalid="@(fieldInvalid ? "true" : null)"
                aria-describedby="@errorId"
                aria-label="@AriaLabel"
                aria-labelledby="@AriaLabelledBy">
            @if (!Required)
            {
                <option value="0" selected="@(selectedValueId == 0)" class="@theme.SelectOption">@effectivePlaceholder</option>
            }
            @foreach (var (key, value) in parsedValues)
            {
                <option value="@key" selected="@(key == selectedValueId)" class="@theme.SelectOption">
                    @GetDisplayText(value)
                </option>
            }
        </select>
        @clearButton
        </div>
    }
    else if (!Multiple)
    {
        <div class="@options.Theme.Position.Relative">
            <button type="button"
                    id="@Id"
                    class="@customTriggerClasses"
                    role="combobox"
                    aria-haspopup="listbox"
                    aria-expanded="@(isFocused ? "true" : "false")"
                    aria-controls="@(isFocused ? listboxId : null)"
                    aria-required="@(Required ? "true" : null)"
                    aria-readonly="@(ReadOnly ? "true" : null)"
                    aria-invalid="@(fieldInvalid ? "true" : null)"
                    aria-describedby="@errorId"
                    aria-label="@AriaLabel"
                    aria-labelledby="@AriaLabelledBy"
                    disabled="@Disabled"
                    @attributes="@Attributes"
                    @onclick="@ToggleOrOpenPanelAsync"
                    @onkeydown="@OnSelectTriggerKeyDownAsync">
                <span class="@(hasSelection ? "truncate" : $"truncate {theme.SelectCustomPlaceholder}")" style="@clearTextStyle">@(hasSelection ? selectedDisplayText : effectivePlaceholder)</span>
                <TwIcon Icon="Icon.Chevron_Down" Plain Class="@chevronClasses" aria-hidden="true" />
            </button>
            @clearButton

            @if (isFocused)
            {
                <div class="@panelPositionClasses" id="@panelId" data-tw-popover tabindex="-1" @ref="PanelRef" @onkeydown="@OnPanelKeyDownAsync">
                    <div class="@customPanelSurfaceClasses">
                        <div id="@listboxId" class="@theme.SelectCustomListbox" role="listbox" tabindex="0" @ref="listboxRef"
                             aria-label="@(string.IsNullOrWhiteSpace(Label) ? AriaLabel ?? localizer[TwStrings.Select_Options] : Label)">
                            @if (!Required)
                            {
                                <div id="@OptionId(0)" role="option" class="@theme.SelectCustomOption" data-value="0"
                                     aria-selected="@(selectedValueId == 0 ? "true" : "false")"
                                     @onclick="@(() => SelectOptionAsync(0))">
                                    <span class="@($"truncate {theme.SelectCustomPlaceholder}")">@effectivePlaceholder</span>
                                </div>
                            }
                            @foreach (var (key, value) in parsedValues)
                            {
                                <div id="@OptionId(key)" role="option" class="@theme.SelectCustomOption" data-value="@key"
                                     aria-selected="@(key == selectedValueId ? "true" : "false")"
                                     @onclick="@(() => SelectOptionAsync(key))">
                                    @OptionContent(value)
                                    @if (key == selectedValueId)
                                    {
                                        <TwIcon Icon="Icon.Check2" Plain Class="@theme.SelectCustomCheck" aria-hidden="true" />
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (UseNativePicker)
    {
        <div class="@options.Theme.Position.Relative">
            <div class="@triggerClasses" style="@clearPaddingStyle" aria-hidden="true">
                @if (selectedValueIds.Count == 0)
                {
                    <span class="@theme.SelectCustomPlaceholder">@effectivePlaceholder</span>
                }
                else
                {
                    @foreach (var id in orderedSelectedValueIds)
                    {
                        <TwChip Label="@GetDisplayText(parsedValues[id])" Size="ChipSize.Large" Variant="ButtonVariant.Outlined" />
                    }
                }
                <TwIcon Icon="Icon.Chevron_Down" Plain Class="@theme.SelectMultiChevron" />
            </div>

            <select id="@Id"
                    @ref="@nativeMultipleRef"
                    multiple
                    class="@nativeOverlayClasses"
                    required="@Required"
                    @onchange="@HandleChange"
                    @attributes="@Attributes"
                    aria-required="@(Required ? "true" : null)"
                    aria-readonly="@(ReadOnly ? "true" : null)"
                    aria-invalid="@(fieldInvalid ? "true" : null)"
                    aria-describedby="@errorId"
                    aria-label="@AriaLabel"
                    aria-labelledby="@AriaLabelledBy">
                @foreach (var (key, value) in parsedValues)
                {
                    <option value="@key" selected="@(selectedValueIds.Contains(key))">
                        @GetDisplayText(value)
                    </option>
                }
            </select>
            @clearButton
        </div>
    }
    else
    {
        <div class="@options.Theme.Position.Relative">
            <div class="@triggerClasses" style="@clearPaddingStyle" @onclick="@ToggleOrOpenPanelAsync">
                @foreach (var id in orderedSelectedValueIds)
                {
                    <span @onclick:stopPropagation="true">
                        <TwChip Label="@GetDisplayText(parsedValues[id])" Size="ChipSize.Large" Variant="ButtonVariant.Outlined" Closable="@(!Disabled && !ReadOnly)" OnClose="@(() => RemoveSelectionAsync(id))" />
                    </span>
                }
                <button type="button"
                        id="@Id"
                        class="@theme.SelectMultiOpenButton"
                        role="combobox"
                        aria-haspopup="listbox"
                        aria-expanded="@(isFocused ? "true" : "false")"
                        aria-controls="@(isFocused ? listboxId : null)"
                        aria-required="@(Required ? "true" : null)"
                        aria-readonly="@(ReadOnly ? "true" : null)"
                        aria-invalid="@(fieldInvalid ? "true" : null)"
                        aria-describedby="@errorId"
                        aria-label="@AriaLabel"
                        aria-labelledby="@AriaLabelledBy"
                        @attributes="@Attributes"
                        @onkeydown="@OnSelectTriggerKeyDownAsync">
                    @if (selectedValueIds.Count == 0)
                    {
                        @effectivePlaceholder
                    }
                    else
                    {
                        @* The chips sit outside the button, so this is what tells assistive technology the value. *@
                        <span class="@options.Theme.Display.ScreenReaderOnly">@selectedSummary</span>
                    }
                </button>
                <TwIcon Icon="Icon.Chevron_Down" Plain Class="@multiChevronClasses" aria-hidden="true" />
            </div>
            @clearButton

            @if (isFocused)
            {
                <div class="@panelPositionClasses" id="@panelId" data-tw-popover tabindex="-1" @ref="PanelRef" @onkeydown="@OnPanelKeyDownAsync">
                    <div class="@customPanelSurfaceClasses">
                        <div id="@listboxId" class="@theme.SelectCustomListbox" role="listbox" aria-multiselectable="true" tabindex="0" @ref="listboxRef"
                             aria-label="@(string.IsNullOrWhiteSpace(Label) ? AriaLabel ?? localizer[TwStrings.Select_Options] : Label)">
                            @foreach (var (key, value) in parsedValues)
                            {
                                <div id="@OptionId(key)" role="option" class="@theme.SelectCustomOption" data-value="@key"
                                     aria-selected="@(selectedValueIds.Contains(key) ? "true" : "false")"
                                     @onclick="@(() => ToggleOptionAsync(key))">
                                    @OptionContent(value)
                                    @if (selectedValueIds.Contains(key))
                                    {
                                        <TwIcon Icon="Icon.Check2" Plain Class="@theme.SelectCustomCheck" aria-hidden="true" />
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</TwInputRoot>

@code {
    /// <summary>
    /// The clear button drawn over the end of the field, just before the chevron, when <see cref="Clearable"/> is set.
    /// It is left out of the Tab order, as the text field's is; Delete and Backspace on the field clear it instead.
    /// </summary>
    private RenderFragment clearButton => @<text>
        @if (showClearButton)
        {
            <div class="@theme.FieldEndContent" style="@clearWrapperStyle">
                <button type="button"
                        class="@theme.ClearButton"
                        style="@clearButtonStyle"
                        tabindex="-1"
                        aria-label="@localizer[TwStrings.Textfield_Clear]"
                        aria-controls="@Id"
                        disabled="@(!canClear)"
                        data-tw-field-button
                        @onclick="@ClearAsync"
                        @onclick:stopPropagation="true">
                    <TwIcon Icon="Icon.X_Lg" Class="@theme.ClearButtonIcon" />
                </button>
            </div>
        }
    </text>;

    /// <summary>
    /// The content of one option in the custom listbox: <see cref="ItemTemplate"/> when set, otherwise its display text.
    /// </summary>
    private RenderFragment OptionContent(T value) => ItemTemplate is not null
        ? ItemTemplate(value)
        : @<span class="truncate">@GetDisplayText(value)</span>;
}
