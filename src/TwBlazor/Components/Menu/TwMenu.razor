@namespace TwBlazor.Components
@inherits TwBlazorComponentBase

<div id="@Id" class="@rootClasses" style="@Style" @ref="rootRef" @attributes="Attributes">
    <span class="@options.Theme.Display.InlineFlex" @ref="triggerRef">
        @if (IconOnly && Icon is { } icon)
        {
            <TwIcon Id="@triggerId"
                    Icon="@icon"
                    Class="@ButtonClass"
                    Plain
                    Disabled="@Disabled"
                    AriaLabel="@effectiveAriaLabel"
                    Tooltip="@effectiveAriaLabel"
                    Attributes="@triggerAttributes"
                    OnClick="@ToggleAsync" />
        }
        else
        {
            <TwButton Id="@triggerId"
                      Label="@(Label ?? string.Empty)"
                      StartIcon="@Icon"
                      Variant="@Variant"
                      Dense="@Dense"
                      Class="@ButtonClass"
                      Disabled="@Disabled"
                      AriaLabel="@AriaLabel"
                      Attributes="@triggerAttributes"
                      OnClick="@ToggleAsync" />
        }
    </span>

    @if (isOpen)
    {
        <div id="@menuId"
             class="@theme.Panel"
             role="menu"
             aria-orientation="vertical"
             aria-labelledby="@triggerId"
             tabindex="-1"
             data-tw-popover
             @ref="menuRef">
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        </div>
    }
</div>
