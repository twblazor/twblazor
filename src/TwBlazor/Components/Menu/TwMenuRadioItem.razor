@namespace TwBlazor.Components
@inherits TwBlazorComponentBase
@typeparam TValue

<button type="button"
        id="@Id"
        role="menuitemradio"
        tabindex="-1"
        class="@itemClasses"
        style="@Style"
        aria-checked="@(isChecked ? "true" : "false")"
        aria-disabled="@(Disabled ? "true" : null)"
        aria-label="@AriaLabel"
        aria-labelledby="@AriaLabelledBy"
        @onclick="@ChooseAsync"
        @attributes="Attributes">
    <TwIcon Icon="TwBlazor.Enums.Icon.Dot" Class="@indicatorClasses" />
    <span>@if (ChildContent != null) { @ChildContent } else { @Label }</span>
    @if (!string.IsNullOrEmpty(Shortcut))
    {
        <span class="@theme.ItemShortcut" aria-hidden="true">@Shortcut</span>
    }
</button>
