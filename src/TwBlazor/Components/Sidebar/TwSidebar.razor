@namespace TwBlazor.Components
@using TwBlazor.Enums
@inherits TwBlazorComponentBase

<div id="@Id" class="@rootClasses" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy">
    <a class="@skipLinkClasses" href="@skipLinkHref" @onclick="FocusMainContentAsync" @onclick:preventDefault="true">Skip to main content</a>

    @* Backdrop overlay for mobile when sidebar is open *@
    @if (IsSidebarOpen)
    {
        <div class="@mobileOverlayClasses" @onclick="ToggleSidebar" aria-hidden="true"></div>
    }

    <nav id="@navigationId" class="@sidebarClasses" aria-label="sidebar navigation" inert="@(!IsSidebarOpen)" @ref="navigationRef" @onkeydown="OnSidebarKeyDownAsync">
        @if (HeaderContent != null)
        {
            @HeaderContent
        }
        
        @if (IsSearchable)
        {
            <TwTextfield T=string Placeholder="Search..." AriaLabel="@SearchLabel" InputType="search" Class="@options.Theme.Spacing.MarginTop.Lg" Value="@searchTerm" ValueChanged="@((v) => OnSearchInput(v))" BindEvent="oninput" />
            <span class="@options.Theme.Display.ScreenReaderOnly" role="status" aria-live="polite">@searchStatusMessage</span>
        }

        <div class="@navigationListClasses">
            <TwSidebarNavigationList Items="displayedNavigationItems" ItemContent="NavigationItemContent" />

            @SidebarContent
        </div>
    </nav>
    <div id="main-content-root" class="@mainContentRootClasses">
        <TwNavbar Fixed="IsNavbarFixed" Class="@NavbarClass" DisableResponsiveCollapse
                  BrandContent="NavbarBrandContent"
                  NavigationContent="NavbarNavigationContent"
                  ActionsContent="NavbarActionsContent"
                  NavigationItems="NavbarNavigationItems">
            <TwIcon Id="@toggleId" Icon="@(IsSidebarOpen? Icon.X: Icon.List)" AriaLabel="@(IsSidebarOpen ? "Close sidebar" : "Open sidebar")" aria-expanded="@(IsSidebarOpen ? "true" : "false")" aria-controls="@navigationId" OnClick="ToggleSidebar" Class="@theme.NavbarToggleIcon" />
            @NavbarContent
        </TwNavbar>
        <main id="main-content" @ref="mainContentRef" class="@mainContentClasses" tabindex="0">
            @ChildContent
        </main>
    </div>
</div>