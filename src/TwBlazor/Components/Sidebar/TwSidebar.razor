@namespace TwBlazor.Components
@using TwBlazor.Enums
@inherits TwBlazorComponentBase

<div id="@Id" class="@rootClasses" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy">
    <a class="@skipLinkClasses" href="@skipLinkHref" @onclick="FocusMainContentAsync" @onclick:preventDefault="true">@localizer[TwStrings.Sidebar_SkipToMain]</a>

    @* Backdrop overlay for mobile when sidebar is open *@
    @if (IsSidebarOpen)
    {
        <div class="@mobileOverlayClasses" @onclick="ToggleSidebar" aria-hidden="true"></div>
    }

    <nav id="@navigationId" class="@sidebarClasses" aria-label="@localizer[TwStrings.Sidebar_NavigationLabel]" inert="@(!IsSidebarOpen)" @ref="navigationRef">
        @if (HeaderContent != null)
        {
            @HeaderContent
        }
        
        @if (IsSearchable)
        {
            <TwTextfield T=string Placeholder="@localizer[TwStrings.Sidebar_SearchPlaceholder]" AriaLabel="@effectiveSearchLabel" InputType="search" Class="@options.Theme.Spacing.MarginTop.Lg" Value="@searchTerm" ValueChanged="@((v) => OnSearchInput(v))" BindEvent="oninput" />
            <span class="@options.Theme.Display.ScreenReaderOnly" role="status" aria-live="polite">@searchStatusMessage</span>
        }

        <div class="@navigationListClasses">
            <TwSidebarNavigationList Items="displayedNavigationItems" ItemContent="NavigationItemContent" />

            @SidebarContent
        </div>

        @* Shown only while the sidebar is a drawer over the page, where the toggle in the top bar is covered
           and inert. It is pinned to the drawer's top corner; Escape closes the drawer too. *@
        @if (IsSidebarOpen)
        {
            <TwIcon Id="@closeButtonId" Icon="Icon.X" AriaLabel="@localizer[TwStrings.Sidebar_Close]" OnClick="CloseDrawerAsync" Class="@theme.DrawerCloseButton" />
        }
    </nav>
    <div id="main-content-root" class="@mainContentRootClasses" @ref="contentRootRef">
        <TwNavbar Fixed="IsNavbarFixed" Class="@NavbarClass" DisableResponsiveCollapse
                  BrandContent="NavbarBrandContent"
                  NavigationContent="NavbarNavigationContent"
                  ActionsContent="NavbarActionsContent"
                  NavigationItems="NavbarNavigationItems">
            <TwIcon Id="@toggleId" Icon="@(IsSidebarOpen? Icon.X: Icon.List)" AriaLabel="@(IsSidebarOpen ? localizer[TwStrings.Sidebar_Close] : localizer[TwStrings.Sidebar_Open])" aria-expanded="@(IsSidebarOpen ? "true" : "false")" aria-controls="@navigationId" OnClick="ToggleSidebar" Class="@theme.NavbarToggleIcon" />
            @NavbarContent
        </TwNavbar>
        <main id="main-content" @ref="mainContentRef" class="@mainContentClasses" tabindex="0">
            @ChildContent
        </main>
    </div>
</div>