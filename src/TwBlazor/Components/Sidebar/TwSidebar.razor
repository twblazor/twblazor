@namespace TwBlazor.Components
@using TwBlazor.Enums
@inherits TwBlazorComponentBase

<div id="@Id" class="@rootClasses" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy">
    <a class="@skipLinkClasses" href="#main-content-root">skip to the main content</a>

    @* Backdrop overlay for mobile when sidebar is open *@
    @if (IsSidebarOpen)
    {
        <div class="@mobileOverlayClasses" @onclick="ToggleSidebar" aria-hidden="true"></div>
    }

    <nav class="@sidebarClasses" aria-label="sidebar navigation">
        @if (HeaderContent != null)
        {
            @HeaderContent
        }
        
        @if (IsSearchable)
        {
            <TwTextfield T=string Placeholder="Search..." Class="@options.Theme.Spacing.MarginTop.Lg" Value="@searchTerm" ValueChanged="@((v) => OnSearchInput(v))" BindEvent="oninput" />
        }

        <div class="@navigationListClasses">
            <TwSidebarNavigationList Items="displayedNavigationItems" />

            @SidebarContent
        </div>
    </nav>
    <div id="main-content-root" class="@mainContentRootClasses">
        <TwNavbar Fixed="IsNavbarFixed" Class="@NavbarClass" DisableResponsiveCollapse
                  BrandContent="NavbarBrandContent"
                  NavigationContent="NavbarNavigationContent"
                  ActionsContent="NavbarActionsContent"
                  NavigationItems="NavbarNavigationItems">
            <TwIcon Icon="@(IsSidebarOpen? Icon.X: Icon.List)" AriaLabel="@(IsSidebarOpen ? "Close sidebar" : "Open sidebar")" aria-expanded="@(IsSidebarOpen ? "true" : "false")" OnClick="ToggleSidebar" Class="@theme.NavbarToggleIcon" />
            @NavbarContent
        </TwNavbar>
        <div @ref="mainContentRef" class="@mainContentClasses" tabindex="0">
            @ChildContent
        </div>
    </div>
</div>