@namespace TwBlazor.Components
@using TwBlazor.Components.TimePicker
@inherits TwPopoverPickerComponentBase

<TwInputRoot @ref="@InputRoot" RootId="@RootId" RootClass="@RootClass" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy">
    <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" Class="@LabelClass" @attributes="@LabelAttributes" />

    <div class="@classes">
        <div class="@($"{theme.IconWrapper} {inputSizeClasses}")" role="button" tabindex="@(Disabled ? "-1" : "0")" aria-label="Open time picker" aria-disabled="@(Disabled ? "true" : null)" @onclick="OnIconClickAsync" @onkeydown="OnIconKeyDownAsync">
            <svg class="@theme.IconGlyph" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
        </div>

        <TwTextfield @ref="@trigger"
                        T="string"
                        Id="@Id"
                        InputType="@(UseNativePicker ? "time" : "text")"
                        Class="@textfieldClasses"
                        Placeholder="@Placeholder"
                        OnFocus="@OnFocusAsync"
                        Value="@Value"
                        ValueChanged="@((e) => OnTextValueChanged(e))"
                        AriaLabel="@AriaLabel"
                        AriaLabelledBy="@AriaLabelledBy"
                        Attributes="@triggerAttributes"
                        Variant="@Variant"
                        Dense="@Dense"
                        ReadOnly="@ReadOnly"
                        Disabled="@Disabled"
                        Invalid="@Invalid"
                        ErrorMessage="@ErrorMessage" />

        @if (isFocused)
        {
            <div class="@theme.PanelWrapper" role="dialog" aria-label="Choose time" tabindex="-1" @ref="PanelRef" @onkeydown="OnPanelKeyDownAsync">
                <TwTimePickerBody Class="@bodyClasses"
                                    Id="@Id"
                                    Variant="@effectiveVariant"
                                    Is12HourFormat="@Is12HourFormat"
                                    SelectedTime="@SelectedTime"
                                    SelectedTimeChanged="@OnTimePickerChanged" />
            </div>
        }
    </div>
</TwInputRoot>