@namespace TwBlazor.Components
@using TwBlazor.Components.TimePicker
@inherits TwPopoverPickerComponentBase

<TwInputRoot @ref="@InputRoot" RootId="@RootId" RootClass="@classes" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy">
    <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" Class="@LabelClass" @attributes="@LabelAttributes" />

    <div class="@options.Theme.Position.Relative">
        <button type="button" class="@($"{theme.IconWrapper} {inputSizeClasses}")" aria-expanded="@iconExpanded" aria-label="@localizer[TwStrings.TimeRangePicker_Open]" disabled="@Disabled" @onclick="OnIconClickAsync">
            <svg class="@theme.IconGlyph" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
        </button>

        <TwTextfield
            @ref="@trigger"
            T="string"
            Id="@Id"
            InputType="text"
            Disabled="@Disabled"
            OnClick="OnTriggerClickAsync"
            OnKeyDown="OnTriggerKeyDownAsync"
            Value="@Value"
            ValueChanged="@((e) => OnTextValueChanged(e))"
            ReadOnly="@ReadOnly"
            Variant="@Variant"
            Dense="@Dense"
            Invalid="@fieldInvalid"
            ErrorMessage="@fieldErrorMessage"
            Attributes="@triggerAttributes"
            Class="@textfieldClasses"
            Placeholder="@effectivePlaceholder" />
    </div>

    @if (isFocused)
    {
        <div class="@panelPositionClasses" role="dialog" aria-label="@(stage == TimeRangePickerStage.Start ? localizer[TwStrings.TimeRangePicker_DialogStart] : localizer[TwStrings.TimeRangePicker_DialogEnd])" id="@panelId" data-tw-popover tabindex="-1" @ref="PanelRef" @onkeydown="OnPanelKeyDownAsync">
            <div class="@panelSurfaceClasses">
                <div class="@stageTabsClasses" role="group" aria-label="@localizer[TwStrings.DateTimeRangePicker_RangeStep]">
                    <button type="button" class="@GetStageTabClasses(TimeRangePickerStage.Start)" aria-pressed="@(stage == TimeRangePickerStage.Start ? "true" : "false")" @onclick="@(() => SwitchStage(TimeRangePickerStage.Start))">
                        @localizer[TwStrings.Common_Start]
                    </button>
                    <button type="button" class="@GetStageTabClasses(TimeRangePickerStage.End)" aria-pressed="@(stage == TimeRangePickerStage.End ? "true" : "false")" @onclick="@(() => SwitchStage(TimeRangePickerStage.End))">
                        @localizer[TwStrings.Common_End]
                    </button>
                </div>
                <TwTimePickerBody Id="@($"{Id}-time")" Variant="@effectiveVariant" Is12HourFormat="@effectiveIs12HourFormat" Step="@Step" SelectedTime="@stageTime" SelectedTimeChanged="@OnStageTimeChanged" />
            </div>
        </div>
    }
</TwInputRoot>
