@namespace TwBlazor.Components
@using TwBlazor.Components.TimePicker
@inherits TwPopoverPickerComponentBase

<TwInputRoot @ref="@InputRoot" RootId="@RootId" RootClass="@classes" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy">
    <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" Class="@LabelClass" @attributes="@LabelAttributes" />

    <div class="@options.Theme.Position.Relative">
        <div class="@($"{theme.IconWrapper} {inputSizeClasses}")" role="button" tabindex="@(Disabled ? "-1" : "0")" aria-label="Open time range picker" aria-disabled="@(Disabled ? "true" : null)" @onclick="OnIconClickAsync" @onkeydown="OnIconKeyDownAsync">
            <svg class="@theme.IconGlyph" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
        </div>

        <TwTextfield
            @ref="@trigger"
            T="string"
            Id="@Id"
            InputType="text"
            Disabled="@Disabled"
            OnFocus="OnFocusAsync"
            Value="@Value"
            ValueChanged="@((e) => OnTextValueChanged(e))"
            ReadOnly="@ReadOnly"
            Variant="@Variant"
            Dense="@Dense"
            Invalid="@Invalid"
            ErrorMessage="@ErrorMessage"
            Attributes="@triggerAttributes"
            Class="@textfieldClasses"
            Placeholder="@effectivePlaceholder" />
    </div>

    @if (isFocused)
    {
        <div class="@panelPositionClasses" role="dialog" aria-label="@(stage == TimeRangePickerStage.Start ? "Choose start time" : "Choose end time")" tabindex="-1" @ref="PanelRef" @onkeydown="OnPanelKeyDownAsync">
            <div class="@panelSurfaceClasses">
                <div class="@stageTabsClasses" role="tablist" aria-label="Range step">
                    <button type="button" role="tab" class="@GetStageTabClasses(TimeRangePickerStage.Start)" aria-selected="@(stage == TimeRangePickerStage.Start ? "true" : "false")" @onclick="@(() => SwitchStage(TimeRangePickerStage.Start))">
                        Start
                    </button>
                    <button type="button" role="tab" class="@GetStageTabClasses(TimeRangePickerStage.End)" aria-selected="@(stage == TimeRangePickerStage.End ? "true" : "false")" @onclick="@(() => SwitchStage(TimeRangePickerStage.End))">
                        End
                    </button>
                </div>
                <TwTimePickerBody Id="@Id" Variant="@effectiveVariant" Is12HourFormat="@Is12HourFormat" SelectedTime="@stageTime" SelectedTimeChanged="@OnStageTimeChanged" />
            </div>
        </div>
    }
</TwInputRoot>
