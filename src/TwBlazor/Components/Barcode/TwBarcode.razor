@namespace TwBlazor.Components
@inherits TwBlazorComponentBase

@if (barcode is not null)
{
    <div id="@Id" class="@classes" style="@Style" role="img" aria-label="@accessibleName" aria-labelledby="@AriaLabelledBy" @attributes="Attributes">
        <svg class="@sizeClasses" xmlns="http://www.w3.org/2000/svg" viewBox="@viewBox" shape-rendering="crispEdges" focusable="false" aria-hidden="true">
            <rect class="@theme.Light" width="100%" height="100%" />
            <path class="@theme.Dark" d="@path" />
        </svg>
        @if (ShowText)
        {
            <span class="@theme.Text" aria-hidden="true">@barcode.Text</span>
        }
    </div>
}
