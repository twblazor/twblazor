@namespace TwBlazor.Components
@inherits TwBlazorComponentBase

@if (OnClick.HasDelegate)
{
    <TwButton Id="@Id" Type="button" Attributes="Attributes" OnClick="@OnClick" AriaLabel="@AriaLabel" Class="@buttonClasses" IconButton Style="@Style" AriaLabelledBy="@AriaLabelledBy" Variant="@ButtonVariant" Color="@Color" Plain="@Plain" Shadow="@Shadow" Disabled="@Disabled" Tooltip="@Tooltip">
        <i class="@bareIconClasses" aria-hidden="true" @onmouseover="OnMouseOver" />
    </TwButton>
}
else
{
    <i id="@Id" class="@iconClasses" style="@Style" @onmouseover="OnMouseOver" @attributes="Attributes" aria-hidden="@(hasAccessibleName ? null : "true")" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" />
}