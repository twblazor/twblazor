@namespace TwBlazor.Components
@using TwBlazor.Components.ColorPicker
@inherits TwPopoverPickerComponentBase

<TwInputRoot @ref="@InputRoot" RootId="@RootId" RootClass="@RootClass" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" Class="@LabelClasses" @attributes="@LabelAttributes" />
    }

    <div class="@inputContainerClasses @options.Theme.Position.Relative">
        <div class="@($"{options.Theme.Position.Relative} {options.Theme.Flexbox.ShrinkNone}")">
            @if (UseNativePicker)
            {
                <input type="color"
                       class="@previewClasses"
                       value="@GetPreviewColor()"
                       disabled="@Disabled"
                       aria-label="Color preview"
                       @onchange="OnNativeColorChangedAsync" />
            }
            else
            {
                <button type="button"
                        class="@previewClasses"
                        style="background-color: @GetPreviewColor(); cursor:pointer;"
                        disabled="@Disabled"
                        aria-haspopup="dialog"
                        aria-expanded="@(isFocused ? "true" : "false")"
                        aria-label="@swatchAriaLabel"
                        @onclick="ShowDialogAsync">
                </button>
            }
        </div>

        <TwTextfield T="string"
                     @bind-Value="@displayValue"
                     @bind-Value:after="@HandleTextInputChangeAsync"
                     Id="@Id"
                     Variant="@effectiveVariant"
                     Dense="@Dense"
                     Placeholder="@GetPlaceholder()"
                     Disabled="@Disabled"
                     ReadOnly="@ReadOnly"
                     OnFocus="@OnFocus"
                     BindEvent="@BindEvent"
                     Class="@Class"
                     Attributes="@Attributes"
                     AriaLabel="@AriaLabel"
                     AriaLabelledBy="@AriaLabelledBy" />

        @if (isFocused)
        {
            <div class="@colorPickerTheme.DialogPosition" role="dialog" aria-label="Choose color" @onkeydown="OnPanelKeyDownAsync" tabindex="-1" @ref="PanelRef">
                <TwColorPickerBody Value="@Value" ShowAlpha="@ShowAlpha" ShowModeSwitch="@ShowModeSwitch" OutputFormat="@OutputFormat" ValueChanged="OnDialogValueChanged" OnClose="OnDialogClose" Variant="@effectiveVariant" Rounded="@Rounded" Shadow="@Shadow" />
            </div>
        }
    </div>
</TwInputRoot>