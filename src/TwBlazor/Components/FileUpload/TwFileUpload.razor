
@using Microsoft.AspNetCore.Components.Forms
@using TwBlazor.Enums
@namespace TwBlazor.Components
@inherits TwBlazorInputComponentBase

<TwInputRoot RootId="@RootId" RootClass="@rootClasses" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy" RootErrorMessage="@ErrorMessage" RootErrorId="@errorId">
    <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" OverrideClass="@classes" @attributes="@LabelAttributes">
        @if (Icon != null)
        {
            <TwIcon Icon="@((Icon)Icon)" Class="@fileUploadTheme.IconSpacing"/>
        }

        @if (Multiple)
        {
            <InputFile id="@Id" OnChange="@OnUpload" multiple @attributes="@Attributes" disabled="@Disabled" class="@inputClasses" aria-readonly="@(ReadOnly ? "true" : null)" aria-invalid="@(Invalid ? "true" : null)" aria-describedby="@errorId" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" />
        }
        else
        {
            <InputFile id="@Id" OnChange="@OnUpload" @attributes="@Attributes" disabled="@Disabled" class="@inputClasses" aria-readonly="@(ReadOnly ? "true" : null)" aria-invalid="@(Invalid ? "true" : null)" aria-describedby="@errorId" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy" />
        }
    </TwInputLabel>

    <span class="@options.Theme.Display.ScreenReaderOnly" role="status" aria-live="polite">@statusMessage</span>

    @if (selectedFiles.Count > 0)
    {
        <div class="@fileListClasses">
            @foreach (var f in selectedFiles)
            {
                <TwChip Label="@f.Name" Closable OnClose="() => RemoveFile(f)" Shadow="Enums.Shadow.None" Class="@chipClasses" />
            }
        </div>
    }
</TwInputRoot>
