@namespace TwBlazor.Components
@typeparam TItem
@using TwBlazor.Enums
@inherits TwBlazorComponentBase

<div id="@Id"
     class="@containerClasses"
     style="@Style"
     @attributes="@Attributes"
     aria-label="@AriaLabel"
     aria-labelledby="@AriaLabelledBy">
    <span class="@options.Theme.Display.ScreenReaderOnly" role="status" aria-live="polite">@statusMessage</span>
    <div class="@theme.Column">
        <div class="@theme.ColumnHeader">
            <span class="@theme.Label">@SourceLabel</span>
            @if (AllowReorder)
            {
                <div class="@theme.ReorderButtons">
                    <TwIcon Icon="Icon.Chevron_Up" Class="@theme.ReorderButton"
                            Disabled="@Disabled" Readonly="@(selectedSource.Count == 0)"
                            OnClick="@(() => MoveSelectionAsync(true, true))"
                            AriaLabel="@($"Move selected {SourceLabel} item up")" />
                    <TwIcon Icon="Icon.Chevron_Down" Class="@theme.ReorderButton"
                            Disabled="@Disabled" Readonly="@(selectedSource.Count == 0)"
                            OnClick="@(() => MoveSelectionAsync(true, false))"
                            AriaLabel="@($"Move selected {SourceLabel} item down")" />
                </div>
            }
        </div>
        <ul class="@GetListBoxClasses()" role="listbox" aria-multiselectable="true" aria-label="@SourceLabel" aria-disabled="@(Disabled ? "true" : null)" @ref="sourceListRef">
            @if (!SourceItems.Any())
            {
                <li class="@theme.EmptyState" role="option" aria-disabled="true" aria-selected="false" tabindex="-1">@EmptyText</li>
            }
            @foreach (var item in SourceItems)
            {
                <li role="option"
                    tabindex="@(Disabled ? "-1" : "0")"
                    aria-selected="@(IsSelected(item, true) ? "true" : "false")"
                    aria-disabled="@(Disabled ? "true" : null)"
                    class="@GetItemClasses(item, true)"
                    @onclick="@(() => ToggleSelectionAsync(item, true))"
                    @onkeydown="@((KeyboardEventArgs e) => OnItemKeyDownAsync(e, item, true))">
                    @GetDisplayText(item)
                </li>
            }
        </ul>
    </div>

    <div class="@theme.TransferButtonColumn">
        <TwIcon Icon="Icon.Chevron_Right" Class="@theme.TransferButton"
                Disabled="@Disabled" Readonly="@(selectedSource.Count == 0)"
                OnClick="@(() => TransferSelectedAsync(true))"
                AriaLabel="@($"Move selected items to {TargetLabel}")" />
        @if (ShowMoveAllButtons)
        {
            <TwIcon Icon="Icon.Chevron_Double_Right" Class="@theme.TransferButton" 
                    Disabled="@Disabled" Readonly="@(!SourceItems.Any())"
                    OnClick="@(() => TransferAllAsync(true))"
                    AriaLabel="@($"Move all items to {TargetLabel}")" />
        }
        <TwIcon Icon="Icon.Chevron_Left" Class="@theme.TransferButton"
                Disabled="@Disabled" Readonly="@(selectedTarget.Count == 0)"
                OnClick="@(() => TransferSelectedAsync(false))"
                AriaLabel="@($"Move selected items to {SourceLabel}")" />
        @if (ShowMoveAllButtons)
        {
            <TwIcon Icon="Icon.Chevron_Double_Left" Class="@theme.TransferButton"
                    Disabled="@Disabled" Readonly="@(!TargetItems.Any())"
                    OnClick="@(() => TransferAllAsync(false))"
                    AriaLabel="@($"Move all items to {SourceLabel}")" />
        }
    </div>

    <div class="@theme.Column">
        <div class="@theme.ColumnHeader">
            <span class="@theme.Label">@TargetLabel</span>
            @if (AllowReorder)
            {
                <div class="@theme.ReorderButtons">
                    <TwIcon Icon="Icon.Chevron_Up" Class="@theme.ReorderButton"
                            Disabled="@Disabled" Readonly="@(selectedTarget.Count == 0)"
                            OnClick="@(() => MoveSelectionAsync(false, true))"
                            AriaLabel="@($"Move selected {TargetLabel} item up")" />
                    <TwIcon Icon="Icon.Chevron_Down" Class="@theme.ReorderButton"
                            Disabled="@Disabled" Readonly="@(selectedTarget.Count == 0)"
                            OnClick="@(() => MoveSelectionAsync(false, false))"
                            AriaLabel="@($"Move selected {TargetLabel} item down")" />
                </div>
            }
        </div>
        <ul class="@GetListBoxClasses()" role="listbox" aria-multiselectable="true" aria-label="@TargetLabel" aria-disabled="@(Disabled ? "true" : null)" @ref="targetListRef">
            @if (!TargetItems.Any())
            {
                <li class="@theme.EmptyState" role="option" aria-disabled="true" aria-selected="false" tabindex="-1">@EmptyText</li>
            }
            @foreach (var item in TargetItems)
            {
                <li role="option"
                    tabindex="@(Disabled ? "-1" : "0")"
                    aria-selected="@(IsSelected(item, false) ? "true" : "false")"
                    aria-disabled="@(Disabled ? "true" : null)"
                    class="@GetItemClasses(item, false)"
                    @onclick="@(() => ToggleSelectionAsync(item, false))"
                    @onkeydown="@((KeyboardEventArgs e) => OnItemKeyDownAsync(e, item, false))">
                    @GetDisplayText(item)
                </li>
            }
        </ul>
    </div>
</div>
