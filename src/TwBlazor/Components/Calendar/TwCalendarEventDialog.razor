@namespace TwBlazor.Components
@typeparam T
@using TwBlazor.Enums
@inherits TwBlazorComponentBase

@if (ReadOnly)
{
    <div class="@fieldsClasses">
        <div class="@summaryClasses" style="@accentCardStyle">
            <TwIcon Icon="Icon.Calendar_Event" Class="@summaryIconClasses" Style="@accentIconStyle" />
            <span>@FormatRange(localizer, WorkingEvent.DateTimeStart, WorkingEvent.DateTimeEnd)</span>
        </div>
        @foreach (var field in Fields)
        {
            var text = field.GetDisplayText(WorkingEvent.Value, localizer);
            if (!string.IsNullOrWhiteSpace(text))
            {
                <div class="@readOnlyFieldClasses">
                    <span class="@readOnlyLabelClasses">@field.Label</span>
                    <p class="@readOnlyValueClasses">@text</p>
                </div>
            }
        }
        @if (ContentTemplate is not null)
        {
            @ContentTemplate(WorkingEvent)
        }
    </div>
    <div class="@actionsClasses">
        <TwButton Label="@localizer[TwStrings.Common_Close]" Variant="ButtonVariant.Text" OnClick="Cancel" />
    </div>
}
else
{
    <div class="@fieldsClasses">
        <div class="@accentClasses" style="@accentBarStyle" aria-hidden="true"></div>
        <TwTextfield T="string" Label="@localizer[TwStrings.Calendar_FieldName]" Value="@WorkingEvent.Name" ValueChanged="@((v) => WorkingEvent.Name = v)" AriaLabel="@localizer[TwStrings.Calendar_FieldName]" />
        <TwSwitch T="bool" Label="@localizer[TwStrings.Calendar_AllDay]" Value="isAllDay" ValueChanged="SetAllDay" />
        <div class="@dateRowClasses">
            @if (isAllDay)
            {
                <TwDatePicker SelectedDate="GetAllDayStart()" SelectedDateChanged="SetAllDayStart" Label="@localizer[TwStrings.Common_Start]" />
                <TwDatePicker SelectedDate="GetAllDayEnd()" SelectedDateChanged="SetAllDayEnd" Label="@localizer[TwStrings.Common_End]" />
            }
            else
            {
                <TwDateTimePicker SelectedDateTime="GetLocalStart()" SelectedDateTimeChanged="SetLocalStart" Label="@localizer[TwStrings.Common_Start]" />
                <TwDateTimePicker SelectedDateTime="GetLocalEnd()" SelectedDateTimeChanged="SetLocalEnd" Label="@localizer[TwStrings.Common_End]" />
            }
        </div>
        <TwColorPicker Value="@GetColor()" ValueChanged="SetColor" Label="@localizer[TwStrings.Calendar_FieldColor]" AriaLabel="@localizer[TwStrings.Calendar_EventColor]" />
        @foreach (var field in Fields)
        {
            var current = field;
            if (WorkingEvent.Value is null)
            {
                continue;
            }

            if (!current.CanEdit)
            {
                <div class="@readOnlyFieldClasses">
                    <span class="@readOnlyLabelClasses">@current.Label</span>
                    <p class="@readOnlyValueClasses">@current.GetDisplayText(WorkingEvent.Value, localizer)</p>
                </div>
            }
            else if (current.Kind == TwCalendarDialogFieldKind.Boolean)
            {
                <TwSwitch T="bool" Label="@current.Label" Value="@current.GetBool(WorkingEvent.Value)" ValueChanged="@((v) => Mutate(target => current.SetBool(target, v)))" />
            }
            else if (current.Kind == TwCalendarDialogFieldKind.DateTime)
            {
                <TwDateTimePicker Label="@current.Label" SelectedDateTime="@current.GetDateTime(WorkingEvent.Value, WorkingEvent.DateTimeStart.DateTime)" SelectedDateTimeChanged="@((v) => Mutate(target => current.SetDateTime(target, v)))" />
            }
            else if (current.Kind == TwCalendarDialogFieldKind.Enum)
            {
                <TwSelect T="string" Label="@current.Label" Required Values="@current.EnumNames" SelectedValue="@current.GetEditText(WorkingEvent.Value)" SelectedValueChanged="@((v) => Mutate(target => current.SetFromText(target, v)))" />
            }
            else if (current.Kind == TwCalendarDialogFieldKind.Number)
            {
                <TwTextfield T="string" Label="@current.Label" InputType="number" step="any" Value="@current.GetEditText(WorkingEvent.Value)" ValueChanged="@((v) => Mutate(target => current.SetFromText(target, v)))" />
            }
            else
            {
                <TwTextfield T="string" Label="@current.Label" Value="@current.GetEditText(WorkingEvent.Value)" ValueChanged="@((v) => Mutate(target => current.SetFromText(target, v)))" />
            }
        }
        @if (ContentTemplate is not null)
        {
            @ContentTemplate(WorkingEvent)
        }
    </div>
    <div class="@actionsClasses">
        @if (!IsNew)
        {
            <TwButton Label="@localizer[TwStrings.Common_Delete]" Color="Color.Danger" Variant="ButtonVariant.Text" OnClick="Delete" />
        }
        <TwButton Label="@localizer[TwStrings.Common_Cancel]" Variant="ButtonVariant.Text" OnClick="Cancel" />
        <TwButton Label="@localizer[TwStrings.Common_Save]" Color="Color.Primary" OnClick="Save" />
    </div>
}
