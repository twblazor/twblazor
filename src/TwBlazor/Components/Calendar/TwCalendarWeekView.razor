@namespace TwBlazor.Components
@typeparam T
@inherits TwBlazorComponentBase

<div id="@Id" class="@(new TwBlazor.Utilities.ClassBuilder(options.Theme.Display.Flex).AddClass(options.Theme.Flexbox.Col).AddClass(Class).Build())" style="@Style" @onkeydown="OnWrapperKeyDownAsync">
    <div class="@options.Theme.Display.Flex">
        <div class="@theme.TimeGutter" style="visibility:hidden" aria-hidden="true">&nbsp;</div>
        @foreach (var day in weekDays)
        {
            <button type="button" class="@dayHeaderClasses" aria-current="@(day.Date == DateTime.Today ? "date" : null)" @onclick="@(() => OnDayHeaderClickedAsync(day))">
                <span class="@theme.DayColumnHeaderLabel">@localizer.Formats.Format(day, localizer.Formats.WeekdayDay)</span>
                <span class="@compactHeaderClasses" aria-hidden="true">
                    <span class="@theme.DayColumnHeaderWeekday">@GetShortWeekday(day)</span>
                    <span class="@GetCompactDayNumberClasses(day)">@day.Day</span>
                </span>
            </button>
        }
    </div>
    <TwCalendarAllDayRow T="T"
                         Days="weekDays"
                         Schedules="Schedules"
                         Editable="Editable"
                         OnEventClick="OnEventClick"
                         OnEventDragStart="OnEventDragStart"
                         OnEventDragOver="OnEventDragOver"
                         OnEventDragEnd="OnEventDragEnd"
                         OnEventDrop="OnEventDrop"
                         DraggedEvent="DraggedEvent"
                         DropPreview="DropPreview" />
    <div class="@scrollContainerClasses" style="@scrollContainerStyle" @ref="scrollContainerRef">
        <div class="@gutterClasses">
            @for (var hour = 0; hour < hoursPerDay; hour++)
            {
                <div class="@GetGutterLabelClasses()" style="height:6rem;">@GetHourLabel(hour)</div>
            }
            <div class="@theme.NowIndicatorLabel" style="@nowOffsetStyle"><span aria-hidden="true">@localizer.Formats.Format(now, localizer.Formats.ShortTime)</span></div>
        </div>
        <div class="@nowLineContainerClasses">
            @for (var i = 0; i < daysPerWeek; i++)
            {
                var dayIndex = i;
                var day = weekDays[dayIndex];
                <TwCalendarDayColumn T="T"
                                      @ref="_columnRefs[dayIndex]"
                                      Date="day"
                                      Events="GetDayEvents(day)"
                                      Editable="Editable"
                                      EventContentTemplate="EventContentTemplate"
                                      OnSlotClick="OnSlotClick"
                                      OnEventClick="OnEventClick"
                                      OnSlotFocused="@((slot) => OnColumnSlotFocused(dayIndex, slot))"
                                      OnEventDragStart="OnEventDragStart"
                                      OnEventDragOver="OnEventDragOver"
                                      OnEventDragEnd="OnEventDragEnd"
                                      OnEventDrop="OnEventDrop"
                                      DraggedEvent="DraggedEvent"
                                      DropPreview="DropPreview"
                                      Compact
                                      Class="@GetDayColumnClasses(day)" />
            }
            <div class="@theme.NowIndicatorLine" style="@nowOffsetStyle" aria-hidden="true">
                @if (todayColumnIndex is int todayIndex)
                {
                    <span class="@theme.NowIndicatorDot" style="@GetDotOffsetStyle(todayIndex)"></span>
                }
            </div>
        </div>
    </div>
</div>
