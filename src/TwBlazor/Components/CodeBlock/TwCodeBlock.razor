@namespace TwBlazor.Components
@using TwBlazor.Enums
@inherits TwBlazorComponentBase

<div id="@Id" class="@classes" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy">
    @if (HideTitle)
    {
        @copyButton
    }
    else
    {
        <div class="@headerClasses">
            <span>@headerTitle</span>
            @copyButton
        </div>
    }
    <span class="@options.Theme.Display.ScreenReaderOnly" aria-live="polite">@statusMessage</span>
    @* Code reads left to right in every language, so the panel never mirrors. The header above still follows
       the page, so its title and copy button swap sides right to left. *@
    <pre class="@panelClasses" dir="ltr">
        @* The highlighter makes the code element the one that scrolls, so it is the one that takes focus
           and carries the region's name. Keyed on the content, because the highlighter rewrites the element's
           children: new content gets a fresh element to highlight rather than one Blazor can no longer diff. *@
        <code @key="Content" class="@codeClasses" tabindex="0" role="group" aria-label="@codeRegionLabel" @ref="codeBlock">
            @Content
        </code>
    </pre>
</div>

@code {
    private RenderFragment copyButton => @<TwIcon OnClick="@Copy"
        Icon="@(copied ? Icon.Check2 : Icon.Copy)"
        Class="@options.Theme.Spacing.Padding.Get(2)"
        RootClass="@copyButtonClasses"
        AriaLabel="@(copied ? localizer[TwStrings.CodeBlock_Copied] : localizer[TwStrings.CodeBlock_Copy])" />;
}
