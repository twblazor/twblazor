@namespace TwBlazor.Components
@using TwBlazor.Enums
@inherits TwBlazorComponentBase

<div id="@Id" class="@classes" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy">
    @if (HideTitle)
    {
        @copyButton
    }
    else
    {
        <div class="@headerClasses">
            <span>@headerTitle</span>
            @copyButton
        </div>
    }
    <span class="@options.Theme.Display.ScreenReaderOnly" aria-live="polite">@statusMessage</span>
    <pre class="@panelClasses">
        <code class="@($"language-{Language}")" tabindex="0" @ref="codeBlock">
            @Content
        </code>
    </pre>
</div>

@code {
    private RenderFragment copyButton => @<TwIcon OnClick="@Copy"
        Icon="@(copied ? Icon.Check2 : Icon.Copy)"
        Class="@options.Theme.Spacing.Padding.Md"
        RootClass="@copyButtonClasses"
        AriaLabel="@(copied ? "Copied" : "Copy code")" />;
}
