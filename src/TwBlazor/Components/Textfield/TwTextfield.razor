@typeparam T
@inherits TwBlazorTextInputComponentBase
@namespace TwBlazor.Components

<TwInputRoot RootId="@RootId" RootClass="@RootClass" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy" RootErrorMessage="@ErrorMessage" RootErrorId="@errorId">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" Class="@LabelClasses" @attributes="@LabelAttributes" />
    }

    <input id="@Id"
           @ref="@inputRef"
           type="@InputType"
           class="@classes"
           placeholder="@Placeholder"
           @bind:get="@Value"
           @bind:set="@OnValueChanged"
           @bind:event="@BindEvent"
           required="@Required"
           aria-required="@(Required ? "true" : null)"
           @attributes="@Attributes"
           @onfocus="@OnFocus"
           @onclick="@OnClick"
           @onkeydown="@OnKeyDown"
           aria-invalid="@(Invalid ? "true" : null)"
           aria-describedby="@errorId"
           aria-label="@AriaLabel"
           aria-labelledby="@AriaLabelledBy" />
</TwInputRoot>