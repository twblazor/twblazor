@typeparam T
@inherits TwBlazorTextInputComponentBase
@namespace TwBlazor.Components
@using TwBlazor.Enums

<TwInputRoot RootId="@RootId" RootClass="@RootClass" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy" RootErrorMessage="@fieldErrorMessage" RootErrorId="@errorId">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" Class="@LabelClasses" @attributes="@LabelAttributes" />
    }

    @if (Multiline)
    {
        <textarea id="@Id"
                  @ref="@inputRef"
                  rows="@(Math.Max(Rows, 1))"
                  style="@multilineStyle"
                  class="@classes"
                  placeholder="@Placeholder"
                  @bind:get="@Value"
                  @bind:set="@OnValueChanged"
                  @bind:event="@BindEvent"
                  required="@Required"
                  aria-required="@(Required ? "true" : null)"
                  @attributes="@Attributes"
                  @onfocus="@OnFocus"
                  @onblur="@OnBlur"
                  @onclick="@OnClick"
                  @onkeydown="@OnKeyDown"
                  aria-invalid="@(fieldInvalid ? "true" : null)"
                  aria-describedby="@errorId"
                  aria-label="@AriaLabel"
                  aria-labelledby="@AriaLabelledBy"></textarea>
    }
    else if (hasFieldContent)
    {
        <div class="@theme.FieldWrapper">
            @if (StartContent is not null)
            {
                <div class="@startContentClasses" style="@startContentStyle">@StartContent</div>
            }

            @singleLineInput

            @if (EndContent is not null || showClearButton)
            {
                <div class="@endContentClasses">
                    @EndContent

                    @if (showClearButton)
                    {
                        <button type="button"
                                class="@theme.ClearButton"
                                tabindex="-1"
                                aria-label="@localizer[TwStrings.Textfield_Clear]"
                                aria-controls="@Id"
                                disabled="@(!hasValue)"
                                data-tw-field-button
                                @onclick="ClearAsync">
                            <TwIcon Icon="Icon.X_Lg" Class="@theme.ClearButtonIcon" />
                        </button>
                    }
                </div>
            }
        </div>
    }
    else
    {
        @singleLineInput
    }
</TwInputRoot>

@code {
    private RenderFragment singleLineInput => @<input id="@Id"
                                                       @ref="@inputRef"
                                                       type="@InputType"
                                                       class="@classes"
                                                       placeholder="@Placeholder"
                                                       @bind:get="@Value"
                                                       @bind:set="@OnValueChanged"
                                                       @bind:event="@BindEvent"
                                                       required="@Required"
                                                       aria-required="@(Required ? "true" : null)"
                                                       @attributes="@Attributes"
                                                       @onfocus="@OnFocus"
                                                       @onblur="@OnBlur"
                                                       @onclick="@OnClick"
                                                       @onkeydown="@OnKeyDown"
                                                       aria-invalid="@(fieldInvalid ? "true" : null)"
                                                       aria-describedby="@errorId"
                                                       aria-label="@AriaLabel"
                                                       aria-labelledby="@AriaLabelledBy" />;
}
