@namespace TwBlazor.Components
@using TwBlazor.Enums
@inherits TwBlazorComponentBase

<div id="@Id" class="@containerClasses" style="@Style" @attributes="@Attributes" role="region" aria-roledescription="carousel" aria-label="@effectiveAriaLabel" aria-labelledby="@AriaLabelledBy" @onkeydown="HandleKeyDown" @onfocusin="HandleFocusIn" @onfocusout="HandleFocusOut">
    <div class="@theme.Viewport" @onmouseenter="HandlePointerEnter" @onmouseleave="HandlePointerLeave" @ontouchstart="HandleTouchStart" @ontouchend="HandleTouchEnd">
        <div class="@theme.Slide" aria-live="@(AutoPlay ? "off" : "polite")">
            @if (ActiveItem != null)
            {
                <div class="@theme.SlideContent" role="group" aria-roledescription="slide" aria-label="@($"{SelectedIndex + 1} of {_items.Count}")">
                    @ActiveItem.ChildContent
                </div>
            }
        </div>

        @if (_items.Count > 1)
        {
            if (LeftNavigation != null)
            {
                @LeftNavigation(this)
            }
            else if (ShowArrows)
            {
                <TwIcon Id="@($"{Id}-previous")" Icon="Icon.Chevron_Left" ButtonVariant="ButtonVariant.Filled" Color="ButtonColor" RootClass="@previousArrowClasses" AriaLabel="Previous slide" OnClick="PreviousSlide" Disabled="@(!Loop && IsFirstSlide)" />
            }

            if (RightNavigation != null)
            {
                @RightNavigation(this)
            }
            else if (ShowArrows)
            {
                <TwIcon Id="@($"{Id}-next")" Icon="Icon.Chevron_Right" ButtonVariant="ButtonVariant.Filled" Color="ButtonColor" RootClass="@nextArrowClasses" AriaLabel="Next slide" OnClick="NextSlide" Disabled="@(!Loop && IsLastSlide)" />
            }
        }

        @if (AutoPlay)
        {
            <TwIcon Id="@($"{Id}-playpause")" Icon="@(IsAutoPlayManuallyPaused ? Icon.Play_Fill : Icon.Pause_Fill)" ButtonVariant="ButtonVariant.Filled" Color="ButtonColor" RootClass="@theme.PlayPauseButton" AriaLabel="@(IsAutoPlayManuallyPaused ?"Play automatic slideshow" : "Pause automatic slideshow")" OnClick="ToggleAutoPlayPaused" />
        }

        @if (_items.Count > 1)
        {
            if (Indicators != null)
            {
                @Indicators(this)
            }
            else if (ShowIndicators)
            {
                <div class="@theme.IndicatorContainer" role="group" aria-label="Choose slide to display">
                    @foreach (var index in Enumerable.Range(0, _items.Count))
                    {
                        <button type="button" class="@GetIndicatorClasses(index)" aria-label="@($"Slide {index + 1} of {_items.Count}")" aria-current="@(index == SelectedIndex ? "true" : "false")" @onclick="@(() => GoToSlide(index))"></button>
                    }
                </div>
            }
        }
    </div>
</div>

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>
