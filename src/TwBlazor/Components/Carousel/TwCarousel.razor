@namespace TwBlazor.Components
@using TwBlazor.Enums
@inherits TwBlazorComponentBase

<div id="@Id" class="@containerClasses" style="@Style" @attributes="@Attributes" role="region" aria-roledescription="@localizer[TwStrings.Carousel_RoleDescription]" aria-label="@effectiveAriaLabel" aria-labelledby="@AriaLabelledBy" @ref="rootRef" @onfocusin="HandleFocusIn" @onfocusout="HandleFocusOut">
    <div class="@theme.Viewport" @onmouseenter="HandlePointerEnter" @onmouseleave="HandlePointerLeave" @ontouchstart="HandleTouchStart" @ontouchend="HandleTouchEnd">
        @* First in the tab order, so the rotation can be stopped before anything inside it is reached. *@
        @if (AutoPlay)
        {
            <TwIcon Id="@($"{Id}-playpause")" Icon="@(IsAutoPlayManuallyPaused ? Icon.Play_Fill : Icon.Pause_Fill)" ButtonVariant="ButtonVariant.Filled" Color="ButtonColor" RootClass="@theme.PlayPauseButton" AriaLabel="@(IsAutoPlayManuallyPaused ? localizer[TwStrings.Carousel_Play] : localizer[TwStrings.Carousel_Pause])" OnClick="ToggleAutoPlayPaused" />
        }

        <div class="@theme.Slide" aria-live="@(AutoPlay && !IsAutoPlayManuallyPaused ? "off" : "polite")">
            @if (ActiveItem != null)
            {
                <div class="@theme.SlideContent" role="group" aria-roledescription="@localizer[TwStrings.Carousel_SlideRoleDescription]" aria-label="@localizer[TwStrings.Carousel_SlidePosition, SelectedIndex + 1, _items.Count]">
                    @ActiveItem.ChildContent
                </div>
            }
        </div>

        @if (_items.Count > 1)
        {
            if (LeftNavigation != null)
            {
                @LeftNavigation(this)
            }
            else if (ShowArrows)
            {
                <TwIcon Id="@($"{Id}-previous")" Icon="@DirectionalIcon(Icon.Chevron_Left, Icon.Chevron_Right)" ButtonVariant="ButtonVariant.Filled" Color="ButtonColor" RootClass="@previousArrowClasses" AriaLabel="@localizer[TwStrings.Carousel_PreviousSlide]" OnClick="PreviousSlide" Readonly="@(!Loop && IsFirstSlide)" />
            }

            if (RightNavigation != null)
            {
                @RightNavigation(this)
            }
            else if (ShowArrows)
            {
                <TwIcon Id="@($"{Id}-next")" Icon="@DirectionalIcon(Icon.Chevron_Right, Icon.Chevron_Left)" ButtonVariant="ButtonVariant.Filled" Color="ButtonColor" RootClass="@nextArrowClasses" AriaLabel="@localizer[TwStrings.Carousel_NextSlide]" OnClick="NextSlide" Readonly="@(!Loop && IsLastSlide)" />
            }
        }

        @if (_items.Count > 1)
        {
            if (Indicators != null)
            {
                @Indicators(this)
            }
            else if (ShowIndicators)
            {
                <div class="@theme.IndicatorContainer" role="group" aria-label="@localizer[TwStrings.Carousel_ChooseSlide]">
                    @foreach (var index in Enumerable.Range(0, _items.Count))
                    {
                        <button type="button" class="@GetIndicatorClasses(index)" aria-label="@localizer[TwStrings.Carousel_SlideOf, index + 1, _items.Count]" aria-current="@(index == SelectedIndex ? "true" : "false")" @onclick="@(() => GoToSlide(index))"></button>
                    }
                </div>
            }
        }
    </div>
</div>

<CascadingValue Value="this">
    @ChildContent
</CascadingValue>
