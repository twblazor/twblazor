@inherits TwBlazorComponentBase

@if (ShowMonthCaption)
{
    <div class="@monthCaptionClasses">@Value.ToString("MMMM yyyy")</div>
}
<table class="@gridClasses" role="grid" aria-label="@Value.ToString("MMMM yyyy")" @ref="gridRef" @onkeydown="OnGridKeyDown">
    <thead>
        <tr role="row">
            @foreach (var (abbreviation, fullName) in weekdayHeaders)
            {
                <th scope="col" role="columnheader" class="@theme.DayHeaderCellPadding"><span class="@dayHeaderClasses"><abbr title="@fullName" class="@theme.DayAbbreviation">@abbreviation</abbr></span></th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var week in GetWeekRows())
        {
            <tr role="row">
                @foreach (var cell in week)
                {
                    var isRangeMode = Range.HasValue;
                    // Key = start, Value = end (see the Range parameter's remarks); defaulted to
                    // (null, null) when Range itself is null, but never read unless isRangeMode.
                    var range = Range ?? default;
                    // Previous-month lead-in cells get a real date too (not just current-month
                    // cells) so a range that spans the month boundary keeps highlighting visually
                    // across it instead of appearing to stop dead at day 1 - even though these
                    // cells stay plain, non-interactive spans (selecting a day still requires
                    // navigating to the month that actually owns it).
                    DateTime? thisDate;
                    if (!cell.HasValue)
                    {
                        thisDate = null;
                    }
                    else if (cell.Value.IsCurrentMonth)
                    {
                        thisDate = new DateTime(Value.Year, Value.Month, cell.Value.DayNumber, 0, 0, 0, DateTimeKind.Unspecified);
                    }
                    else
                    {
                        var prevMonth = Value.AddMonths(-1);
                        thisDate = new DateTime(prevMonth.Year, prevMonth.Month, cell.Value.DayNumber, 0, 0, 0, DateTimeKind.Unspecified);
                    }
                    var isRangeStart = isRangeMode && thisDate.HasValue && range.Key.HasValue && thisDate.Value.Date == range.Key.Value.Date;
                    var isRangeEnd = isRangeMode && thisDate.HasValue && range.Value.HasValue && thisDate.Value.Date == range.Value.Value.Date;
                    var isInRange = isRangeMode && thisDate.HasValue && IsStrictlyWithinRange(range, thisDate.Value);
                    // Range-participating cells drop their own horizontal padding so adjacent days in
                    // the same row touch and read as one merged bar; vertical padding (the rhythm
                    // between week rows) is kept either way.
                    var tdClasses = (isRangeStart || isRangeEnd || isInRange) ? "py-0.5 px-0" : "p-0.5";

                    <td class="@tdClasses" role="gridcell">
                        @if (cell is null)
                        {
                            <span aria-hidden="true"></span>
                        }
                        else if (!cell.Value.IsCurrentMonth)
                        {
                            <span class="@GetPrevDayClasses(isRangeStart, isRangeEnd, isInRange)">
                                @cell.Value.DayNumber
                            </span>
                        }
                        else
                        {
                            var isSelected = isRangeMode
                                ? (isRangeStart || isRangeEnd)
                                : SelectedDate.HasValue && SelectedDate.Value.Date == thisDate!.Value.Date;
                            var isDisabled = IsDayDisabled(thisDate!.Value);
                            var today = Value.Kind == DateTimeKind.Utc ? DateTime.UtcNow.Date : DateTime.Today;
                            var isToday = thisDate!.Value.Date == today;
                            var fullDate = new DateTime(Value.Year, Value.Month, cell.Value.DayNumber, Value.Hour, Value.Minute, Value.Second, Value.Kind);
                            @* Keyed by date: without it Blazor reuses last month's buttons by position, their
                               element references are never captured again, and focus cannot follow the keyboard
                               onto the new page. *@
                            <button type="button" @key="thisDate!.Value" class="@GetButtonClasses(isSelected, isToday, isRangeStart, isRangeEnd, isInRange, isDisabled)"
                                    tabindex="@(cell.Value.DayNumber == focusedDay ? "0" : "-1")"
                                    aria-label="@GetDayAriaLabel(thisDate!.Value, isSelected, isRangeStart, isRangeEnd, isInRange)"
                                    aria-pressed="@(isSelected ? "true" : "false")"
                                    aria-current="@(isToday ? "date" : null)"
                                    aria-disabled="@(isDisabled ? "true" : null)"
                                    @ref="GetDayCellRef(cell.Value.DayNumber).Element"
                                    @onclick="@(() => HandleDayClick(fullDate, isDisabled))">
                                @cell.Value.DayNumber
                            </button>
                        }
                    </td>
                }
            </tr>
        }
    </tbody>
</table>
