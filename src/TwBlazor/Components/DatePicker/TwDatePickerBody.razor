@using TwBlazor.Configuration.Components
@using TwBlazor.Utilities
@inherits TwBlazorComponentBase

<div id="@Id" class="@rootClasses" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy">
    <div class="@classes">
        @ChildContent
    </div>
</div>

@code {
    private TwDatePickerTheme theme => options.Theme.Components.Require<TwDatePickerTheme>();

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string rootClasses => new ClassBuilder("datepicker-body")
        .AddClass(theme.Body).Build();

    private string classes => new ClassBuilder(options.Theme.Sizing.FullWidth).AddClass(Class).Build();
}
