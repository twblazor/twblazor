@namespace TwBlazor.Components
@typeparam T
@inherits TwBlazorInputComponentBase

<TwInputRoot RootId="@RootId" RootClass="@RootClass" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy" RootErrorMessage="@ErrorMessage" RootErrorId="@errorId">
    <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" OverrideClass="@labelClasses" @attributes="@LabelAttributes">
        <input type="checkbox"
               @ref="inputRef"
               id="@Id"
               name="@effectiveName"
               value="@Value"
               checked="@isChecked"
               @onchange="@HandleChange"
               @onclick:preventDefault="@(ReadOnly && !Disabled)"
               class="@classes"
               disabled="@Disabled"
               @attributes="@Attributes"
               aria-readonly="@(ReadOnly ? "true" : null)"
               aria-invalid="@(Invalid ? "true" : null)"
               aria-describedby="@errorId"
               aria-label="@AriaLabel"
               aria-labelledby="@AriaLabelledBy" />
        <span class="@checkClasses">
            <svg xmlns="http://www.w3.org/2000/svg" class="@iconSizeClasses" viewBox="0 0 20 20" fill="currentColor" stroke="currentColor" stroke-width="1" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
        </span>
        @if (isIndeterminate)
        {
            <span class="@indeterminateClasses">
                <svg xmlns="http://www.w3.org/2000/svg" class="@iconSizeClasses" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <rect x="4" y="9" width="12" height="2" rx="1"></rect>
                </svg>
            </span>
        }
    </TwInputLabel>
</TwInputRoot>