@namespace TwBlazor.Components
@typeparam TValue
@inherits TwBlazorComponentBase

<fieldset id="@Id"
          class="@classes"
          style="@Style"
          disabled="@Disabled"
          aria-describedby="@errorId"
          aria-label="@AriaLabel"
          aria-labelledby="@AriaLabelledBy"
          @attributes="@Attributes">
    @if (!string.IsNullOrWhiteSpace(Legend))
    {
        <legend class="@legendClasses">@Legend</legend>
    }
    @if (Items != null && Items.Any())
    {
        <CascadingValue Value="@Name" Name="GroupName" IsFixed="true">
            @foreach (var item in Items)
            {
                <TwCheckbox Label="@item.Label"
                            Value="@item.IsSelected"
                            ValueChanged="@(async (bool val) => await HandleItemChanged(item, val))"
                            Color="@ItemColor"
                            Disabled="@Disabled" />
            }
        </CascadingValue>
    }
    else
    {
        <CascadingValue Value="@Name" Name="GroupName" IsFixed="true">
            @ChildContent
        </CascadingValue>
    }
    @if (errorId is not null)
    {
        <p id="@errorId" class="@inputTheme.ErrorMessage" role="alert">@ErrorMessage</p>
    }
</fieldset>
