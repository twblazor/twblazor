@namespace TwBlazor.Components
@inherits TwBlazorComponentBase

<div class="@containerClasses">
    <div class="@theme.Wrapper" style="@wrapperStyle" tabindex="0" role="group" aria-label="@scrollRegionLabel" @ref="wrapperRef">
        <table id="@Id" class="@tableClasses" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy">
            @if (Caption != null)
            {
                <caption class="@captionClasses">
                    @Caption
                </caption>
            }
            @if (ColumnGroup != null)
            {
                <colgroup>
                    @ColumnGroup
                </colgroup>
            }
            @if (TableHeader != null)
            {
                <thead class="@headerClasses">
                    @TableHeader
                </thead>
            }
            @if (RowGroups != null)
            {
                @RowGroups(bodyClasses)
            }
            else if (TableBody != null)
            {
                <tbody class="@bodyClasses">
                    @TableBody
                </tbody>
            }
            @if (TableFooter != null)
            {
                <tfoot class="@footerClasses">
                    @TableFooter
                </tfoot>
            }
        </table>
    </div>
</div>
