@namespace TwBlazor.Components
@inherits TwBlazorComponentBase

<div id="@Id"
     class="@wrapperClasses"
     style="@Style"
     tabindex="@(isFocusable && !describesControl ? "0" : null)"
     aria-describedby="@(hasTooltip && !describesControl ? tooltipId : null)"
     @ref="wrapperRef"
     data-tw-tooltip="@hasTooltip"
     @attributes="@Attributes"
     aria-label="@AriaLabel"
     aria-labelledby="@AriaLabelledBy"
     @onkeydown="OnKeyDown"
     @onmouseleave="ResetDismissal"
     @onfocusout="ResetDismissal">
    @ChildContent
    @if (hasTooltip)
    {
        <span id="@tooltipId" role="tooltip" class="@tooltipClasses" style="@TooltipStyle">
            @if (Arrow)
            {
                <span class="@arrowClasses" aria-hidden="true"></span>
            }
            @if (TooltipContent != null)
            {
                @TooltipContent
            }
            else
            {
                @Text
            }
        </span>
    }
</div>
