@namespace TwBlazor.Components
@typeparam T
@inherits TwBlazorInputComponentBase

<TwInputRoot RootId="@RootId" RootClass="@RootClass" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy" RootErrorMessage="@ErrorMessage" RootErrorId="@errorId">
    <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" OverrideClass="@labelClasses" @attributes="@LabelAttributes">
        <input type="radio"
               id="@Id"
               name="@effectiveName"
               value="@Value"
               checked="@isChecked"
               @onchange="@HandleChange"
               @onclick:preventDefault="@(ReadOnly && !Disabled)"
               class="@classes"
               disabled="@Disabled"
               @attributes="@Attributes"
               aria-readonly="@(ReadOnly ? "true" : null)"
               aria-invalid="@(Invalid ? "true" : null)"
               aria-describedby="@errorId"
               aria-label="@AriaLabel"
               aria-labelledby="@AriaLabelledBy" />
        <span class="@radioClasses">
            <svg xmlns="http://www.w3.org/2000/svg" class="@options.Theme.Sizing.Icon.Xs" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <circle cx="8" cy="8" r="4"></circle>
            </svg>
        </span>
    </TwInputLabel>
</TwInputRoot>
