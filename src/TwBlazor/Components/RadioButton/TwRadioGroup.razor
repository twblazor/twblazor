@namespace TwBlazor.Components
@typeparam T
@inherits TwBlazorComponentBase

<fieldset id="@Id"
          class="@classes"
          style="@Style"
          disabled="@Disabled"
          role="radiogroup"
          aria-required="@(Required ? "true" : null)"
          aria-invalid="@(Invalid ? "true" : null)"
          aria-describedby="@errorId"
          aria-label="@AriaLabel"
          aria-labelledby="@AriaLabelledBy"
          @attributes="@Attributes">
    @if (!string.IsNullOrWhiteSpace(Legend))
    {
        <legend class="@legendClasses">@Legend</legend>
    }
    @if (Items != null && Items.Any())
    {
        <CascadingValue Value="@Name" Name="GroupName" IsFixed="true">
            @foreach (var item in Items)
            {
                <TwRadioButton Label="@item.Label"
                               Value="@item.Value"
                               SelectedValue="@Value"
                               SelectedValueChanged="@ValueChanged"
                               Color="@ItemColor"
                               Disabled="@Disabled" />
            }
        </CascadingValue>
    }
    else
    {
        <CascadingValue Value="@Name" Name="GroupName" IsFixed="true">
            @ChildContent
        </CascadingValue>
    }
    @if (errorId is not null)
    {
        <p id="@errorId" class="@inputTheme.ErrorMessage" role="alert">@ErrorMessage</p>
    }
</fieldset>
