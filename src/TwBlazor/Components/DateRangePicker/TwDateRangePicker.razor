@namespace TwBlazor.Components
@using TwBlazor.Components.DatePicker
@inherits TwPopoverPickerComponentBase

<TwInputRoot @ref="@InputRoot" RootId="@RootId" RootClass="@classes" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy">
    <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" Class="@LabelClass" @attributes="@LabelAttributes" />
    <div class="@options.Theme.Position.Relative">
        <button type="button" class="@($"{theme.IconTriggerWrapper} {inputSizeClasses}")" aria-expanded="@iconExpanded" aria-label="@localizer[TwStrings.DateRangePicker_Open]" disabled="@Disabled" @onclick="OnIconClickAsync">
            <svg class="@theme.IconGlyph" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 10h16m-8-3V4M7 7V4m10 3V4M5 20h14a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Zm3-7h.01v.01H8V13Zm4 0h.01v.01H12V13Zm4 0h.01v.01H16V13Zm-8 4h.01v.01H8V17Zm4 0h.01v.01H12V17Zm4 0h.01v.01H16V17Z" />
            </svg>
        </button>

        <TwTextfield
            @ref="@trigger"
            T="string"
            Id="@Id"
            InputType="text"
            Disabled="@Disabled"
            OnClick="OnTriggerClickAsync"
            OnKeyDown="OnTriggerKeyDownAsync"
            Value="@Value"
            ValueChanged="@((e) => OnTextValueChanged(e))"
            ReadOnly="@ReadOnly"
            Variant="@Variant"
            Dense="@Dense"
            Invalid="@Invalid"
            ErrorMessage="@ErrorMessage"
            Attributes="@triggerAttributes"
            Class="@textfieldClasses"
            Placeholder="@effectivePlaceholder" />
    </div>

    @if (isFocused)
    {
        <div class="@datepickerContainerClasses" role="dialog" aria-label="@localizer[TwStrings.DateRangePicker_Dialog]" id="@panelId" data-tw-popover tabindex="-1" @ref="PanelRef" @onkeydown="OnPanelKeyDownAsync">
            <div class="@panelWidthClasses">
                @if (view == DateRangePickerView.Year)
                {
                    <TwDatePickerHeader OnPreviousClick="PreviousDecade" OnNextClick="NextDecade" PreviousLabel="@localizer[TwStrings.DatePicker_PreviousDecade]" NextLabel="@localizer[TwStrings.DatePicker_NextDecade]">
                        @localizer.Formats.Format(anchorMonth, localizer.Formats.Year)
                    </TwDatePickerHeader>
                    <TwDatePickerBody Class="@bodyClasses">
                        <div class="@yearsGridClasses">
                            @foreach (var year in Enumerable.Range(anchorMonth.Year, anchorMonth.Year + 10).Take(10))
                            {
                                var yearDate = new DateTime(year, anchorMonth.Month, 1, 0, 0, 0, DateTimeKind.Unspecified);
                                var isSelectedYear = SelectedRange.Key.HasValue && year == SelectedRange.Key.Value.Year;
                                <button type="button" class="@GetButtonClasses("year", isSelectedYear)" aria-pressed="@(isSelectedYear ? "true" : "false")" data-tw-autofocus="@(year == anchorMonth.Year)" @onclick="@(() => SelectYear(yearDate))">
                                    @localizer.Formats.Format(yearDate, localizer.Formats.Year)
                                </button>
                            }
                        </div>
                    </TwDatePickerBody>
                }
                else if (view == DateRangePickerView.Month)
                {
                    <TwDatePickerHeader OnPreviousClick="PreviousYear" OnNextClick="NextYear" OnTitleClick="@(() => SwitchView(DateRangePickerView.Year))" PreviousLabel="@localizer[TwStrings.DatePicker_PreviousYear]" NextLabel="@localizer[TwStrings.DatePicker_NextYear]">
                        @localizer.Formats.Format(anchorMonth, localizer.Formats.Year)
                    </TwDatePickerHeader>
                    <TwDatePickerBody Class="@bodyClasses">
                        <div class="@monthsGridClasses">
                            @foreach (var month in Enumerable.Range(1, 12))
                            {
                                var monthDate = new DateTime(anchorMonth.Year, month, 1, 0, 0, 0, DateTimeKind.Unspecified);
                                var isSelectedMonth = SelectedRange.Key.HasValue && anchorMonth.Year == SelectedRange.Key.Value.Year && month == SelectedRange.Key.Value.Month;
                                <button type="button" class="@GetButtonClasses("month", isSelectedMonth)" aria-pressed="@(isSelectedMonth ? "true" : "false")" aria-label="@localizer.Formats.Format(monthDate, localizer.Formats.MonthYear)" data-tw-autofocus="@(month == anchorMonth.Month)" @onclick="@(() => SelectMonth(monthDate))">
                                    @localizer.Formats.Format(monthDate, localizer.Formats.ShortMonth)
                                </button>
                            }
                        </div>
                    </TwDatePickerBody>
                }
                else
                {
                    <TwDatePickerHeader OnPreviousClick="PreviousMonth" OnNextClick="NextMonth" OnTitleClick="@(() => SwitchView(DateRangePickerView.Month))" PreviousLabel="@localizer[TwStrings.DatePicker_PreviousMonth]" NextLabel="@localizer[TwStrings.DatePicker_NextMonth]" PreviousDisabled="@isPreviousMonthDisabled" NextDisabled="@isNextMonthDisabled">
                        @localizer[TwStrings.Common_Range, localizer.Formats.Format(anchorMonth, localizer.Formats.MonthYear), localizer.Formats.Format(anchorMonth.AddMonths(1), localizer.Formats.MonthYear)]
                    </TwDatePickerHeader>
                    <TwDatePickerBody Class="@bodyClasses">
                        <div class="@theme.DualMonthLayout">
                            <div class="@theme.DualMonthColumn">
                                <TwDatePickerDayView @ref="firstMonthView" Value="anchorMonth" Range="SelectedRange" MinDate="MinDate" MaxDate="MaxDate" ShowMonthCaption="true" ValueChanged="SelectRangeDateAsync" NavigationRequested="OnDayNavigationRequested" />
                            </div>
                            <div class="@theme.DualMonthColumn">
                                <TwDatePickerDayView @ref="secondMonthView" Value="anchorMonth.AddMonths(1)" Range="SelectedRange" MinDate="MinDate" MaxDate="MaxDate" ShowMonthCaption="true" ValueChanged="SelectRangeDateAsync" NavigationRequested="OnDayNavigationRequested" />
                            </div>
                        </div>
                    </TwDatePickerBody>
                }
            </div>
        </div>
    }
</TwInputRoot>
