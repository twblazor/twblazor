@namespace TwBlazor.Components
@using TwBlazor.Components.DatePicker
@inherits TwPopoverPickerComponentBase

<TwInputRoot @ref="@InputRoot" RootId="@RootId" RootClass="@classes" RootAttributes="@RootAttributes" RootStyle="@Style" RootAriaLabel="@AriaLabel" RootAriaLabelledBy="@AriaLabelledBy">
    <TwInputLabel Id="@LabelId" For="@Id" Label="@Label" Class="@LabelClass" @attributes="@LabelAttributes" />
    <div class="@options.Theme.Position.Relative">
        <div class="@($"{theme.IconTriggerWrapper} {inputSizeClasses}")" role="button" tabindex="@(Disabled ? "-1" : "0")" aria-label="Open date range picker" aria-disabled="@(Disabled ? "true" : null)" @onclick="OnIconClickAsync" @onkeydown="OnIconKeyDownAsync">
            <svg class="@theme.IconGlyph" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 10h16m-8-3V4M7 7V4m10 3V4M5 20h14a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Zm3-7h.01v.01H8V13Zm4 0h.01v.01H12V13Zm4 0h.01v.01H16V13Zm-8 4h.01v.01H8V17Zm4 0h.01v.01H12V17Zm4 0h.01v.01H16V17Z" />
            </svg>
        </div>

        <TwTextfield
            @ref="@trigger"
            T="string"
            Id="@Id"
            InputType="text"
            Disabled="@Disabled"
            OnFocus="OnFocusAsync"
            Value="@Value"
            ValueChanged="@((e) => OnTextValueChanged(e))"
            ReadOnly="@ReadOnly"
            Variant="@Variant"
            Dense="@Dense"
            Invalid="@Invalid"
            ErrorMessage="@ErrorMessage"
            Attributes="@triggerAttributes"
            Class="@textfieldClasses"
            Placeholder="@effectivePlaceholder" />
    </div>

    @if (isFocused)
    {
        <div class="@datepickerContainerClasses" role="dialog" aria-label="Choose date range" tabindex="-1" @ref="PanelRef" @onkeydown="OnPanelKeyDownAsync">
            <div class="@panelWidthClasses">
                @if (view == DateRangePickerView.Year)
                {
                    <TwDatePickerHeader OnPreviousClick="PreviousDecade" OnNextClick="NextDecade" PreviousLabel="Previous decade" NextLabel="Next decade">
                        @anchorMonth.ToString("yyyy")
                    </TwDatePickerHeader>
                    <TwDatePickerBody Class="@bodyClasses">
                        <div class="@yearsGridClasses">
                            @foreach (var year in Enumerable.Range(anchorMonth.Year, anchorMonth.Year + 10).Take(10))
                            {
                                var yearDate = new DateTime(year, anchorMonth.Month, 1, 0, 0, 0, DateTimeKind.Unspecified);
                                var isSelectedYear = SelectedRange.Key.HasValue && year == SelectedRange.Key.Value.Year;
                                <button type="button" class="@GetButtonClasses("year", isSelectedYear)" aria-pressed="@(isSelectedYear ? "true" : "false")" @onclick="@(() => SelectYear(yearDate))">
                                    @yearDate.ToString("yyyy")
                                </button>
                            }
                        </div>
                    </TwDatePickerBody>
                }
                else if (view == DateRangePickerView.Month)
                {
                    <TwDatePickerHeader OnPreviousClick="PreviousYear" OnNextClick="NextYear" OnTitleClick="@(() => SwitchView(DateRangePickerView.Year))" PreviousLabel="Previous year" NextLabel="Next year">
                        @anchorMonth.ToString("yyyy")
                    </TwDatePickerHeader>
                    <TwDatePickerBody Class="@bodyClasses">
                        <div class="@monthsGridClasses">
                            @foreach (var month in Enumerable.Range(1, 12))
                            {
                                var monthDate = new DateTime(anchorMonth.Year, month, 1, 0, 0, 0, DateTimeKind.Unspecified);
                                var isSelectedMonth = SelectedRange.Key.HasValue && anchorMonth.Year == SelectedRange.Key.Value.Year && month == SelectedRange.Key.Value.Month;
                                <button type="button" class="@GetButtonClasses("month", isSelectedMonth)" aria-pressed="@(isSelectedMonth ? "true" : "false")" @onclick="@(() => SelectMonth(monthDate))">
                                    @monthDate.ToString("MMM")
                                </button>
                            }
                        </div>
                    </TwDatePickerBody>
                }
                else
                {
                    <TwDatePickerHeader OnPreviousClick="PreviousMonth" OnNextClick="NextMonth" OnTitleClick="@(() => SwitchView(DateRangePickerView.Month))" PreviousLabel="Previous month" NextLabel="Next month" PreviousDisabled="@isPreviousMonthDisabled" NextDisabled="@isNextMonthDisabled">
                        @anchorMonth.ToString("MMMM yyyy") - @anchorMonth.AddMonths(1).ToString("MMMM yyyy")
                    </TwDatePickerHeader>
                    <TwDatePickerBody Class="@bodyClasses">
                        <div class="@theme.DualMonthLayout">
                            <div class="@theme.DualMonthColumn">
                                <TwDatePickerDayView Value="anchorMonth" Range="SelectedRange" MinDate="MinDate" MaxDate="MaxDate" ShowMonthCaption="true" ValueChanged="SelectRangeDateAsync" />
                            </div>
                            <div class="@theme.DualMonthColumn">
                                <TwDatePickerDayView Value="anchorMonth.AddMonths(1)" Range="SelectedRange" MinDate="MinDate" MaxDate="MaxDate" ShowMonthCaption="true" ValueChanged="SelectRangeDateAsync" />
                            </div>
                        </div>
                    </TwDatePickerBody>
                }
            </div>
        </div>
    }
</TwInputRoot>
