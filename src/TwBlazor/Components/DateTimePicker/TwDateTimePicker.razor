@namespace TwBlazor.Components
@using TwBlazor.Components.DatePicker
@using TwBlazor.Components.TimePicker
@inherits TwBlazorTextInputComponentBase

<TwDatePicker 
    @ref="datePicker"
    RootId="@RootId"
    RootClass="@RootClass"
    RootAttributes="@RootAttributes"
    Style="@Style"
    AriaLabel="@AriaLabel"
    AriaLabelledBy="@AriaLabelledBy"
    Id="@Id"
    Format="@format"
    PreferNativePicker="@PreferNativePicker"
    NativeInputType="datetime-local"
    NativeFormat="yyyy-MM-ddTHH:mm"
    NativeStep="@nativeStep"
    Value="@Value"
    ValueChanged="@OnValueChangedAsync"
    SelectedDate="@SelectedDateTime"
    SelectedDateChanged="@OnDateChangedAsync"
    SelectedDateExpression="@SelectedDateTimeExpression"
    ValueExpression="@ValueExpression"
    Invalid="@Invalid"
    ErrorMessage="@ErrorMessage"
    @attributes="@Attributes"
    Placeholder="@effectivePlaceholder" 
    Class="@Class" 
    Label="@Label"
    LabelClass="@LabelClass"
    LabelId="@LabelId"
    LabelAttributes="@LabelAttributes"
    Variant="@Variant"
    Rounded="@Rounded"
    Dense="@Dense"
    ReadOnly="@ReadOnly"
    Disabled="@Disabled">
    <FocusedChildContent>
        <TwDatePickerBody Class="time">
            <TwTimePickerBody Id="@($"{Id}-time")"
                              Variant="@effectiveVariant"
                              Rounded="@Rounded"
                              Is12HourFormat="@effectiveIs12HourFormat"
                              Step="@Step"
                              SelectedTime="@currentTime"
                              SelectedTimeChanged="@OnTimePickerChanged" />
        </TwDatePickerBody>
    </FocusedChildContent>
</TwDatePicker>



