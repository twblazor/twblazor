@namespace TwBlazor.Components
@inherits TwBlazorComponentBase

<li class="@theme.Item">
    @if (!isFirst)
    {
        <span class="@theme.Separator" aria-hidden="true">
            @if (separatorIcon is { } separatorGlyph)
            {
                <TwIcon Icon="@separatorGlyph" Class="@theme.SeparatorIcon" />
            }
            else
            {
                @separator
            }
        </span>
    }
    @if (isCurrent)
    {
        <span id="@Id" aria-current="page" class="@currentClasses" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy">
            @if (icon is { } currentIcon)
            {
                <TwIcon Icon="@currentIcon" Class="@currentIconClasses" />
            }
            @label
        </span>
    }
    else
    {
        <a id="@Id" href="@href" class="@linkClasses" style="@Style" @attributes="Attributes" aria-label="@AriaLabel" aria-labelledby="@AriaLabelledBy">
            @if (icon is { } linkIcon)
            {
                <TwIcon Icon="@linkIcon" Class="@theme.Icon" />
            }
            @label
        </a>
    }
</li>
