@namespace TwBlazor.Components
@inherits TwBlazorComponentBase

<nav id="@Id" class="@Class" style="@Style" aria-label="@(AriaLabel ?? (AriaLabelledBy == null ? "Breadcrumb" : null))" aria-labelledby="@AriaLabelledBy" @attributes="@Attributes">
    <ol class="@theme.List">
        @if (ChildContent != null)
        {
            <CascadingValue Value="this" IsFixed="true">
                @ChildContent
            </CascadingValue>
        }
        else
        {
            @for (var i = 0; i < Breadcrumbs.Count; i++)
            {
                <TwBreadcrumbItem Breadcrumb="@Breadcrumbs[i]" Class="" IsFirst="@(i == 0)" Separator="@Separator" SeparatorIcon="@SeparatorIcon" />
            }
        }
    </ol>
</nav>